---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../lib/images';
import { ensureProtocol } from '../../../lib/url';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../../lib/seo/schema';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

const countryNames: Record<string, string> = {
  'united-kingdom': 'United Kingdom',
  'south-korea': 'South Korea',
  'united-states': 'United States',
};

function countryDisplayName(slugVal: string | null): string {
  if (!slugVal) return '';
  const val = slugVal.toLowerCase();
  if (countryNames[val]) return countryNames[val];
  return val.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

let fair: any = null;
let relatedFairs: any[] = [];
let relatedTitle = 'More design fairs';
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [fairsRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/fairs.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (fairsRes.ok) {
    const rawFairs = await fairsRes.json();
    const allFairs = Array.isArray(rawFairs) ? rawFairs : (rawFairs.items || []);

    fair = allFairs.find((f: any) => f.slug === slug) || null;

    if (fair) {
      const fairDate = fair.start_date ? new Date(fair.start_date) : null;
      const hasFairDate = !!fairDate && !isNaN(fairDate.getTime());

      // Discovery: fairs happening in the same month (makes far more sense
      // than "in the area", which is almost never true for fairs).
      const sameMonth = allFairs
        .filter((f: any) => f.slug !== slug && f.start_date)
        .filter((f: any) => {
          if (!hasFairDate) return false;
          const d = new Date(f.start_date);
          return d.getFullYear() === fairDate.getFullYear() && d.getMonth() === fairDate.getMonth();
        })
        .sort((a: any, b: any) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());

      const pool = sameMonth.length > 0 ? sameMonth : allFairs
        .filter((f: any) => f.slug !== slug && f.start_date)
        .sort((a: any, b: any) => {
          if (!hasFairDate) return 0;
          return Math.abs(new Date(a.start_date).getTime() - fairDate.getTime())
               - Math.abs(new Date(b.start_date).getTime() - fairDate.getTime());
        });

      relatedFairs = pool.slice(0, 5);
      relatedTitle = hasFairDate
        ? `Design fairs in ${monthNames[fairDate.getMonth()]} ${fairDate.getFullYear()}`
        : 'More design fairs';
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();
  if (countriesRes.ok) countriesMapping = await countriesRes.json();

} catch (e) {
  console.error('[Fair Slug] Fail to fetch data:', e);
}

if (!fair) {
  return Astro.redirect('/404');
}

function getPeriod(startStr: string, endStr: string) {
  if (!startStr) return "";
  const start = new Date(startStr);
  const end = endStr ? new Date(endStr) : null;
  const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const startDay = start.getDate();
  const startMonth = monthNames[start.getMonth()];
  if (!end || isNaN(end.getTime()) || startStr === endStr) return `${startMonth} ${startDay}, ${start.getFullYear()}`;
  const endDay = end.getDate();
  if (start.getMonth() === end.getMonth()) return `${startMonth} ${startDay}-${endDay}, ${start.getFullYear()}`;
  const endMonth = monthNames[end.getMonth()];
  return `${startMonth} ${startDay} - ${endMonth} ${endDay}, ${start.getFullYear()}`;
}

const countryName = fair.country || countriesMapping.find(c => c.slug === fair.country_slug)?.name || countryDisplayName(fair.country_slug);
const cityName = fair.city || citiesMapping.find(c => c.slug === fair.city_slug)?.name || fair.city_slug;

const pageTitle = `${fair.name} — Design Fair in ${cityName} | Acceso`;
const pageDesc = fair.description || `Explore ${fair.name}, a premier design event in ${cityName}, ${countryName}.`;

// ── SEO: Canonical + Event schema ──────────────────────────────────────────
const canonical = new URL(`/directory/fairs/${slug}`, Astro.site);
const fairSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Event',
      '@id': `${canonical}#event`,
      name: fair.name,
      description: pageDesc,
      url: canonical.toString(),
      image: fair.image || undefined,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      ...(fair.start_date ? { startDate: fair.start_date } : {}),
      ...(fair.end_date ? { endDate: fair.end_date } : {}),
      location: {
        '@type': 'Place',
        name: cityName,
        address: {
          '@type': 'PostalAddress',
          addressLocality: cityName,
          addressCountry: countryName,
        },
      },
      organizer: fair.website ? { '@type': 'Organization', name: fair.name, url: fair.website } : undefined,
    },
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Fairs', url: '/directory/fairs' },
      { name: fair.name, url: `/directory/fairs/${slug}` },
    ]),
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={fairSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={[
      { label: 'Directory', href: '/directory' },
      { label: 'Fairs', href: '/directory/fairs' },
      { label: fair.name }
    ]} />
  </div>

  <main class="fair-detail-container">
    <div class="fair-hero-row">
      <div class="hero-image-wrapper">
        {fair.image ? (
          <img 
            src={normalizeImage(fair.image, Astro, { width: 1200 })} 
            alt={fair.name} 
            class="hero-image" 
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero-image-placeholder">No image available</div>
        )}
      </div>

      <aside class="info-card">
        <div class="info-card-content">
          <h1 class="fair-name">{fair.name}</h1>
          <p class="fair-description">
            {fair.description}
          </p>

          <div class="social-links">
            {fair.website && (
              <a href={ensureProtocol(fair.website)} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                <img src="/icons/source.svg" alt="" width="16" height="16" />
                <span>Website</span>
              </a>
            )}
            {fair.instagram && (
              <a href={ensureProtocol(fair.instagram)} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                <span>Instagram</span>
              </a>
            )}
          </div>

          <div class="details-section">
            <div class="details-row">
              <span class="detail-label">Period</span>
              <span class="detail-value">{getPeriod(fair.start_date, fair.end_date)}</span>
            </div>
            <div class="details-divider"></div>
            <div class="details-row">
              <span class="detail-label">Country</span>
              {fair.country_slug ? (
                <a href={`/directory/fairs/in/${fair.country_slug}`} class="detail-value underlined detail-link">{countryName}</a>
              ) : (
                <span class="detail-value">{countryName}</span>
              )}
            </div>
            <div class="details-divider"></div>
            <div class="details-row">
              <span class="detail-label">Location</span>
              {fair.city_slug ? (
                <a href={`/directory/fairs/in/${fair.city_slug}`} class="detail-value underlined detail-link">{cityName}</a>
              ) : (
                <span class="detail-value underlined">{cityName}</span>
              )}
            </div>
          </div>
        </div>

        <div class="card-footer-actions">
          <button class="footer-btn share-btn" id="shareButton">
            <img src="/icons/share.svg" alt="" width="18" height="18" />
            <span>Share</span>
          </button>
          <button 
            class="footer-btn save-btn" 
            id="calendarBtn"
            data-name={fair.name}
            data-desc={fair.description}
            data-start={fair.start_date}
            data-end={fair.end_date || fair.start_date}
            data-url={fair.website}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Save date</span>
          </button>
        </div>
      </aside>
    </div>

    <section class="discovery-area">
      <div class="discovery-content">
        {relatedFairs.length > 0 && (
          <div class="discovery-section">
            <div class="section-top">
              <h2 class="discovery-title">{relatedTitle}</h2>
              <a href="/directory/fairs" class="discovery-see-all pill-link">
                Explore fairs
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <div class="discovery-grid">
              {relatedFairs.map(f => (
                <div class="grid-item">
                  <EventBasicCard 
                    name={f.name}
                    slug={f.slug}
                    type="fair"
                    location={f.city || cityName}
                    date={getPeriod(f.start_date, f.end_date)}
                    image={normalizeImage(f.image, Astro)}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: `Check out ${document.title.split('—')[0]} on Acceso`
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) { }
    });
  }

  const calendarBtn = document.getElementById('calendarBtn');
  if (calendarBtn) {
    calendarBtn.addEventListener('click', () => {
      const { name = '', desc = '', start = '', end = '', url: website = '' } = calendarBtn.dataset;
      const fmtStart = start.replace(/-/g, '').split('T')[0];
      const fmtEnd = end.replace(/-/g, '').split('T')[0];

      const icsData = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Acceso//Design Events//EN',
        'BEGIN:VEVENT',
        `DTSTART;VALUE=DATE:${fmtStart}`,
        `DTEND;VALUE=DATE:${fmtEnd}`,
        `SUMMARY:${name}`,
        `DESCRIPTION:${(desc || '').replace(/\n/g, '\\n')}\\n\\nWebsite: ${website || 'N/A'}`,
        `URL:${website || ''}`,
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${name.toLowerCase().replace(/\s+/g, '-')}.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
    });
  }
</script>

<style>
  .fair-detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .fair-hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: stretch;
    justify-content: flex-end;
    --hero-card-height: clamp(500px, 75vh, 700px);
  }

  .hero-image-wrapper {
    height: var(--hero-card-height);
    max-height: var(--hero-card-height);
    width: auto;
    max-width: 100%;
    background: var(--color-bg-secondary);
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 1;
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .hero-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-sans);
  }

  .info-card {
    width: 400px;
    height: var(--hero-card-height);
    max-height: var(--hero-card-height);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
    min-height: 0;
  }

  .info-card::-webkit-scrollbar { display: none; }
  .info-card-content::-webkit-scrollbar { display: none; }

  .fair-name {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-black);
    margin: 0 0 24px -2px;
  }

  .fair-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    margin-bottom: 24px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .social-links { display: flex; gap: 8px; margin-bottom: 24px; }

  /* Unify hover for Website and Instagram buttons: a subtle, elegant darken. */
  .card-social-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .details-section {
    background: var(--color-btn-bg);
    border-radius: 10px;
    padding: 16px 0;
    margin-bottom: 16px;
  }

  .details-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .detail-label { font-size: 15px; color: var(--color-gray); }
  .detail-value { font-size: 15px; font-weight: 700; color: var(--color-black); text-align: right; text-decoration: none; line-height: 1.4; word-break: break-word; }

  /* Unify hover for Location links: simply get a little lighter, no movement. */
  .detail-link { transition: opacity 0.2s ease; }
  .detail-link:hover { opacity: 0.6; }

  .detail-value.underlined { text-decoration: underline; }
  .detail-value.underlined:hover { color: var(--color-black); }
  .detail-value-group { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .detail-separator { color: var(--color-gray); margin: 0 2px; font-weight: 400; }
  .details-divider { height: 1px; background: var(--color-stroke); margin: 12px 0; }

  .card-footer-actions {
    margin-top: auto;
    flex-shrink: 0;
  }

  .discovery-area { margin-top: 120px; padding-bottom: 40px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; padding-bottom: 0; }
  .discovery-title { font-family: var(--font-sans); font-size: 24px; font-weight: 400; color: var(--color-black); letter-spacing: -0.02em; }
  .discovery-see-all { flex-shrink: 0; }

  .discovery-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }

  /* Force the discovery cards to be squared, like the designers slug. */
  .discovery-grid :global(.card-image-wrapper) { aspect-ratio: 1; }

  @media (max-width: 1300px) {
    .discovery-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 1100px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .fair-hero-row { flex-direction: column; align-items: center; }
    .hero-image-wrapper { width: 100%; max-width: 600px; height: auto; max-height: none; min-height: auto; border-radius: 0; }
    .info-card { width: 100%; height: auto; max-height: none; max-width: 600px; }
    .fair-detail-container { padding: 0 20px 40px; }
    .breadcrumbs-container { padding: 32px 20px 0; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
    .discovery-title { font-size: 20px; }
  }
</style>
