---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CalendarModal from '../../../components/CalendarModal.astro';
import { normalizeImage } from '../../../lib/images';
import { breadcrumbList } from '../../../lib/seo/schema';

// Reusable Components
import FairHeader from '../../../components/fair/FairHeader.astro';
import FairGallery from '../../../components/fair/FairGallery.astro';
import FairStats from '../../../components/fair/FairStats.astro';
import AboutSection from '../../../components/school/AboutSection.astro';
import FairSidebarInfo from '../../../components/fair/FairSidebarInfo.astro';
import FairLocationSection from '../../../components/fair/FairLocationSection.astro';
import FairPromoCard from '../../../components/fair/FairPromoCard.astro';
import ReportIssueModal from '../../../components/school/ReportIssueModal.astro';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

const countryNames: Record<string, string> = {
  'united-kingdom': 'United Kingdom',
  'south-korea': 'South Korea',
  'united-states': 'United States',
};

function countryDisplayName(slugVal: string | null): string {
  if (!slugVal) return '';
  const val = slugVal.toLowerCase();
  if (countryNames[val]) return countryNames[val];
  return val.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

let fair: any = null;
let relatedFairs: any[] = [];
let relatedTitle = 'More design fairs';
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [fairsRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/fairs.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (fairsRes.ok) {
    const rawFairs = await fairsRes.json();
    const allFairs = Array.isArray(rawFairs) ? rawFairs : (rawFairs.items || []);

    fair = allFairs.find((f: any) => f.slug === slug) || null;

    if (fair) {
      const fairDate = fair.start_date ? new Date(fair.start_date) : null;
      const hasFairDate = !!fairDate && !isNaN(fairDate.getTime());

      // Discovery: fairs happening in the same month
      const sameMonth = allFairs
        .filter((f: any) => f.slug !== slug && f.start_date)
        .filter((f: any) => {
          if (!hasFairDate) return false;
          const d = new Date(f.start_date);
          return d.getFullYear() === fairDate.getFullYear() && d.getMonth() === fairDate.getMonth();
        })
        .sort((a: any, b: any) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());

      const pool = sameMonth.length > 0 ? sameMonth : allFairs
        .filter((f: any) => f.slug !== slug && f.start_date)
        .sort((a: any, b: any) => {
          if (!hasFairDate) return 0;
          return Math.abs(new Date(a.start_date).getTime() - fairDate.getTime())
               - Math.abs(new Date(b.start_date).getTime() - fairDate.getTime());
        });

      relatedFairs = pool.slice(0, 5);
      relatedTitle = hasFairDate
        ? `Design fairs in ${monthNames[fairDate.getMonth()]} ${fairDate.getFullYear()}`
        : 'More design fairs';
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();
  if (countriesRes.ok) countriesMapping = await countriesRes.json();

} catch (e) {
  console.error('[Fair Slug] Fail to fetch data:', e);
}

if (!fair) {
  return Astro.redirect('/404');
}

function getPeriod(startStr: string, endStr: string) {
  if (!startStr) return "";
  const start = new Date(startStr);
  // An unparseable CMS date used to render as "NaN NaN, NaN" on the card.
  if (isNaN(start.getTime())) return "";
  const end = endStr ? new Date(endStr) : null;
  const monthAbbrs = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const startDay = start.getDate();
  const startMonth = monthAbbrs[start.getMonth()];
  if (!end || isNaN(end.getTime()) || startStr === endStr) return `${startMonth} ${startDay}, ${start.getFullYear()}`;
  const endDay = end.getDate();
  if (start.getMonth() === end.getMonth()) return `${startMonth} ${startDay}-${endDay}, ${start.getFullYear()}`;
  const endMonth = monthAbbrs[end.getMonth()];
  return `${startMonth} ${startDay} - ${endMonth} ${endDay}, ${start.getFullYear()}`;
}

const countryName = fair.country || countriesMapping.find(c => c.slug === fair.country_slug)?.name || countryDisplayName(fair.country_slug);
const cityName = fair.city || citiesMapping.find(c => c.slug === fair.city_slug)?.name || fair.city_slug;

const periodStr = getPeriod(fair.start_date, fair.end_date);

// Location / embed data
const fairLat = fair ? parseFloat(fair.latitude) : NaN;
const fairLng = fair ? parseFloat(fair.longitude) : NaN;
const fairHasLocation = !!fair && !!fair.address && !isNaN(fairLat) && !isNaN(fairLng);

const gmapsUrl = fairHasLocation
  ? (fair.gmaps_url || fair.gmaps || `https://www.google.com/maps/search/?api=1&query=${fairLat},${fairLng}`)
  : (fair.gmaps_url || fair.gmaps || '');

const aboutParagraphs = (fair.long_description || '')
  .split(/\n+/)
  .map((p: string) => p.trim())
  .filter((p: string) => p.length > 0);

const pageTitle = `${fair.name} — Design Fair in ${cityName} | Acceso`;
const pageDesc = fair.description || `Explore ${fair.name}, a premier design event in ${cityName}, ${countryName}.`;

// ── SEO: Canonical + Event schema ──────────────────────────────────────────
const canonical = new URL(`/directory/fairs/${slug}`, Astro.site);
const fairStartDate = fair.start_date || fair.end_date;

const fairSchema = fairStartDate && cityName ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Event',
      '@id': `${canonical}#event`,
      name: fair.name,
      description: pageDesc,
      url: canonical.toString(),
      image: fair.image || undefined,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      startDate: fairStartDate,
      ...(fair.end_date ? { endDate: fair.end_date } : {}),
      location: {
        '@type': 'Place',
        name: cityName,
        address: {
          '@type': 'PostalAddress',
          addressLocality: cityName,
          addressCountry: countryName,
        },
      },
      organizer: fair.website ? { '@type': 'Organization', name: fair.name, url: fair.website } : undefined,
    },
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Fairs', url: '/directory/fairs' },
      { name: fair.name, url: `/directory/fairs/${slug}` },
    ]),
  ],
} : null;
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={fairSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={[
      { label: 'Directory', href: '/directory' },
      { label: 'Fairs', href: '/directory/fairs' },
      { label: fair.name }
    ]} />
  </div>

  <main class="detail-container">

    <!-- ── IDENTITY HEADER ────────────────────────────────────────────────── -->
    <FairHeader fair={fair} cityName={cityName} countryName={countryName} />

    <!-- ── TWO-COLUMN MAIN LAYOUT ─────────────────────────────────────────── -->
    <div class="fair-grid">

      <!-- LEFT: EDITORIAL CONTENT -->
      <div class="fair-main-col">

        <!-- 1. Slideshow Gallery -->
        <FairGallery fair={fair} />

        <!-- 2. Overview Intro -->
        {fair.description && (
          <section class="content-block intro-block">
            <h2 class="info-heading">Information</h2>
            <h3 class="block-title">OVERVIEW</h3>
            <p class="fair-lead-text">{fair.description}</p>
          </section>
        )}

        <!-- 3. Key Stats (Exhibitors, Visitors, Founded, Recurrence) -->
        <FairStats
          exhibitors={fair.exhibitors}
          visitors={fair.visitors}
          founded={fair.founded}
          recurrence={fair.recurrence}
        />

        <!-- 5. About the Fair (Editorial Columns) -->
        <AboutSection aboutParagraphs={aboutParagraphs} title="About the Fair" />

      </div>

      <!-- RIGHT: STICKY SIDEBAR -->
      <aside class="fair-sidebar-col">
        <div class="sidebar-sticky-wrapper">

          <!-- 1. Main Info Card (Website + Save Date Buttons) -->
          <FairSidebarInfo
            fair={fair}
            period={periodStr}
            countryName={countryName}
            cityName={cityName}
          />

          <!-- 2. Venue & Location Map Section (Get Directions Button) -->
          {fairHasLocation && (
            <FairLocationSection fair={fair} gmapsUrl={gmapsUrl} />
          )}

          <!-- 3. Organizer Promo Card -->
          <FairPromoCard />

        </div>
      </aside>

    </div>

    <!-- ── BOTTOM DISCOVERY AREA ─────────────────────────────────────────── -->
    {relatedFairs.length > 0 && (
      <section class="discovery-area">
        <div class="discovery-header">
          <h2 class="discovery-title">{relatedTitle}</h2>
          <a href="/directory/fairs" class="pill-link">
            <span>Explore all fairs</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="discovery-grid">
          {relatedFairs.map(f => (
            <div class="discovery-item">
              <EventBasicCard
                name={f.name}
                slug={f.slug}
                type="fair"
                location={f.city || cityName}
                date={getPeriod(f.start_date, f.end_date)}
                image={normalizeImage(f.image, Astro)}
              />
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <!-- Save Date / Google Calendar Modal -->
  <CalendarModal />

  <!-- Report Embed Modal -->
  <ReportIssueModal universityName={fair.name} universityHasLocation={fairHasLocation} />

  <Footer />
</Layout>

<style>
  /* ── Page Containers ───────────────────────────────────────────────── */
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 100px;
    box-sizing: border-box;
    width: 100%;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── 2-Column Grid Layout ────────────────────────────────────────── */
  .fair-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  .fair-main-col {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Content Blocks ──────────────────────────────────────────────── */
  .content-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .fair-lead-text {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-black);
    margin: 0;
    font-weight: 400;
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  .info-heading {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* ── RIGHT SIDEBAR ───────────────────────────────────────────────── */
  .fair-sidebar-col {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--navbar-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Bottom Discovery Area ───────────────────────────────────────── */
  .discovery-area {
    margin-top: 64px;
    padding-top: 0;
    border-top: none;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    width: 100%;
  }

  .discovery-title {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-grid :global(.card-image-wrapper) {
    aspect-ratio: 1;
  }

  /* ── Responsive Breakpoints & Visitor Priority Ordering ─────────────── */
  @media (max-width: 1300px) {
    .discovery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1100px) {
    .fair-grid {
      grid-template-columns: 1fr 340px;
      gap: 32px;
    }
    .discovery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 960px) {
    .fair-main-col,
    .fair-sidebar-col,
    .sidebar-sticky-wrapper {
      display: contents;
    }

    .fair-grid {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 100%;
    }

    :global(.gallery-section) { order: 1; }
    .intro-block { order: 2; }
    :global(.info-card) { order: 3; }
    :global(.fair-stats-grid) { order: 4; }
    :global(.spec-block) { order: 5; }
    :global(.sidebar-location-section) { order: 6; }
    :global(.about-block) { order: 7; }
    :global(.promo-box) { order: 8; }
  }

  @media (max-width: 768px) {
    .breadcrumbs-container {
      padding: 24px 20px 0;
    }
    .detail-container {
      padding: 0 20px 60px;
    }
    .discovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .breadcrumbs-container {
      padding: 20px 16px 0;
    }
    .detail-container {
      padding: 0 16px 48px;
    }
    .discovery-grid {
      grid-template-columns: 1fr;
    }
    .discovery-title {
      font-size: 18px;
    }
  }
</style>
