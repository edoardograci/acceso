---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { normalizeImage } from '../../../lib/images';
import { breadcrumbList } from '../../../lib/seo/schema';

// Reusable Museum Components
import MuseumHeader from '../../../components/museum/MuseumHeader.astro';
import MuseumGallery from '../../../components/museum/MuseumGallery.astro';
import MuseumSidebarInfo from '../../../components/museum/MuseumSidebarInfo.astro';
import MuseumLocationSection from '../../../components/museum/MuseumLocationSection.astro';
import MuseumPromoCard from '../../../components/museum/MuseumPromoCard.astro';
import AboutSection from '../../../components/school/AboutSection.astro';
import ReportIssueModal from '../../../components/school/ReportIssueModal.astro';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let museum: any = null;
let relatedMuseums: any[] = [];
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [musRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/museums.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (musRes.ok) {
    const rawData = await musRes.json();
    const allMuseums = Array.isArray(rawData) ? rawData : (rawData.items || []);
    
    const processedMuseums = allMuseums;

    museum = processedMuseums.find((m: any) => m.slug === slug) || null;

    if (museum) {
      // Discovery: curated set of other museums prioritizing country/city
      relatedMuseums = processedMuseums
        .filter((m: any) => m.slug !== slug)
        .sort((a: any, b: any) => {
          const aCountry = a.country_slug === museum.country_slug ? 0 : 1;
          const bCountry = b.country_slug === museum.country_slug ? 0 : 1;
          if (aCountry !== bCountry) return aCountry - bCountry;
          const aCity = a.city_slug === museum.city_slug ? 0 : 1;
          const bCity = b.city_slug === museum.city_slug ? 0 : 1;
          if (aCity !== bCity) return aCity - bCity;
          return 0;
        })
        .slice(0, 5);
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();
  if (countriesRes.ok) countriesMapping = await countriesRes.json();

} catch (e) {
  console.error('[Museum Slug] Fail to fetch data:', e);
}

if (!museum) {
  return new Response(null, { status: 404 });
}

const countryName = museum.country || countriesMapping.find(c => c.slug === museum.country_slug)?.name || museum.country_slug;
const cityName = museum.city || citiesMapping.find(c => c.slug === museum.city_slug)?.name || museum.city_slug;

// ── Location / embed data ───────────────────────────────────────────────
const museumLat = museum ? parseFloat(museum.latitude) : NaN;
const museumLng = museum ? parseFloat(museum.longitude) : NaN;
const museumHasLocation = !!museum && !!museum.address && !isNaN(museumLat) && !isNaN(museumLng);

const gmapsUrl = museumHasLocation
  ? (museum.gmaps || `https://www.google.com/maps/search/?api=1&query=${museumLat},${museumLng}`)
  : '';

const aboutParagraphs = (museum.long_description || '')
  .split(/\n+/)
  .map((p: string) => p.trim())
  .filter((p: string) => p.length > 0);

const contactParts = museum.contact
  ? museum.contact.split(/[/,|;]/).map((p: string) => p.trim()).filter(Boolean)
  : [];

const pageTitle = `${museum.name} — Design Museum in ${cityName} | Acceso`;
const pageDesc = museum.description || `Explore ${museum.name}, a prominent design institution in ${cityName}, ${countryName}.`;

// ── SEO: Canonical + Museum schema ────────────────────────────────────────
const canonical = new URL(`/directory/museums/${slug}`, Astro.site);
const museumSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Museum',
      '@id': `${canonical}#museum`,
      name: museum.name,
      description: pageDesc,
      url: canonical.toString(),
      image: museum.image || undefined,
      address: museum.address ? {
        '@type': 'PostalAddress',
        streetAddress: museum.address,
        addressLocality: cityName,
        addressCountry: countryName,
      } : undefined,
      ...(museumHasLocation ? { geo: { '@type': 'GeoCoordinates', latitude: museumLat, longitude: museumLng } } : {}),
      sameAs: [museum.website, museum.instagram, museum.facebook].filter(Boolean),
    },
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Museums', url: '/directory/museums' },
      { name: museum.name, url: `/directory/museums/${slug}` },
    ]),
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={museumSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={[
      { label: 'Directory', href: '/directory' },
      { label: 'Museums', href: '/directory/museums' },
      { label: museum.name }
    ]} />
  </div>

  <main class="detail-container">

    <!-- ── IDENTITY HEADER ────────────────────────────────────────────────── -->
    <MuseumHeader museum={museum} cityName={cityName} countryName={countryName} />

    <!-- ── TWO-COLUMN MAIN LAYOUT ─────────────────────────────────────────── -->
    <div class="museum-grid">

      <!-- LEFT: EDITORIAL CONTENT -->
      <div class="museum-main-col">

        <!-- 1. Slideshow Gallery -->
        <MuseumGallery museum={museum} />

        <!-- 2. Info Section with Overview and Read More -->
        <section class="content-block info-block">
          <h2 class="info-heading">Information</h2>
          <h3 class="block-title">ABOUT THE MUSEUM</h3>
          {museum.description && (
            <p class="museum-lead-text">{museum.description}</p>
          )}
          {aboutParagraphs.length > 0 && (
            <div class="about-text-content">
              {aboutParagraphs.map((para: string) => (
                <p class="about-paragraph">{para}</p>
              ))}
            </div>
          )}
        </section>

      </div>

      <!-- RIGHT: STICKY SIDEBAR -->
      <aside class="museum-sidebar-col">
        <div class="sidebar-sticky-wrapper">

          <!-- 1. Main Info Card (Website + Save Buttons) -->
          <MuseumSidebarInfo
            museum={museum}
            countryName={countryName}
            cityName={cityName}
            contactParts={contactParts}
          />

          <!-- 2. Museum Location Map Section (Get Directions Button) -->
          {museumHasLocation && (
            <MuseumLocationSection museum={museum} gmapsUrl={gmapsUrl} />
          )}

          <!-- 3. Submit for Review Promo Card -->
          <MuseumPromoCard />

        </div>
      </aside>

    </div>

    <!-- ── BOTTOM DISCOVERY AREA ─────────────────────────────────────────── -->
    {relatedMuseums.length > 0 && (
      <section class="discovery-area">
        <div class="discovery-header">
          <h2 class="discovery-title">Explore design museums</h2>
          <a href="/directory/museums" class="pill-link">
            <span>Explore all museums</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="discovery-grid">
          {relatedMuseums.map(m => (
            <div class="discovery-item">
              <EventBasicCard
                name={m.name}
                slug={m.slug}
                type="museum"
                location={m.city || cityName}
                image={normalizeImage(m.image, Astro)}
              />
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <!-- Report Embed Modal -->
  <ReportIssueModal universityName={museum.name} universityHasLocation={museumHasLocation} />

  <Footer />
</Layout>

<style>
  /* ── Page Containers ───────────────────────────────────────────────── */
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 100px;
    box-sizing: border-box;
    width: 100%;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── 2-Column Grid Layout ────────────────────────────────────────── */
  .museum-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  .museum-main-col {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Content Blocks ──────────────────────────────────────────────── */
  .content-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .museum-lead-text {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-black);
    margin: 0;
    font-weight: 400;
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  /* ── Info Section ────────────────────────────────────────────────── */
  .info-heading {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .about-text-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
    margin-top: 18px;
  }

  .about-paragraph {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── RIGHT SIDEBAR ───────────────────────────────────────────────── */
  .museum-sidebar-col {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--navbar-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Bottom Discovery Area ───────────────────────────────────────── */
  .discovery-area {
    margin-top: 64px;
    padding-top: 0;
    border-top: none;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    width: 100%;
  }

  .discovery-title {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-grid :global(.card-image-wrapper) {
    aspect-ratio: 1;
  }

  /* ── Responsive Breakpoints & Visitor Priority Ordering ─────────────── */
  @media (max-width: 1300px) {
    .discovery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1100px) {
    .museum-grid {
      grid-template-columns: 1fr 340px;
      gap: 32px;
    }
    .discovery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 960px) {
    .museum-main-col,
    .museum-sidebar-col,
    .sidebar-sticky-wrapper {
      display: contents;
    }

    .museum-grid {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 100%;
    }

    .museum-main-col > :nth-child(1) { order: 1; }
    .info-block { order: 2; }
    .museum-sidebar-col :global(.info-card) { order: 3; }
    .museum-sidebar-col :global(.sidebar-location-section) { order: 4; }
    .museum-sidebar-col :global(.promo-box) { order: 5; }

    .about-text-content {
      margin-top: 14px;
    }
  }

  @media (max-width: 768px) {
    .breadcrumbs-container {
      padding: 24px 20px 0;
    }
    .detail-container {
      padding: 0 20px 60px;
    }
    .discovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .breadcrumbs-container {
      padding: 20px 16px 0;
    }
    .detail-container {
      padding: 0 16px 48px;
    }
    .discovery-grid {
      grid-template-columns: 1fr;
    }
    .discovery-title {
      font-size: 18px;
    }
  }
</style>
