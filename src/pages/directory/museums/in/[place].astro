---
import PostHogLayout from '../../../../layouts/PostHogLayout.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import DirectoryCard from '../../../../components/DirectoryCard.astro';
import GetListedCard from '../../../../components/GetListedCard.astro';
import { museumTitle, museumDescription, museumIntro } from '../../../../lib/seo/copy';
import { breadcrumbList, itemList } from '../../../../lib/seo/schema';
import { normalizeImage } from '../../../../lib/images';
import type { Museum } from '../../../../lib/types';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';

const { place } = Astro.params;

const isDev = import.meta.env.DEV;
const origin = Astro.url.origin;
const domain = isDev ? 'https://json.acceso.design' : `${origin}/cdn`;

async function fetchJson<T>(path: string): Promise<T> {
  const u = `${domain}${path.startsWith('/') ? '' : '/'}${path}`;
  const r = await fetch(u);
  if (!r.ok) throw new Error(`Fetch failed ${path}: ${r.status}`);
  return (await r.json()) as T;
}

type City = { slug: string; name: string; country?: string };
type Country = { slug: string; name: string };

let cities: City[] = [];
let countries: Country[] = [];
let allMuseums: Museum[] = [];
let mode: 'city' | 'country' | 'unknown' = 'unknown';
let cityName: string | null = null;
let countryName: string | null = null;
let totalMuseums: number = 0;

try {
  [cities, countries, allMuseums] = await Promise.all([
    fetchJson<City[]>('/test-cities.json'),
    fetchJson<Country[]>('/test-countries.json'),
    fetchJson<Museum[]>('/museums.json'),
  ]);
} catch (e) {
  console.error('[SSR] Fetch failed:', e);
}

const cityObj = cities.find((c) => c.slug === place) ?? null;
const countryObj = countries.find((c) => c.slug === place) ?? null;

let museums: Museum[] = [];

if (cityObj) {
  mode = 'city';
  cityName = cityObj.name;
  const c = countries.find((x) => x.slug === (cityObj.country ?? '')) ?? null;
  countryName = c?.name ?? null;
  museums = allMuseums.filter((m) => {
    const museumSlug = (m.city_slug || '').toLowerCase();
    const museumCity = (m.city || '').toLowerCase();
    const target = place.toLowerCase();
    return (
      museumSlug === target ||
      museumCity === target ||
      museumCity.startsWith(`${target},`) ||
      museumCity.startsWith(`${target} `)
    );
  });
} else if (countryObj) {
  mode = 'country';
  countryName = countryObj.name;
  museums = allMuseums.filter((m) => m.country_slug === place);
} else {
  return new Response(null, { status: 404 });
}

totalMuseums = museums.length;

museums = museums.map((m) => ({
  ...m,
  cover: normalizeImage(m.image, Astro) as string | null,
}));

const where =
  mode === 'city'
    ? { cityName: cityName!, countryName, totalMuseums, exampleMuseums: museums.slice(0, 6).map((m) => m.name) }
    : { cityName: countryName!, countryName: null, totalMuseums, exampleMuseums: museums.slice(0, 6).map((m) => m.name) };

const pageTitle = museumTitle(where);
const pageDesc = museumDescription(where);
const { paragraphs } = museumIntro(where);

const canonical = new URL(`/directory/museums/in/${place}`, Astro.site);

const crumbs =
  mode === 'city'
    ? [
        { name: 'Home', url: '/' },
        { name: 'Museums', url: '/directory/museums' },
        { name: `in ${cityName}`, url: canonical.pathname }
      ]
    : [
        { name: 'Home', url: '/' },
        { name: 'Museums', url: '/directory/museums' },
        { name: `in ${countryName}`, url: canonical.pathname }
      ];

const listSchema = itemList({
  url: canonical.toString(),
  name: mode === 'city' ? `Museums in ${cityName}${countryName ? `, ${countryName}` : ''}` : `Museums in ${countryName}`,
  items: museums.slice(0, 50).map((m) => ({
    name: m.name,
    url: new URL(`/directory/museums/${encodeURIComponent(m.slug)}`, Astro.site).toString(),
  })),
});

const schema = {
  '@context': 'https://schema.org',
  '@graph': [breadcrumbList(crumbs), listSchema],
};

const placeName = mode === 'city' ? cityName : countryName;

const initialMuseums = museums.slice(0, 18);
const mapMuseums = museums.map((m) => ({
  id: m.id,
  name: m.name,
  city: m.city,
  country: m.country,
  address: m.address,
  latitude: m.latitude,
  longitude: m.longitude,
  slug: m.slug,
  cover: m.cover
}));

function museumMatchesCity(museum: any, citySlug: string, cityName: string): boolean {
  const museumSlug = (museum.city_slug || '').toLowerCase();
  const museumCity = (museum.city || '').toLowerCase();
  const targetSlug = citySlug.toLowerCase();
  const targetName = cityName.toLowerCase();
  return (
    museumSlug === targetSlug ||
    museumCity === targetName ||
    museumCity.startsWith(`${targetName},`) ||
    museumCity.startsWith(`${targetName} `)
  );
}

const cityToCountrySlug: Record<string, string> = {};
cities.forEach((ct: any) => {
  if (!ct.slug) return;
  const match = allMuseums.find((m: any) => m.country_slug && museumMatchesCity(m, ct.slug, ct.name));
  if (match) cityToCountrySlug[ct.slug] = match.country_slug;
});

let relatedLocations: { name: string; slug: string }[] = [];
if (mode === 'country') {
  relatedLocations = cities
    .filter(c => c.slug !== place && cityToCountrySlug[c.slug] === place)
    .map(c => ({ name: c.name, slug: c.slug }));
} else if (mode === 'city') {
  const currentCountry = cityToCountrySlug[place] || cityObj?.country || null;
  if (currentCountry) {
    relatedLocations = cities
      .filter(c => c.slug !== place && cityToCountrySlug[c.slug] === currentCountry)
      .map(c => ({ name: c.name, slug: c.slug }));
  }
}
---

<PostHogLayout title={pageTitle} description={pageDesc} canonical={canonical} schema={schema}>
  <Navbar />

  <main class="designers-page">
    <div class="split-container">
      <!-- Left Column: Results Panel -->
      <aside class="results-panel">
        <div class="panel-handle" aria-hidden="true"><span class="panel-handle-bar"></span></div>
        <div class="results-panel-content">
          <Breadcrumbs items={[
            { label: 'Home', href: '/' },
            { label: 'Museums', href: '/directory/museums' },
            { label: `In ${mode === 'city' ? cityName : countryName}` }
          ]} />

          <header class="panel-header">
             <h1 class="location-heading">
                Design museums<br />
                in <span class="location-accent">{mode === 'city' ? cityName : countryName}</span>
             </h1>

             {mode === 'city' && countryName && (
               <div class="country-subtitle">({countryName})</div>
             )}
          </header>

          <div class="results-meta">
            <h2 class="results-count" id="museum-count">
              {totalMuseums} results
            </h2>
          </div>

          <div class="studios-grid" id="museums-grid">
            {initialMuseums.map((museum, index) => (
              <DirectoryCard studio={museum as any} index={index} cover={museum.cover} />
            ))}
          </div>

          <div class="hidden py-12 text-center text-gray" id="empty-result">
            <p>No museums found matching your criteria.</p>
          </div>

          <!-- Pagination: pinned footer of the panel on mobile (like the homepage) -->
          <div id="pagination-container" class="pagination-wrapper"></div>

           <!-- New Cards Section -->
           <div class="bottom-cards-section mt-16 pb-12">
             <div class:list={['cards-split-grid', { 'single-card': relatedLocations.length === 0 }]}>
                <GetListedCard
                  className="full-height-card"
                  title={`Are you based in ${placeName}?`}
                  subtitle={`Submit your museum for free. Once approved, it will appear on the ${placeName} design map and directory.`}
                  ctaLabel="Submit for free"
                />

                {relatedLocations.length > 0 && (
                  <div class="related-locations-card">
                     <div class="rl-header">
                        <h3 class="rl-title">Related locations</h3>
                     </div>
                     <div class="rl-content">
                        {relatedLocations.slice(0, 10).map(loc => (
                          <a href={`/directory/museums/in/${loc.slug}`} class="pill-btn">
                            {loc.name}
                          </a>
                        ))}
                     </div>
                  </div>
                )}
             </div>
           </div>

           <!-- SEO Text Section -->
           <div class="seo-text-area mt-20 pt-16 border-t border-stroke">
             <div class="max-w-[70ch] space-y-8">
               {paragraphs.map((p) => (
                 <p class="font-sans text-[16px] leading-[1.8] text-gray">{p}</p>
               ))}
             </div>
           </div>
        </div>
      </aside>

      <!-- Right Column: Map Panel -->
      <section class="map-panel">
        <div class="map-canvas-wrap">
          <div id="map"></div>

          <button type="button" class="map-recenter-btn" id="map-recenter-btn" aria-label="Recenter map">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>
            </svg>
            RECENTER
          </button>

          <!-- Studio UI Card -->
          <div class="studio-ui-container" id="studio-ui-container">
            <div class="studio-card" id="studio-card">
              <a href="#" class="studio-card-inner" id="studio-card-link">
                <div class="studio-card-media">
                  <img
                    src=""
                    alt=""
                    class="studio-card-image"
                    id="studio-card-image"
                  />
                </div>
                <div class="studio-card-info">
                  <h3 class="studio-card-title" id="studio-card-title"></h3>
                  <p class="studio-card-city" id="studio-card-city"></p>
                  <div class="studio-card-address-row">
                     <p class="studio-card-address" id="studio-card-address"></p>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ museums, mapMuseums }}>
    window.INITIAL_MUSEUMS = museums;
    window.MAP_MUSEUMS = mapMuseums;
  </script>

  <script>
    import { initializeMap } from '../../../../lib/map-init';

    const ALL_MUSEUMS = (window as any).INITIAL_MUSEUMS;
    const MAP_MUSEUMS = (window as any).MAP_MUSEUMS;
    const itemsPerPage = 18;
    let currentPage = 1;
    let filteredMuseums = [...ALL_MUSEUMS];
    let mapInstance: any = null;

    async function initMap() {
      if (MAP_MUSEUMS?.length > 0) {
        const bounds: [[number, number], [number, number]] | null = (() => {
          let minLng = Infinity, minLat = Infinity, maxLng = -Infinity, maxLat = -Infinity;
          MAP_MUSEUMS.forEach((m: any) => {
            const lat = typeof m.latitude === 'string' ? parseFloat(m.latitude) : m.latitude;
            const lng = typeof m.longitude === 'string' ? parseFloat(m.longitude) : m.longitude;
            if (lat == null || lng == null || isNaN(lat) || isNaN(lng)) return;
            minLng = Math.min(minLng, lng);
            minLat = Math.min(minLat, lat);
            maxLng = Math.max(maxLng, lng);
            maxLat = Math.max(maxLat, lat);
          });
          if (minLng === Infinity) return null;
          return [[minLng, minLat], [maxLng, maxLat]];
        })();

        mapInstance = await initializeMap(MAP_MUSEUMS, null, 'museum', bounds);
        if (!mapInstance || !mapInstance.map) return;

        const focusLocation = () => {
          mapInstance.map.resize();
          if (mapInstance.updateStudios) {
            mapInstance.updateStudios(MAP_MUSEUMS, false, true);
          }
        };

        if (mapInstance.map.loaded()) {
          focusLocation();
        } else {
          mapInstance.map.once('load', focusLocation);
        }

        const recenterBtn = document.getElementById('map-recenter-btn');
        recenterBtn?.addEventListener('click', () => {
          mapInstance?.recenter();
        });
      }
    }

    function init() {
      initMap();

      renderGrid();

      const museumsGrid = document.getElementById('museums-grid');
      museumsGrid?.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('.directory-card') as HTMLElement;
        if (!card) return;

        const lat = card.dataset.lat;
        const lng = card.dataset.lng;
        const slug = card.dataset.slug;

        if (window.innerWidth > 1024 && lat && lng && mapInstance) {
          e.preventDefault();
          const museum = mapInstance.studiosData.find((s: any) => s.slug === slug);
          if (museum) {
            mapInstance.navigateToStudio(museum);
          }
        }
      });
    }

    function escapeHtml(value: string) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function resolveCover(cover?: string | null) {
      if (!cover) return '';
      if (cover.startsWith('http')) return cover;
      return `${window.location.origin}/cdn/${cover.replace(/^\/+/, '')}`;
    }

    function renderGrid() {
      const grid = document.getElementById('museums-grid');
      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const pageItems = filteredMuseums.slice(start, end);

      const count = document.getElementById('museum-count');
      if (count) count.textContent = `${filteredMuseums.length} results`;

      if (grid) {
        if (filteredMuseums.length === 0) {
          grid.style.display = 'none';
          const empty = document.getElementById('empty-result');
          if (empty) empty.style.display = 'block';
        } else {
          grid.style.display = 'grid';
          const empty = document.getElementById('empty-result');
          if (empty) empty.style.display = 'none';

          grid.innerHTML = pageItems.map((m) => {
            const cover = resolveCover(m.cover);
            const cityClean = (m.city || '').split(',')[0].trim();
            const location = cityClean || '';
            return `
            <a href="/directory/museums/${encodeURIComponent(m.slug || '')}"
               class="directory-card"
               data-lat="${escapeHtml(m.latitude || '')}"
               data-lng="${escapeHtml(m.longitude || '')}"
               data-slug="${escapeHtml(m.slug || '')}"
            >
              <div class="directory-card-media">
                ${cover ? `<img src="${escapeHtml(cover)}" alt="${escapeHtml(m.name || '')}" class="directory-card-image" loading="lazy" decoding="async" />` : '<div class="directory-card-placeholder"></div>'}
              </div>
              <h3 class="directory-card-name">${escapeHtml(m.name || '')}</h3>
              <p class="directory-card-location">${escapeHtml(location)}</p>
            </a>
          `;
          }).join('');
        }
      }

      renderPagination();
    }

    function renderPagination() {
      const container = document.getElementById('pagination-container');
      const totalPages = Math.ceil(filteredMuseums.length / itemsPerPage);

      if (!container) return;
      if (totalPages <= 1) {
        container.innerHTML = '';
        container.style.display = 'none';
        return;
      }
      container.style.display = '';

      let html = `<button class="pagination-btn pagination-arrow" ${currentPage === 1 ? 'disabled' : ''} data-page="prev">‹</button>`;
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, startPage + 4);
      if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }
      html += `<button class="pagination-btn pagination-arrow" ${currentPage === totalPages ? 'disabled' : ''} data-page="next">›</button>`;
      container.innerHTML = html;

      container.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const page = (e.currentTarget as HTMLElement).dataset.page;
          if (page === 'prev') currentPage--;
          else if (page === 'next') currentPage++;
          else currentPage = parseInt(page!);
          renderGrid();
          const inner = document.querySelector('.results-panel-content') as HTMLElement | null;
          if (inner && window.innerWidth <= 1024) {
            inner.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
    }

    init();

      // Mobile bottom sheet — swipe to expand/collapse the list over the map.
      const panel = document.querySelector('.results-panel') as HTMLElement | null;
      const panelInner = panel ? panel.querySelector('.results-panel-content') as HTMLElement | null : null;

      const COLLAPSED_PEEK = 240;
      const isMobilePanel = () => window.innerWidth <= 1024;

      let startY = 0;
      let startMaxH = 0;
      let currentMaxH = 0;
      let startedOnHandle = false;
      let isDragging = false;
      let collapsed = true;

      const collapsedHeight = () => COLLAPSED_PEEK;
      const expandedHeight = () => Math.round(window.innerHeight * 0.88);

      function setSnap(expanded: boolean, animate = true) {
        if (!panel) return;
        collapsed = !expanded;
        panel.style.transition = animate ? 'max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
        panel.style.maxHeight = expanded ? `${expandedHeight()}px` : `${collapsedHeight()}px`;
        panel.classList.toggle('is-expanded', expanded);
        if (!expanded && panelInner) panelInner.scrollTop = 0;
        if (animate) setTimeout(() => mapInstance?.map?.resize(), 350);
      }

      if (panel && isMobilePanel()) {
        setSnap(false, false);
      }

      window.addEventListener('resize', () => {
        if (!panel) return;
        if (!isMobilePanel()) {
          panel.style.transition = '';
          panel.style.maxHeight = '';
          panel.classList.remove('is-expanded');
          return;
        }
        setSnap(false, false);
      });

      panel?.addEventListener('touchstart', (e) => {
        if (!isDragging) {
          startY = e.touches[0].clientY;
          startMaxH = collapsed ? collapsedHeight() : expandedHeight();
          currentMaxH = startMaxH;
          startedOnHandle = false;
          isDragging = true;
          panel.style.transition = 'none';
        }
      }, { passive: true });

      panel?.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        if (!startedOnHandle && panelInner && panelInner.scrollTop > 0) return;

        const delta = e.touches[0].clientY - startY;
        if (!startedOnHandle && delta < 0 && !collapsed) return;

        let next = startMaxH - delta;
        const full = expandedHeight();
        if (next > full) next = full + (next - full) * 0.15;
        if (next < collapsedHeight() * 0.5) next = collapsedHeight() * 0.5 + (next - collapsedHeight() * 0.5) * 0.3;

        currentMaxH = next;
        panel.style.maxHeight = `${Math.max(0, next)}px`;
      }, { passive: true });

      const endDrag = () => {
        if (!isDragging) return;
        isDragging = false;
        panel.style.transition = '';
        const full = expandedHeight();
        const mid = (collapsedHeight() + full) / 2;
        panel.style.maxHeight = '';
        if (currentMaxH <= collapsedHeight() * 0.6) {
          setSnap(false, true);
        } else if (currentMaxH >= mid) {
          setSnap(true, true);
        } else {
          setSnap(false, true);
        }
      };

      panel?.addEventListener('touchend', endDrag);
      panel?.addEventListener('touchcancel', endDrag);
    </script>

  <script>
    (function () {
      const referrer = document.referrer;
      let referrerPath = '';
      try {
        referrerPath = new URL(referrer).pathname;
      } catch (e) {}

      if (referrerPath !== '/') return;

      const breadcrumbNav = document.querySelector('.breadcrumbs');
      if (!breadcrumbNav) return;

      const backBtn = breadcrumbNav.querySelector('.breadcrumb-back');
      const items = breadcrumbNav.querySelectorAll('.breadcrumb-item');
      const separators = breadcrumbNav.querySelectorAll('.breadcrumb-separator');

      if (backBtn) backBtn.href = '/';
      if (items.length >= 2) items[1].remove();
      if (separators.length >= 1) separators[0].remove();
    })();
  </script>

  <style>
    .designers-page {
      background: var(--color-white);
    }

    .split-container {
      display: flex;
      align-items: flex-start;
      max-width: 1600px;
      margin: 0 auto;
      width: 100%;
    }

    /* Left Column */
    .results-panel {
      width: clamp(360px, 40%, 620px);
      flex: 0 0 auto;
      position: relative;
      background: var(--color-white);
      z-index: 1000;
    }

    /* Sheet grip only exists on the mobile bottom sheet */
    .panel-handle { display: none; }

    .results-panel-content {
      padding: var(--page-top-spacing) 40px 60px;
    }

    .panel-header {
      margin-bottom: 40px;
    }

    .location-heading {
      font-family: var(--font-sans);
      font-size: clamp(40px, 5vw, 68px);
      font-weight: 400;
      line-height: 0.96;
      letter-spacing: -0.02em;
      color: var(--color-black);
      margin: 0;
    }

    .location-accent {
      color: var(--color-black);
      text-decoration: underline;
      text-decoration-color: var(--color-stroke);
      text-underline-offset: 8px;
      text-decoration-thickness: 2px;
    }

    .country-subtitle {
       font-family: var(--font-sans);
       font-size: 24px;
       color: var(--color-gray);
       margin-top: 12px;
       font-weight: 400;
       letter-spacing: 0;
    }

    .results-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .results-count {
      font-family: var(--font-sans);
      font-size: 15px;
      font-weight: 400;
      color: var(--color-gray);
      margin: 0;
    }

    .studios-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 24px);
      margin-bottom: 40px;
    }

    :global(.studios-grid .directory-card) {
      min-width: 0;
    }

    :global(.directory-card) {
      display: flex;
      flex-direction: column;
      gap: 10px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease;
    }

    :global(.directory-card:hover) {
      transform: translateY(-2px);
      color: inherit;
    }

    :global(.directory-card-media) {
      aspect-ratio: 1;
      overflow: hidden;
      background: #E8E8EA;
      border-radius: 12px;
    }

    :global(.directory-card-image) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    :global(.directory-card-placeholder) {
      width: 100%;
      height: 100%;
      background: #E8E8EA;
    }

    :global(.directory-card-name) {
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 400;
      color: var(--color-black);
      margin: 0;
      line-height: 1.25;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    :global(.directory-card-location) {
      font-family: var(--font-sans);
      font-size: 13px;
      font-weight: 400;
      color: var(--color-text-muted);
      margin: -6px 0 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Cards Section */
    .cards-split-grid {
       display: grid;
       grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
       gap: 16px;
    }

    .cards-split-grid.single-card {
