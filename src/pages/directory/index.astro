---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import EventBasicCard from '../../components/EventBasicCard.astro';
import { normalizeImage } from '../../lib/images';

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let fairs = [];
let museums = [];
let universities = [];
let awards = [];
let error = null;

try {
  const [fRes, mRes, uRes, aRes] = await Promise.all([
    fetch(`${domain}/fairs.json`),
    fetch(`${domain}/museums.json`),
    fetch(`${domain}/universities.json`),
    fetch(`${domain}/awards.json`)
  ]);

  if (fRes.ok) {
    const data = await fRes.json();
    const allFairs = (Array.isArray(data) ? data : data.items || []).sort((a: any, b: any) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    // Find first fair that hasn't ended yet
    let startIndex = allFairs.findIndex((f: any) => {
        const endDate = f.end_date ? new Date(f.end_date) : new Date(f.start_date);
        return endDate >= now;
    });

    if (startIndex === -1) {
        // All fairs are in the past, take the last 5
        fairs = allFairs.slice(-5);
    } else {
        // We have upcoming fairs. We want to start from the current one, 
        // but if we're near the end of the list, we back up to ensure we get 5.
        const endPos = Math.min(startIndex + 5, allFairs.length);
        const startPos = Math.max(0, endPos - 5);
        fairs = allFairs.slice(startPos, endPos);
    }
  }
  if (mRes.ok) {
    const data = await mRes.json();
    museums = (Array.isArray(data) ? data : data.items || []).slice(0, 5);
  }
  if (uRes.ok) {
    const data = await uRes.json();
    universities = (Array.isArray(data) ? data : data.items || []).slice(0, 5);
  }
  if (aRes.ok) {
    const data = await aRes.json();
    awards = (Array.isArray(data) ? data : data.items || []).slice(0, 5);
  }
} catch (e) {
  error = e;
  console.error('[Directory Index] Fail to fetch R2 data:', e);
}

function getPeriod(startStr: string, endStr: string) {
  if (!startStr) return "";
  const start = new Date(startStr);
  const end = endStr ? new Date(endStr) : null;
  const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const startDay = start.getDate();
  const startMonth = monthNames[start.getMonth()];
  if (!end || isNaN(end.getTime()) || startStr === endStr) return `${startMonth} ${startDay}`;
  const endDay = end.getDate();
  if (start.getMonth() === end.getMonth()) return `${startMonth} ${startDay}-${endDay}`;
  const endMonth = monthNames[end.getMonth()];
  return `${startMonth} ${startDay} - ${endMonth} ${endDay}`;
}

function getAwardStatus(deadlinesStr: string) {
  if (!deadlinesStr) return null;
  const now = new Date();
  const dates = deadlinesStr.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return null;
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  const deadlineEnd = new Date(lastDeadline);
  deadlineEnd.setHours(23, 59, 59, 999);
  return deadlineEnd > now ? 'status-open' : 'status-closed';
}

const sections = [
  { 
    title: 'Next fairs', 
    cardTitle: 'Fairs',
    items: fairs.map((f: any) => ({
      ...f,
      pillText: getPeriod(f.start_date, f.end_date),
      pillType: 'default',
      location: f.city || f.location
    })), 
    slug: 'fairs',
    description: "Global design weeks, biennials, and furniture trade shows.",
    coverImage: normalizeImage('fairs-cover.webp', Astro)
  },
  { 
    title: 'Museums', 
    items: museums.map((m: any) => ({
      ...m,
      location: m.city || m.location
    })), 
    slug: 'museums',
    description: "Permanent collections and institutions preserving design history.",
    coverImage: normalizeImage('museums-cover.webp', Astro)
  },
  { 
    title: 'Schools', 
    items: universities.map((u: any) => ({
      ...u,
      location: u.city || u.location
    })), 
    slug: 'schools',
    description: "Design schools and institutions shaping the future of design education.",
    coverImage: normalizeImage('universities-cover.webp', Astro)
  },
  { 
    title: 'Awards', 
    items: awards.map((a: any) => {
      const st = getAwardStatus(a.deadlines);
      const deadlineDate = a.deadlines ? new Date(Math.max(...a.deadlines.split(',').map((d: any) => new Date(d.trim()).getTime()))) : null;
      return {
        ...a,
        pillText: st === 'status-open' ? 'OPEN' : '',
        pillType: st === 'status-open' ? st : 'default',
        location: deadlineDate ? `Deadline: ${deadlineDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}` : ''
      };
    }), 
    slug: 'awards',
    description: "The most prestigious recognitions in industrial design worldwide.",
    coverImage: normalizeImage('awards-cover.webp', Astro)
  }
];
---

<Layout 
  title="Design Directory | Acceso"
  description="Discover the world of design through a curated index of Fairs, Museums, Schools, and Awards."
>
  <Navbar />
  
  <main class="directory-page">
    <div class="directory-inner">
      <header class="directory-hero">
        <h1 class="directory-title">Directory</h1>
        <p class="directory-description">
          Design fairs, museums, schools, awards, and institutions worldwide. Find the places and organizations that support, celebrate, and connect the global design community.
        </p>
      </header>

      {error && (
        <div role="alert" style="padding: 14px 18px; margin-bottom: 24px; border: 1px solid var(--color-stroke); border-radius: 12px; background: var(--color-bg-secondary); color: var(--color-text-muted); font-family: var(--font-sans); font-size: 15px;">
          <p style="margin: 0;">We couldn't load the latest directory data. Please try again later.</p>
        </div>
      )}

      <div class="hero-quick-nav">
        {sections.map(section => (
          <a href={`/directory/${section.slug}`} class={`quick-nav-card quick-nav-card--${section.slug}`}>
            <div class="card-image-bg">
              <img 
                src={section.coverImage} 
                alt={section.title} 
                loading="lazy" 
                decoding="async"
              />
              <div class="card-overlay"></div>
            </div>
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-top"></div>
              <div class="card-bottom">
                <h2 class="card-title">{section.cardTitle || section.title}</h2>
                <div class="card-link">
                  <span>Explore</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Quick Directory Sections -->
      <div class="directory-sections">
        {sections.map(section => (
          <section class="directory-section">
            <div class="section-header">
              <h2 class="directory-name">{section.title}</h2>
              <a href={`/directory/${section.slug}`} class="discovery-see-all pill-link">
                See all
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            
            <div class="section-grid">
              {section.items.map((item: any) => (
                <div class="event-card-wrapper">
                  <EventBasicCard 
                    name={item.name}
                    slug={item.slug}
                    type={section.slug === 'fairs' ? 'fair' : section.slug === 'museums' ? 'museum' : section.slug === 'schools' ? 'university' : 'award'}
                    location={item.location}
                    image={normalizeImage(item.image, Astro)}
                    pillText={item.pillText}
                    pillType={item.pillType}
                  />
                </div>
              ))}
              {section.items.length === 0 && <p class="empty-state">No upcoming {section.title.toLowerCase()} found.</p>}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .directory-page { background: var(--color-white); }
  .directory-inner { max-width: 1600px; margin: 0 auto; padding: var(--page-top-spacing) 40px 80px; }
  .directory-hero { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; margin-bottom: 48px; max-width: 640px; }
  .directory-title { font-family: var(--font-sans); font-size: clamp(48px, 5.5vw, 80px); font-weight: 400; line-height: 1; letter-spacing: -0.08em; margin: 0; color: var(--color-black); }
  .directory-description { font-family: var(--font-sans); font-size: 16px; line-height: 1.55; color: var(--color-text-muted); margin: 0; max-width: 52ch; }
  @media (min-width: 1025px) {
    .directory-hero {
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0 48px;
      max-width: none;
    }
    .directory-description {
      max-width: min(52ch, 42vw);
    }
  }

  .hero-quick-nav {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    grid-template-rows: 340px 340px;
    gap: 20px;
    grid-template-areas:
      "museum schools      schools"
      "museum fairs       awards";
    margin-bottom: 80px;
  }

  .quick-nav-card--museums { grid-area: museum; }
  .quick-nav-card--schools { grid-area: schools; }
  .quick-nav-card--fairs { grid-area: fairs; }
  .quick-nav-card--awards { grid-area: awards; }

  .quick-nav-card {
    position: relative;
    height: 100%;
    min-height: 0;
    background: var(--color-white);
    border-radius: 20px;
    border: 1px solid var(--color-stroke);
    overflow: hidden;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    display: flex;
    flex-direction: column;
  }

  .quick-nav-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-black);
    box-shadow: 0 0 0 1px var(--color-black);
    background: var(--color-bg-secondary);
  }

  .quick-nav-card .card-image-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .quick-nav-card .card-image-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .quick-nav-card:hover .card-image-bg img {
    transform: scale(1.08);
  }

  .quick-nav-card .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.4) 40%, transparent 100%);
    z-index: 1;
  }

  .quick-nav-card .card-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(237, 255, 119, 0.05), transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .quick-nav-card:hover .card-bg {
    opacity: 1;
  }

  .quick-nav-card .card-content {
    position: relative;
    z-index: 3;
    height: 100%;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .quick-nav-card .card-title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 400;
    color: #fff;
    margin: 0 0 12px;
    letter-spacing: 0;
  }

  .quick-nav-card .card-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
  }

  .quick-nav-card .card-link svg {
    transition: transform 0.2s ease;
  }

  .quick-nav-card:hover .card-link svg {
    transform: translateX(4px);
  }

  .directory-sections { display: flex; flex-direction: column; gap: 80px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; padding-bottom: 0; border-bottom: none; }
  .directory-name { font-family: var(--font-sans); font-size: 32px; font-weight: 400; color: var(--color-black); margin: 0; letter-spacing: -0.02em; }
  
  .discovery-see-all { flex-shrink: 0; display: flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 14px; font-weight: 700; color: var(--color-black); text-decoration: none; transition: gap 0.2s ease; }
  .discovery-see-all:hover { gap: 12px; }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .event-card-wrapper {
    width: 100%;
  }

  /* Match the designers cards: square media */
  :global(.section-grid .event-card-wrapper .card-image-wrapper) {
    aspect-ratio: 1;
  }

  .empty-state { color: var(--color-gray); font-family: var(--font-sans); font-size: 14px; padding: 20px 0; }

  @media (max-width: 1200px) {
    .hero-quick-nav { grid-template-rows: 300px 300px; }
  }
  @media (max-width: 900px) {
    .section-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .hero-quick-nav {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-rows: 240px;
      grid-template-areas: none;
    }
    .quick-nav-card--museums,
    .quick-nav-card--schools,
    .quick-nav-card--fairs,
    .quick-nav-card--awards { grid-area: auto; }
  }
  @media (max-width: 768px) {
    .directory-inner { padding: var(--page-top-spacing) 20px 60px; }
    .directory-name { font-size: 24px; }
  }
  @media (max-width: 640px) {
    .section-grid { grid-template-columns: 1fr; }
  }
</style>
