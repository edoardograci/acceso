---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../lib/images';
import { ensureProtocol } from '../../../lib/url';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../../lib/seo/schema';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let award: any = null;
let relatedAwards: any[] = [];
let citiesMapping: any[] = [];

try {
  const [awardsRes, citiesRes] = await Promise.all([
    fetch(`${domain}/awards.json`),
    fetch(`${domain}/test-cities.json`)
  ]);

  if (awardsRes.ok) {
    const rawAwards = await awardsRes.json();
    const allAwards = Array.isArray(rawAwards) ? rawAwards : (rawAwards.items || []);

    award = allAwards.find((a: any) => a.slug === slug) || null;

    // Awards store the link in `url`, not `website`.
    if (award && !award.website && award.url) award.website = award.url;

    if (award) {
      relatedAwards = allAwards
        .filter((a: any) => a.slug !== slug)
        .slice(0, 10);
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();

} catch (e) {
  console.error('[Award Slug] Fail to fetch data:', e);
}

if (!award) {
  return Astro.redirect('/404');
}

function getAwardStatus(deadlinesStr: string) {
  if (!deadlinesStr) return null;
  const now = new Date();
  const dates = deadlinesStr.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return null;
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  const deadlineEnd = new Date(lastDeadline);
  deadlineEnd.setHours(23, 59, 59, 999);
  return deadlineEnd > now ? 'status-open' : 'status-closed';
}

function formatDeadlines(str: string) {
  if (!str) return "Not specified";
  return str.split(',').map(d => {
    const date = new Date(d.trim());
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }).join(', ');
}

function formatDeadlinesShort(str: string) {
  if (!str) return "";
  const dates = str.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return "";
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  return "Deadline: " + lastDeadline.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const status = getAwardStatus(award.deadlines);
const pillText = status === 'status-open' ? 'OPEN' : 'CLOSED';

const cityName = award.city || citiesMapping.find(c => c.slug === award.city_slug)?.name || award.city_slug;

const pageTitle = `${award.name} — Design Award | Acceso`;
const pageDesc = award.description || `Explore ${award.name}, one of the most prestigious recognitions in industrial and furniture design.`;

// ── SEO: Canonical + schema ────────────────────────────────────────────────────
const canonical = new URL(`/directory/awards/${slug}`, Astro.site);
const awardSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Event',
      '@id': `${canonical}#event`,
      name: award.name,
      description: pageDesc,
      url: canonical.toString(),
      image: award.image || undefined,
      eventStatus: status === 'status-open'
        ? 'https://schema.org/EventScheduled'
        : 'https://schema.org/EventPostponed',
      location: cityName ? {
        '@type': 'Place',
        name: cityName,
      } : undefined,
      organizer: award.website ? { '@type': 'Organization', name: award.name, url: award.website } : undefined,
    },
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Awards', url: '/directory/awards' },
      { name: award.name, url: `/directory/awards/${slug}` },
    ]),
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={awardSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={[
      { label: 'Directory', href: '/directory' },
      { label: 'Awards', href: '/directory/awards' },
      { label: award.name }
    ]} />
  </div>

  <main class="award-detail-container">
    <div class="award-hero-row">
      <div class="hero-image-wrapper">
        {award.image ? (
          <img 
            src={normalizeImage(award.image, Astro, { width: 1200 })} 
            alt={award.name} 
            class="hero-image" 
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero-image-placeholder">No image available</div>
        )}
      </div>

      <aside class="info-card">
        <div class="info-card-content">
          <div class="tag-row">
            <span class:list={["status-pill", status]}>{pillText}</span>
          </div>

          <h1 class="award-name">{award.name}</h1>
          <div class="description-wrapper">
            <p class="award-description" id="awardDescription">
              {award.description}
            </p>
            <button class="description-toggle" id="descriptionToggle" type="button" hidden>Read more</button>
          </div>

          <div class="social-links">
            {award.website && (
              <a href={ensureProtocol(award.website)} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                <img src="/icons/source.svg" alt="" width="16" height="16" />
                <span>Website</span>
              </a>
            )}
            {award.instagram && (
              <a href={ensureProtocol(award.instagram)} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                <span>Instagram</span>
              </a>
            )}
          </div>

          <div class="details-section">
            <div class="details-row">
              <span class="detail-label">Deadline</span>
              <span class="detail-value">{formatDeadlines(award.deadlines)}</span>
            </div>
          </div>
        </div>

        <div class="card-footer-actions">
          <button class="footer-btn share-btn" id="shareButton">
            <img src="/icons/share.svg" alt="" width="18" height="18" />
            <span>Share</span>
          </button>
          <button class="footer-btn save-btn" 
            id="calendarBtn"
            data-name={award.name}
            data-desc={award.description}
            data-deadlines={award.deadlines}
            data-url={award.website}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Save date</span>
          </button>
        </div>
      </aside>
    </div>

    <section class="discovery-area">
      <div class="discovery-content">
        {relatedAwards.length > 0 && (
          <div class="discovery-section">
            <div class="section-top">
              <h2 class="discovery-title">Explore more awards</h2>
              <a href="/directory/awards" class="discovery-see-all pill-link">
                Explore awards
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <div class="discovery-grid">
              {relatedAwards.map(a => (
                <div class="grid-item">
                  <EventBasicCard 
                    name={a.name}
                    slug={a.slug}
                    type="award"
                    location={a.city || cityName}
                    date={formatDeadlinesShort(a.deadlines)}
                    image={normalizeImage(a.image, Astro)}
                    pillText={getAwardStatus(a.deadlines) === 'status-open' ? 'OPEN' : 'CLOSED'}
                    pillType={getAwardStatus(a.deadlines) || 'default'}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: `Explore ${document.title.split('—')[0]} on Acceso`
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) { }
    });
  }

  const calendarBtn = document.getElementById('calendarBtn');
  if (calendarBtn) {
    calendarBtn.addEventListener('click', () => {
      const { name = '', desc = '', deadlines = '', url: website = '' } = calendarBtn.dataset;
      const matches = (deadlines || '').match(/\d{4}-\d{2}-\d{2}/g) || [];
      const dateStr = matches.length
        ? matches[matches.length - 1]
        : new Date().toISOString().split('T')[0];
      const fmt = dateStr.replace(/-/g, '');

      const icsData = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Acceso//Design Awards//EN',
        'BEGIN:VEVENT',
        `DTSTART;VALUE=DATE:${fmt}`,
        `DTEND;VALUE=DATE:${fmt}`,
        `SUMMARY:${name} — Deadline`,
        `DESCRIPTION:${(desc || '').replace(/\n/g, '\\n')}\\n\\nWebsite: ${website || 'N/A'}`,
        `URL:${website || ''}`,
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${name.toLowerCase().replace(/\s+/g, '-')}-deadline.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
    });
  }

  // Description Read more / Read less
  const description = document.getElementById('awardDescription');
  const descriptionToggle = document.getElementById('descriptionToggle');
  if (description && descriptionToggle) {
    const checkTruncation = () => {
      if (description.classList.contains('expanded')) return;
      descriptionToggle.hidden = description.scrollHeight <= description.clientHeight + 1;
    };

    checkTruncation();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkTruncation);
    }
    window.addEventListener('resize', checkTruncation);

    descriptionToggle.addEventListener('click', () => {
      const expanded = description.classList.toggle('expanded');
      descriptionToggle.textContent = expanded ? 'Read less' : 'Read more';
    });
  }
</script>

<style>
  .award-detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .award-hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: stretch;
    justify-content: flex-end;
    --hero-card-height: clamp(500px, 75vh, 700px);
  }

  .hero-image-wrapper {
    height: var(--hero-card-height);
    max-height: var(--hero-card-height);
    width: auto;
    max-width: 100%;
    background: var(--color-bg-secondary);
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 1;
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .hero-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-sans);
  }

  .info-card {
    width: 400px;
    height: var(--hero-card-height);
    max-height: var(--hero-card-height);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
    min-height: 0;
  }

  .info-card::-webkit-scrollbar { display: none; }
  .info-card-content::-webkit-scrollbar { display: none; }

  .tag-row { margin-bottom: 20px; }
  .status-pill {
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
  }
  .status-open { background: #C6F6D6; color: var(--color-black); }
  .status-closed { background: rgba(15, 17, 19, 0.88); color: rgba(255, 255, 255, 0.72); }

  .award-name {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-black);
    margin: 0 0 24px -2px;
  }

  .description-wrapper { margin-bottom: 24px; }

  .award-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    margin-bottom: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .award-description.expanded {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .description-toggle {
    margin-top: 6px;
    padding: 0;
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-black);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .description-toggle:hover { opacity: 0.6; }

  .social-links { display: flex; gap: 8px; margin-bottom: 24px; }

  /* Unify hover for Website and Instagram buttons: a subtle, elegant darken. */
  .card-social-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .details-section {
    background: var(--color-btn-bg);
    border-radius: 10px;
    padding: 16px 0;
    margin-bottom: 16px;
  }

  .details-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .detail-label { font-size: 15px; color: var(--color-gray); }
  .detail-value { font-size: 15px; font-weight: 700; color: var(--color-black); text-align: right; text-decoration: none; line-height: 1.4; word-break: break-word; }

  /* Unify hover for Location links: simply get a little lighter, no movement. */
  .detail-link { transition: opacity 0.2s ease; }
  .detail-link:hover { opacity: 0.6; }

  .detail-value.underlined { text-decoration: underline; }
  .detail-value.underlined:hover { color: var(--color-black); }
  .detail-separator { color: var(--color-gray); margin: 0 2px; font-weight: 400; }
  .details-divider { height: 1px; background: var(--color-stroke); margin: 12px 0; }

  .card-footer-actions {
    margin-top: auto;
    flex-shrink: 0;
  }

  :global(.footer-btn:active) { transform: scale(0.98); }

  .discovery-area { margin-top: 120px; padding-bottom: 40px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; padding-bottom: 0; }
  .discovery-title { font-family: var(--font-sans); font-size: 24px; font-weight: 400; color: var(--color-black); letter-spacing: -0.02em; }
  .discovery-see-all { flex-shrink: 0; }

  .discovery-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }

  /* Force the discovery cards to be squared, like the designers slug. */
  .discovery-grid :global(.card-image-wrapper) { aspect-ratio: 1; }

  @media (max-width: 1300px) {
    .discovery-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 1100px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .award-hero-row { flex-direction: column; align-items: center; }
    .hero-image-wrapper { width: 100%; max-width: 600px; height: auto; max-height: none; min-height: auto; border-radius: 0; }
    .info-card { width: 100%; height: auto; max-height: none; max-width: 600px; }
    .award-detail-container { padding: 0 20px 40px; }
    .breadcrumbs-container { padding: 32px 20px 0; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
    .discovery-title { font-size: 20px; }
  }
</style>
