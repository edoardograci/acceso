---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CalendarModal from '../../../components/CalendarModal.astro';
import { normalizeImage } from '../../../lib/images';
import { breadcrumbList } from '../../../lib/seo/schema';

// Reusable Award Components
import AwardHeader from '../../../components/award/AwardHeader.astro';
import AwardGallery from '../../../components/award/AwardGallery.astro';
import AwardDetails from '../../../components/award/AwardDetails.astro';
import AwardSidebarInfo from '../../../components/award/AwardSidebarInfo.astro';
import AwardLocationSection from '../../../components/award/AwardLocationSection.astro';
import AwardPromoCard from '../../../components/award/AwardPromoCard.astro';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let award: any = null;
let relatedAwards: any[] = [];
let citiesMapping: any[] = [];

try {
  const [awardsRes, citiesRes] = await Promise.all([
    fetch(`${domain}/awards.json`),
    fetch(`${domain}/test-cities.json`)
  ]);

  if (awardsRes.ok) {
    const rawAwards = await awardsRes.json();
    const allAwards = Array.isArray(rawAwards) ? rawAwards : (rawAwards.items || []);

    award = allAwards.find((a: any) => a.slug === slug) || null;

    if (award && !award.website && award.url) award.website = award.url;

    if (award) {
      relatedAwards = allAwards
        .filter((a: any) => a.slug !== slug)
        .slice(0, 10);
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();

} catch (e) {
  console.error('[Award Slug] Fail to fetch data:', e);
}

if (!award) {
  return Astro.redirect('/404');
}

function getAwardStatus(deadlinesStr: string) {
  if (!deadlinesStr) return null;
  const now = new Date();
  const dates = deadlinesStr.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return null;
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  const deadlineEnd = new Date(lastDeadline);
  deadlineEnd.setHours(23, 59, 59, 999);
  return deadlineEnd > now ? 'status-open' : 'status-closed';
}

function formatDeadlines(str: string) {
  if (!str) return "Not specified";
  return str.split(',').map(d => {
    const date = new Date(d.trim());
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }).join(', ');
}

function formatDeadlinesShort(str: string) {
  if (!str) return "";
  const dates = str.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return "";
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  return "Deadline: " + lastDeadline.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function getLastDeadline(deadlinesStr: string): string {
  if (!deadlinesStr) return '';
  const dates = deadlinesStr.split(',').map(d => d.trim()).filter(Boolean);
  if (dates.length === 0) return '';
  return dates[dates.length - 1];
}

const status = getAwardStatus(award.deadlines);
const pillText = status === 'status-open' ? 'OPEN' : 'CLOSED';

const cityName = award.city || citiesMapping.find(c => c.slug === award.city_slug)?.name || award.city_slug;
const countryName = '';

const periodStr = formatDeadlines(award.deadlines);
const lastDeadline = getLastDeadline(award.deadlines || '');

// Location / embed data
const awardLat = award ? parseFloat(award.latitude) : NaN;
const awardLng = award ? parseFloat(award.longitude) : NaN;
const awardHasLocation = !!award && !!award.address && !isNaN(awardLat) && !isNaN(awardLng);

const gmapsUrl = awardHasLocation
  ? (award.gmaps || `https://www.google.com/maps/search/?api=1&query=${awardLat},${awardLng}`)
  : '';

const aboutParagraphs = (award.long_description || '')
  .split(/\n+/)
  .map((p: string) => p.trim())
  .filter((p: string) => p.length > 0);

const pageTitle = `${award.name} — Design Award | Acceso`;
const pageDesc = award.description || `Explore ${award.name}, one of the most prestigious recognitions in industrial and furniture design.`;

// ── SEO: Canonical + schema ────────────────────────────────────────────────────
const canonical = new URL(`/directory/awards/${slug}`, Astro.site);

function getAwardDates(deadlinesStr: string) {
  if (!deadlinesStr) return { startDate: null, endDate: null };
  const dates = deadlinesStr.split(',').map(d => d.trim()).filter(Boolean);
  if (dates.length === 0) return { startDate: null, endDate: null };
  return { startDate: dates[0], endDate: dates[dates.length - 1] };
}

const { startDate: awardStartDate, endDate: awardEndDate } = getAwardDates(award.deadlines);

const awardEventSchema = awardStartDate && cityName ? {
  '@type': 'Event',
  '@id': `${canonical}#event`,
  name: award.name,
  description: pageDesc,
  url: canonical.toString(),
  image: award.image || undefined,
  eventStatus: status === 'status-open'
    ? 'https://schema.org/EventScheduled'
    : 'https://schema.org/EventPostponed',
  startDate: awardStartDate,
  endDate: awardEndDate,
  location: {
    '@type': 'Place',
    name: cityName,
  },
  organizer: award.website ? { '@type': 'Organization', name: award.name, url: award.website } : undefined,
} : null;

const awardSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    ...(awardEventSchema ? [awardEventSchema] : []),
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Awards', url: '/directory/awards' },
      { name: award.name, url: `/directory/awards/${slug}` },
    ]),
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={awardSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={[
      { label: 'Directory', href: '/directory' },
      { label: 'Awards', href: '/directory/awards' },
      { label: award.name }
    ]} />
  </div>

  <main class="detail-container">

    <!-- ── IDENTITY HEADER ────────────────────────────────────────────────── -->
    <AwardHeader award={award} cityName={cityName} countryName={countryName} />

    <!-- ── TWO-COLUMN MAIN LAYOUT ─────────────────────────────────────────── -->
    <div class="award-grid">

      <!-- LEFT: EDITORIAL CONTENT -->
      <div class="award-main-col">

        <!-- 1. Slideshow Gallery -->
        <AwardGallery award={award} />

        <!-- 2. Information Section -->
        <section class="content-block info-block">
          <h2 class="info-heading">Information</h2>
          <h3 class="block-title">OVERVIEW</h3>
          {award.description && (
            <p class="award-lead-text">{award.description}</p>
          )}
          {aboutParagraphs.length > 0 && (
            <details class="more-about-details">
              <summary class="more-about-toggle">
                <span>Read more</span>
                <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="about-text-content">
                {aboutParagraphs.map((para: string) => (
                  <p class="about-paragraph">{para}</p>
                ))}
              </div>
            </details>
          )}
        </section>

        <!-- 3. Key Details -->
        <AwardDetails
          fee={award.fee}
          focus={award.focus}
          eligibility={award.eligibility}
          prototype={award.prototype}
        />

        <!-- 4. FAQ -->
        <section class="content-block info-block faq-block">
          <h2 class="info-heading">FAQ</h2>
          <div class="faq-list">
            {award.eligibility && (
              <div class="faq-item">
                <p class="faq-question">Who can enter this award?</p>
                <p class="faq-answer">{award.eligibility}</p>
              </div>
            )}
            {award.prize && (
              <div class="faq-item">
                <p class="faq-question">What is the prize?</p>
                <p class="faq-answer">{award.prize}</p>
              </div>
            )}
            {award.submission_requirements && (
              <div class="faq-item">
                <p class="faq-question">What do I need to submit?</p>
                <p class="faq-answer">{award.submission_requirements}</p>
              </div>
            )}
            {award.prototype && (
              <div class="faq-item">
                <p class="faq-question">Do I need to submit a physical prototype?</p>
                <p class="faq-answer">
                  {(award.prototype || '').trim() === 'Finalists only'
                    ? 'Only finalists are required to submit a physical prototype. You do not need to submit one when applying or making your initial submission. If selected as a finalist, a physical prototype may need to be sent for evaluation and additional costs may apply. Check the official award website for specific requirements and shipping details.'
                    : (award.prototype || '').trim() === 'Required'
                      ? 'A physical prototype is required as part of the submission. Check the official award website for details on prototype requirements, shipping, evaluation, and any associated costs.'
                      : 'A physical prototype is not required for this award. You can submit your project without providing a physical prototype.'}
                </p>
              </div>
            )}
          </div>
        </section>

      </div>

      <!-- RIGHT: STICKY SIDEBAR -->
      <aside class="award-sidebar-col">
        <div class="sidebar-sticky-wrapper">

          <!-- 1. Main Info Card -->
          <AwardSidebarInfo
            award={award}
            period={periodStr}
            countryName={countryName}
            cityName={cityName}
          />

          <!-- 2. Location Section -->
          {awardHasLocation && (
            <AwardLocationSection award={award} gmapsUrl={gmapsUrl} />
          )}

          <!-- 3. Submit for Review Promo Card -->
          <AwardPromoCard />

        </div>
      </aside>

    </div>

    <!-- ── BOTTOM DISCOVERY AREA ─────────────────────────────────────────── -->
    {relatedAwards.length > 0 && (
      <section class="discovery-area">
        <div class="discovery-header">
          <h2 class="discovery-title">Explore more awards</h2>
          <a href="/directory/awards" class="pill-link">
            <span>Explore all awards</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

        <div class="discovery-grid">
          {relatedAwards.map(a => (
            <div class="discovery-item">
              <EventBasicCard
                name={a.name}
                slug={a.slug}
                type="award"
                location={a.city || cityName}
                date={formatDeadlinesShort(a.deadlines)}
                image={normalizeImage(a.image, Astro)}
                pillText={getAwardStatus(a.deadlines) === 'status-open' ? 'OPEN' : 'CLOSED'}
                pillType={getAwardStatus(a.deadlines) || 'default'}
              />
            </div>
          ))}
        </div>
      </section>
    )}

  </main>

  <!-- Save Date / Google Calendar Modal -->
  <CalendarModal />

  <Footer />
</Layout>

<style>
  /* ── Page Containers ───────────────────────────────────────────────── */
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 100px;
    box-sizing: border-box;
    width: 100%;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── 2-Column Grid Layout ────────────────────────────────────────── */
  .award-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  .award-main-col {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Content Blocks ──────────────────────────────────────────────── */
  .content-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .award-lead-text {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-black);
    margin: 0;
    font-weight: 400;
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  .info-heading {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .more-about-details {
    display: block;
    width: 100%;
    align-self: stretch;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .more-about-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-black);
    cursor: pointer;
    list-style: none;
  }

  .more-about-toggle::-webkit-details-marker {
    display: none;
  }

  .more-about-toggle svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .more-about-details[open] .more-about-toggle svg {
    transform: rotate(180deg);
  }

  .about-text-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
    margin-top: 18px;
  }

  .about-paragraph {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-stroke);
  }

  .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .faq-question {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-black);
    margin: 0;
  }

  .faq-answer {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── RIGHT SIDEBAR ───────────────────────────────────────────────── */
  .award-sidebar-col {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--navbar-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Bottom Discovery Area ───────────────────────────────────────── */
  .discovery-area {
    margin-top: 64px;
    padding-top: 0;
    border-top: none;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    width: 100%;
  }

  .discovery-title {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-grid :global(.card-image-wrapper) {
    aspect-ratio: 1;
  }

  /* ── Responsive Breakpoints & Visitor Priority Ordering ─────────────── */
  @media (max-width: 1300px) {
    .discovery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1100px) {
    .award-grid {
      grid-template-columns: 1fr 340px;
      gap: 32px;
    }
    .discovery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 960px) {
    .award-main-col,
    .award-sidebar-col,
    .sidebar-sticky-wrapper {
      display: contents;
    }

    .award-grid {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 100%;
    }

    :global(.gallery-section) { order: 1; }
    .info-block { order: 2; }
    :global(.details-block) { order: 3; }
    :global(.spec-block) { order: 4; }
    .faq-block { order: 5; }
    :global(.info-card) { order: 6; }
    :global(.sidebar-location-section) { order: 7; }
    :global(.promo-box) { order: 8; }
  }

  @media (max-width: 768px) {
    .breadcrumbs-container {
      padding: 24px 20px 0;
    }
    .detail-container {
      padding: 0 20px 60px;
    }
    .discovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .breadcrumbs-container {
      padding: 20px 16px 0;
    }
    .detail-container {
      padding: 0 16px 48px;
    }
    .discovery-grid {
      grid-template-columns: 1fr;
    }
    .discovery-title {
      font-size: 18px;
    }
  }
</style>
