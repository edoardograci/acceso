---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import DirectoryCard from '../../../components/DirectoryCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { normalizeImage } from '../../../lib/images';
import { breadcrumbList } from '../../../lib/seo/schema';
import { schoolSeo, schoolSchemaNode } from '../../../lib/seo/school';
import { readJsonFromBucket, toArray } from '../../../lib/readJson';
import { pickDiscoveryTiers } from '../../../lib/discovery';
import type { Env } from '../../../env.d';

// Reusable School Components
import SchoolHeader from '../../../components/school/SchoolHeader.astro';
import SchoolGallery from '../../../components/school/SchoolGallery.astro';
import DegreeList from '../../../components/school/DegreeList.astro';
import SchoolSidebarInfo from '../../../components/school/SchoolSidebarInfo.astro';
import SchoolLocationSection from '../../../components/school/SchoolLocationSection.astro';
import SchoolPromoCard from '../../../components/school/SchoolPromoCard.astro';
import ReportIssueModal from '../../../components/school/ReportIssueModal.astro';

const { slug } = Astro.params;

let university: any = null;
let sameCitySchools: any[] = [];
let sameCountrySchools: any[] = [];
let worldSchools: any[] = [];
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];
let fetchFailed = false;
let cityCount = 0;
let countryCount = 0;

try {
  const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;
  const origin = Astro.url.origin;
  const [uniData, citiesData, countriesData] = await Promise.all([
    readJsonFromBucket('universities.json', env, origin),
    readJsonFromBucket('test-cities.json', env, origin),
    readJsonFromBucket('test-countries.json', env, origin),
  ]);

  if (!uniData) throw new Error('Failed to read universities.json');

  const processedUniversities = toArray(uniData);

  university = processedUniversities.find((u: any) => u.slug === slug) || null;

  if (university) {
    cityCount = processedUniversities.filter((u: any) => u.city_slug && u.city_slug === university.city_slug).length;
    countryCount = processedUniversities.filter((u: any) => u.country_slug && u.country_slug === university.country_slug).length;

    // Discovery tiers, same rules as the designer page (see lib/discovery.ts)
    ({ sameCity: sameCitySchools, sameCountry: sameCountrySchools, world: worldSchools } =
      pickDiscoveryTiers(processedUniversities, university));
  }

  citiesMapping = toArray(citiesData);
  countriesMapping = toArray(countriesData);

} catch (e) {
  fetchFailed = true;
  console.error('[University Slug] Fail to fetch data:', e);
}

// An upstream fetch failure is transient, not "not found" — don't tell
// crawlers this URL is permanently gone when the CDN proxy just hiccupped.
if (fetchFailed) {
  return new Response(null, { status: 503, headers: { 'Retry-After': '60' } });
}

if (!university) {
  return new Response(null, { status: 404 });
}

const countryName = university.country || countriesMapping.find(c => c.slug === university.country_slug)?.name || university.country_slug;
const cityName = university.city || citiesMapping.find(c => c.slug === university.city_slug)?.name || university.city_slug;

// ── Location / embed data ───────────────────────────────────────────────
const universityLat = university ? parseFloat(university.latitude) : NaN;
const universityLng = university ? parseFloat(university.longitude) : NaN;
const universityHasLocation = !!university && !!university.address && !isNaN(universityLat) && !isNaN(universityLng);

const gmapsUrl = universityHasLocation
  ? (university.gmaps || `https://www.google.com/maps/search/?api=1&query=${universityLat},${universityLng}`)
  : '';

const aboutParagraphs = (university.long_description || '')
  .split(/\n+/)
  .map((p: string) => p.trim())
  .filter((p: string) => p.length > 0);

const degreeEntries = (() => {
  const names = (university.degree || '').split(' + ').map((s: string) => s.trim()).filter(Boolean);
  const rawEntries = (university.duration || '').split(';').map((s: string) => s.trim()).filter(Boolean);

  return names.map((name: string, i: number): { name: string; duration: string; credits: string } => {
    const raw = rawEntries[i] || '';

    const withoutTrailingCode = raw.replace(/\s*\([^)]+\)\s*$/, '').trim();
    const withoutLeadingCode = withoutTrailingCode
      .replace(/^(B\.A\.|BA|M\.A\.|MA|BSc|MSc|BFA|MFA|BDes|MDes|BSD|MID|MSD|PhD|BIND|Dipl\.?|RNCP|Hons\.?|HES-SO|KABK\/DAE)\s+/i, '')
      .trim();

    let duration = '';
    let credits = '';

    if (withoutLeadingCode.includes('/')) {
      const [durPart, credPart] = withoutLeadingCode.split('/');
      duration = durPart.trim();
      credits = credPart.trim();
    } else {
      duration = withoutLeadingCode;
    }

    return { name, duration, credits };
  });
})();

const contactParts = university.contact
  ? university.contact.split(/[/,|;]/).map((p: string) => p.trim()).filter(Boolean)
  : [];

// ── SEO: title and description lead with programme data (see lib/seo/school.ts)
const seo = schoolSeo({ university, cityName, countryName });
const pageTitle = seo.title;
const pageDesc = seo.description;

// Only link to listing pages that exist and have something else to show.
const cityListing =
  cityCount > 1 && citiesMapping.some((c: any) => c.slug === university.city_slug)
    ? { href: `/directory/schools/in/${university.city_slug}`, label: `Design schools in ${cityName}`, count: cityCount }
    : null;
const countryListing =
  countryCount > 1 && countriesMapping.some((c: any) => c.slug === university.country_slug)
    ? { href: `/directory/schools/in/${university.country_slug}`, label: `Design schools in ${countryName}`, count: countryCount }
    : null;

const canonical = new URL(`/directory/schools/${slug}`, Astro.site);
const crumbs = [
  { label: 'Directory', href: '/directory' },
  { label: 'Schools', href: '/directory/schools' },
  ...(cityListing ? [{ label: cityName, href: cityListing.href }] : []),
  { label: university.name },
];

const schoolSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    schoolSchemaNode({
      university,
      canonical: canonical.toString(),
      cityName,
      countryName,
      imageUrl: normalizeImage(university.image, Astro),
      geo: universityHasLocation ? { latitude: universityLat, longitude: universityLng } : null,
      fallbackDescription: pageDesc,
    }),
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Directory', url: '/directory' },
      { name: 'Schools', url: '/directory/schools' },
      ...(cityListing ? [{ name: cityName, url: cityListing.href }] : []),
      { name: university.name, url: `/directory/schools/${slug}` },
    ]),
  ],
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical} schema={schoolSchema}>
  <Navbar />

  <div class="breadcrumbs-container">
    <Breadcrumbs items={crumbs} backHref="/directory/schools" />
  </div>

  <main class="detail-container">

    <!-- ── IDENTITY HEADER ────────────────────────────────────────────────── -->
    <SchoolHeader university={university} cityName={cityName} countryName={countryName} />

    <!-- ── TWO-COLUMN MAIN LAYOUT ─────────────────────────────────────────── -->
    <div class="school-grid">

      <!-- LEFT: EDITORIAL CONTENT -->
      <div class="school-main-col">

        <!-- 1. Slideshow Gallery -->
        <SchoolGallery university={university} />

        <!-- 2. Info Section -->
        <section class="content-block info-block">
          <h2 class="info-heading">Information</h2>
          <h3 class="block-title">OVERVIEW</h3>
          {university.description && (
            <p class="school-lead-text">{university.description}</p>
          )}
          {aboutParagraphs.length > 0 && (
            <details class="more-about-details">
              <summary class="more-about-toggle">
                <span>Read more</span>
                <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="about-text-content">
                {aboutParagraphs.map((para: string) => (
                  <p class="about-paragraph">{para}</p>
                ))}
              </div>
            </details>
          )}
        </section>

        <!-- 3. Academic & Programme Grid -->
        <div class="programme-grid">
          <!-- Left: Academic Programme Table -->
          <div class="programme-left">
            <DegreeList degreeEntries={degreeEntries} />
          </div>
          <!-- Right: Relevant Courses -->
          <div class="programme-right">
            {university.relevant_courses && (
              <section class="content-block courses-block">
                <h2 class="block-title">Relevant Courses</h2>
                <p class="courses-body-text">{university.relevant_courses}</p>
              </section>
            )}
          </div>
        </div>

      </div>

      <!-- RIGHT: STICKY SIDEBAR -->
      <aside class="school-sidebar-col">
        <div class="sidebar-sticky-wrapper">

          <!-- 1. Main Info Card (Website + Save Buttons) -->
          <SchoolSidebarInfo
            university={university}
            countryName={countryName}
            cityName={cityName}
            contactParts={contactParts}
          />

          <!-- 2. Campus & Location Map Section (Get Directions Button) -->
          {universityHasLocation && (
            <SchoolLocationSection university={university} gmapsUrl={gmapsUrl} />
          )}

          <!-- 3. Submit for Review Promo Card -->
          <SchoolPromoCard />

        </div>
      </aside>

    </div>

    <!-- ── BOTTOM DISCOVERY AREA: city → country → world ─────────────────── -->
    {(sameCitySchools.length > 0 || sameCountrySchools.length > 0 || worldSchools.length > 0) && (
      <section class="discovery-area">
        <div class="discovery-content">
          {sameCitySchools.length > 0 && (
            <div class="discovery-section">
              <div class="section-top">
                <h2 class="discovery-title">Discover more in {cityName}</h2>
                {cityListing && (
                  <a href={cityListing.href} class="discovery-see-all pill-link">
                    Discover city
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                )}
              </div>
              <div class="discovery-grid">
                {sameCitySchools.map((u, index) => (
                  <DirectoryCard studio={u} index={index} cover={u.image} basePath="/directory/schools" />
                ))}
              </div>
            </div>
          )}

          {sameCountrySchools.length > 0 && (
            <div class="discovery-section">
              <div class="section-top">
                <h2 class="discovery-title">Discover more in {countryName}</h2>
                {countryListing && (
                  <a href={countryListing.href} class="discovery-see-all pill-link">
                    Discover country
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                )}
              </div>
              <div class="discovery-grid">
                {sameCountrySchools.map((u, index) => (
                  <DirectoryCard studio={u} index={index} cover={u.image} basePath="/directory/schools" />
                ))}
              </div>
            </div>
          )}

          {worldSchools.length > 0 && (
            <div class="discovery-section">
              <div class="section-top">
                <h2 class="discovery-title">Discover from the world</h2>
                <a href="/directory/schools" class="discovery-see-all pill-link">
                  Discover world
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
              <div class="discovery-grid">
                {worldSchools.map((u, index) => (
                  <DirectoryCard studio={u} index={index} cover={u.image} basePath="/directory/schools" />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

  </main>

  <!-- Report Embed Modal -->
  <ReportIssueModal universityName={university.name} universityHasLocation={universityHasLocation} />

  <Footer />
</Layout>

<style>
  /* ── Page Containers ───────────────────────────────────────────────── */
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 100px;
    box-sizing: border-box;
    width: 100%;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
    box-sizing: border-box;
    width: 100%;
  }

  /* ── 2-Column Grid Layout ────────────────────────────────────────── */
  .school-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
  }

  .school-main-col {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Content Blocks ──────────────────────────────────────────────── */
  .content-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .school-lead-text {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-black);
    margin: 0;
    font-weight: 400;
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  .courses-body-text {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    word-break: break-word;
  }

  /* ── Info Section ────────────────────────────────────────────────── */
  .info-heading {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .more-about-details {
    display: block;
    width: 100%;
    align-self: stretch;
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .more-about-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-black);
    cursor: pointer;
    list-style: none;
  }

  .more-about-toggle::-webkit-details-marker {
    display: none;
  }

  .more-about-toggle svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .more-about-details[open] .more-about-toggle svg {
    transform: rotate(180deg);
  }

  .about-text-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
    margin-top: 18px;
  }

  .about-paragraph {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Programme Grid (2 columns: Degrees | Courses + Specs) ─────────── */
  .programme-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    width: 100%;
    box-sizing: border-box;
    align-items: start;
  }

  .programme-left {
    min-width: 0;
  }

  .programme-right {
    display: flex;
    flex-direction: column;
    gap: 44px;
    min-width: 0;
  }

  /* ── RIGHT SIDEBAR ───────────────────────────────────────────────── */
  .school-sidebar-col {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .sidebar-sticky-wrapper {
    position: sticky;
    top: calc(var(--navbar-height) + 24px);
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Bottom Discovery Area ───────────────────────────────────────── */
  .discovery-area {
    margin-top: 64px;
    padding-top: 0;
    border-top: none;
    width: 100%;
    box-sizing: border-box;
  }

  .discovery-section {
    margin-bottom: 64px;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 20px;
    width: 100%;
  }

  .discovery-title {
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .discovery-see-all {
    flex-shrink: 0;
    font-weight: 600;
  }

  .discovery-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Responsive Breakpoints & Visitor Priority Ordering ─────────────── */
  @media (max-width: 1300px) {
    .discovery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 1100px) {
    .school-grid {
      grid-template-columns: 1fr 340px;
      gap: 32px;
    }
    .discovery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 960px) {
    .school-main-col,
    .school-sidebar-col,
    .sidebar-sticky-wrapper {
      display: contents;
    }

    .school-grid {
      display: flex;
      flex-direction: column;
      gap: 36px;
      width: 100%;
    }

    .school-main-col > :nth-child(1) { order: 1; }
    .info-block { order: 2; }
    .school-sidebar-col :global(.info-card) { order: 3; }
    .programme-grid { order: 4; display: flex; flex-direction: column; gap: 36px; }
    .school-sidebar-col :global(.sidebar-location-section) { order: 5; }
    .school-sidebar-col :global(.promo-box) { order: 6; }

    .about-text-content {
      margin-top: 14px;
    }
  }

  @media (max-width: 768px) {
    .breadcrumbs-container {
      padding: 24px 20px 0;
    }
    .detail-container {
      padding: 0 20px 60px;
    }
    .discovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .breadcrumbs-container {
      padding: 20px 16px 0;
    }
    .detail-container {
      padding: 0 16px 48px;
    }
    .discovery-title {
      font-size: 18px;
    }
  }
</style>