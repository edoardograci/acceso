---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Spotlight from '../components/landing/Spotlight.astro';
import Footer from '../components/Footer.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface SpotlightItem {
  id: string;
  product_id: string;
  start_date: string;
  end_date: string | null;
  created_at: string;
  updated_at: string;
  product: {
    id: string;
    slug: string;
    name: string;
    designer: string | null;
    year: string | null;
    client: string | null;
    link: string | null;
    city: string | null;
    cover: string | null;
  } | null;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

interface Studio {
  id: string;
  slug: string;
  name: string;
  city: string;
  cover: string | null;
}

// Fetch spotlight data
let activeSpotlight: SpotlightItem | null = null;
let spotlightImages: ProductImage[] = [];
let designerStudio: Studio | null = null;
let carouselCities: string[] = [];

// Fetch data in parallel for better performance
try {
  const [studiosResponse, spotlightResponse, moodboardResponse] = await Promise.all([
    fetch(new URL('/studios.json', Astro.url.origin).toString()),
    fetch(new URL('/spotlight.json', Astro.url.origin).toString()),
    fetch(new URL('/moodboard.json', Astro.url.origin).toString())
  ]);

  if (studiosResponse.ok && spotlightResponse.ok && moodboardResponse.ok) {
    const [studios, spotlights, moodboardItems] = await Promise.all([
      studiosResponse.json() as Promise<Studio[]>,
      spotlightResponse.json() as Promise<SpotlightItem[]>,
      moodboardResponse.json() as Promise<MoodboardItem[]>
    ]);

    // Extract unique cities
    const dbCities = [...new Set(studios.map(s => s.city))];
    const userCities = ['Milan', 'London', 'Paris', 'Berlin', 'Copenhagen', 'Tokyo', 'Seoul'];
    carouselCities = [...new Set([...userCities, ...dbCities])].sort((a, b) => a.localeCompare(b));

    // Find active spotlight
    const now = new Date();
    const nowDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    activeSpotlight = spotlights.find(s => {
      const startDateStr = s.start_date.split(' ')[0];
      const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);
      const start = new Date(startYear, startMonth - 1, startDay);
      
      if (s.end_date) {
        const endDateStr = s.end_date.split(' ')[0];
        const [endYear, endMonth, endDay] = endDateStr.split('-').map(Number);
        const end = new Date(endYear, endMonth - 1, endDay);
        return nowDateOnly >= start && nowDateOnly <= end;
      }
      return nowDateOnly >= start;
    }) || spotlights.sort((a, b) => new Date(b.start_date).getTime() - new Date(a.start_date).getTime())[0] || null;

    if (activeSpotlight) {
      const productItem = moodboardItems.find(item => item.id === activeSpotlight!.product_id);
      if (productItem) {
        spotlightImages = productItem.images || [];
      }
      if (activeSpotlight.product?.designer) {
        designerStudio = studios.find(s => s.name === activeSpotlight!.product!.designer) || null;
      }
    }
  }
} catch (e) {
  console.error('Failed to fetch data:', e);
}
---

<Layout 
  title="Acceso - Discover Independent Design Studios Worldwide"
  description="Explore curated independent industrial design studios from Milan, Seoul, Berlin, London, and beyond. Browse objects, projects, and local design scenes."
  keywords="design studios directory, industrial design, product design Milan, design moodboard, independent designers, design studio map"
  type="website"
>
  <Navbar />
  
  {/* Hero Section */}
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-image-wrapper">
        <img src="/images/hero-image.png" alt="Acceso Design Hero" class="hero-static-image" width="1200" height="675" />
        <div class="hero-gradient-overlay"></div>
      </div>

      <h1 class="hero-title">Discover independent<br/>design studios worldwide</h1>
      <p class="hero-subtitle">A curated index of studios and objects rooted in local design scenes around the world.</p>
      
      <div class="hero-actions">
        <a href="/designers" class="btn-secondary">Browse studios</a>
        <a href="/map" class="btn-primary">Explore by city</a>
      </div>
    </div>

    <div class="hero-lower">
      <p class="cities-intro">
        Independent design studios shaping the design scene in major cities worldwide.
      </p>
      
      <div class="carousel-container">
        <div class="carousel-track">
          {/* Quadruple for infinite loop safety */}
          {[...carouselCities, ...carouselCities, ...carouselCities, ...carouselCities].map((city) => (
            <a href={`/designers?city=${city}`} class="city-pill">
              {city}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Features Section */}
  <section class="features-section">
    <div class="features-header">
      <h2 class="features-title">What you can do on Acceso</h2>
      <p class="features-subtitle">
        Explore independent design studios and objects through cities, projects and curated references.
      </p>
    </div>

    <div class="features-grid">
      <div class="feature-item">
        <h3 class="feature-title">Browse studios</h3>
        <p class="feature-description">
          Discover independent industrial design studios, indexed and organized for clarity.
        </p>
      </div>

      <div class="feature-item">
        <h3 class="feature-title">Explore by city</h3>
        <p class="feature-description">
          View local design scenes and move across cities to compare approaches and aesthetics.
        </p>
      </div>

      <div class="feature-item">
        <h3 class="feature-title">Moodboard</h3>
        <p class="feature-description">
          Collect and browse objects, projects and references in a shared visual space.
        </p>
      </div>

      <div class="feature-item">
        <h3 class="feature-title">Objects and projects</h3>
        <p class="feature-description">
          See products and works as standalone entries, connected back to their studios.
        </p>
      </div>

      <div class="feature-item">
        <h3 class="feature-title">Curated, not automated</h3>
        <p class="feature-description">
          Every studio and reference is selected manually, with no trend-based ranking.
        </p>
      </div>

      <div class="feature-item">
        <h3 class="feature-title">Made for exploration</h3>
        <p class="feature-description">
          Useful for inspiration, research and understanding contemporary design culture.
        </p>
      </div>
    </div>
  </section>

  {/* Feature Showcase: Map Discovery */}
  <section class="feature-showcase">
    <div class="showcase-container">
      <div class="showcase-content">
        <span class="showcase-label">Explore by location</span>
        <h2 class="showcase-title">Navigate the<br/>design map</h2>
        <p class="showcase-description">
          Discover independent design studios on a global interactive map. Navigate by city, dive into local design scenes, and uncover studios across Milan, London, Paris, Berlin, and beyond.
        </p>
        <a href="/map" class="showcase-btn">Explore map</a>
      </div>
      <div class="showcase-image">
        <div class="showcase-image-wrapper">
          <img src="/images/map.png" alt="Acceso Map Interface" class="showcase-img" />
          <div class="showcase-gradient-overlay"></div>
        </div>
      </div>
    </div>
  </section>

  {/* Feature Showcase: Moodboard (Mirrored) */}
  <section class="feature-showcase feature-showcase--reversed">
    <div class="showcase-container">
      <div class="showcase-content">
        <span class="showcase-label">Visual inspiration</span>
        <h2 class="showcase-title">Curate your<br/>moodboard</h2>
        <p class="showcase-description">
          Explore real product photography from independent studios worldwide. Save objects, curate moodboards, and collect references for your next project in a single visual space.
        </p>
        <a href="/moodboard" class="showcase-btn">Browse moodboard</a>
      </div>
      <div class="showcase-image">
        <div class="showcase-image-wrapper">
          <img src="/images/moodboard.png" alt="Acceso Moodboard Interface" class="showcase-img" />
          <div class="showcase-gradient-overlay"></div>
        </div>
      </div>
    </div>
  </section>
  
  {/* 
  <main class="spotlight-page">
    <Spotlight 
      activeSpotlight={activeSpotlight} 
      spotlightImages={spotlightImages} 
      designerStudio={designerStudio} 
    />
  </main>
  */}

  {/* Join Community Section */}
  <section class="community-section">
    <div class="community-content">
      <h2 class="community-title">Join the community</h2>
      <p class="community-subtitle">Be part of a growing network of independent designers and design lovers.</p>
      <a href="/login" class="btn-primary community-btn">Start collecting</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 24px var(--spacing-page) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--color-black);
    height: auto;
    min-height: 100vh;
    min-height: 100dvh;
    position: relative;
  }

  .hero-content {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* Hero Static Image */
  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin-bottom: 64px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: none !important;
    outline: none !important;
    background: var(--color-black);
  }

  .hero-static-image {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    top: -1px;
  }

  .hero-gradient-overlay {
    position: absolute;
    bottom: -10px; 
    left: -10px;
    right: -10px;
    height: 60%; 
    background: linear-gradient(
      to top,
      var(--color-black) 0%,
      var(--color-black) 40%,
      rgba(15, 15, 15, 0.8) 65%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .hero-title {
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-yellow);
    color: var(--color-black);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    color: var(--color-black);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .hero-lower {
    width: 100%;
    max-width: 1200px;
    margin-top: 0;
    position: relative;
    z-index: 10;
  }

  .lower-title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 300;
    margin-bottom: 32px;
    color: var(--color-white);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Cities Introduction Text */
  .cities-intro {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 300;
    color: var(--color-white);
    text-align: center;
    max-width: 700px;
    margin: 0 auto 40px;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  /* Carousel */
  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0;
  }

  .carousel-container::before,
  .carousel-container::after {
    content: "";
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .carousel-container::before {
    left: -2px;
    background: linear-gradient(to right, var(--color-black) 0%, transparent 100%);
  }

  .carousel-container::after {
    right: -2px;
    background: linear-gradient(to left, var(--color-black) 0%, transparent 100%);
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 120s linear infinite;
    will-change: transform;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Move only 25% because we have 4 sets of items.
         Moving 1 set length (1/4 = 25%) seamlessly loops back to start. */
      transform: translateX(-25%);
    }
  }

  @media (min-width: 769px) {
    .hero-section {
      padding-top: 80px;
      height: auto;
      min-height: 100vh;
      overflow: visible;
      justify-content: flex-start;
    }
    
    .hero-content {
      display: grid !important;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0;
    }

    .hero-title {
      grid-row: 1;
      font-size: 64px;
      margin-bottom: 24px;
    }

    .hero-subtitle {
      grid-row: 2;
      margin-bottom: 32px;
    }

    .hero-actions {
      grid-row: 3;
      margin-bottom: 80px;
    }

    .hero-image-wrapper {
      grid-row: 4;
      margin-top: 0;
      margin-bottom: 0;
      box-shadow: none;
      max-width: 1100px;
      width: 100%;
      inset: 0;
    }
  }

  .carousel-container {
    margin-top: 64px;
  }

  .city-pill {
    padding: 8px 24px;
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1.5px var(--color-stroke);
    border: none;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
  }

  /* Features Section */
  .features-section {
    max-width: 1400px;
    margin: 120px auto 120px;
    padding: 0 var(--spacing-page);
  }

  .features-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .features-title {
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 20px;
    color: var(--color-white);
    letter-spacing: -0.02em;
  }

  .features-subtitle {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-gray);
    max-width: 700px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 60px 40px;
    align-items: start;
  }

  .feature-item {
    text-align: left;
  }

  .feature-title {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 12px;
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  .feature-description {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0;
  }

  .spotlight-page {
    position: relative;
    padding-top: 80px;
    min-height: auto;
    background: var(--color-black);
  }

  @media (max-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 32px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      justify-content: flex-start;
      padding: 24px var(--spacing-page) 32px;
      min-height: auto;
      height: auto;
    }

    .hero-content {
      margin-bottom: 32px;
      width: 100%;
      max-width: 100%;
      padding: 0;
    }

    .hero-title {
      margin-bottom: 24px;
      font-size: 32px;
      max-width: 100%;
      overflow-wrap: break-word;
    }

    .hero-subtitle {
      margin-bottom: 32px;
      font-size: 18px;
      width: 100%;
      max-width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: break-word;
      word-wrap: break-word;
      line-height: 1.4;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-image-wrapper {
      margin-bottom: 0px;
      box-shadow: none;
      border: none;
      outline: none;
    }

    .hero-image-wrapper .hero-gradient-overlay {
      height: 60%; 
      bottom: -3px;
      background: linear-gradient(
        to top,
        var(--color-black) 0%,
        var(--color-black) 35%,
        rgba(15, 15, 15, 0.9) 55%,
        transparent 100%
      );
    }

    .lower-title {
      font-size: 16px;
    }

    .carousel-track {
      animation-duration: 40s;
    }

    .cities-intro {
      font-size: 16px;
      margin-top: 48px;
      padding: 0 8px;
    }

    .features-section {
      margin: 80px auto 80px;
    }

    .features-header {
      margin-bottom: 60px;
    }

    .features-title {
      font-size: 32px;
      margin-bottom: 16px;
    }

    .features-subtitle {
      font-size: 16px;
      padding: 0 8px;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .feature-title {
      font-size: 24px;
    }

    .feature-description {
      font-size: 15px;
    }

    .feature-item {
      border-bottom: 1px solid var(--color-gray);
      padding-bottom: 24px;
    }
  }

  /* Feature Showcase Sections */
  .feature-showcase {
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px var(--spacing-page);
  }

  .showcase-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .feature-showcase--reversed .showcase-container {
    direction: rtl;
  }

  .feature-showcase--reversed .showcase-content,
  .feature-showcase--reversed .showcase-image {
    direction: ltr;
  }

  .showcase-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .showcase-label {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-yellow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .showcase-title {
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .showcase-description {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-gray);
    max-width: 500px;
    margin: 8px 0 12px;
  }

  .showcase-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: transparent;
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    margin-top: 8px;
  }

  .showcase-btn:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
    transform: translateY(-2px);
  }

  .showcase-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
  }

  .showcase-image-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-gradient-overlay {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(
      to top,
      var(--color-black) 0%,
      var(--color-black) 20%,
      rgba(15, 15, 15, 0.8) 50%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .feature-showcase {
      padding: 60px var(--spacing-page);
    }

    .showcase-container {
      gap: 48px;
    }

    .showcase-title {
      font-size: 44px;
    }

    .showcase-description {
      font-size: 16px;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .feature-showcase {
      padding: 48px var(--spacing-page);
    }

    .showcase-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .feature-showcase--reversed .showcase-container {
      direction: ltr;
    }

    .showcase-content {
      text-align: center;
      align-items: center;
    }

    .showcase-title {
      font-size: 36px;
    }

    .showcase-description {
      font-size: 16px;
      max-width: 100%;
    }

    .showcase-image {
      aspect-ratio: 16 / 10;
    }

    .placeholder-icon {
      font-size: 48px;
    }
  }
  /* Community Section */
  .community-section {
    padding: 120px var(--spacing-page);
    text-align: center;
    background: var(--color-black);
  }

  .community-content {
    max-width: 600px;
