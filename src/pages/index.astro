---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Spotlight from '../components/landing/Spotlight.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface SpotlightItem {
  id: string;
  product_id: string;
  start_date: string;
  end_date: string | null;
  created_at: string;
  updated_at: string;
  product: {
    id: string;
    slug: string;
    name: string;
    designer: string | null;
    year: string | null;
    client: string | null;
    link: string | null;
    city: string | null;
    cover: string | null;
  } | null;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

interface Studio {
  id: string;
  slug: string;
  name: string;
  city: string;
  cover: string | null;
}

// Fetch spotlight data
let activeSpotlight: SpotlightItem | null = null;
let spotlightImages: ProductImage[] = [];
let designerStudio: Studio | null = null;
let carouselCities: string[] = [];

// Fetch data in parallel for better performance
try {
  const [studiosResponse, spotlightResponse, moodboardResponse] = await Promise.all([
    fetch(new URL('/studios.json', Astro.url.origin).toString()),
    fetch(new URL('/spotlight.json', Astro.url.origin).toString()),
    fetch(new URL('/moodboard.json', Astro.url.origin).toString())
  ]);

  if (studiosResponse.ok && spotlightResponse.ok && moodboardResponse.ok) {
    const [studios, spotlights, moodboardItems] = await Promise.all([
      studiosResponse.json() as Promise<Studio[]>,
      spotlightResponse.json() as Promise<SpotlightItem[]>,
      moodboardResponse.json() as Promise<MoodboardItem[]>
    ]);

    // Extract unique cities
    const dbCities = [...new Set(studios.map(s => s.city))];
    const userCities = ['Milan', 'London', 'Paris', 'Berlin', 'Copenhagen', 'Tokyo', 'Seoul'];
    carouselCities = [...new Set([...userCities, ...dbCities])].sort((a, b) => a.localeCompare(b));

    // Find active spotlight
    const now = new Date();
    const nowDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    activeSpotlight = spotlights.find(s => {
      const startDateStr = s.start_date.split(' ')[0];
      const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);
      const start = new Date(startYear, startMonth - 1, startDay);
      
      if (s.end_date) {
        const endDateStr = s.end_date.split(' ')[0];
        const [endYear, endMonth, endDay] = endDateStr.split('-').map(Number);
        const end = new Date(endYear, endMonth - 1, endDay);
        return nowDateOnly >= start && nowDateOnly <= end;
      }
      return nowDateOnly >= start;
    }) || spotlights.sort((a, b) => new Date(b.start_date).getTime() - new Date(a.start_date).getTime())[0] || null;

    if (activeSpotlight) {
      const productItem = moodboardItems.find(item => item.id === activeSpotlight!.product_id);
      if (productItem) {
        spotlightImages = productItem.images || [];
      }
      if (activeSpotlight.product?.designer) {
        designerStudio = studios.find(s => s.name === activeSpotlight!.product!.designer) || null;
      }
    }
  }
} catch (e) {
  console.error('Failed to fetch data:', e);
}
---

<Layout title="Acceso Design">
  <Navbar />
  
  {/* Hero Section */}
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-image-wrapper">
        <img src="/images/hero-image.png" alt="Acceso Design Hero" class="hero-static-image" width="1200" height="675" />
        <div class="hero-gradient-overlay"></div>
      </div>

      <h1 class="hero-title">Discover independent<br/>design studios worldwide</h1>
      <p class="hero-subtitle">A curated index of studios and objects rooted in local design scenes around the world.</p>
      
      <div class="hero-actions">
        <a href="/designers" class="btn-secondary">Browse studios</a>
        <a href="/map" class="btn-primary">Explore by city</a>
      </div>
    </div>

    <div class="hero-lower">
      <div class="carousel-container">
        <div class="carousel-track">
          {/* Duplicate for infinite loop */}
          {[...carouselCities, ...carouselCities].map((city) => (
            <a href={`/designers?city=${city}`} class="city-pill">
              {city}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  {/* 
  <main class="spotlight-page">
    <Spotlight 
      activeSpotlight={activeSpotlight} 
      spotlightImages={spotlightImages} 
      designerStudio={designerStudio} 
    />
  </main>
  */}
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 24px var(--spacing-page) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* justify-content: center; REMOVED to fix overlap */
    text-align: center;
    background: var(--color-black);
    height: auto; /* Allow auto height */
    min-height: 100vh;
    min-height: 100dvh;
    position: relative;
  }

  .hero-content {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* Hero Static Image */
  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin-bottom: 64px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* Explicitly kill all potential border/box artifacts */
    border: none !important;
    outline: none !important;
    background: var(--color-black); /* Match bg to hide any bleed */

  }

  .hero-static-image {
    position:relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    top: -1px;
  }

  .hero-gradient-overlay {
    position: absolute;
    /* Deeply over-extend in all directions to capture 100% of sub-pixel rendering gaps */
    bottom: -10px; 
    left: -10px;
    right: -10px;
    height: 60%; 
    background: linear-gradient(
      to top,
      var(--color-black) 0%,
      var(--color-black) 40%,
      rgba(15, 15, 15, 0.8) 65%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 2;
  }



  .hero-title {
    margin-top: 0;

    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-yellow);
    color: var(--color-black);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    color: var(--color-black);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .hero-lower {
    width: 100%;
    max-width: 1200px;
    margin-top: 0;
    position: relative; /* Ensure z-index works */
    z-index: 10; /* Bring above any potential overlaps */
  }

  .lower-title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 300;
    margin-bottom: 32px;
    color: var(--color-white);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Carousel */
  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0; /* Reduced vertical padding */
  }

  .carousel-container::before,
  .carousel-container::after {
    content: "";
    position: absolute;
    top: -2px; /* Slight vertical overlap */
    bottom: -2px;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .carousel-container::before {
    left: -2px; /* Deep overlap on the left edge */
    background: linear-gradient(to right, var(--color-black) 0%, transparent 100%);
  }

  .carousel-container::after {
    right: -2px; /* Deep overlap on the right edge */
    background: linear-gradient(to left, var(--color-black) 0%, transparent 100%);
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 120s linear infinite;
    will-change: transform;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (min-width: 769px) {
    .hero-section {
      padding-top: 80px;
      height: auto;
      min-height: 100vh;
      overflow: visible;
      justify-content: flex-start;
    }
    
    .hero-content {
      display: grid !important;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0;
    }

    .hero-title {
      grid-row: 1;
      font-size: 64px;
      margin-bottom: 24px;
    }

    .hero-subtitle {
      grid-row: 2;
      margin-bottom: 32px;
    }

    .hero-actions {
      grid-row: 3;
      margin-bottom: 80px; /* Space before image */
    }

    .hero-image-wrapper {
      grid-row: 4;
      margin-top: 0;
      margin-bottom: 0;
      box-shadow: none;
      max-width: 1100px;
      width: 100%;
      inset: 0;
    }
  }

  .carousel-container {
    margin-top: 64px;
  }

  .city-pill {
    padding: 8px 24px;
    background: var(--color-bg-secondary);
    /* Corrected pill borders: inset shadow is more stable for sliding elements */
    box-shadow: inset 0 0 0 1.5px var(--color-stroke);
    border: none;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
  }

  .spotlight-page {
    position: relative;
    padding-top: 80px;
    min-height: auto;
    background: var(--color-black);
  }

  @media (max-width: 768px) {
    .hero-section {
      /* Remove centering to pull content up */
      justify-content: flex-start;
      /* Reduced padding top significantly based on user feedback */
      padding: 24px var(--spacing-page) 32px;
      min-height: auto;
      height: auto;
    }

    .hero-content {
      margin-bottom: 32px;
      width: 100%; /* Force width to fit container */
      max-width: 100%; /* Ensure it does not overflow */
      padding: 0; /* Remove potential padding issues */
    }

    .hero-title {
      margin-bottom: 24px;
      font-size: 32px;
      max-width: 100%;
      overflow-wrap: break-word;
    }

    .hero-subtitle {
      margin-bottom: 32px;
      font-size: 18px;
      width: 100%;
      max-width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: break-word;
      word-wrap: break-word; /* Fallback */
      line-height: 1.4;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-image-wrapper {
      margin-bottom: 0px;
      box-shadow: none;
      border: none;
      outline: none;
    }

    /* Target the overlay specifically on mobile to deepen the mask */
    .hero-image-wrapper .hero-gradient-overlay {
      height: 60%; 
      bottom: -3px;
      background: linear-gradient(
        to top,
        var(--color-black) 0%,
        var(--color-black) 35%,
        rgba(15, 15, 15, 0.9) 55%,
        transparent 100%
      );
    }

    .lower-title {
      font-size: 16px;
    }

    .carousel-track {
      animation-duration: 40s;
    }
  }
</style>

