---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface SpotlightItem {
  id: string;
  product_id: string;
  start_date: string;
  end_date: string | null;
  created_at: string;
  updated_at: string;
  product: {
    id: string;
    slug: string;
    name: string;
    designer: string | null;
    year: string | null;
    client: string | null;
    link: string | null;
    city: string | null;
    cover: string | null;
  } | null;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

interface Studio {
  id: string;
  slug: string;
  name: string;
  city: string;
  cover: string | null;
}

// Fetch spotlight data
let activeSpotlight: SpotlightItem | null = null;
let spotlightImages: ProductImage[] = [];
let designerStudio: Studio | null = null;
let carouselCities: string[] = [];

try {
  // Fetch all studios for cities list
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const studiosResponse = await fetch(studiosUrl.toString());
  
  if (studiosResponse.ok) {
    const studios: Studio[] = await studiosResponse.json();
    
    // Extract unique cities
    const dbCities = [...new Set(studios.map(s => s.city))];
    const userCities = ['Milan', 'London', 'Paris', 'Berlin', 'Copenhagen', 'Tokyo', 'Seoul'];
    carouselCities = [...new Set([...userCities, ...dbCities])].sort((a, b) => {
      // Keep user cities in front or just alpha sort
      return a.localeCompare(b);
    });

    // Fetch spotlight.json
  const spotlightUrl = new URL('/spotlight.json', Astro.url.origin);
  const spotlightResponse = await fetch(spotlightUrl.toString());
  
  if (spotlightResponse.ok) {
    const spotlights: SpotlightItem[] = await spotlightResponse.json();
    
    // Find active spotlight (current date within date range)
    const now = new Date();
    const nowDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    activeSpotlight = spotlights.find(s => {
      // Parse start date (handle both YYYY-MM-DD and YYYY-MM-DD HH:mm:ss formats)
      const startDateStr = s.start_date.split(' ')[0]; // Get just the date part
      const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);
      const start = new Date(startYear, startMonth - 1, startDay);
      
      // Parse end date if it exists
      if (s.end_date) {
        const endDateStr = s.end_date.split(' ')[0]; // Get just the date part
        const [endYear, endMonth, endDay] = endDateStr.split('-').map(Number);
        const end = new Date(endYear, endMonth - 1, endDay);
        // Include the end date (>= comparison)
        return nowDateOnly >= start && nowDateOnly <= end;
      } else {
        // No end date means it's active from start date onwards
        return nowDateOnly >= start;
      }
    }) || null;

    // Fallback: if no active spotlight, use the most recent one (for development)
    if (!activeSpotlight && spotlights.length > 0) {
      // Sort by start_date descending and take the first one
      const sorted = [...spotlights].sort((a, b) => {
        const dateA = new Date(a.start_date);
        const dateB = new Date(b.start_date);
        return dateB.getTime() - dateA.getTime();
      });
      activeSpotlight = sorted[0];
    }

    // If we have an active spotlight, fetch its images from moodboard.json
    if (activeSpotlight?.product) {
      const moodboardUrl = new URL('/moodboard.json', Astro.url.origin);
      const moodboardResponse = await fetch(moodboardUrl.toString());
      
      if (moodboardResponse.ok) {
        const moodboardItems: MoodboardItem[] = await moodboardResponse.json();
        const productItem = moodboardItems.find(item => item.id === activeSpotlight.product_id);
        
        if (productItem) {
          spotlightImages = productItem.images || [];
        }
      }

      // Fetch designer studio info
      if (activeSpotlight.product.designer) {
        designerStudio = studios.find(s => s.name === activeSpotlight!.product!.designer) || null;
      }
    }
  }
}
} catch (e) {
  console.error('Failed to fetch spotlight:', e);
}
---

<Layout title="Acceso Design">
  <Navbar />
  
  {/* Hero Section */}
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-showreel-container">
        <img src="/animations/showreel.gif" alt="Acceso Design Animation" class="hero-showreel" />
      </div>
      <h1 class="hero-title">Discover independent<br/>design studios worldwide</h1>
      <p class="hero-subtitle">A curated index of studios and objects revealing local design scenes, city by city.</p>
      
      <div class="hero-actions">
        <a href="/designers" class="btn-secondary">Browse studios</a>
        <a href="/map" class="btn-primary">Explore by city</a>
      </div>
    </div>

    <div class="hero-lower">
      <div class="carousel-container">
        <div class="carousel-track">
          {/* Duplicate for infinite loop */}
          {[...carouselCities, ...carouselCities, ...carouselCities, ...carouselCities].map((city) => (
            <a href={`/designers?city=${city}`} class="city-pill">
              {city}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <main class="spotlight-page">
  {activeSpotlight?.product && spotlightImages.length > 0 ? (
    <div class="spotlight-container">
      {/* Radial Gradient Background */}
      <div class="radial-gradient"></div>
      
      {/* Header Section */}
      <div class="spotlight-header">
        <h2 class="spotlight-heading">SPOTLIGHT OF<br/>THE WEEK</h2>
        <div class="week-badge">#1 week</div>
      </div>

      {/* Year and City */}
      <div class="spotlight-meta">
        {activeSpotlight.product.year && <span>{activeSpotlight.product.year}</span>}
        {activeSpotlight.product.city && (
          <>
            <svg width="4" height="4" viewBox="0 0 4 4" fill="currentColor">
              <circle cx="2" cy="2" r="2"/>
            </svg>
            <span>{activeSpotlight.product.city}</span>
          </>
        )}
      </div>

      {/* Product Name */}
      <h2 class="product-name">{activeSpotlight.product.name}</h2>

      {/* Cover Image */}
      <div class="cover-image-container">
        <img 
          src={spotlightImages[0].image_url} 
          alt={activeSpotlight.product.name}
          class="cover-image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-skeleton
          crossorigin="anonymous"
        />
      </div>

      {/* See Other Photos Button */}
      <a href={`/moodboard/${activeSpotlight.product.slug}`} class="see-photos-btn">
        See other photos
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      {/* Designer Section */}
      {activeSpotlight.product.designer && (
        <div class="designer-section">
          <div class="designer-label">Designer</div>
          
          {designerStudio ? (
            <a href={`/designers/${designerStudio.slug}`} class="designer-card">
              <div class="designer-card-inner">
                {designerStudio.cover && (
                  <img 
                    src={designerStudio.cover} 
                    alt={designerStudio.name}
                    class="designer-card-image"
                    loading="lazy"
                    decoding="async"
                    data-skeleton
                  />
                )}
                <div class="designer-card-content">
                  <div class="designer-card-title">{designerStudio.name}</div>
                  <div class="designer-card-address">Via Massimo Gorki 2</div>
                </div>
                <div class="designer-card-arrow">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </a>
          ) : (
            <div class="designer-name-only">{activeSpotlight.product.designer}</div>
          )}
        </div>
      )}
    </div>
    ) : (
      <div class="no-spotlight">
        <p style="font-size: 18px; color: var(--text-secondary); margin-bottom: 32px;">
          Discover Milan's independent design studios
        </p>
        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="/designers" style="background: var(--accent-yellow); color: #000; padding: 16px 32px; text-decoration: none; font-weight: 600;">
            Browse Designers
          </a>
          <a href="/moodboard" style="background: var(--gray-dark); color: #fff; padding: 16px 32px; text-decoration: none; font-weight: 600;">
            View Moodboard
          </a>
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 24px var(--spacing-page) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center; /* Center everything as a tight group */
    text-align: center;
    background: var(--color-black);
    height: 100vh;
    height: 100dvh;
    min-height: 550px;
    overflow: hidden;
    position: relative;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px; /* Reduced gap before carousel */
  }

  .hero-showreel-container {
    width: 100%;
    max-width: 480px;
    height: 270px;
    margin-bottom: 16px; /* Tightened */
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    pointer-events: none;
  }

  .hero-showreel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 270px; /* Physical width (becomes visual height) */
    height: 480px; /* Physical height (becomes visual width) */
    transform: translate(-50%, -50%) rotate(90deg) scale(1.02);
    object-fit: cover;
  }

  .hero-title {
    margin-top: 0;

    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-yellow);
    color: var(--color-black);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    color: var(--color-black);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .hero-lower {
    width: 100%;
    max-width: 1200px;
    margin-top: 0;
  }

  .lower-title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 300;
    margin-bottom: 32px;
    color: var(--color-white);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Carousel */
  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0; /* Reduced vertical padding */
  }

  .carousel-container::before,
  .carousel-container::after {
    content: "";
    position: absolute;
    top: 0;
    width: 100px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .carousel-container::before {
    left: 0;
    background: linear-gradient(to right, var(--color-black), transparent);
  }

  .carousel-container::after {
    right: 0;
    background: linear-gradient(to left, var(--color-black), transparent);
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }

  @media (min-width: 1024px) {
    .hero-showreel-container {
      max-width: 800px;
      height: 450px;
      margin-bottom: 48px;
    }

    .hero-showreel {
      width: 450px;
      height: 800px;
      transform: translate(-50%, -50%) rotate(90deg) scale(1.02);
    }

    .hero-section {
      padding-top: 60px;
    }
    
    .hero-title {
      font-size: 72px;
    }
  }

  .city-pill {
    padding: 8px 24px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
  }

  .spotlight-page {
    position: relative;
    padding-top: 80px;
    min-height: auto;
    background: var(--color-black);
  }

  .spotlight-container {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    padding: 0 var(--spacing-page) 80px;
    text-align: center;
  }

  /* Radial Gradient */
  .radial-gradient {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 400px;
    background: radial-gradient(ellipse at center top, rgba(255, 224, 0, 0.15) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Header Section */
  .spotlight-header {
    position: relative;
    z-index: 1;
    padding-top: 48px;
    margin-bottom: 24px;
  }

  .spotlight-heading {
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin: 0 0 16px 0;
    color: var(--color-white);
  }

  .week-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgba(255, 224, 0, 0.1);
    border: 1px solid var(--color-yellow);
    color: var(--color-yellow);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
  }

  /* Meta Info */
  .spotlight-meta {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .spotlight-meta svg {
    opacity: 0.5;
  }

  /* Product Name */
  .product-name {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin: 0 0 32px 0;
    color: var(--color-white);
  }

  /* Cover Image */
  .cover-image-container {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-bottom: 24px;
    overflow: hidden;
  }

  .cover-image {
    width: 100%;
    height: auto;
    display: block;
  }

  /* See Photos Button */
  .see-photos-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 8px;
    padding: 14px 24px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 6px;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 450;
    text-decoration: none;
    transition: all 0.2s ease;
    margin-bottom: 48px;
  }

  .see-photos-btn:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .see-photos-btn svg {
    flex-shrink: 0;
  }

  /* Designer Section */
  .designer-section {
    position: relative;
    z-index: 1;
    text-align: left;
  }

  .designer-label {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 200;
    letter-spacing: 0.56px;
    color: var(--color-white);
    margin-bottom: 16px;
  }

  /* Designer Card - Map Style */
  .designer-card {
    display: block;
    background: var(--color-black);
    border: 1px solid var(--color-stroke);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .designer-card:hover {
    border-color: var(--color-white);
  }

  .designer-card-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
  }

  .designer-card-image {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    object-fit: cover;
    background-color: var(--color-bg-secondary);
  }

  .designer-card-content {
    flex: 1;
    min-width: 0;
  }

  .designer-card-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-white);
    margin-bottom: 6px;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .designer-card-address {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-gray);
    line-height: 1.4;
    margin: 0;
  }

  .designer-card-arrow {
    flex-shrink: 0;
    padding-left: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
  }

  .designer-card-arrow svg {
    width: 24px;
    height: 24px;
  }

  .designer-name-only {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 450;
    color: var(--text-primary);
  }

  /* No Spotlight State */
  .no-spotlight {
    padding: 48px var(--spacing-page);
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 0 var(--spacing-page) 32px;
      min-height: 500px;
    }

    .hero-content {
      margin-bottom: 48px; /* More space before carousel */
    }

    .hero-showreel-container {
      margin-top: -40px; /* Pull showreel up towards navbar */
      margin-bottom: 32px; /* Add space below showreel */
    }

    .hero-title {
      margin-bottom: 24px;
    }

    .hero-subtitle {
      margin-bottom: 48px; /* More space between text and buttons */
    }

    .spotlight-heading {
      font-size: 28px;
    }

    .product-name {
      font-size: 24px;
    }

    .hero-title {
      font-size: 36px;
    }

    .hero-subtitle {
      font-size: 18px;
    }

    .lower-title {
      font-size: 16px;
    }

    .carousel-track {
      animation-duration: 40s;
    }

    .designer-card-inner {
      padding: 12px;
    }

    .designer-card-image {
      width: 80px;
      height: 80px;
    }

    .designer-card-title {
      font-size: 14px;
    }

    .designer-card-address {
      font-size: 12px;
    }
  }
</style>

