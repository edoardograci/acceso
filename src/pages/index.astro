---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Showreel from '../components/landing/Showreel.astro';
import Spotlight from '../components/landing/Spotlight.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface SpotlightItem {
  id: string;
  product_id: string;
  start_date: string;
  end_date: string | null;
  created_at: string;
  updated_at: string;
  product: {
    id: string;
    slug: string;
    name: string;
    designer: string | null;
    year: string | null;
    client: string | null;
    link: string | null;
    city: string | null;
    cover: string | null;
  } | null;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

interface Studio {
  id: string;
  slug: string;
  name: string;
  city: string;
  cover: string | null;
}

// Fetch spotlight data
let activeSpotlight: SpotlightItem | null = null;
let spotlightImages: ProductImage[] = [];
let designerStudio: Studio | null = null;
let carouselCities: string[] = [];

try {
  // Fetch all studios for cities list
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const studiosResponse = await fetch(studiosUrl.toString());
  
  if (studiosResponse.ok) {
    const studios: Studio[] = await studiosResponse.json();
    
    // Extract unique cities
    const dbCities = [...new Set(studios.map(s => s.city))];
    const userCities = ['Milan', 'London', 'Paris', 'Berlin', 'Copenhagen', 'Tokyo', 'Seoul'];
    carouselCities = [...new Set([...userCities, ...dbCities])].sort((a, b) => {
      // Keep user cities in front or just alpha sort
      return a.localeCompare(b);
    });

    // Fetch spotlight.json
  const spotlightUrl = new URL('/spotlight.json', Astro.url.origin);
  const spotlightResponse = await fetch(spotlightUrl.toString());
  
  if (spotlightResponse.ok) {
    const spotlights: SpotlightItem[] = await spotlightResponse.json();
    
    // Find active spotlight (current date within date range)
    const now = new Date();
    const nowDateOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    activeSpotlight = spotlights.find(s => {
      // Parse start date (handle both YYYY-MM-DD and YYYY-MM-DD HH:mm:ss formats)
      const startDateStr = s.start_date.split(' ')[0]; // Get just the date part
      const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);
      const start = new Date(startYear, startMonth - 1, startDay);
      
      // Parse end date if it exists
      if (s.end_date) {
        const endDateStr = s.end_date.split(' ')[0]; // Get just the date part
        const [endYear, endMonth, endDay] = endDateStr.split('-').map(Number);
        const end = new Date(endYear, endMonth - 1, endDay);
        // Include the end date (>= comparison)
        return nowDateOnly >= start && nowDateOnly <= end;
      } else {
        // No end date means it's active from start date onwards
        return nowDateOnly >= start;
      }
    }) || null;

    // Fallback: if no active spotlight, use the most recent one (for development)
    if (!activeSpotlight && spotlights.length > 0) {
      // Sort by start_date descending and take the first one
      const sorted = [...spotlights].sort((a, b) => {
        const dateA = new Date(a.start_date);
        const dateB = new Date(b.start_date);
        return dateB.getTime() - dateA.getTime();
      });
      activeSpotlight = sorted[0];
    }

    // If we have an active spotlight, fetch its images from moodboard.json
    if (activeSpotlight?.product) {
      const moodboardUrl = new URL('/moodboard.json', Astro.url.origin);
      const moodboardResponse = await fetch(moodboardUrl.toString());
      
      if (moodboardResponse.ok) {
        const moodboardItems: MoodboardItem[] = await moodboardResponse.json();
        const productItem = moodboardItems.find(item => item.id === activeSpotlight.product_id);
        
        if (productItem) {
          spotlightImages = productItem.images || [];
        }
      }

      // Fetch designer studio info
      if (activeSpotlight.product.designer) {
        designerStudio = studios.find(s => s.name === activeSpotlight!.product!.designer) || null;
      }
    }
  }
}
} catch (e) {
  console.error('Failed to fetch spotlight:', e);
}
---

<Layout title="Acceso Design">
  <Navbar />
  
  {/* Hero Section */}
  <section class="hero-section">
    <div class="hero-content">
        <Showreel />
      <h1 class="hero-title">Discover independent<br/>design studios worldwide</h1>
      <p class="hero-subtitle">A curated index of studios and objects revealing local design scenes, city by city.</p>
      
      <div class="hero-actions">
        <a href="/designers" class="btn-secondary">Browse studios</a>
        <a href="/map" class="btn-primary">Explore by city</a>
      </div>
    </div>

    <div class="hero-lower">
      <div class="carousel-container">
        <div class="carousel-track">
          {/* Duplicate for infinite loop */}
          {[...carouselCities, ...carouselCities, ...carouselCities, ...carouselCities].map((city) => (
            <a href={`/designers?city=${city}`} class="city-pill">
              {city}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
  
  <main class="spotlight-page">
    <Spotlight 
      activeSpotlight={activeSpotlight} 
      spotlightImages={spotlightImages} 
      designerStudio={designerStudio} 
    />
  </main>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 24px var(--spacing-page) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* justify-content: center; REMOVED to fix overlap */
    text-align: center;
    background: var(--color-black);
    height: auto; /* Allow auto height */
    min-height: 100vh;
    min-height: 100dvh;
    position: relative;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px; /* Reduced gap before carousel */
  }



  .hero-title {
    margin-top: 0;

    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-yellow);
    color: var(--color-black);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    color: var(--color-black);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .hero-lower {
    width: 100%;
    max-width: 1200px;
    margin-top: 0;
    position: relative; /* Ensure z-index works */
    z-index: 10; /* Bring above any potential overlaps */
  }

  .lower-title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 300;
    margin-bottom: 32px;
    color: var(--color-white);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Carousel */
  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0; /* Reduced vertical padding */
  }

  .carousel-container::before,
  .carousel-container::after {
    content: "";
    position: absolute;
    top: 0;
    width: 100px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .carousel-container::before {
    left: 0;
    background: linear-gradient(to right, var(--color-black), transparent);
  }

  .carousel-container::after {
    right: 0;
    background: linear-gradient(to left, var(--color-black), transparent);
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    width: max-content;
    animation: scroll 60s linear infinite;
  }

  .carousel-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-25%);
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      padding-top: 48px; /* Push content down below navbar */
      height: auto; /* Allow growth */
      min-height: 100vh; /* Restore full height on desktop */
      overflow: visible; /* CRITICAL: Allow filters to be seen */
      justify-content: flex-start; /* Ensure top alignment */
    }
    
    .hero-title {
      font-size: 64px;
    }
  }

  .city-pill {
    padding: 8px 24px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 14px;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
  }

  .spotlight-page {
    position: relative;
    padding-top: 80px;
    min-height: auto;
    background: var(--color-black);
  }

  @media (max-width: 768px) {
    .hero-section {
      /* Remove centering to pull content up */
      justify-content: flex-start;
      /* Reduced padding top significantly based on user feedback */
      padding: 24px var(--spacing-page) 32px;
      min-height: auto;
      height: auto;
    }

    .hero-content {
      margin-bottom: 32px;
      width: 100%; /* Force width to fit container */
      max-width: 100%; /* Ensure it does not overflow */
      padding: 0; /* Remove potential padding issues */
    }

    .hero-title {
      margin-bottom: 24px;
      font-size: 32px;
      max-width: 100%;
      overflow-wrap: break-word;
    }

    .hero-subtitle {
      margin-bottom: 32px;
      font-size: 18px;
      width: 100%;
      max-width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: break-word;
      word-wrap: break-word; /* Fallback */
      line-height: 1.4;
    }

    .lower-title {
      font-size: 16px;
    }

    .carousel-track {
      animation-duration: 40s;
    }
  }
</style>

