---
import PostHogLayout from '../layouts/PostHogLayout.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Spotlight from '../components/landing/Spotlight.astro';
import Footer from '../components/Footer.astro';
import '../styles/home.css';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface SpotlightItem {
  id: string;
  product_id: string;
  start_date: string;
  end_date: string | null;
  created_at: string;
  updated_at: string;
  product: {
    id: string;
    slug: string;
    name: string;
    designer: string | null;
    year: string | null;
    client: string | null;
    link: string | null;
    city: string | null;
    cover: string | null;
  } | null;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

// Fetch spotlight data
let spotlightItems: SpotlightItem[] = [];
let activeSpotlight: SpotlightItem | null = null;
let spotlightImages: ProductImage[] = [];
let designerStudio: { name: string; city: string; slug: string } | null = null;

try {
  const spotlightUrl = new URL('/spotlight.json', Astro.url.origin);
  const response = await fetch(spotlightUrl.toString());
  if (response.ok) {
    spotlightItems = await response.json();
    
    // Find active spotlight (where end_date is null or in the future)
    const now = new Date().toISOString();
    activeSpotlight = spotlightItems.find(
      item => !item.end_date || new Date(item.end_date) > new Date(now)
    ) || null;

    if (activeSpotlight && activeSpotlight.product) {
      // Fetch moodboard data to get images
      const moodboardUrl = new URL('/moodboard.json', Astro.url.origin);
      const moodboardResponse = await fetch(moodboardUrl.toString());
      if (moodboardResponse.ok) {
        const moodboardItems: MoodboardItem[] = await moodboardResponse.json();
        const matchingItem = moodboardItems.find(
          item => item.id === activeSpotlight!.product_id
        );
        
        if (matchingItem) {
          spotlightImages = matchingItem.images || [];
          designerStudio = {
            name: matchingItem.designer || 'Unknown Designer',
            city: matchingItem.city || 'Unknown City',
            slug: matchingItem.slug
          };
        }
      }
    }
  }
} catch (e) {
  console.error('Failed to fetch spotlight data:', e);
}

// Get unique cities for carousel
let cities: string[] = [];
try {
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const response = await fetch(studiosUrl.toString());
  if (response.ok) {
    const studios = await response.json();
    cities = [...new Set(studios.map((s: { city: string }) => s.city))].sort((a, b) => {
      if (a === 'Milan') return -1;
      if (b === 'Milan') return 1;
      return a.localeCompare(b);
    });
  }
} catch (e) {
  console.error('Failed to fetch cities:', e);
}
---

<PostHogLayout>
  <Layout 
    title="Acceso - Discover Independent Design Studios Worldwide"
    description="Explore curated independent industrial design studios from Milan, Seoul, Berlin, London, and beyond. Browse objects, projects, and local design scenes."
    keywords="design studios directory, industrial design, product design Milan, design moodboard, independent designers, design studio map"
  >
    <Navbar />

    {/* Hero Section */}
    <section class="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">Discover independent design studios worldwide</h1>
        <p class="hero-subtitle">
          Explore curated studios, projects, and objects from Milan, Seoul, Berlin, London, and beyond.
        </p>
        <div class="hero-actions">
          <a href="/designers" class="btn-primary">Browse Studios</a>
          <a href="/moodboard" class="btn-secondary">View Moodboard</a>
        </div>
        
        <div class="hero-image-wrapper">
          <img 
            src="/images/hero-image.png" 
            alt="Design studios showcase" 
            class="hero-static-image"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            data-skeleton
          />
          <div class="hero-gradient-overlay"></div>
        </div>
      </div>

      <div class="hero-lower">
        <p class="lower-title">Explore by city</p>
        
        <p class="cities-intro">
          From Milan's industrial design heritage to Seoul's innovative product design scene, discover studios across the globe.
        </p>

        <div class="carousel-container">
          <div class="carousel-track">
            {cities.map(city => (
              <a href={`/designers?city=${encodeURIComponent(city)}`} class="city-pill">
                {city}
              </a>
            ))}
            {cities.map(city => (
              <a href={`/designers?city=${encodeURIComponent(city)}`} class="city-pill">
                {city}
              </a>
            ))}
            {cities.map(city => (
              <a href={`/designers?city=${encodeURIComponent(city)}`} class="city-pill">
                {city}
              </a>
            ))}
            {cities.map(city => (
              <a href={`/designers?city=${encodeURIComponent(city)}`} class="city-pill">
                {city}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Features Section */}
    <section class="features-section">
      <div class="features-header">
        <h2 class="features-title">Everything you need to discover design</h2>
        <p class="features-subtitle">
          Browse studios, save your favorites, and explore design projects from around the world.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-item">
          <h3 class="feature-title">Studio Directory</h3>
          <p class="feature-description">
            Browse 86+ independent design studios from major design cities. Each studio includes contact information, projects, and location details.
          </p>
        </div>

        <div class="feature-item">
          <h3 class="feature-title">Design Moodboard</h3>
          <p class="feature-description">
            Explore curated design objects and projects. Save your favorites to build your personal design collection.
          </p>
        </div>

        <div class="feature-item">
          <h3 class="feature-title">Interactive Map</h3>
          <p class="feature-description">
            Discover studios by location. See where independent designers are working around the world.
          </p>
        </div>
      </div>
    </section>

    {/* Feature Showcase - Collections */}
    <section class="feature-showcase">
      <div class="showcase-container">
        <div class="showcase-content">
          <span class="showcase-label">Collections</span>
          <h2 class="showcase-title">Save your favorites</h2>
          <p class="showcase-description">
            Create personal collections of studios and design objects. Access your saved items anytime, anywhere.
          </p>
          <a href="/login" class="showcase-btn">Get Started</a>
        </div>
        <div class="showcase-image">
          <div class="showcase-image-wrapper">
            <img 
              src="/images/moodboard.png" 
              alt="Design collections" 
              class="showcase-img"
              loading="lazy"
              data-skeleton
            />
            <div class="showcase-gradient-overlay"></div>
          </div>
        </div>
      </div>
    </section>

    {/* Feature Showcase - Map (Reversed) */}
    <section class="feature-showcase feature-showcase--reversed">
      <div class="showcase-container">
        <div class="showcase-content">
          <span class="showcase-label">Explore</span>
          <h2 class="showcase-title">Discover by location</h2>
          <p class="showcase-description">
            Use our interactive map to explore design studios across different cities. See the global distribution of independent design talent.
          </p>
          <a href="/map" class="showcase-btn">View Map</a>
        </div>
        <div class="showcase-image">
          <div class="showcase-image-wrapper">
            <img 
              src="/images/map.png" 
              alt="Design studio map" 
              class="showcase-img"
              loading="lazy"
              data-skeleton
            />
            <div class="showcase-gradient-overlay"></div>
          </div>
        </div>
      </div>
    </section>
    
    {/* Join Community Section */}
    <section class="community-section">
      <div class="community-content">
        <h2 class="community-title">Join the community</h2>
        <p class="community-subtitle">Be part of a growing network of independent designers and design lovers.</p>
        <a href="/login" class="btn-primary community-btn">Start collecting</a>
      </div>
    </section>

    <Footer />
  </Layout>
</PostHogLayout>
