    .mockup-img-placeholder { width: 80px; height: 80px; background: var(--color-white); border: 1px solid var(--color-stroke); border-radius: 12px; flex-shrink: 0; background-size: cover; background-position: center; }
    .mockup-content { flex: 1; }
    .mockup-title { font-weight: 400; font-size: 18px; margin-bottom: 4px; }
    .mockup-meta { font-size: 13px; color: var(--color-gray); margin-bottom: 8px; font-weight: 400; }
    .mockup-desc { font-size: 14px; color: var(--color-gray); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .payment-block-card {
      background: var(--color-white);
      border: 1px solid var(--color-stroke);
