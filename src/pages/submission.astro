    }
    .btn-back:hover { background: #EBEBED; border-color: #D4D4D8; }
    .btn-back-icon { display: block; }

    .preview-label { font-size: 11px; font-weight: 400; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-black); margin-bottom: 20px; }
    
    .listing-mockup {
      display: flex;
      gap: 20px;
      align-items: center;
      background: var(--color-white);
