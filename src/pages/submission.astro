    .suggest-captcha { margin-top: 24px; }
    .suggest-submit { width: 100%; justify-content: center; margin-top: 24px; }

    .btn-suggest-another {
      height: 48px;
      padding: 0 28px;
      background: var(--color-bg-secondary);
      color: var(--color-black);
      border: 1px solid var(--color-stroke);
      border-radius: 999px;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
