    }
    .upload-zone:hover { border-color: var(--color-black); background: var(--color-white); }
    
    .upload-ui { display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--color-gray); }
    .upload-ui svg { color: var(--color-black); }
    .upload-ui span { font-weight: 400; font-size: 14px; }

    .upload-preview { display: flex; align-items: center; gap: 16px; text-align: left; }
    .preview-thumb { width: 64px; height: 64px; border-radius: 8px; background-size: cover; background-position: center; flex-shrink: 0; }
    .preview-info { flex: 1; min-width: 0; }
    .file-name { display: block; font-size: 14px; font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 4px; }
    .btn-remove-file { font-size: 11px; font-weight: 400; text-transform: uppercase; color: var(--color-error); background: transparent; border: none; cursor: pointer; padding: 0; }

    .error-msg { font-size: 13px; color: var(--color-error); font-weight: 400; margin-top: 4px; }

    .step-actions { display: flex; align-items: center; gap: 16px; margin-top: 12px; }
    .step-actions.split { justify-content: space-between; }

    .btn-continue {
      height: 52px;
