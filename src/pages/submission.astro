---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const runtimeEnv = Astro.locals.runtime?.env;
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY || runtimeEnv?.TURNSTILE_SITE_KEY;
const turnstileSecretKey = import.meta.env.TURNSTILE_SECRET_KEY || runtimeEnv?.TURNSTILE_SECRET_KEY;

const user = Astro.locals.user;
---

<Layout
  title="List Your Design Studio on Acceso | Free Submission"
  description="Submit your studio to Acceso for free. Get discovered by people exploring independent design in your city."
>
    <Navbar />
    
    <main class="submission-page">
      {/* Background Atmosphere */}
      <div class="mesh-canvas">
        <div class="noise-grain"></div>
      </div>
      
      {user && (
      <div class="form-outer-container" id="submission-form-area" style="display:none;">
        <h1 class="sr-only">Submit your studio to Acceso</h1>
        <!-- Visual Progress Path -->
        <div class="step-path-container">
          <div class="step-nodes" id="step-track">
            <!-- Progress Fill (handled via JS for the yellow part) -->
            <div class="step-line-progress" id="progress-line" style="width: 0%;"></div>
            
            <div class="step-node active" data-step="1">
              <div class="node-circle">1</div>
              <span class="node-label">Info</span>
            </div>
            <div class="step-node" data-step="2">
              <div class="node-circle">2</div>
              <span class="node-label">Details</span>
            </div>
            <div class="step-node" data-step="3">
              <div class="node-circle">3</div>
              <span class="node-label">Review</span>
            </div>
          </div>
        </div>

        <form id="multi-step-form" class="submission-form">
          <!-- STEP 1: STUDIO INFO -->
          <div class="form-step active" data-step="1">
            <div class="step-header">
              <h2>Studio Info</h2>
              <p>Basic details to identify your practice.</p>
            </div>
            
            <div class="fields-grid split">
              <div class="input-group">
                <label>Studio Name</label>
                <input type="text" name="name" required placeholder="Name" />
              </div>
              <div class="input-group">
                <label>Website</label>
                <input type="url" name="website" required placeholder="https://..." />
              </div>
            </div>

            <div class="fields-grid split">
              <div class="input-group">
                <label>City</label>
                <input type="text" name="city" required placeholder="e.g. Milan" />
              </div>
              <div class="input-group">
                <label>Country</label>
                <input type="text" name="country" required placeholder="e.g. Italy" />
              </div>
            </div>

            <div class="input-group">
              <label>Full Address <span class="opt">(Optional)</span></label>
              <input type="text" name="address" placeholder="e.g. Via Tortona 31, 20144 Milan" />
              <p class="field-help">Note: If you don't provide an address, your studio won't be displayed on our map.</p>
            </div>

            <div class="input-group">
              <label>Instagram <span class="opt">(optional)</span></label>
              <input type="text" name="instagram" placeholder="@studio" />
            </div>

            <div class="step-actions split">
              <button type="button" class="btn-back" data-close-form aria-label="Back to overview">
                <svg class="btn-back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span>Back</span>
              </button>
              <button type="button" class="btn-continue" data-next="2">
                Continue
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>

          <!-- STEP 2: DETAILS -->
          <div class="form-step" data-step="2">
            <div class="step-header">
              <h2>Details</h2>
              <p>Add context and visual personality.</p>
            </div>

            <div class="input-group">
              <label>Description</label>
              <textarea name="description" rows="5" maxlength="1200" required placeholder="Tell us about the studio..."></textarea>
              <p class="field-help"><span id="desc-count">0</span>/1200 characters</p>
            </div>

            <div class="input-group">
              <label>Cover Image <span class="opt">(Max 1MB: PNG, JPG, WEBP)</span></label>
              <div class="upload-zone" id="upload-zone">
                <input type="file" id="cover-upload" name="cover_file" accept=".png, .jpg, .jpeg, .webp" hidden />
                <div class="upload-ui" id="upload-ui">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" /></svg>
                  <span>Click to upload image</span>
                </div>
                <div class="upload-preview hidden" id="upload-preview">
                  <div class="preview-thumb"></div>
                  <div class="preview-info">
                    <span class="file-name">filename.jpg</span>
                    <button type="button" class="btn-remove-file">Remove</button>
                  </div>
                </div>
              </div>
              <div id="upload-error" class="error-msg hidden">File is too large (max 1MB) or invalid format.</div>
            </div>

            <div class="step-actions split">
              <button type="button" class="btn-back" data-prev="1">
                <svg class="btn-back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span>Back</span>
              </button>
              <button type="button" class="btn-continue" data-next="3" id="build-review">
                Continue
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>

          <!-- STEP 3: REVIEW -->
          <div class="form-step" data-step="3">
            <div class="step-header">
              <h2>Review</h2>
              <p>Verify your information before submitting.</p>
            </div>

            <div class="preview-label">Preview of your listing</div>
            <div class="listing-mockup" id="listing-preview">
              <div class="mockup-img-placeholder"></div>
              <div class="mockup-content">
                <div class="mockup-title">Studio Name</div>
                <div class="mockup-meta">City, Country</div>
                <div class="mockup-desc">Description will appear here...</div>
              </div>
            </div>

            <div class="payment-block-card">
              <p class="submission-notify">
                You will be notified via email <strong>{user.email}</strong> on the status of your submission.
              </p>

              <div class="payment-notice">
                Your submission will be reviewed. It may take up to 24 hours to see your studio online.
              </div>

              <!-- Captcha Gate (anti-spam) -->
              <div class="captcha-block">
                <input type="hidden" name="captcha_token" id="captcha-token" />
                <p class="captcha-hint suggest-captcha-hint" id="captcha-hint">Complete the steps above to reveal the captcha.</p>
                <div
                  id="turnstile-container"
                  class="turnstile-container hidden"
                  data-sitekey={turnstileSiteKey || ''}
                ></div>
                <p class="captcha-error hidden" id="captcha-error">Please complete the captcha.</p>
                {(!turnstileSiteKey || !turnstileSecretKey) && (
                  <p class="captcha-hint">
                    Captcha is not configured. Set <code>TURNSTILE_SITE_KEY</code> and <code>TURNSTILE_SECRET_KEY</code>.
                  </p>
                )}
              </div>
            </div>

            <div class="step-actions split">
              <button type="button" class="btn-back" data-prev="2">
                <svg class="btn-back-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span>Back</span>
              </button>
              <button type="submit" class="btn-continue final-cta">
                Submit for Review
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>

          <!-- STEP 4: SUCCESS -->
          <div class="form-step" data-step="4">
            <div class="success-screen">
              <div class="success-icon">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="var(--color-yellow)" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
              </div>
              <h2 class="success-title">Submission Received</h2>
              <p class="success-p">Thank you! We've received your data. Our team will review it and notify you by email within 24 hours.</p>
              
              <div class="success-actions">
                <a href="/" class="btn-continue">
                  Go to Homepage
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          </div>
        </form>
      </div>
      )}

      <div class="sub-layout" id="submission-overview">
        <div class="sub-split">
          <div class="sub-col sub-col-submit active" data-panel="submit">
            <section class="sub-hero">
              <div class="sub-hero-content">
                <h1 class="sub-hero-title">Put your studio<br>on the map</h1>
                <p class="sub-hero-sub">Be included in cities, searches, and curated listings.</p>
              <div class="sub-hero-ctas">
                {user ? (
                  <button type="button" class="sub-hero-cta" id="toggle-submission-btn">
                    Submit for free
                  </button>
                ) : (
                  <a href="/login?redirect=/submission" class="sub-hero-cta">
                    Submit for free
                  </a>
                )}
                <p class="sub-hero-disclaimer">The process takes less than a minute. After logging in, you can submit your studio.</p>
              </div>
              </div>
            </section>

            <section class="sub-section">
              <div class="sub-block sub-card">
                <span class="sub-label">Why studios join</span>
                <ul class="sub-perks">
                  <li>✦ Free permanent listing</li>
                  <li>✦ Featured on the map, in search, and in curated collections</li>
                  <li>✦ Reviewed to keep the platform focused and high quality</li>
                  <li>✦ Reach an audience actively looking for independent design</li>
                  <li>✦ Become part of a growing international design network</li>
                </ul>
              </div>
            </section>
          </div>

          <div class="sub-col sub-col-suggest" data-panel="suggest">
            <section class="sub-hero">
              <div class="sub-hero-content">
                <h2 class="sub-hero-title">Have a<br>recommendation?</h2>
                <p class="sub-hero-sub sub-hero-sub-wide">Know a designer, school, museum, award, or fair that should be on Acceso? Send us a suggestion. You don't need to provide all the details. We'll take care of the research before publishing anything.</p>
              </div>
            </section>

            <section class="sub-section">
              <div class="sub-section-inner">
                <form id="suggest-form" class="suggest-form">
                  <div class="suggest-card">
                    <div class="fields-grid">
                      <div class="input-group">
                        <label for="suggest_type">Type</label>
                        <div class="select-wrap custom-select" id="suggest-type-select" data-name="suggest_type">
                          <button type="button" class="cs-trigger" aria-haspopup="listbox" aria-expanded="false">
                            <span class="cs-value" data-placeholder="Select a type">Designer</span>
                            <svg class="select-chevron cs-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </button>
                          <ul class="cs-list" role="listbox" tabindex="-1">
                            <li class="cs-option" role="option" data-value="Designer" aria-selected="true">Designer</li>
                            <li class="cs-option" role="option" data-value="School" aria-selected="false">School</li>
                            <li class="cs-option" role="option" data-value="Museum" aria-selected="false">Museum</li>
                            <li class="cs-option" role="option" data-value="Award" aria-selected="false">Award</li>
                            <li class="cs-option" role="option" data-value="Fair" aria-selected="false">Fair</li>
                          </ul>
                          <select name="suggest_type" id="suggest_type" required aria-required="true" class="cs-native">
                            <option value="Designer">Designer</option>
                            <option value="School">School</option>
                            <option value="Museum">Museum</option>
                            <option value="Award">Award</option>
                            <option value="Fair">Fair</option>
                          </select>
                        </div>
                      </div>

                      <div class="input-group">
                        <label for="suggest_name">Name</label>
                        <input type="text" name="suggest_name" id="suggest_name" required aria-required="true" placeholder="Name of place" />
                      </div>

                      <div class="fields-grid split">
                        <div class="input-group">
                          <label for="suggest_city">City</label>
                          <input type="text" name="suggest_city" id="suggest_city" required aria-required="true" placeholder="e.g. Milan" />
                        </div>
                        <div class="input-group">
                          <label for="suggest_website">Website <span class="opt">(optional)</span></label>
                          <input type="url" name="suggest_website" id="suggest_website" placeholder="https://..." />
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="captcha-block suggest-captcha">
                    <input type="hidden" name="suggest_captcha_token" id="suggest-captcha-token" />
                    <p class="captcha-hint suggest-captcha-hint" id="suggest-captcha-hint">Fill in the required fields above to reveal the captcha.</p>
                    <div id="suggest-turnstile" class="turnstile-container hidden" data-sitekey={turnstileSiteKey || ''}></div>
                    <p class="captcha-error hidden" id="suggest-captcha-error">Please complete the captcha.</p>
                  </div>

                  <button type="submit" class="btn-continue suggest-submit">
                    Send Suggestion
                  </button>
                  <p class="suggest-error hidden" id="suggest-error"></p>
                </form>

                <div id="suggest-success" class="success-screen hidden">
                  <div class="success-icon" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </div>
                  <h3 class="success-h" style="font-size:22px;margin:0 0 12px;">Thank you!</h3>
                  <p class="success-p" style="font-size:15px;max-width:320px;margin:0 auto;">Your suggestions have been received. We'll review them and research each place before adding it to Acceso.</p>
                  <button type="button" class="btn-suggest-another" id="suggest-another">
                    Send another
                  </button>
                </div>
              </div>
            </section>
          </div>
        </div>

        <!-- Mobile tab switcher (bottom pill, mirrors .map-filters on the map page) -->
        <div class="sub-mobile-tabs" role="tablist" aria-label="Submission page sections">
          <button type="button" class="sub-tab-btn active" data-tab="submit" role="tab" aria-selected="true">Submit studio</button>
          <button type="button" class="sub-tab-btn" data-tab="suggest" role="tab" aria-selected="false">Suggest place</button>
        </div>
      </div>

      <svg style="display: none;">
        <filter id="grainyNoise">
          <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="3" stitchTiles="stitch" />
          <feColorMatrix type="saturate" values="0" />
        </filter>
      </svg>
    </main>

    <Footer />
  </Layout>

  <style>
    .submission-page {
      background: var(--color-white);
      color: var(--color-black);
      min-height: 100vh;
      position: relative;
      overflow-x: clip;
      font-family: var(--font-sans);
    }

    /* Consistent Background */
    .mesh-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: var(--color-white);
      background-image: 
        linear-gradient(to top, var(--color-white) 0%, transparent 40%),
        radial-gradient(
          ellipse 150% 160% at 50% 165%,
          #F3E8FF 0%,
          rgba(243, 232, 255, 0.4) 30%,
          rgba(243, 232, 255, 0.1) 60%,
          transparent 90%
        );
    }
    .noise-grain { position: absolute; inset: 0; opacity: 0.02; filter: url(#grainyNoise); mix-blend-mode: overlay; }

    .form-outer-container {
      position: relative;
      z-index: 10;
      max-width: 640px;
      margin: 0 auto;
      padding: var(--page-top-spacing) 24px 140px;
    }

    /* LOGGED-OUT SPLIT: two equal columns */
    .sub-split {
      position: relative;
      z-index: 10;
      display: flex;
      align-items: flex-start;
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: var(--page-top-spacing) 40px 120px;
      gap: 64px;
      box-sizing: border-box;
    }

    .sub-col {
      flex: 1 1 0;
      min-width: 0;
      box-sizing: border-box;
    }

    .sub-hero {
      position: relative;
      z-index: 10;
    }

    .sub-hero-content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .sub-hero-title {
      font-family: var(--font-sans);
      font-size: clamp(48px, 5.5vw, 80px);
      font-weight: 400;
      line-height: 1.0;
      letter-spacing: -0.08em;
      color: var(--color-black);
      margin: 0 0 18px;
    }

    .sub-hero-sub {
      font-size: 18px;
      line-height: 1.5;
      color: var(--color-gray);
      margin: 0 0 32px;
      max-width: 38ch;
    }

    .sub-hero-ctas {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      flex-wrap: wrap;
    }
    .sub-hero-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      height: 48px;
      padding: 0 24px;
      background: var(--color-black);
      color: var(--color-white);
      border: none;
      border-radius: 10px;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 15px;
      text-decoration: none;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    .sub-hero-cta:hover { opacity: 0.9; }
    .sub-hero-note {
      font-size: 14px;
      color: var(--color-gray);
      margin: 0;
    }
    .sub-hero-note a {
      color: var(--color-black);
      font-weight: 700;
      text-decoration: underline;
    }
    .sub-hero-disclaimer {
      font-size: 14px;
      line-height: 1.5;
      color: var(--color-gray);
      margin: 0;
      max-width: 32ch;
    }

    .sub-hero-sub-wide {
      max-width: 46ch;
    }

    /* CONTENT SECTIONS */
    .sub-section {
      position: relative;
      z-index: 10;
      padding-top: 24px;
    }

    .sub-section-inner {
      max-width: 720px;
      display: flex;
      flex-direction: column;
      gap: 56px;
    }

    .sub-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    /* "Why studios join" nested card */
    .sub-card {
      background: var(--color-white);
      border-radius: 20px;
      padding: 32px;
      width: 100%;
      box-sizing: border-box;
    }

    .sub-label {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-gray);
      margin-bottom: 22px;
    }

    .sub-body {
      font-family: var(--font-sans);
      font-size: 17px;
      line-height: 1.5;
      color: var(--color-gray);
      margin: 0 0 16px;
      max-width: 60ch;
    }
    .sub-body:last-child { margin-bottom: 0; }

    .sub-emphasis {
      font-size: 22px;
      line-height: 1.3;
      color: var(--color-black);
      font-weight: 400;
      letter-spacing: -0.01em;
      margin-bottom: 10px;
    }
    .sub-emphasis:last-of-type { margin-bottom: 20px; }

    .sub-perks {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .sub-perks li {
      font-family: var(--font-sans);
      font-size: 16px;
      line-height: 1.5;
      color: var(--color-black);
      padding-left: 4px;
    }
    .perk-hl {
      background: var(--color-yellow);
      padding: 0 4px;
      border-radius: 4px;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    /* MOBILE TAB SWITCHER (pill, fixed to bottom, mirrors .map-filters) */
    .sub-mobile-tabs {
      display: none;
    }

    /* DESKTOP ONLY: yellow background on the left (submit) column content */
    @media (min-width: 901px) {
      .sub-col-submit {
        background: rgba(237, 255, 119, 0.5);
        border-radius: 24px;
        padding: 56px 48px 48px 48px;
        align-self: stretch;
        display: flex;
        flex-direction: column;
      }
      /* Push the "Why studios join" card to the bottom of the yellow column */
      .sub-col-submit .sub-hero {
        flex: 1 1 auto;
      }
      .sub-col-submit .sub-card {
        margin-top: 48px;
      }
    }

    @media (max-width: 900px) {
      .sub-layout {
        display: flex;
        flex-direction: column;
        padding-bottom: 96px; /* clear the fixed bottom pill */
      }
      .sub-split {
        flex-direction: column;
        gap: 0;
        padding: var(--page-top-spacing) 24px 40px;
      }
      .sub-col {
        display: none;
        width: 100%;
      }
      .sub-col.active {
        display: block;
      }
      .sub-section {
        padding-top: 24px;
      }
      .sub-section-inner {
        gap: 40px;
      }
      .sub-emphasis {
        font-size: 20px;
      }
      .suggest-card .fields-grid.split { grid-template-columns: 1fr; }
      .suggest-submit { height: 52px; font-size: 16px; }

      /* Mobile: keep the "Why studios join" card left-aligned and flush with content */
      .sub-card {
        padding: 0;
        background: transparent;
        align-items: flex-start;
        text-align: left;
      }
      .sub-card .sub-label,
      .sub-card .sub-perks,
      .sub-card .sub-perks li {
        text-align: left;
        align-items: flex-start;
      }

      .sub-mobile-tabs {
        position: fixed;
        bottom: max(24px, env(safe-area-inset-bottom, 0px) + 16px);
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        flex-wrap: nowrap;
        gap: 6px;
        padding: 6px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 999px;
        border: 1px solid var(--color-stroke);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      }
      .sub-tab-btn {
        pointer-events: auto;
        padding: 11px 18px;
        border-radius: 999px;
        border: none;
        background: transparent;
        color: var(--color-text-muted);
        font-family: var(--font-sans);
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        cursor: pointer;
        transition: color 0.2s ease, background 0.2s ease;
      }
      .sub-tab-btn:hover {
        color: var(--color-black);
        background: var(--color-bg-secondary);
      }
      .sub-tab-btn.active {
        background: var(--color-yellow);
        color: var(--color-black);
      }
    }

    /* VISUAL STEP PATH - INVINCIBLE VERSION */
    .step-path-container {
      position: relative;
      margin-bottom: 64px;
      padding: 0 20px;
    }
    
    .step-nodes { 
      position: relative; 
      z-index: 10; 
      display: flex; 
      justify-content: space-between; 
      width: 100%;
    }

    /* THE BACKGROUND LINE: now a pseudo-element of the node container itself */
    /* This ensures it EXACTLY matching the bounds of Node 1 center to Node 3 center */
    .step-nodes::before {
      content: "";
      position: absolute;
      top: 20px;
      left: 21px; /* Center of first node circle */
      right: 21px; /* Center of last node circle */
      height: 2px;
      background: rgba(0,0,0,0.06);
      z-index: -1; /* Behind circles */
    }

    .step-line-progress { 
      position: absolute; 
      top: 20px; 
      left: 21px; 
      /* width is handled by JS but will be relative to this container now */
      height: 2px; 
      background: var(--color-black); 
      z-index: 0; /* Above bg line, behind nodes */
      transition: width 0.5s ease; 
    }
    
    .step-node { 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      gap: 12px; 
      width: 42px; /* Fixed width prevents label overflow from shifting circle position */
      flex-shrink: 0;
      position: relative;
    }
    
    .node-circle {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--color-white);
      border: 2px solid var(--color-black);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 400;
      color: var(--color-black);
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .node-label { 
      font-size: 11px; 
      font-weight: 400; 
      text-transform: uppercase; 
      color: var(--color-black); 
      letter-spacing: 0.1em; 
      white-space: nowrap; 
      position: absolute;
      top: 54px;
      left: 50%;
      transform: translateX(-50%);
    }
    
    .step-node.active .node-circle { border-color: var(--color-black); background: var(--color-black); color: var(--color-white); transform: scale(1.1); box-shadow: 0 0 20px rgba(0, 0, 0, 0.15); }
    .step-node.active .node-label { color: var(--color-black); }
    .step-node.completed .node-circle { border-color: var(--color-black); background: var(--color-white); color: var(--color-black); }

    /* FORM STEPS */
    .form-step { display: none; flex-direction: column; gap: 40px; }
    .form-step.active { display: flex; animation: stepFadeIn 0.5s ease-out; }

    @keyframes stepFadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .step-header h2 { font-family: var(--font-sans); font-size: 38px; font-weight: 400; margin-bottom: 8px; letter-spacing: 0; }
    .step-header p { color: var(--color-gray); font-size: 16px; }

    .fields-grid { display: flex; flex-direction: column; gap: 24px; }
    .fields-grid.split { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    .input-group { display: flex; flex-direction: column; gap: 10px; }
    .input-group label { font-size: 13px; font-weight: 400; color: var(--color-black); text-transform: uppercase; letter-spacing: 0.05em; }
    .input-group label .opt { font-weight: 400; text-transform: lowercase; }
    
    .input-group input, .input-group textarea, .input-group select {
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-stroke);
      border-radius: 12px;
      padding: 16px 20px;
      color: var(--color-black);
      font-size: 16px;
      font-family: var(--font-sans);
      transition: border-color 0.2s ease;
    }
    .input-group input::placeholder, .input-group textarea::placeholder { color: var(--color-gray); }
    .input-group input:focus, .input-group textarea:focus, .input-group select:focus { border-color: var(--color-black); outline: none; }

    /* Custom select (Type dropdown) — fully styled custom dropdown */
    .select-wrap {
      position: relative;
    }

    /* Hide native select visually but keep it accessible/functional */
    .custom-select .cs-native {
      position: absolute;
      opacity: 0;
      width: 1px;
