    .submission-notify { font-size: 15px; font-weight: 400; color: var(--color-black); text-align: center; margin: 0; line-height: 1.5; }
    .submission-notify strong { font-weight: 700; }

    .payment-notice { font-size: 13px; font-weight: 400; color: var(--color-gray); text-align: center; font-style: italic; }

    @media (max-width: 640px) {
