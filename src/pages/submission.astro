    }
    .btn-continue:hover { background: var(--color-yellow); filter: brightness(0.93); }

    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex: none;
      height: 52px;
      padding: 0 22px;
      border: 1px solid var(--color-stroke);
      border-radius: 999px;
      background: var(--color-bg-secondary);
      color: var(--color-black);
      font-family: var(--font-sans);
      font-size: 15px;
