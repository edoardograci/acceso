      border-color: #D4D4D8;
      color: var(--color-black);
    }
  </style>

  <!-- Turnstile (explicit render) -->
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

  <script>
    const steps = document.querySelectorAll('.form-step');
    const nodes = document.querySelectorAll('.step-node');
    const progressLine = document.getElementById('progress-line');
    const form = document.getElementById('multi-step-form');

    const captchaTokenInput = document.getElementById('captcha-token') || null;
    const captchaError = document.getElementById('captcha-error') || null;
    const turnstileContainer = document.getElementById('turnstile-container') || null;
    const turnstileSiteKey = turnstileContainer?.dataset.sitekey || '';
    let turnstileWidgetId = null;

    // Turnstile callbacks (referenced by `data-callback` / `data-expired-callback`)
    (window).onTurnstileVerified = (token) => {
      if (captchaTokenInput) captchaTokenInput.value = token;
      captchaError?.classList.add('hidden');
    };
    (window).onTurnstileExpired = () => {
      if (captchaTokenInput) captchaTokenInput.value = '';
      // Keep error state visible only when the user attempts to submit.
    };
    
    const fileInput = document.getElementById('cover-upload');
    const uploadZone = document.getElementById('upload-zone');
    const uploadUI = document.getElementById('upload-ui');
    const uploadPreview = document.getElementById('upload-preview');
    const thumb = uploadPreview?.querySelector('.preview-thumb');
    const fileNameDisplay = uploadPreview?.querySelector('.file-name');
    const removeBtn = uploadPreview?.querySelector('.btn-remove-file');
    const uploadError = document.getElementById('upload-error');

    let uploadedFile = null;

    function updateStepUI(step) {
      steps.forEach((s) => {
        s.classList.remove('active');
        if (s.dataset.step === String(step)) {
          s.classList.add('active');
        }
      });

      // Render Turnstile only when step 3 is visible (it won't render correctly in display:none),
      // and only once the required fields have been filled.
      if (step === 3) {
        maybeRenderTurnstile();
      }

      // Update Path
      // Now using relative width inside the flex container
      const totalSteps = 3;
      const progressPercent = ((step - 1) / (totalSteps - 1)) * 100;
      
      if (progressLine) {
        // Track width is TotalWidth - 42px (radius on both ends)
        // We set the progress line width based on that ratio
        progressLine.style.width = `calc(${progressPercent}% - ${(progressPercent/100) * 42}px)`;
      }

      nodes.forEach((n, idx) => {
        const nodeStep = idx + 1;
        n.classList.remove('active', 'completed');
        if (nodeStep === step) n.classList.add('active');
        if (nodeStep < step) n.classList.add('completed');
      });

      window.scrollTo(0, 0);
    }

    // True once all required submission fields are filled (so the captcha
    // only appears at the end, after the user has done the work).
    function submissionFieldsReady() {
      const fd = new FormData(form);
      const name = String(fd.get('name') || '').trim();
      const website = String(fd.get('website') || '').trim();
      const city = String(fd.get('city') || '').trim();
      const country = String(fd.get('country') || '').trim();
      const description = String(fd.get('description') || '').trim();
      return Boolean(name && website && city && country && description && uploadedFile);
    }

    // Reveal the captcha only after the required fields are filled.
    function maybeRenderTurnstile() {
      if (!turnstileContainer || !turnstileSiteKey) return;
      if (!submissionFieldsReady()) return;
      document.getElementById('captcha-hint')?.classList.add('hidden');
      turnstileContainer.classList.remove('hidden');
      ensureTurnstileRendered();
    }

    function ensureTurnstileRendered() {
      if (!turnstileContainer) return;
      if (!turnstileSiteKey) return;
      if (turnstileWidgetId) return;

      const start = Date.now();
      const tryRender = () => {
        const t = window.turnstile;
        if (t && typeof t.render === 'function') {
          turnstileContainer.innerHTML = '';
          try {
            turnstileWidgetId = t.render(turnstileContainer, {
              sitekey: turnstileSiteKey,
              theme: 'light',
              callback: (token) => (window).onTurnstileVerified(token),
              'expired-callback': () => (window).onTurnstileExpired(),
              'error-callback': (err) => {
                turnstileWidgetId = null;
                const code =
                  typeof err === 'string'
                    ? err
                    : (err?.code || err?.errorCode || err?.message || null);

                if (captchaError) {
                  captchaError.textContent = code
                    ? `Captcha failed to load (${code}). Check Turnstile domain/site configuration and refresh.`
                    : 'Captcha failed to load. Check Turnstile domain/site configuration and refresh.';
                  captchaError.classList.remove('hidden');
                }
              },
            });
          } catch {
            turnstileWidgetId = null;
            if (captchaError) {
              captchaError.textContent = 'Captcha failed to render. Check Turnstile domain/site configuration and refresh.';
              captchaError.classList.remove('hidden');
            }
          }
          return;
        }

        if (Date.now() - start > 6000) {
          turnstileWidgetId = null;
          if (captchaError) {
            captchaError.textContent = 'Captcha did not load. If this continues, check Turnstile domain/site configuration and ensure requests to challenges.cloudflare.com are allowed.';
            captchaError.classList.remove('hidden');
          }
          return;
        }
        requestAnimationFrame(tryRender);
      };

      requestAnimationFrame(tryRender);
    }

    // Navigation
    document.querySelectorAll('.btn-continue[data-next]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const step = e.currentTarget.closest('.form-step');
        if (step) {
          const stepNumber = Number(step.dataset.step || '1');
          const requiredFields = step.querySelectorAll('input[required], textarea[required]');
          let allValid = true;
          requiredFields.forEach((field) => {
            if (!field.checkValidity()) {
              field.reportValidity();
              allValid = false;
            }
          });
          if (stepNumber === 2 && !uploadedFile) {
            uploadError?.classList.remove('hidden');
            if (uploadError) uploadError.textContent = 'Please upload a cover image before continuing.';
            allValid = false;
          }
          if (!allValid) return;
        }

        const next = e.currentTarget.dataset.next;
        if (next) updateStepUI(parseInt(next));
      });
    });

    document.querySelectorAll('.btn-back').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        if (target.hasAttribute('data-close-form')) {
          const formArea = document.getElementById('submission-form-area');
          const overview  = document.getElementById('submission-overview');
          if (formArea) formArea.style.display = 'none';
          if (overview) overview.style.display = '';
          return;
        }
        const prev = target.dataset.prev;
        if (prev) updateStepUI(parseInt(prev));
      });
    });

    const toggleBtn = document.getElementById('toggle-submission-btn');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const formArea = document.getElementById('submission-form-area');
        const overview  = document.getElementById('submission-overview');
        if (formArea && overview) {
          overview.style.display = 'none';
          formArea.style.display = '';
          updateStepUI(1);
          formArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }

    // File Upload Logic
    uploadZone?.addEventListener('click', () => fileInput?.click());

    fileInput?.addEventListener('change', (e) => {
      const target = e.target;
      const file = target.files?.[0];
      if (!file) return;

      // Validation
      const maxSize = 1024 * 1024; // 1MB
      const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];

      if (file.size > maxSize || !allowedTypes.includes(file.type)) {
        uploadError?.classList.remove('hidden');
        return;
      }

      uploadError?.classList.add('hidden');
      if (uploadError) uploadError.textContent = 'File is too large (max 1MB) or invalid format.';
      uploadedFile = file;

      // UI Switch
      uploadUI?.classList.add('hidden');
      uploadPreview?.classList.remove('hidden');
      if (fileNameDisplay) fileNameDisplay.textContent = file.name;

      const reader = new FileReader();
      reader.onload = (re) => {
        if (thumb) thumb.style.backgroundImage = `url(${re.target?.result})`;
      };
      reader.readAsDataURL(file);
    });

    removeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      uploadedFile = null;
      if (fileInput) fileInput.value = '';
      uploadUI?.classList.remove('hidden');
      uploadPreview?.classList.add('hidden');
    });

    // Preview Logic
    const buildPreviewBtn = document.getElementById('build-review');
    buildPreviewBtn?.addEventListener('click', () => {
      const formData = new FormData(form);
      const preview = document.getElementById('listing-preview');
      if (preview) {
        const mockupTitle = preview.querySelector('.mockup-title');
        const mockupMeta = preview.querySelector('.mockup-meta');
        const mockupDesc = preview.querySelector('.mockup-desc');
        const previewIcon = preview.querySelector('.mockup-img-placeholder');
        if (mockupTitle) mockupTitle.textContent = String(formData.get('name') || 'Studio Name');
        if (mockupMeta) mockupMeta.textContent = `${formData.get('city')}, ${formData.get('country')}`;
        if (mockupDesc) mockupDesc.textContent = String(formData.get('description') || 'Description will appear here...');
        if (previewIcon) {
          if (uploadedFile) {
            const reader = new FileReader();
            reader.onload = (re) => {
              previewIcon.style.backgroundImage = `url(${re.target?.result})`;
            };
            reader.readAsDataURL(uploadedFile);
          }
        }
      }
    });

    // Final Submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const token = captchaTokenInput?.value || '';
      if (!token) {
        captchaError?.classList.remove('hidden');
        return;
      }
      captchaError?.classList.add('hidden');

      const descriptionValue = String((new FormData(form).get('description') || '')).trim();
      if (!uploadedFile) {
        uploadError?.classList.remove('hidden');
        if (uploadError) uploadError.textContent = 'Please upload a cover image before submitting.';
        updateStepUI(2);
        return;
      }
      if (!descriptionValue || descriptionValue.length > 1200) {
        alert('Description is required and must be 1200 characters or fewer.');
        updateStepUI(2);
        return;
      }

      const btn = form.querySelector('.final-cta');
      if (!btn) return;
      const originalHtml = btn.innerHTML;
      btn.innerHTML = 'Submitting...';
      btn.disabled = true;

      (async () => {
        let uiFailsafeId = null;
        try {
          const payload = new FormData(form);
          if (uploadedFile) payload.set('cover_file', uploadedFile);
          uiFailsafeId = window.setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
          }, 65000);
          const res = await fetch('/api/submissions', {
            method: 'POST',
            body: payload,
            credentials: 'include'
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(json?.error || 'Submission failed');
          }
          updateStepUI(4);
          const stepsCount = document.querySelector('.step-path-container');
          if (stepsCount) stepsCount.style.opacity = '0';
        } catch (err) {
          alert(err?.message || 'Submission failed. Please try again.');
          btn.innerHTML = originalHtml;
          btn.disabled = false;
        } finally {
          if (uiFailsafeId) window.clearTimeout(uiFailsafeId);
        }
      })();
    });

    const descriptionField = form?.querySelector('textarea[name="description"]') || null;
    const descCount = document.getElementById('desc-count');
    const syncDescCount = () => {
      if (!descriptionField || !descCount) return;
      descCount.textContent = String(descriptionField.value.length);
    };
    descriptionField?.addEventListener('input', syncDescCount);
    syncDescCount();

    /* ===== SUGGEST A PLACE (inline form) ===== */
    const suggestForm = document.getElementById('suggest-form') || null;
    const suggestSuccess = document.getElementById('suggest-success');
    const suggestError = document.getElementById('suggest-error');
    const suggestCaptchaTokenInput = document.getElementById('suggest-captcha-token') || null;
    const suggestCaptchaError = document.getElementById('suggest-captcha-error');
    const suggestTurnstileContainer = document.getElementById('suggest-turnstile') || null;
    const suggestSiteKey = suggestTurnstileContainer?.dataset.sitekey || '';
    let suggestTurnstileWidgetId = null;

    function resetSuggestCaptcha() {
      if (suggestTurnstileWidgetId && window.turnstile?.reset) {
        try {
          window.turnstile.reset(suggestTurnstileWidgetId);
        } catch {}
      }
      if (suggestCaptchaTokenInput) suggestCaptchaTokenInput.value = '';
      suggestCaptchaError?.classList.add('hidden');
    }

    function suggestFieldsReady() {
      const fd = new FormData(suggestForm);
      const type = String(fd.get('suggest_type') || '').trim();
      const name = String(fd.get('suggest_name') || '').trim();
      const city = String(fd.get('suggest_city') || '').trim();
      return Boolean(type && name && city);
    }

    function renderSuggestTurnstile() {
      if (!suggestTurnstileContainer || !suggestSiteKey) return;
      if (suggestTurnstileWidgetId) return;
      if (!suggestFieldsReady()) return;
      const captchaHint = document.getElementById('suggest-captcha-hint');
      captchaHint?.classList.add('hidden');
      suggestTurnstileContainer.classList.remove('hidden');
      const start = Date.now();
      const tryRender = () => {
        const t = window.turnstile;
        if (t && typeof t.render === 'function') {
          suggestTurnstileContainer.innerHTML = '';
          try {
            suggestTurnstileWidgetId = t.render(suggestTurnstileContainer, {
              sitekey: suggestSiteKey,
              theme: 'light',
              callback: (token) => {
                if (suggestCaptchaTokenInput) suggestCaptchaTokenInput.value = token;
                suggestCaptchaError?.classList.add('hidden');
              },
              'expired-callback': () => {
                if (suggestCaptchaTokenInput) suggestCaptchaTokenInput.value = '';
              },
            });
          } catch {
            suggestTurnstileWidgetId = null;
          }
          return;
        }
        if (Date.now() - start > 6000) return;
        requestAnimationFrame(tryRender);
      };
      requestAnimationFrame(tryRender);
    }

    function maybeRenderSuggestTurnstile() {
      if (suggestFieldsReady()) renderSuggestTurnstile();
    }

    const csRoot = document.getElementById('suggest-type-select');
    const csTrigger = csRoot?.querySelector('.cs-trigger');
    const csValue = csRoot?.querySelector('.cs-value');
    const csOptions = Array.from(csRoot?.querySelectorAll('.cs-option') || []);
    const csNative = csRoot?.querySelector('.cs-native');
    let csActiveIndex = csOptions.findIndex((o) => o.getAttribute('aria-selected') === 'true');
    if (csActiveIndex < 0) csActiveIndex = 0;

    function csSetValue(value) {
      csOptions.forEach((o) => {
        const selected = o.dataset.value === value;
        o.setAttribute('aria-selected', selected ? 'true' : 'false');
      });
      if (csValue) csValue.textContent = value;
      if (csNative) csNative.value = value;
    }

    function csOpen() {
      csRoot?.classList.add('open');
      csTrigger?.setAttribute('aria-expanded', 'true');
      csOptions.forEach((o, i) => o.classList.toggle('active', i === csActiveIndex));
    }

    function csClose() {
      csRoot?.classList.remove('open');
      csTrigger?.setAttribute('aria-expanded', 'false');
      csOptions.forEach((o) => o.classList.remove('active'));
    }

    csTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (csRoot?.classList.contains('open')) csClose();
      else csOpen();
    });

    csOptions.forEach((opt, i) => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        csSetValue(opt.dataset.value || '');
        csActiveIndex = i;
        csClose();
        csTrigger?.focus();
      });
      opt.addEventListener('mousemove', () => {
        if (csRoot?.classList.contains('open')) {
          csActiveIndex = i;
          csOptions.forEach((o, j) => o.classList.toggle('active', j === i));
        }
      });
    });

    csTrigger?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!csRoot?.classList.contains('open')) { csOpen(); return; }
        csActiveIndex = e.key === 'ArrowDown'
          ? (csActiveIndex + 1) % csOptions.length
          : (csActiveIndex - 1 + csOptions.length) % csOptions.length;
        csOptions.forEach((o, j) => o.classList.toggle('active', j === csActiveIndex));
      } else if (e.key === 'Enter' || e.key === ' ') {
        if (csRoot?.classList.contains('open')) {
          e.preventDefault();
          csSetValue(csOptions[csActiveIndex].dataset.value || '');
          csClose();
        }
      } else if (e.key === 'Escape') {
        csClose();
      }
    });

    document.addEventListener('click', (e) => {
      if (csRoot && !csRoot.contains(e.target)) csClose();
    });

    if (csNative) {
      csNative.addEventListener('change', () => {
        csSetValue(csNative.value);
        maybeRenderSuggestTurnstile();
      });
    }

    const suggestRequiredInputs = [
      document.getElementById('suggest_name'),
      document.getElementById('suggest_city'),
      document.getElementById('suggest_website'),
    ].filter(Boolean);

    suggestRequiredInputs.forEach((input) => {
      input.addEventListener('input', maybeRenderSuggestTurnstile);
    });

    /* ===== MOBILE TAB SWITCHER (Submit studio / Suggest place) ===== */
    const subTabBtns = document.querySelectorAll('.sub-tab-btn');
    const subCols = document.querySelectorAll('.sub-col');

    function switchSubTab(tab) {
      subCols.forEach((col) => col.classList.toggle('active', col.dataset.panel === tab));
      subTabBtns.forEach((btn) => {
        const isActive = btn.dataset.tab === tab;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
      if (tab === 'suggest') maybeRenderSuggestTurnstile();
    }

    subTabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        if (tab) switchSubTab(tab);
      });
    });

    suggestForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      suggestError?.classList.add('hidden');

      const token = suggestCaptchaTokenInput?.value || '';
      if (suggestSiteKey && !token) {
        suggestCaptchaError?.classList.remove('hidden');
        return;
      }
      suggestCaptchaError?.classList.add('hidden');

      const fd = new FormData(suggestForm);
      const suggestion = {
        type: String(fd.get('suggest_type') || 'Designer').trim(),
        name: String(fd.get('suggest_name') || '').trim(),
        city: String(fd.get('suggest_city') || '').trim(),
        website: String(fd.get('suggest_website') || '').trim(),
      };

      if (!suggestion.name || !suggestion.city) {
        if (suggestError) {
          suggestError.textContent = 'Please provide at least a name and a city.';
          suggestError.classList.remove('hidden');
        }
        return;
      }

      const submitBtn = suggestForm.querySelector('.suggest-submit');
      const originalHtml = submitBtn?.innerHTML || 'Send Suggestion';
      if (submitBtn) {
        submitBtn.innerHTML = 'Sending...';
        submitBtn.disabled = true;
      }

      (async () => {
        try {
          const payload = new FormData();
          payload.set('captcha_token', token);
          payload.set('suggestions', JSON.stringify([suggestion]));

          const res = await fetch('/api/suggestions', {
            method: 'POST',
            body: payload,
            credentials: 'include',
          });
          const jsonRes = await res.json().catch(() => ({}));
          if (!res.ok) {
            throw new Error(jsonRes?.error || 'Suggestion failed');
          }

          suggestForm.classList.add('hidden');
          suggestSuccess?.classList.remove('hidden');
        } catch (err) {
          if (suggestError) {
            suggestError.textContent = err?.message || 'Something went wrong. Please try again.';
            suggestError.classList.remove('hidden');
          }
          resetSuggestCaptcha();
        } finally {
          if (submitBtn) {
            submitBtn.innerHTML = originalHtml;
            submitBtn.disabled = false;
          }
        }
      })();
    });

    const suggestAnotherBtn = document.getElementById('suggest-another');
    suggestAnotherBtn?.addEventListener('click', () => {
      suggestForm?.reset();
      csSetValue(csOptions[0].dataset.value || '');
      csActiveIndex = 0;
      suggestError?.classList.add('hidden');
      suggestSuccess?.classList.add('hidden');
      suggestForm?.classList.remove('hidden');
      suggestTurnstileWidgetId = null;
      suggestTurnstileContainer?.classList.add('hidden');
      suggestTurnstileContainer && (suggestTurnstileContainer.innerHTML = '');
      document.getElementById('suggest-captcha-hint')?.classList.remove('hidden');
      if (suggestCaptchaTokenInput) suggestCaptchaTokenInput.value = '';
    });
  </script>