      border: 1px solid rgba(237, 255, 119, 0.5);
    }
    .success-title { font-family: var(--font-sans); font-size: 36px; font-weight: 400; color: var(--color-black); }
    .success-p { color: var(--color-gray); font-size: 18px; line-height: 1.6; max-width: 480px; }
    .success-actions { margin-top: 20px; }

    .hidden { display: none !important; }

    .captcha-block {
      margin-top: 8px;
