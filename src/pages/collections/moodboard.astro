---
import PostHogLayout from '../../layouts/PostHogLayout.astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SaveButton from '../../components/SaveButton.astro';
import '../../styles/collections.css';
import moodboardData from '../../../public/moodboard.json';
import type { Env } from '../../env.d';

// Protected
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

let objects: any[] = [];
let error = null;

try {
  objects = moodboardData as any[];
} catch (e) {
  error = e;
  console.error('Failed to fetch moodboard collection:', e);
}
---

<PostHogLayout>
  <Layout title="My Moodboard - Acceso">
    <Navbar />
    
    <main class="objects-page">
      <div class="header">
        <h1 class="page-title">Moodboard</h1>
        <p id="count" class="count">Loading moodboard...</p>
      </div>

      {!error && (
        <div id="objects-grid" class="objects-grid" style="opacity: 0; transition: opacity 0.3s ease;">
          {objects.map(item => (
            <div class="object-card-wrapper" data-id={item.id} style="display: none;">
              <a 
                href={`/moodboard/${item.slug}`} 
                class="object-card"
              >
                {item.cover && (
                  <img 
                    src={item.cover} 
                    alt={item.name}
                    loading="lazy"
                    data-skeleton
                  />
                )}
                <div class="item-overlay">
                  <h3>{item.name}</h3>
                  {item.designer && <p>{item.designer}</p>}
                </div>
              </a>
              
              <div class="save-btn-container">
                <SaveButton 
                  type="object" 
                  itemId={item.id} 
                />
              </div>
            </div>
          ))}
          <div id="empty-state" class="empty-state" style="display: none;">
             <p>No saved objects.</p>
             <a href="/moodboard" class="browse-link">Explore Moodboard</a>
          </div>
        </div>
      )}
    </main>
  </Layout>
</PostHogLayout>

<script src="/js/collections.js" is:inline></script>
<script is:inline>
  initCollectionsFilter('objects-grid', 'empty-state', 'count', 'object');
</script>