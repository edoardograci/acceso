---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SaveButton from '../../components/SaveButton.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

// Protected
if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

let objects: any[] = [];
let error = null;

try {
  const publicDir = path.join(process.cwd(), 'public');
  const moodboardStr = await fs.readFile(path.join(publicDir, 'moodboard.json'), 'utf-8');
  objects = JSON.parse(moodboardStr);
} catch (e) {
  error = e;
  console.error('Failed to fetch moodboard collection:', e);
}
---

<Layout title="My Moodboard - Acceso">
  <Navbar />
  
  <main class="objects-page">
    <div class="header">
      <h1 class="page-title">Moodboard</h1>
      <p id="count" class="count">Loading moodboard...</p>
    </div>

    {!error && (
      <div id="objects-grid" class="objects-grid" style="opacity: 0; transition: opacity 0.3s ease;">
        {objects.map(item => (
          <div class="object-card-wrapper" data-id={item.id} style="display: none;">
            <a 
              href={`/moodboard/${item.slug}`} 
              class="object-card"
            >
              {item.cover && (
                <img 
                  src={item.cover} 
                  alt={item.name}
                  loading="lazy"
                  data-skeleton
                />
              )}
              <div class="item-overlay">
                <h3>{item.name}</h3>
                {item.designer && <p>{item.designer}</p>}
              </div>
            </a>
            
            <div class="save-btn-container">
              <SaveButton 
                type="object" 
                itemId={item.id} 
              />
            </div>
          </div>
        ))}
        <div id="empty-state" class="empty-state" style="display: none;">
           <p>No saved objects.</p>
           <a href="/moodboard" class="browse-link">Explore Moodboard</a>
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  .objects-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-title {
    font-size: 48px;
    margin-bottom: 8px;
    font-weight: 400;
  }

  .count {
    color: var(--color-gray);
  }

  .objects-grid {
    column-count: 4;
    column-gap: 16px;
    padding: 0 var(--spacing-page) 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .objects-grid {
      column-count: 3;
    }
  }

  @media (max-width: 768px) {
    .objects-grid {
      column-count: 2;
    }
  }

  .object-card-wrapper {
    position: relative;
    break-inside: avoid;
    margin-bottom: 16px;
    background: var(--color-bg-secondary);
  }

  .moodboard-item {
    display: block;
    width: 100%;
  }

  .object-card {
    display: block;
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .object-card img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease;
  }

  .object-card:hover img {
    transform: scale(1.02);
  }

  .item-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .object-card:hover .item-overlay {
    opacity: 1;
  }

  .item-overlay h3 {
    font-size: 14px;
    margin-bottom: 4px;
    font-weight: 400;
  }

  .item-overlay p {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
  }

  .save-btn-container {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }

  .browse-link {
    color: var(--color-yellow);
    text-decoration: none;
    margin-top: 16px;
    display: inline-block;
  }
</style>

<script>
const filterGrid = () => {
    const grid = document.getElementById('objects-grid');
    const emptyState = document.getElementById('empty-state');
    const countLabel = document.getElementById('count');
    if (!grid || !window.collectionsState) return;

    const cards = grid.querySelectorAll('.object-card-wrapper');
    let visibleCount = 0;

    cards.forEach(card => {
      const id = card.getAttribute('data-id');
      if (window.collectionsState.isSaved('object', id)) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      if (emptyState) emptyState.style.display = 'block';
      if (countLabel) countLabel.innerText = '0 saved';
    } else {
      if (emptyState) emptyState.style.display = 'none';
      if (countLabel) countLabel.innerText = `${visibleCount} saved`;
    }

    grid.style.opacity = '1';
  };

  // Run on init
  if (window.collectionsState?.loaded) {
    filterGrid();
  } else {
    // Wait for state to load
    const checkState = setInterval(() => {
      if (window.collectionsState?.loaded) {
        filterGrid();
        clearInterval(checkState);
      }
    }, 50);
  }

  // Sync on changes
  document.addEventListener('save-change', ((e: CustomEvent) => {
    const { saved, type } = e.detail;
    if (type === 'object') {
      filterGrid();
    }
  }) as EventListener);

  // Sync on cross-tab storage changes
  window.addEventListener('storage', (e) => {
    if (e.key === 'collections_state_v1') {
      filterGrid();
    }
  });
</script>
