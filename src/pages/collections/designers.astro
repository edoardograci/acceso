---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SaveButton from '../../components/SaveButton.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { getSavedDesigners } from '../../lib/db';
import type { Env } from '../../env.d';

// Protected
if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

let studios: any[] = [];
let error = null;

try {
  const [savedIds, response] = await Promise.all([
    getSavedDesigners(Astro.locals.user.id, env),
    fetch(new URL('/studios.json', Astro.url.origin))
  ]);

  if (!response.ok) throw new Error('Failed to load studios data');
  const allStudios = await response.json();
  
  studios = allStudios.filter((s: any) => savedIds.includes(s.id));
} catch (e) {
  error = e;
  console.error('Failed to fetch designers collection:', e);
}
---

<Layout title="My Saved Designers - Acceso">
  <Navbar />
  
  <main class="designers-page">
    <div class="header">
      <h1 class="page-title">My Designers</h1>
      <p class="count">{studios.length} saved</p>
    </div>

    {!error && (
      <div class="designers-grid">
        {studios.map(studio => (
          <div class="studio-card-wrapper">
            <a 
              href={`/designers/${studio.slug}`} 
              class="studio-card"
            >
              {studio.cover ? (
                <OptimizedImage
                  src={studio.cover}
                  alt={studio.name}
                  width={400}
                  height={200}
                  class="studio-image"
                />
              ) : (
                <div class="studio-image-placeholder">No image</div>
              )}
              <div class="studio-info">
                <h3>{studio.name}</h3>
                <p>{studio.city}</p>
              </div>
            </a>
            
            <div class="save-btn-container">
              <SaveButton 
                type="designer" 
                itemId={studio.id} 
              />
            </div>
          </div>
        ))}
        {studios.length === 0 && (
          <div class="empty-state">
             <p>No saved designers.</p>
             <a href="/designers" class="browse-link">Browse Designers</a>
          </div>
        )}
      </div>
    )}
  </main>
</Layout>

<style>
  .designers-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-title {
    font-size: 48px;
    margin-bottom: 8px;
    font-weight: 400;
  }

  .count {
    color: var(--color-gray);
  }

  .designers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding: 0 var(--spacing-page) 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Card wrapper to handle positioning */
  .studio-card-wrapper {
    position: relative;
    /* Wrapper ensures the button can be positioned absolute over the card */
  }

  .studio-card {
    text-decoration: none;
    display: block;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .studio-card:hover {
    transform: translateY(-4px);
  }

  .studio-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .studio-image-placeholder {
     width: 100%;
     height: 200px;
     background: var(--color-bg-secondary);
     margin-bottom: 12px;
     display: flex;
     align-items: center;
     justify-content: center;
     color: var(--color-gray);
  }

  .studio-info h3 {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .studio-info p {
    color: var(--color-gray);
    font-size: 14px;
  }

  /* Position Save button top right */
  .save-btn-container {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }
  
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px;
    color: var(--color-gray);
  }

  .browse-link {
    color: var(--color-yellow);
    text-decoration: none;
    margin-top: 16px;
    display: inline-block;
  }
</style>

<script>
  document.addEventListener('save-change', ((e: CustomEvent) => {
    const { saved, type } = e.detail;
    if (!saved && type === 'designer') {
      const target = e.target as HTMLElement;
      const cardWrapper = target.closest('.studio-card-wrapper');
      
      if (cardWrapper) {
        // Animate removal
        (cardWrapper as HTMLElement).style.opacity = '0';
        (cardWrapper as HTMLElement).style.transform = 'scale(0.95)';
        
        setTimeout(() => {
          cardWrapper.remove();
          
          // Check if grid is empty
          const grid = document.querySelector('.designers-grid');
          if (grid && grid.children.length === 0) {
            // Can reload or show empty state manually
            // For simplicity, just reload to fetch empty state from server or toggle it
            // Or simpler: make the empty state visible if hidden
            window.location.reload(); 
          }
        }, 200);
      }
    }
  }) as EventListener);
</script>
