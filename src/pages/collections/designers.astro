---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SaveButton from '../../components/SaveButton.astro';
import fs from 'node:fs/promises';
import path from 'node:path';

// Protected
if (!Astro.locals.user) {
  return Astro.redirect('/auth/login');
}

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

let studios: any[] = [];
let error = null;

try {
  const publicDir = path.join(process.cwd(), 'public');
  const studiosStr = await fs.readFile(path.join(publicDir, 'studios.json'), 'utf-8');
  studios = JSON.parse(studiosStr);
} catch (e) {
  error = e;
  console.error('Failed to fetch designers collection:', e);
}
---

<Layout title="My Saved Designers - Acceso">
  <Navbar />
  
  <main class="designers-page">
    <div class="header">
      <h1 class="page-title">My Designers</h1>
      <p id="count" class="count">Loading saved designers...</p>
    </div>

    {!error && (
      <div id="designers-grid" class="designers-grid" style="opacity: 0; transition: opacity 0.3s ease;">
        {studios.map(studio => (
          <div class="studio-card-wrapper" data-id={studio.id} style="display: none;">
            <a 
              href={`/designers/${studio.slug}`} 
              class="studio-card"
            >
              {studio.cover ? (
                <img 
                  src={studio.cover} 
                  alt={studio.name} 
                  class="studio-image" 
                  loading="lazy" 
                  data-skeleton
                />
              ) : (
                <div class="studio-image-placeholder">No image</div>
              )}
              <div class="studio-info">
                <h3>{studio.name}</h3>
                <p>{studio.city}</p>
              </div>
            </a>
            
            <div class="save-btn-container">
              <SaveButton 
                type="designer" 
                itemId={studio.id} 
              />
            </div>
          </div>
        ))}
        <div id="empty-state" class="empty-state" style="display: none;">
           <p>No saved designers.</p>
           <a href="/designers" class="browse-link">Browse Designers</a>
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  .designers-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-title {
    font-size: 48px;
    margin-bottom: 8px;
    font-weight: 400;
  }

  .count {
    color: var(--color-gray);
  }

  .designers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding: 0 var(--spacing-page) 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Card wrapper to handle positioning */
  .studio-card-wrapper {
    position: relative;
    /* Wrapper ensures the button can be positioned absolute over the card */
  }

  .studio-card {
    text-decoration: none;
    display: block;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .studio-card:hover {
    transform: translateY(-4px);
  }

  .studio-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .studio-image-placeholder {
     width: 100%;
     height: 200px;
     background: var(--color-bg-secondary);
     margin-bottom: 12px;
     display: flex;
     align-items: center;
     justify-content: center;
     color: var(--color-gray);
  }

  .studio-info h3 {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .studio-info p {
    color: var(--color-gray);
    font-size: 14px;
  }

  /* Position Save button top right */
  .save-btn-container {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }
  
  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px;
    color: var(--color-gray);
  }

  .browse-link {
    color: var(--color-yellow);
    text-decoration: none;
    margin-top: 16px;
    display: inline-block;
  }
</style>

<script>
const filterGrid = () => {
    const grid = document.getElementById('designers-grid');
    const emptyState = document.getElementById('empty-state');
    const countLabel = document.getElementById('count');
    if (!grid || !window.collectionsState) return;

    const cards = grid.querySelectorAll('.studio-card-wrapper');
    let visibleCount = 0;

    cards.forEach(card => {
      const id = card.getAttribute('data-id');
      if (window.collectionsState.isSaved('designer', id)) {
        (card as HTMLElement).style.display = 'block';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      if (emptyState) emptyState.style.display = 'block';
      if (countLabel) countLabel.innerText = '0 saved';
    } else {
      if (emptyState) emptyState.style.display = 'none';
      if (countLabel) countLabel.innerText = `${visibleCount} saved`;
    }

    grid.style.opacity = '1';
  };

  // Run on init
  if (window.collectionsState?.loaded) {
    filterGrid();
  } else {
    // Wait for state to load
    const checkState = setInterval(() => {
      if (window.collectionsState?.loaded) {
        filterGrid();
        clearInterval(checkState);
      }
    }, 50);
  }

  // Sync on changes
  document.addEventListener('save-change', ((e: CustomEvent) => {
    const { saved, type } = e.detail;
    if (type === 'designer') {
      filterGrid();
    }
  }) as EventListener);

  // Sync on cross-tab storage changes
  window.addEventListener('storage', (e) => {
    if (e.key === 'collections_state_v1') {
      filterGrid();
    }
  });
</script>
