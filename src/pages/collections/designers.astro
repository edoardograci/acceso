---
import PostHogLayout from '../../layouts/PostHogLayout.astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import SaveButton from '../../components/SaveButton.astro';
import type { Env } from '../../env.d';

// Protected
if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

let studios: any[] = [];
let error = null;

try {
  const studiosUrl = new URL('/cdn/test-studios.json', Astro.url.origin).toString();
  const response = await fetch(studiosUrl);
  if (!response.ok) throw new Error('CDN Proxy Not Ready');
  studios = await response.json();
} catch (e) {
  console.warn('Falling back to local test-studios.json:', e.message);
  try {
     const localUrl = new URL('/test-studios.json', Astro.url.origin);
     const localRes = await fetch(localUrl.toString());
     studios = await localRes.json();
  } catch (localErr) {
     error = localErr;
     console.error('Total failure to load designers collection:', localErr);
  }
}
---

<PostHogLayout>
  <Layout title="My Saved Designers - Acceso">
    <Navbar />
    
    <main class="designers-page">
      <div class="header">
        <h1 class="page-title">My Designers</h1>
        <p id="count" class="count">Loading saved designers...</p>
        
        <div class="search-bar-container">
          <div class="search-bar">
            <input 
              type="text" 
              id="search-input" 
              placeholder="Search by name..."
              aria-label="Search saved designers"
            />
          </div>
        </div>
      </div>

      {!error && (
        <div id="designers-grid" class="designers-grid" style="opacity: 0; transition: opacity 0.3s ease;">
          {studios.map(studio => (
            <div class="studio-card-wrapper" data-id={studio.id} style="display: none;">
              <a 
                href={`/designers/${studio.slug}`} 
                class="studio-card"
              >
                {studio.cover ? (
                  <img 
                    src={studio.cover} 
                    alt={studio.name} 
                    class="studio-image" 
                    loading="lazy" 
                    data-skeleton
                  />
                ) : (
                  <div class="studio-image-placeholder">No image</div>
                )}
                <div class="studio-info">
                  <h3>{studio.name}</h3>
                  <p>{studio.city}</p>
                </div>
              </a>
              
              <div class="save-btn-container">
                <SaveButton 
                  type="designer" 
                  itemId={studio.id} 
                />
              </div>
            </div>
          ))}
          <div id="empty-state" class="empty-state" style="display: none;">
             <p>No saved designers.</p>
             <a href="/designers" class="browse-link">Browse Designers</a>
          </div>
        </div>
      )}
    </main>
  </Layout>
</PostHogLayout>

<style>
  .designers-page {
    min-height: 100vh;
    padding-top: var(--page-top-spacing);
  }

  .header {
    text-align: center;
    margin-bottom: 48px;
  }

  .page-title {
    font-size: 48px;
    margin-bottom: 8px;
    font-weight: 400;
  }

  .count {
    color: var(--color-gray);
  }

  .designers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding: 0 40px 48px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Card wrapper to handle positioning */
  .studio-card-wrapper {
    position: relative;
    /* Wrapper ensures the button can be positioned absolute over the card */
  }

  .studio-card {
    text-decoration: none;
    display: block;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .studio-card:hover {
    transform: translateY(-4px);
  }

  .studio-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .studio-image-placeholder {
     width: 100%;
     height: 200px;
     background: var(--color-bg-secondary);
     margin-bottom: 12px;
     display: flex;
     align-items: center;
     justify-content: center;
     color: var(--color-gray);
  }

  .studio-info h3 {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .studio-info p {
    color: var(--color-gray);
    font-size: 14px;
  }

  /* Position Save button top right */
  .save-btn-container {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
  }
  
  .search-bar-container {
    max-width: 500px;
    margin: 24px auto 0;
  }

  .search-bar {
    display: flex;
    justify-content: center;
  }

  .search-bar input {
    width: 100%;
    padding: 12px 20px;
    font-size: 16px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    font-family: var(--font-sans);
    border-radius: 6px;
  }

  .search-bar input::placeholder {
    color: var(--color-gray);
  }

  .search-bar input:focus {
    outline: none;
    border-color: var(--color-yellow);
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 48px;
    color: var(--color-gray);
  }

  .browse-link {
    color: var(--color-yellow);
    text-decoration: none;
    margin-top: 16px;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .designers-grid {
      padding: 0 20px 48px;
    }
  }
</style>

<script>
  const filterGrid = () => {
    const grid = document.getElementById('designers-grid');
    const emptyState = document.getElementById('empty-state');
    const countLabel = document.getElementById('count');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const query = searchInput?.value.toLowerCase() || '';
    
    if (!grid || !window.collectionsState) {
      return;
    }

    // Check if still loading
    if (!window.collectionsState.loaded) {
      if (countLabel) countLabel.textContent = 'Loading collections...';
      return;
    }

    // 1. Hide all cards first
    const allCards = grid.querySelectorAll('.studio-card-wrapper');
    allCards.forEach(card => (card as HTMLElement).style.display = 'none');

    let visibleCount = 0;
    const savedIDs = window.collectionsState.designers;

    // 2. Iterate keys in order (Newest -> Oldest)
    // Set iteration preserves insertion order, which matches our requirements
    for (const id of savedIDs) {
      // Find the specific card
      const card = grid.querySelector(`.studio-card-wrapper[data-id="${id}"]`);
      
      if (card) {
        const name = (card.querySelector('h3')?.textContent || '').toLowerCase();
        const city = (card.querySelector('p')?.textContent || '').toLowerCase();
        const matchesSearch = name.includes(query) || city.includes(query);

        if (matchesSearch) {
          (card as HTMLElement).style.display = 'block';
          // Re-append to move to the end of the lists (sorting visually)
          grid.appendChild(card);
          visibleCount++;
        }
      }
    }

    if (visibleCount === 0) {
      if (emptyState) {
        emptyState.style.display = 'block';
        emptyState.querySelector('p')!.textContent = query ? 'No designers match your search.' : 'No saved designers.';
      }
      if (countLabel) countLabel.textContent = '0 saved';
    } else {
      if (emptyState) emptyState.style.display = 'none';
      if (countLabel) countLabel.textContent = `${visibleCount} saved`;
    }

    grid.style.opacity = '1';
  };

  // Search input handler
  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('input', filterGrid);
  }

  // Wait for collections state with timeout
  const waitForState = () => {
    let attempts = 0;
    const maxAttempts = 200; // 10 seconds (50ms * 200)
    
    const checkState = setInterval(() => {
      attempts++;
      
      if (window.collectionsState?.loaded) {
        filterGrid();
        clearInterval(checkState);
      } else if (attempts >= maxAttempts) {
        // Timeout - show error
        const countLabel = document.getElementById('count');
        if (countLabel) {
          countLabel.textContent = 'Failed to load collections. Please refresh.';
          countLabel.style.color = '#ef4444';
        }
        clearInterval(checkState);
      }
    }, 50);
  };

  // Start waiting
  waitForState();

  // Sync on changes
  // Sync on changes
  window.addEventListener('collections-changed', () => {
    filterGrid();
  });

  // Sync on cross-tab storage changes
  window.addEventListener('storage', (e) => {
    if (e.key === 'collections_state_v1') {
      filterGrid();
    }
  });
</script>
