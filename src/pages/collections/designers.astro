---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SaveButton from '../../components/SaveButton.astro';
import { normalizeImage } from '../../lib/images';

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

let studios: any[] = [];
let error = null;

try {
  const studiosUrl = new URL('/cdn/test-studios.json', Astro.url.origin).toString();
  const response = await fetch(studiosUrl);
  if (!response.ok) throw new Error('CDN Proxy Not Ready');
  studios = await response.json();
} catch (e) {
  console.warn('Falling back to local test-studios.json:', e instanceof Error ? e.message : String(e));
  try {
     const localUrl = new URL('/test-studios.json', Astro.url.origin);
     const localRes = await fetch(localUrl.toString());
     studios = await localRes.json();
  } catch (localErr) {
     error = localErr;
     console.error('Total failure to load designers collection:', localErr);
  }
}
---

<Layout title="My Saved Designers - Acceso">
    <Navbar />
    
    <main class="collection-page">
      <div class="collection-inner">
        <nav class="collection-back" aria-label="Back navigation">
          <a href="/profile" class="collection-back-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Profile
          </a>
        </nav>

        <header class="collection-hero">
          <h1 class="collection-title">My Designers</h1>
          <p id="count" class="collection-meta">Loading saved designers...</p>
        </header>

        <div class="collection-search-wrap">
          <svg class="collection-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3" stroke-linecap="round"/>
          </svg>
          <input 
            type="search" 
            id="search-input" 
            class="collection-search-input"
            placeholder="Search by name..."
            aria-label="Search saved designers"
          />
        </div>

        {!error && (
          <div id="designers-grid" class="designers-grid" style="opacity: 0; transition: opacity 0.3s ease;">
            {studios.map(studio => (
              <div class="studio-card-wrapper" data-id={studio.id} style="display: none;">
                <a 
                  href={`/designers/${studio.slug}`} 
                  class="studio-card"
                >
                  <div class="studio-card-media">
                    {studio.cover ? (
                      <img 
                        src={normalizeImage(studio.cover, Astro)} 
                        alt={studio.name} 
                        class="studio-image" 
                        loading="lazy" 
                        data-skeleton
                      />
                    ) : (
                      <div class="studio-image-placeholder">No image</div>
                    )}
                  </div>
                  <div class="studio-info">
                    <h3>{studio.name}</h3>
                    <p>{studio.city}</p>
                  </div>
                </a>
                
                <div class="save-btn-container">
                  <SaveButton 
                    type="designer" 
                    itemId={studio.id} 
                  />
                </div>
              </div>
            ))}
            <div id="empty-state" class="empty-state" style="display: none;">
               <p>No saved designers.</p>
               <a href="/designers" class="browse-link">Browse Designers</a>
            </div>
          </div>
        )}
      </div>
    </main>

    <Footer />
</Layout>

<style>
  .collection-page {
    background: var(--color-white);
    min-height: calc(100vh - var(--navbar-height));
    padding: var(--page-top-spacing) 0 80px;
  }

  .collection-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .collection-back {
    margin-bottom: 24px;
  }

  .collection-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-stroke);
    border-radius: 999px;
    background: var(--color-bg-secondary);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .collection-back-link:hover {
    border-color: #D4D4D8;
    background: #EBEBED;
    color: var(--color-black);
  }

  .collection-hero {
    margin-bottom: 28px;
    max-width: 640px;
  }

  .collection-title {
    font-family: var(--font-sans);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-black);
    margin: 0 0 10px -2px;
  }

  .collection-meta {
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .collection-search-wrap {
    position: relative;
    max-width: 480px;
    margin-bottom: 32px;
  }

  .collection-search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .collection-search-input {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 44px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-bg-secondary);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-size: 15px;
    letter-spacing: -0.01em;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .collection-search-input:focus {
    border-color: var(--color-black);
    background: var(--color-white);
    box-shadow: 0 0 0 3px rgba(15, 17, 19, 0.06);
  }

  .collection-search-input::placeholder {
    color: var(--color-text-muted);
  }

  .designers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
  }

  .studio-card-wrapper {
    position: relative;
  }

  .studio-card {
    text-decoration: none;
    display: block;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .studio-card:hover {
    transform: translateY(-2px);
    color: inherit;
  }

  .studio-card-media {
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-secondary);
    margin-bottom: 10px;
  }

  .studio-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .studio-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 14px;
    letter-spacing: -0.01em;
  }

  .studio-info h3 {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0 0 4px;
    color: var(--color-black);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .studio-info p {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: -0.005em;
    color: var(--color-text-muted);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .save-btn-container {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 10;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 64px 24px;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    letter-spacing: -0.01em;
  }

  .browse-link {
    display: inline-block;
    margin-top: 16px;
    color: var(--color-black);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .collection-inner {
      padding: 0 20px;
    }

    .designers-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    .collection-inner {
      padding: 0 16px;
    }
  }
</style>

<script>
  const filterGrid = () => {
    const grid = document.getElementById('designers-grid');
    const emptyState = document.getElementById('empty-state');
    const countLabel = document.getElementById('count');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const query = searchInput?.value.toLowerCase() || '';
    
    if (!grid || !window.collectionsState) {
      return;
    }

    if (!window.collectionsState.loaded) {
      if (countLabel) countLabel.textContent = 'Loading collections...';
      return;
    }

    const allCards = grid.querySelectorAll('.studio-card-wrapper');
    allCards.forEach(card => (card as HTMLElement).style.display = 'none');

    let visibleCount = 0;
    const savedIDs = window.collectionsState.designers;

    for (const id of savedIDs) {
      const card = grid.querySelector(`.studio-card-wrapper[data-id="${id}"]`);
      
      if (card) {
        const name = (card.querySelector('h3')?.textContent || '').toLowerCase();
        const city = (card.querySelector('p')?.textContent || '').toLowerCase();
        const matchesSearch = name.includes(query) || city.includes(query);

        if (matchesSearch) {
          (card as HTMLElement).style.display = 'block';
          grid.appendChild(card);
          visibleCount++;
        }
      }
    }

    if (visibleCount === 0) {
      if (emptyState) {
        emptyState.style.display = 'block';
        emptyState.querySelector('p')!.textContent = query ? 'No designers match your search.' : 'No saved designers.';
      }
      if (countLabel) countLabel.textContent = '0 saved';
    } else {
      if (emptyState) emptyState.style.display = 'none';
      if (countLabel) countLabel.textContent = `${visibleCount} saved`;
    }

    grid.style.opacity = '1';
  };

  const searchInput = document.getElementById('search-input');
  if (searchInput) {
    searchInput.addEventListener('input', filterGrid);
  }

  const waitForState = () => {
    let attempts = 0;
    const maxAttempts = 200;
    
    const checkState = setInterval(() => {
      attempts++;
      
      if (window.collectionsState?.loaded) {
        filterGrid();
        clearInterval(checkState);
      } else if (attempts >= maxAttempts) {
        const countLabel = document.getElementById('count');
        if (countLabel) {
          countLabel.textContent = 'Failed to load collections. Please refresh.';
          countLabel.style.color = '#ef4444';
        }
        clearInterval(checkState);
      }
    }, 50);
  };

  waitForState();

  window.addEventListener('collections-changed', () => {
    filterGrid();
  });

  window.addEventListener('storage', (e) => {
    if (e.key === 'collections_state_v1') {
      filterGrid();
    }
  });
</script>
