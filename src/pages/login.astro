---
import PostHogLayout from '../layouts/PostHogLayout.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const url = Astro.url;
const error = url.searchParams.get('error');
const errorMessage = url.searchParams.get('message');
---

<PostHogLayout>
  <Layout title="Log In - Acceso">
    <div class="login-wrapper">
      <Navbar />
      <div class="login-content">
        <main class="login-container">
          <h1>Welcome to Acceso</h1>
          {error && (
            <div class="error-message">
              {error === 'invalid_token' && 'Invalid or expired magic link'}
              {error === 'oauth_init_failed' && 'Failed to initialize OAuth'}
              {error === 'oauth_error' && errorMessage ? decodeURIComponent(errorMessage) : 'OAuth error occurred'}
              {error === 'oauth_failed' && 'OAuth authentication failed'}
              {error === 'no_email' && 'No email found in Google account'}
              {error === 'invalid_state' && 'Invalid OAuth state'}
              {!['invalid_token', 'oauth_init_failed', 'oauth_error', 'oauth_failed', 'no_email', 'invalid_state'].includes(error) && 'An error occurred'}
            </div>
          )}
          
          <a href="/auth/google" class="google-btn">
            <img src="/icons/google.svg" alt="Google" />
            Continue with Google
          </a>
          
          <div class="divider">
            <span>or</span>
          </div>
          
          <form id="magic-link-form" class="magic-link-form">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="your@email.com" />
            <button type="submit">Send Magic Link</button>
          </form>
          
          <div id="magic-link-result" class="magic-link-result"></div>

          <p class="auth-disclaimer">
            By continuing, you agree to our <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a>.
          </p>
        </main>
      </div>
    </div>

  </Layout>
</PostHogLayout>

<style>
  .login-wrapper {
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .login-content {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 40px; /* Space for aesthetic balance */
  }

  .login-container {
    width: 100%;
    max-width: 400px;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .login-logo {
    width: 48px;
    height: 48px;
    margin-bottom: 8px;
  }

  .login-container h1 {
    font-size: 24px;
    font-weight: 400;
    color: var(--color-white);
    margin: 0;
    text-align: center;
  }

  .error-message {
    padding: 12px 16px;
    background-color: rgba(255, 0, 0, 0.1);
    border: 1px solid rgba(255, 0, 0, 0.3);
    border-radius: 4px;
    color: #ff6b6b;
    font-size: 14px;
    text-align: center;
    width: 100%;
  }

  .google-btn {
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background-color: var(--color-white);
    color: var(--color-black);
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .google-btn:hover {
    opacity: 0.9;
  }

  .google-btn img {
    width: 20px;
    height: 20px;
  }

  .divider {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--color-gray);
    font-size: 14px;
  }

  .divider::before,
  .divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-stroke);
  }

  .magic-link-form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .magic-link-form label {
    font-size: 14px;
    color: var(--color-white);
  }

  .magic-link-form input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 8px;
    color: var(--color-white);
    font-size: 16px;
    box-sizing: border-box;
    font-family: var(--font-sans);
  }

  .magic-link-form button {
    width: 100%;
    height: 48px;
    background-color: var(--color-white);
    color: var(--color-black);
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: var(--font-sans);
  }

  .magic-link-form button:hover {
    opacity: 0.9;
  }

  .magic-link-form button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .magic-link-result {
    width: 100%;
    padding: 12px 16px;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 8px;
    font-size: 14px;
    color: var(--color-white);
    word-break: break-all;
    display: none;
  }

  .magic-link-result.show {
    display: block;
  }

  .magic-link-result.success {
    background-color: rgba(0, 255, 0, 0.1);
    border-color: rgba(0, 255, 0, 0.3);
    color: #90ee90;
  }

  .magic-link-result.error {
    background-color: rgba(255, 0, 0, 0.1);
    border-color: rgba(255, 0, 0, 0.3);
    color: #ff6b6b;
  }

  .auth-disclaimer {
    color: var(--color-gray);
    font-size: 13px;
    text-align: center;
    line-height: 1.5;
    margin-top: 16px;
  }

  .auth-disclaimer a {
    color: var(--color-white);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .auth-disclaimer a:hover {
    color: var(--color-yellow);
  }
</style>

<script>
  const form = document.getElementById('magic-link-form') as HTMLFormElement;
  const resultDiv = document.getElementById('magic-link-result') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    
    if (!email) return;
    
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    resultDiv.className = 'magic-link-result';
    resultDiv.textContent = '';
    
    try {
      const response = await fetch('/auth/magic-link/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email }),
      });
      
      const data = await response.json();
      
      if (response.status === 429) {
        resultDiv.className = 'magic-link-result show error';
        resultDiv.textContent = data.error || 'Too many requests. Please try again later.';
        return;
      }

      if (data.success) {
        resultDiv.className = 'magic-link-result show success';
        
        resultDiv.innerHTML = `
          <strong>Check your email!</strong><br>
          <small>We've sent a login link to ${email}. Check your inbox and spam folder.</small>
        `;
      } else {
        resultDiv.className = 'magic-link-result show error';
        resultDiv.textContent = data.error || 'Failed to send magic link';
      }
    } catch (error) {
      resultDiv.className = 'magic-link-result show error';
      resultDiv.textContent = 'Failed to send magic link. Please try again.';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send Magic Link';
    }
  });
</script>