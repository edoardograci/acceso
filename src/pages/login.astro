---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const url = Astro.url;
const error = url.searchParams.get('error');
const errorMessage = url.searchParams.get('message');
---

<Layout
    title="Log In | Acceso"
    description="Log in to Acceso to save studios, objects, and collections across independent design scenes worldwide."
    keywords="login acceso, log in acceso, log in, login, log in to acceso"
  >
    <div class="login-shell">
      <Navbar />

      <main class="login-main">
        <div class="login-card">
          <div class="login-card-header">
            <p class="login-eyebrow">Welcome back</p>
            <h1 class="login-title">Log in to Acceso</h1>
            <p class="login-subtitle">Access your saved studios and moodboard collections.</p>
          </div>

          {error && (
            <div class="login-alert" role="alert">
              {error === 'invalid_token' && 'Invalid or expired magic link'}
              {error === 'oauth_init_failed' && 'Failed to initialize OAuth'}
              {error === 'oauth_error' && errorMessage ? decodeURIComponent(errorMessage) : 'OAuth error occurred'}
              {error === 'oauth_failed' && 'OAuth authentication failed'}
              {error === 'no_email' && 'No email found in Google account'}
              {error === 'invalid_state' && 'Invalid OAuth state'}
              {!['invalid_token', 'oauth_init_failed', 'oauth_error', 'oauth_failed', 'no_email', 'invalid_state'].includes(error) && 'An error occurred'}
            </div>
          )}

          <a href="/auth/google" class="login-google-btn">
            <img src="/icons/google.svg" alt="" width="20" height="20" />
            Continue with Google
          </a>

          <div class="login-divider">
            <span>or</span>
          </div>

          <form id="magic-link-form" class="login-form">
            <label for="email" class="login-label">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="you@studio.com"
              class="login-input"
              autocomplete="email"
            />
            <button type="submit" class="login-submit-btn">Send magic link</button>
          </form>

          <div id="magic-link-result" class="magic-link-result"></div>

          <p class="login-legal">
            By continuing, you agree to our
            <a href="/terms" target="_blank" rel="noopener">Terms of Service</a>
            and
            <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
          </p>
        </div>
      </main>
    </div>
  </Layout>

<style>
  .login-shell {
    min-height: 100vh;
    background: var(--color-bg-secondary);
    display: flex;
    flex-direction: column;
  }

  .login-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(32px, 6vh, 64px) 24px;
    min-height: calc(100vh - var(--navbar-height));
  }

  .login-card {
    width: 100%;
    max-width: 520px;
    padding: clamp(36px, 5vw, 48px);
    border: 1px solid var(--color-stroke);
    border-radius: 28px;
    background: var(--color-white);
    box-shadow: 0 24px 64px rgba(15, 17, 19, 0.08);
  }

  .login-card-header {
    margin-bottom: 32px;
    text-align: center;
  }

  .login-eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .login-title {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-size: clamp(32px, 5vw, 42px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-black);
  }

  .login-subtitle {
    margin: 0 auto;
    max-width: 36ch;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .login-alert {
    margin-bottom: 20px;
    padding: 12px 14px;
    border-radius: 12px;
    border: 1px solid rgba(239, 68, 68, 0.25);
    background: rgba(239, 68, 68, 0.08);
    color: var(--color-danger);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.4;
  }

  .login-google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    height: 52px;
    border-radius: 999px;
    border: 1px solid var(--color-stroke);
    background: var(--color-white);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .login-google-btn:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-gray);
    color: var(--color-black);
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 28px 0;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .login-divider::before,
  .login-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-stroke);
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .login-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-black);
  }

  .login-input {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-bg-secondary);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .login-input:focus {
    border-color: var(--color-black);
    background: var(--color-white);
    box-shadow: 0 0 0 3px rgba(15, 17, 19, 0.06);
  }

  .login-input::placeholder {
    color: var(--color-text-muted);
  }

  .login-submit-btn {
    width: 100%;
    height: 52px;
    margin-top: 6px;
    border: 1px solid var(--color-black);
    border-radius: 999px;
    background: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .login-submit-btn:hover:not(:disabled) {
    background: #2a2d30;
    border-color: #2a2d30;
  }

  .login-submit-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .login-legal {
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
    color: var(--color-text-muted);
  }

  .login-legal a {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .login-legal a:hover {
    color: var(--color-black);
    opacity: 0.75;
  }

  .magic-link-result {
    width: 100%;
    margin-top: 16px;
    padding: 12px 16px;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    font-size: 14px;
    color: var(--color-black);
    word-break: break-word;
    display: none;
  }

  .magic-link-result.show {
    display: block;
  }

  .magic-link-result.success {
    background-color: rgba(46, 204, 113, 0.08);
    border-color: rgba(46, 204, 113, 0.25);
    color: #1f7a45;
  }

  .magic-link-result.error {
    background-color: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.25);
    color: var(--color-danger);
  }

  @media (max-width: 640px) {
    .login-main {
      padding: 24px 16px 48px;
    }

    .login-card {
      padding: 28px 24px;
      border-radius: 22px;
    }
  }
</style>

<script>
  const form = document.getElementById('magic-link-form') as HTMLFormElement;
  const resultDiv = document.getElementById('magic-link-result') as HTMLDivElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;

    if (!email) return;

    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    resultDiv.className = 'magic-link-result';
    resultDiv.textContent = '';

    try {
      const response = await fetch('/auth/magic-link/send', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email }),
      });

      const data = await response.json();

      if (response.status === 429) {
        resultDiv.className = 'magic-link-result show error';
        resultDiv.textContent = data.error || 'Too many requests. Please try again later.';
        return;
      }

      if (data.success) {
        resultDiv.className = 'magic-link-result show success';

        resultDiv.replaceChildren();
        const strong = document.createElement('strong');
        strong.textContent = 'Check your email!';
        const br = document.createElement('br');
        const small = document.createElement('small');
        small.textContent = `We've sent a login link to ${email}. Check your inbox and spam folder.`;
        resultDiv.append(strong, br, small);
      } else {
        resultDiv.className = 'magic-link-result show error';
        resultDiv.textContent = data.error || 'Failed to send magic link';
      }
    } catch {
      resultDiv.className = 'magic-link-result show error';
      resultDiv.textContent = 'Failed to send magic link. Please try again.';
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send magic link';
    }
  });
</script>
