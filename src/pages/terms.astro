<style>
  .legal-page {
    min-height: 100vh;
    background: var(--color-white);
  }

  .legal-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 60px var(--spacing-page) 120px;
  }

  .legal-title {
    font-family: var(--font-sans);
    font-size: 48px;
    font-weight: 400;
    color: var(--color-black);
    margin-bottom: 16px;
    letter-spacing: 0;
  }

  .last-updated {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
    margin-bottom: 60px;
  }

  .legal-content section {
    margin-bottom: 48px;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 400;
    color: var(--color-black);
    margin-bottom: 16px;
  }

  p {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    margin-bottom: 12px;
  }

  a {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-gray);
  }

  ul {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    padding-left: 24px;
    list-style-type: disc;
  }

  ol {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    padding-left: 24px;
    list-style-type: decimal;
  }

  li {
    margin-bottom: 8px;
  }

  @media (max-width: 768px) {
    .legal-title {
      font-size: 36px;
    }
  }
</style>
