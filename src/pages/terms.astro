---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service | Acceso"
  description="Terms and conditions governing the use of Acceso, the independent design studios directory."
  keywords="terms of service acceso, terms of service, tos acceso">
    <Navbar />
    
    <main class="legal-page">
      <div class="legal-container">
        <h1 class="legal-title">Terms of Service</h1>
        <p class="last-updated">Last updated: August 11, 2026</p>

