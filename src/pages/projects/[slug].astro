---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SaveButton from '../../components/SaveButton.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

const { slug } = Astro.params;

let item: MoodboardItem | null = null;
let error = null;

try {
  const moodboardUrl = new URL('/cdn/moodboard.json', Astro.url.origin).toString();
  const response = await fetch(moodboardUrl);
  if (!response.ok) throw new Error('CDN Proxy Not Ready');
  
  const items: MoodboardItem[] = await response.json();
  item = items.find(i => i.slug === slug) || null;
} catch (e) {
  error = e;
}

if (!item && !error) {
  return Astro.redirect('/404');
}

// Function to get designer slug from studios.json
async function getDesignerSlug(designerName: string | null): Promise<string | null> {
  if (!designerName) return null;
  try {
    const studiosUrl = new URL('/cdn/test-studios.json', Astro.url.origin).toString();
    const response = await fetch(studiosUrl);
    if (!response.ok) return null;
    const studios = await response.json();
    const studio = studios.find((s: any) => s.name === designerName);
    return studio?.slug || null;
  } catch {
    return null;
  }
}

const designerSlug = item ? await getDesignerSlug(item.designer) : null;
---

<Layout 
  title={item ? `${item.name}${item.designer ? ` by ${item.designer}` : ''} | Acceso Projects` : 'Loading...'}
  description={item ? `${item.name}${item.designer ? ` by ${item.designer}` : ''}. Industrial design project gallery.` : ''}
>
  <Navbar />
  
  {item && (
    <div class="breadcrumbs-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/projects" class="breadcrumb-item">Projects</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">{item.name}</span>
      </nav>
    </div>
  )}

  <main class="project-container">
    {item && (
      <div class="project-hero-row">
        <div class="hero-image-wrapper">
          <div class="carousel-container">
            <div class="carousel-track" id="carousel-track">
              {item.images.map((image, idx) => (
                <div class="carousel-slide">
                  <img 
                    src={image.image_url} 
                    alt={`${item.name} - View ${idx + 1}`} 
                    class="hero-image"
                  />
                </div>
              ))}
            </div>

            {item.images.length > 1 && (
              <div class="carousel-controls">
                <button class="carousel-nav-btn prev" id="carousel-prev" aria-label="Previous image">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                
                <div class="carousel-indicators" id="carousel-indicators">
                  {item.images.map((_, idx) => (
                    <button 
                      class={`indicator ${idx === 0 ? 'active' : ''}`} 
                      data-index={idx}
                      aria-label={`Go to slide ${idx + 1}`}
                    />
                  ))}
                </div>

                <button class="carousel-nav-btn next" id="carousel-next" aria-label="Next image">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 18L15 12L9 6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            )}
          </div>
        </div>

        <aside class="info-card">
          <div class="info-card-content">
            <h1 class="project-title">{item.name}</h1>
            
            <div class="details-section">
              {item.designer && (
                <div class="details-row">
                  <span class="detail-label">Designer</span>
                  {designerSlug ? (
                    <a href={`/designers/${designerSlug}`} class="detail-value underlined">{item.designer}</a>
                  ) : (
                    <span class="detail-value">{item.designer}</span>
                  )}
                </div>
              )}
              {item.designer && (item.year || item.client || item.city) && <div class="details-divider"></div>}
              
              {item.year && (
                <div class="details-row">
                  <span class="detail-label">Year</span>
                  <span class="detail-value">{item.year}</span>
                </div>
              )}
              {item.year && (item.client || item.city) && <div class="details-divider"></div>}

              {item.client && (
                <div class="details-row">
                  <span class="detail-label">Client</span>
                  <span class="detail-value">{item.client}</span>
                </div>
              )}
              {item.client && item.city && <div class="details-divider"></div>}

              {item.city && (
                <div class="details-row">
                  <span class="detail-label">Location</span>
                  <a href="/designers" class="detail-value underlined">{item.city}</a>
                </div>
              )}
            </div>

            {item.link && (
              <div class="social-links">
                <a href={item.link} target="_blank" class="social-btn">
                  <img src="/icons/source.svg" alt="" width="16" height="16" />
                  <span>Website</span>
                </a>
              </div>
            )}
          </div>

          <div class="card-footer-actions">
            <button class="footer-btn share-btn" id="shareButton">
              <img src="/icons/share.svg" alt="" width="18" height="18" />
              <span>Share</span>
            </button>
            <SaveButton type="product" itemId={item.id} itemName={item.name} buttonClass="footer-btn save-btn" />
          </div>
        </aside>
      </div>
    )}
  </main>

  <Footer />
</Layout>

<script>
  // Carousel logic
  const track = document.getElementById('carousel-track');
  const slides = track?.querySelectorAll('.carousel-slide');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const indicators = document.getElementById('carousel-indicators')?.querySelectorAll('.indicator');
  
  let currentIndex = 0;
  const slideCount = slides?.length || 0;

  function updateCarousel() {
    if (!track) return;
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    
    indicators?.forEach((ind, idx) => {
      if (idx === currentIndex) ind.classList.add('active');
      else ind.classList.remove('active');
    });
  }

  prevBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex > 0) ? currentIndex - 1 : slideCount - 1;
    updateCarousel();
  });

  nextBtn?.addEventListener('click', () => {
    currentIndex = (currentIndex < slideCount - 1) ? currentIndex + 1 : 0;
    updateCarousel();
  });

  indicators?.forEach((ind, idx) => {
    ind.addEventListener('click', () => {
      currentIndex = idx;
      updateCarousel();
    });
  });

  // ── Touch swipe support for mobile ──────────────────────
  if (track && slideCount > 1) {
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    const SWIPE_THRESHOLD = 40;  // px minimum to register as swipe

    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].clientX;
      touchEndY = e.changedTouches[0].clientY;
      const dx = touchEndX - touchStartX;
      const dy = touchEndY - touchStartY;
      // Only act when horizontal movement dominates (not a scroll)
      if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) {
          // Swipe left → next slide
          currentIndex = (currentIndex < slideCount - 1) ? currentIndex + 1 : 0;
        } else {
          // Swipe right → prev slide
          currentIndex = (currentIndex > 0) ? currentIndex - 1 : slideCount - 1;
        }
        updateCarousel();
      }
    }, { passive: true });
  }

  // Share Button
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: 'Check out this design project on Acceso'
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) {
      }
    });
  }
</script>

<style>
  .project-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 120px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
  }

  .breadcrumb-item {
    color: var(--color-gray);
    text-decoration: none;
  }

  .breadcrumb-separator {
    color: var(--color-gray);
  }

  .breadcrumb-current {
    color: var(--color-white);
  }

  .project-hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: flex-start;
    justify-content: flex-end;
  }

  .hero-image-wrapper {
    height: clamp(400px, 75vh, 850px);
    width: auto;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 1;
    display: flex;
    justify-content: center;
    position: relative;
    flex: 1;
  }

  .carousel-container {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .carousel-slide {
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  .carousel-controls {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    z-index: 10;
  }

  .carousel-nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(15, 17, 19, 0.42);
    border: 1px solid rgba(255,255,255,0.24);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .carousel-nav-btn:hover {
    background: rgba(28, 30, 32, 0.58);
    border-color: rgba(255,255,255,0.34);
  }

  .carousel-indicators {
    display: flex;
    gap: 8px;
  }

  .indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.28);
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .indicator.active {
    background: rgba(237,254,68,0.95);
    transform: scale(1.25);
  }

  .info-card {
    width: 400px;
    height: clamp(500px, 75vh, 700px);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .info-card::-webkit-scrollbar {
    display: none;
  }

  .project-title {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .details-section {
    background: var(--color-btn-bg);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 24px;
  }

  .details-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .detail-label {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gray);
  }

  .detail-value {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-white);
    text-decoration: none;
  }

  .detail-value.underlined {
    text-decoration: underline;
  }

  .details-divider {
    height: 1px;
    background: var(--color-stroke);
    margin: 12px 0;
  }

  .social-links {
    margin-bottom: 24px;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    background: var(--color-btn-bg);
    border-radius: 10px;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .card-footer-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
  }

  :global(.footer-btn) {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 48px;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700 !important;
    cursor: pointer;
    border: none;
    padding: 0 16px;
    transition: opacity 0.2s ease;
  }

  :global(.share-btn) {
    background: var(--color-btn-bg) !important;
    color: var(--color-white) !important;
  }

  :global(.save-btn) {
    background: var(--color-white) !important;
    color: var(--color-black) !important;
  }

  @media (max-width: 1024px) {
    .project-hero-row {
      flex-direction: column;
      align-items: center;
    }
    .info-card {
      width: 100%;
      height: auto;
      max-width: 600px;
    }
    .hero-image-wrapper {
      width: 100%;
      max-width: 600px;
      height: auto;  /* reset desktop clamp height when stacked */
    }
    .project-container {
      padding: 0 20px 80px;
    }
    .breadcrumbs-container {
       padding-left: 20px;
    }
  }

  /* ── Mobile: ≤640px ───────────────────────── */
  @media (max-width: 640px) {
    .breadcrumbs-container {
      padding: 20px 16px 0;
    }
    .project-container {
      padding: 0 16px 60px;
    }
    .project-hero-row {
      gap: 20px;
      margin-top: 24px;
      align-items: stretch;
    }
    /* Hero image wrapper: full width, natural height */
    .hero-image-wrapper {
      max-width: none;
      width: 100%;
      height: auto;
      min-height: 260px;
      /* Remove the clamp min so it doesn't force too-tall a box on phones */
      flex: none;
    }
    /* Carousel fills available width */
    .carousel-container {
      min-height: 260px;
    }
    .hero-image {
      max-height: 65vh;
    }
    /* Carousel nav buttons: ensure minimum 44px touch target */
    .carousel-nav-btn {
      width: 44px;
      height: 44px;
    }
    /* Info card: full width, no max-width cap */
    .info-card {
      max-width: none;
      width: 100%;
      height: auto;
      padding: 20px;
      border-radius: 16px;
    }
    .project-title {
      font-size: clamp(22px, 6vw, 32px);
      margin-bottom: 16px;
    }
    .details-section {
      margin-bottom: 16px;
    }
    .social-btn {
      height: 44px;
      font-size: 14px;
    }
    /* Footer action buttons */
    :global(.footer-btn) {
      height: 44px;
      font-size: 14px;
    }
  }
</style>
