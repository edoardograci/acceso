---
// src/pages/admin/index.astro
// Owner-only monitoring dashboard. Rendered entirely server-side: the PostHog
// personal API key stays in the Worker and the browser only ever receives
// aggregated numbers.
import AdminLayout from '../../layouts/AdminLayout.astro';
import BreakdownList from '../../components/admin/BreakdownList.astro';
import StatTile from '../../components/admin/StatTile.astro';
import TrafficChart from '../../components/admin/TrafficChart.astro';
import { isAdmin } from '../../lib/admin';
import { getAdminMetrics, parseRange, percentChange, RANGES } from '../../lib/admin-metrics';
import type { Env } from '../../env.d';

export const prerender = false;

const env = (Astro.locals.runtime?.env || import.meta.env) as unknown as Env;

// 404 rather than 403 or a redirect: a logged-out visitor and a logged-in
// non-admin must not be able to tell that this route exists.
if (!isAdmin(Astro.locals.user, env)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain' },
  });
}

const range = parseRange(Astro.url.searchParams.get('range'));
const refresh = Astro.url.searchParams.get('refresh') === '1';

let metrics = null;
let fatalError: string | null = null;
try {
  metrics = await getAdminMetrics(env, range, { refresh });
} catch (error: any) {
  fatalError = error?.message || 'Failed to load metrics';
}

const number = (n: number) => new Intl.NumberFormat('en-US').format(Math.round(n));

const duration = (seconds: number) => {
  const total = Math.max(0, Math.round(seconds));
  if (total < 60) return `${total}s`;
  const minutes = Math.floor(total / 60);
  return `${minutes}m ${String(total % 60).padStart(2, '0')}s`;
};

const percent = (fraction: number) => `${(fraction * 100).toFixed(1)}%`;

const traffic = metrics?.traffic;
const app = metrics?.app;

// PostHog runs cookieless with `persistence: 'memory'` and Acceso is a
// multi-page app, so each page load starts a fresh session and distinct ID.
// When that is happening, sessions/visitors simply track pageviews and the
// bounce rate is pinned at 100% — say so instead of presenting three numbers
// that look independent but are not.
const sessionsMirrorPageviews =
  !!traffic && traffic.current.pageviews > 0 && traffic.current.sessions / traffic.current.pageviews > 0.95;

const savedRows = app
  ? [
      { label: 'Studios', value: app.saves.designers, secondary: app.recentSaves.designers },
      { label: 'Objects', value: app.saves.objects, secondary: app.recentSaves.objects },
      { label: 'Museums', value: app.saves.museums, secondary: app.recentSaves.museums },
      { label: 'Universities', value: app.saves.universities, secondary: app.recentSaves.universities },
    ]
  : [];

const totalSaves = savedRows.reduce((acc, row) => acc + row.value, 0);

const toItems = (rows: { label: string; sessions: number; pageviews: number }[]) =>
  rows.map((row) => ({ label: row.label, value: row.sessions, secondary: row.pageviews }));

const generatedAt = metrics
  ? new Date(metrics.generatedAt).toLocaleString('en-US', {
      dateStyle: 'medium',
      timeStyle: 'short',
    })
  : null;
---

<AdminLayout title="Acceso — Monitoring">
  <main class="mx-auto max-w-[1200px] px-4 py-8 sm:px-6">
    <header class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-xl">Monitoring</h1>
        <p class="mt-1 text-xs text-[#52525B]">
          Last {metrics?.days ?? RANGES[range]} days
          {generatedAt && <span> · generated {generatedAt}</span>}
          {metrics && <span> · cached up to 5 min</span>}
        </p>
      </div>

      <nav class="flex items-center gap-2">
        {Object.keys(RANGES).map((key) => (
          <a
            href={`/admin?range=${key}`}
            class={`rounded-full border px-3 py-1 text-xs transition-colors ${
              key === range
                ? 'border-black bg-black text-white'
                : 'border-[#E4E4E7] text-[#52525B] hover:border-black hover:text-black'
            }`}
          >
            {key}
          </a>
        ))}
        <a
          href={`/admin?range=${range}&refresh=1`}
          class="rounded-full border border-[#E4E4E7] px-3 py-1 text-xs text-[#52525B] transition-colors hover:border-black hover:text-black"
          title="Bypass the 5 minute cache"
        >
          Refresh
        </a>
        <a href="/" class="px-2 text-xs text-[#52525B] underline-offset-2 hover:underline">Site</a>
      </nav>
    </header>

    {fatalError && (
      <div class="mb-6 rounded-lg border border-[#d13b3b] bg-[#fef6f6] px-4 py-3 text-xs text-[#d13b3b]">
        Could not load metrics: {fatalError}
      </div>
    )}

    {metrics && !metrics.posthogConfigured && (
      <div class="mb-6 rounded-lg border border-[#E4E4E7] bg-[#F4F4F5] px-4 py-3 text-xs text-[#52525B]">
        <p class="mb-1 text-black">PostHog is not connected — only app data is shown below.</p>
        <p>
          Set <code>POSTHOG_API_KEY</code> (a personal API key with read access) and
          <code>POSTHOG_PROJECT_ID</code> in <code>.dev.vars</code> locally and as Cloudflare Pages
          secrets in production. Optionally <code>POSTHOG_API_HOST</code> if the project is not on
          the EU cloud.
        </p>
      </div>
    )}

    {metrics && metrics.errors.length > 0 && (
      <details class="mb-6 rounded-lg border border-[#E4E4E7] bg-white px-4 py-3 text-xs">
        <summary class="cursor-pointer text-[#52525B]">
          {metrics.errors.length} of the queries failed — the panels they feed are empty
        </summary>
        <ul class="mt-2 space-y-1 text-[#d13b3b]">
          {metrics.errors.map((message) => (
            <li class="break-words">{message}</li>
          ))}
        </ul>
      </details>
    )}

    {sessionsMirrorPageviews && (
      <div class="mb-6 rounded-lg border border-[#E4E4E7] bg-[#F4F4F5] px-4 py-3 text-xs text-[#52525B]">
        <p class="mb-1 text-black">Sessions and visitors currently mirror pageviews.</p>
        <p>
          PostHog is loaded cookieless with <code>persistence: 'memory'</code>, and Acceso is a
          multi-page site, so every page load starts a fresh session and a fresh distinct ID.
          Sessions, visitors and bounce rate cannot be read as unique-people metrics until that
          changes — pageviews, and “avg session” (in practice, time on page) are the numbers to
          trust here.
        </p>
      </div>
    )}

    {metrics && traffic && app && (
      <div class="space-y-8">
        <section class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
          <StatTile
            label="Pageviews"
            value={number(traffic.current.pageviews)}
            delta={percentChange(traffic.current.pageviews, traffic.previous.pageviews)}
            hint="vs previous period"
          />
          <StatTile
            label="Visitors"
            value={number(traffic.current.visitors)}
            delta={percentChange(traffic.current.visitors, traffic.previous.visitors)}
            hint="vs previous period"
          />
          <StatTile
            label="Sessions"
            value={number(traffic.current.sessions)}
            delta={percentChange(traffic.current.sessions, traffic.previous.sessions)}
            hint="vs previous period"
          />
          <StatTile
            label="Avg session"
            value={duration(metrics.engagement.sessions.avgDurationSec)}
            hint={`median ${duration(metrics.engagement.sessions.medianDurationSec)}`}
          />
          <StatTile
            label="Bounce rate"
            value={percent(metrics.engagement.sessions.bounceRate)}
            hint="single-pageview sessions"
            higherIsBetter={false}
          />
          <StatTile
            label="New signups"
            value={number(app.newUsers)}
            hint={`${number(app.totalUsers)} total users`}
          />
        </section>

        <TrafficChart series={traffic.series} title="Pageviews & visitors" />

        <section class="grid gap-3 lg:grid-cols-2">
          <BreakdownList
            title="Sections"
            rows={toItems(metrics.content.sections)}
            valueLabel="sessions"
            emptyText="No pageviews recorded in this period."
          />
          <BreakdownList
            title="Top pages"
            rows={toItems(metrics.content.topPages)}
            valueLabel="sessions"
            emptyText="No pageviews recorded in this period."
          />
        </section>

        <section class="grid gap-3 lg:grid-cols-3">
          <BreakdownList title="Referrer type" rows={toItems(metrics.acquisition.referrerTypes)} limit={8} />
          <BreakdownList
            title="External referrers"
            rows={toItems(metrics.acquisition.referringDomains)}
            limit={10}
            emptyText="No external referrers in this period."
          />
          <BreakdownList title="Countries" rows={toItems(metrics.acquisition.countries)} limit={10} />
        </section>

        <section class="grid gap-3 lg:grid-cols-3">
          <BreakdownList title="UTM source" rows={toItems(metrics.acquisition.utmSources)} limit={8} />
          <BreakdownList title="UTM campaign" rows={toItems(metrics.acquisition.utmCampaigns)} limit={8} />
          <BreakdownList title="Devices" rows={toItems(metrics.acquisition.devices)} limit={6} />
        </section>

        <section class="grid gap-3 lg:grid-cols-2">
          <BreakdownList
            title="Page types"
            rows={toItems(metrics.content.pageTypes)}
            limit={10}
            emptyText="No page_type property recorded yet."
          />
          <BreakdownList
            title="Custom events"
            rows={metrics.engagement.customEvents.map((row) => ({ label: row.event, value: row.total }))}
            valueLabel="events"
            emptyText="No custom events in this period."
            limit={12}
          />
        </section>

        <section>
          <h2 class="mb-3 text-sm">
            App data
            <span class="ml-2 text-[11px] font-normal text-[#52525B]">from the database, not PostHog</span>
          </h2>

          <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
            <StatTile label="Total users" value={number(app.totalUsers)} hint="all time" />
            <StatTile label="Saved items" value={number(totalSaves)} hint="all time, all types" />
            <StatTile
              label="Pending studio requests"
              value={number(app.pendingStudioRequests)}
              higherIsBetter={false}
            />
            <StatTile label="Suggestions" value={number(app.suggestions)} hint="in this period" />
          </div>

          <div class="mt-3 grid gap-3 lg:grid-cols-2">
            <BreakdownList
              title="Saved items by type"
              rows={savedRows}
              valueLabel="all time"
              secondaryLabel="in period"
              emptyText="Nothing saved yet."
            />
            <BreakdownList
              title="Submissions by status"
              rows={app.submissionsByStatus.map((row) => ({ label: row.status, value: row.count }))}
              valueLabel="submissions"
              emptyText="No submissions yet."
            />
          </div>
        </section>

        <footer class="border-t border-[#E4E4E7] pt-4 text-[11px] text-[#52525B]">
          <p>
            PostHog only captures on <code>acceso.design</code>, so this dashboard always reflects
            production traffic — including when it is opened from a dev server. Day boundaries
            follow the PostHog project timezone. Section totals sum sessions across paths, so a
            visitor who browses two sections counts in both.
          </p>
        </footer>
      </div>
    )}
  </main>
</AdminLayout>
