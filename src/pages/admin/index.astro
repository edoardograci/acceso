---
// src/pages/admin/index.astro
// Fast, lightweight Admin Dashboard homepage with quick navigation cards (zero blocking metrics calls).
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';
import type { Env } from '../../env.d';

export const prerender = false;

const runtimeEnv = Astro.locals.runtime?.env || {};
const metaEnv = import.meta.env || {};
const env = { ...metaEnv, ...runtimeEnv } as unknown as Env;

if (!isAdmin(Astro.locals.user, env)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain' },
  });
}

const sections = [
  {
    title: 'Analytics',
    description: 'Traffic dashboard, visitor trends, pageviews, and AI platform citations.',
    href: '/admin/analytics',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    badge: 'Traffic & Views',
  },
  {
    title: 'ADS',
    description: 'Track ad campaigns, referral links, impressions, and click metrics.',
    href: '/admin/ads',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 7L2 7"/></svg>`,
    badge: 'Campaigns',
  },
  {
    title: 'Submissions',
    description: 'Review and approve submitted designers, schools, and museums.',
    href: '/admin/submissions',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
    badge: 'Review Queue',
  },
  {
    title: 'Recommendations',
    description: 'Manage user recommendations, suggestions, and corrections.',
    href: '/admin/recommendations',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
    badge: 'Suggestions',
  },
  {
    title: 'App Data',
    description: 'Inspect live database items, designers, schools, and museum counts.',
    href: '/admin/app',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    badge: 'Database',
  },
];
---

<AdminLayout title="Acceso - Admin Dashboard" active="overview">
  <main class="an-page">
    <header class="an-head" style="margin-bottom: 28px;">
      <div>
        <h1 class="an-title" style="font-size: 24px;">Admin Overview</h1>
        <p class="an-sub">Quick navigation to management sections and metrics.</p>
      </div>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;">
      {sections.map((section) => (
        <a
          href={section.href}
          style="display: flex; flex-direction: column; justify-content: space-between; background: #ffffff; border: 1px solid #E4E4E7; border-radius: 14px; padding: 22px; text-decoration: none; color: inherit; transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;"
        >
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
              <div style="width: 40px; height: 40px; border-radius: 10px; background: #F4F4F5; display: flex; align-items: center; justify-content: center; color: #0F1113;" set:html={section.icon}></div>
              <span class="admin-pill" style="font-size: 10px; font-weight: 600;">{section.badge}</span>
            </div>
            <h2 style="margin: 0 0 6px; font-size: 17px; font-weight: 500; color: #0F1113;">{section.title}</h2>
            <p style="margin: 0; font-size: 13px; line-height: 1.5; color: #52525B;">{section.description}</p>
          </div>
          <div style="margin-top: 20px; display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #0F1113;">
            <span>Open {section.title}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </main>
</AdminLayout>
