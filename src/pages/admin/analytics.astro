---
// src/pages/admin/analytics.astro
// Traffic dashboard: live panel, interactive graph, cross-filterable breakdowns.
import AdminLayout from '../../layouts/AdminLayout.astro';
import { isAdmin } from '../../lib/admin';
import { parseRange, parseSelectedDay, RANGES } from '../../lib/admin-metrics';
import { parseFilters, serializeFilters } from '../../lib/analytics-filters';
import type { Env } from '../../env.d';

export const prerender = false;

const runtimeEnv = Astro.locals.runtime?.env || {};
const metaEnv = import.meta.env || {};
const env = { ...metaEnv, ...runtimeEnv } as unknown as Env;

if (!isAdmin(Astro.locals.user, env)) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'Content-Type': 'text/plain' },
  });
}

const range = parseRange(Astro.url.searchParams.get('range'));
const selectedDay = parseSelectedDay(Astro.url.searchParams.get('day'));
const refresh = Astro.url.searchParams.get('refresh') === '1';
const filters = parseFilters(Astro.url.searchParams);
const filterQuery = serializeFilters(filters);
const today = new Date().toISOString().slice(0, 10);

const rangeLabels: Record<string, string> = {
  '1d': 'Today',
  '7d': '7 days',
  '30d': '30 days',
  '90d': '90 days',
};
---

<AdminLayout title="Acceso - Analytics" active="analytics">
  <main class="an-page">
    <header class="an-head">
      <div>
        <h1 class="an-title">Analytics</h1>
        <p class="an-sub" data-meta>Loading…</p>
      </div>

      <div class="an-controls">
        <div class="an-ranges" role="group" aria-label="Date range">
          {Object.keys(RANGES).map((key) => (
            <a
              href={`/admin/analytics?range=${key}&day=${selectedDay}${filterQuery ? `&${filterQuery}` : ''}`}
              class={`an-range ${key === range ? 'is-active' : ''}`}
              aria-current={key === range ? 'page' : undefined}
            >
              {rangeLabels[key] || key}
            </a>
          ))}
        </div>
        <label class="sr-only" for="day">Day</label>
        <input id="day" name="day" type="date" value={selectedDay} max={today} class="an-date" />
        <button type="button" class="an-refresh" data-refresh>Refresh</button>
      </div>
    </header>

    <div data-filter-bar></div>
    <div data-errors></div>

    <section class="an-live-strip" data-live-strip>
      {['Current visitors', 'Pageviews · 5 min', "Today's visitors", "Today's pageviews"].map((label) => (
        <div class="an-tile">
          <p class="an-tile-label">{label}</p>
          <div class="an-skel" style="height:30px;width:72px;margin-top:8px"></div>
        </div>
      ))}
    </section>

    <div data-metrics-root>
      <div class="an-skel" style="height:120px"></div>
      <div class="an-skel" style="height:320px;margin-top:12px"></div>
      <div class="an-skel" style="height:260px;margin-top:12px"></div>
    </div>
  </main>
</AdminLayout>

<script define:vars={{ range, selectedDay, refresh, initialFilters: filters }}>
  // define:vars can only reach an inline script, so hand the SSR values to the
  // bundled module below through a single well-known global.
  window.__acceso_analytics = { range, selectedDay, refresh, initialFilters };
</script>

<script>
  import { renderChart, type ChartPoint } from '../../lib/admin/chart';
  import { el } from '../../lib/admin/queue-ui';
  import {
    ACCENT,
    ACCENT_SOFT,
    breakdown,
    filterPills,
    formatDuration,
    formatNumber,
    formatPercent,
    percentChange,
    tile,
    type BreakdownItem,
  } from '../../lib/admin/analytics-ui';
  import { flagEmoji } from '../../lib/admin/icons';
  import { serializeFilters, type AnalyticsFilter, type FilterKey } from '../../lib/analytics-filters';

  const boot = (window as any).__acceso_analytics || {};
  const range: string = boot.range || '30d';
  const selectedDay: string = boot.selectedDay || new Date().toISOString().slice(0, 10);
  let filters: AnalyticsFilter[] = boot.initialFilters || [];
  const wantsRefresh: boolean = Boolean(boot.refresh);

  const metaEl = document.querySelector<HTMLElement>('[data-meta]')!;
  const errorsEl = document.querySelector<HTMLElement>('[data-errors]')!;
  const filterBarEl = document.querySelector<HTMLElement>('[data-filter-bar]')!;
  const liveStripEl = document.querySelector<HTMLElement>('[data-live-strip]')!;
  const rootEl = document.querySelector<HTMLElement>('[data-metrics-root]')!;
  const dayInput = document.getElementById('day') as HTMLInputElement | null;
  const refreshBtn = document.querySelector<HTMLButtonElement>('[data-refresh]')!;

  const isToday = selectedDay === new Date().toISOString().slice(0, 10);

  /** Which series the main graph emphasises. Remembered per browser. */
  let primaryMetric: 'visitors' | 'pageviews' | 'sessions' = 'visitors';
  try {
    const stored = localStorage.getItem('acceso.analytics.metric');
    if (stored === 'visitors' || stored === 'pageviews' || stored === 'sessions') primaryMetric = stored;
  } catch {
    // Private windows throw on access; the default is fine.
  }

  let state: any = null;
  let disposeChart: (() => void) | null = null;
  let disposeHourly: (() => void) | null = null;

  /* ------------------------------------------------------------ URL state */

  function buildUrl(overrides: { day?: string; refresh?: boolean } = {}): string {
    const params = new URLSearchParams();
    params.set('range', range);
    params.set('day', overrides.day || selectedDay);
    if (overrides.refresh) params.set('refresh', '1');
    const serialized = serializeFilters(filters);
    return `/admin/analytics?${params.toString()}${serialized ? `&${serialized}` : ''}`;
  }

  function applyFilters(next: AnalyticsFilter[]) {
    filters = next;
    window.location.href = buildUrl();
  }

  function addFilter(filter: AnalyticsFilter) {
    if (filters.some((f) => f.key === filter.key && f.value === filter.value)) return;
    applyFilters([...filters, filter]);
  }

  // refresh=1 must not survive in the address bar: left there, every later
  // reload bypasses the 5-minute server cache and re-hits PostHog.
  if (wantsRefresh) {
    window.history.replaceState({}, '', buildUrl());
  }

  dayInput?.addEventListener('change', () => {
    if (dayInput.value) window.location.href = buildUrl({ day: dayInput.value });
  });

  refreshBtn.addEventListener('click', () => {
    window.location.href = buildUrl({ refresh: true });
  });

  /* ---------------------------------------------------------------- Live */

  function renderLiveStrip(live: any) {
    if (!live) {
      liveStripEl.replaceChildren(el('p', { class: 'an-empty an-span', text: 'Live data unavailable.' }));
      return;
    }

    const pulseLabel = el('span', { class: 'an-tile-label' });
    pulseLabel.append(el('span', { class: 'an-pulse' }), document.createTextNode('Current visitors'));

    liveStripEl.replaceChildren(
      el('div', {
        class: 'an-tile is-live',
        children: [
          pulseLabel,
          el('span', { class: 'an-tile-value', text: formatNumber(live.liveVisitors) }),
          el('span', {
            class: 'an-tile-foot',
            children: [el('span', { class: 'an-tile-hint', text: 'last 30 minutes' })],
          }),
        ],
      }),
      tile({ label: 'Pageviews · 5 min', value: formatNumber(live.livePageviews), hint: 'right now' }),
      tile({ label: "Today's visitors", value: formatNumber(live.todayVisitors), hint: 'UTC day' }),
      tile({ label: "Today's pageviews", value: formatNumber(live.todayPageviews), hint: 'UTC day' })
    );
  }

  function liveList(title: string, rows: any[], kind: 'page' | 'country' | 'referrer'): HTMLElement {
    const card = el('section', { class: 'an-card' });
    card.appendChild(
      el('header', {
        class: 'an-card-head',
        children: [
          el('h2', { class: 'an-card-title', text: title }),
          el('span', { class: 'an-card-metric', text: 'visitors' }),
        ],
      })
    );

    if (!rows?.length) {
      card.appendChild(el('p', { class: 'an-empty', text: 'Nobody on site in the last 30 minutes.' }));
      return card;
    }

    const max = rows.reduce((acc: number, row: any) => Math.max(acc, row.visitors || 0), 0);
    const list = el('ul', { class: 'an-list' });
    const filterKey: FilterKey = kind === 'page' ? 'path' : kind === 'country' ? 'country' : 'referringDomain';

    for (const row of rows) {
      const fill = el('span', { class: 'an-row-fill' });
      fill.style.width = `${max > 0 ? Math.max((row.visitors / max) * 100, 1) : 0}%`;

      const button = el('button', {
        class: 'an-row is-clickable',
        attrs: { type: 'button', title: `Filter by ${row.label}` },
        children: [
          fill,
          kind === 'country' ? el('span', { class: 'an-flag', text: flagEmoji(row.code) }) : null,
          el('span', { class: 'an-row-label', text: row.label }),
          el('span', { class: 'an-row-value', text: formatNumber(row.visitors) }),
          el('span', { class: 'an-row-secondary', text: formatNumber(row.pageviews) }),
        ],
      });
      button.addEventListener('click', () =>
        addFilter({ key: filterKey, value: kind === 'country' ? row.code || row.label : row.label })
      );
      list.appendChild(el('li', { children: [button] }));
    }

    card.appendChild(list);
    return card;
  }

  function renderLive(payload: any) {
    renderLiveStrip(payload?.live);

    const holder = document.querySelector<HTMLElement>('[data-live-detail]');
    if (!holder) return;

    const detail = payload?.detail;
    holder.replaceChildren(
      liveList('Pages being viewed', detail?.pages || [], 'page'),
      liveList('Where they are', detail?.countries || [], 'country'),
      liveList('How they arrived', detail?.referrers || [], 'referrer')
    );
  }

  function loadLive() {
    fetch(`/api/admin/live${wantsRefresh ? '?refresh=1' : ''}`, { credentials: 'same-origin' })
      .then((res) => (res.ok ? res.json() : null))
      .then(renderLive)
      .catch(() => renderLive(null));
  }

  /* ------------------------------------------------------------- Metrics */

  function toItems(rows: any[]): BreakdownItem[] {
    return (rows || []).map((row) => ({
      label: row.label,
      visitors: row.visitors ?? 0,
      pageviews: row.pageviews ?? 0,
      code: row.code,
    }));
  }

  function metricTiles(m: any): HTMLElement {
    const current = m.traffic?.current || {};
    const previous = m.traffic?.previous || {};
    const sessions = m.engagement?.sessions || {};

    const metricTile = (key: 'visitors' | 'pageviews' | 'sessions', label: string) =>
      tile({
        label,
        value: formatNumber(current[key] || 0),
        hint: 'vs previous period',
        delta: percentChange(current[key] || 0, previous[key] || 0),
        active: primaryMetric === key,
        onClick: () => {
          primaryMetric = key;
          try {
            localStorage.setItem('acceso.analytics.metric', key);
          } catch {
            // Non-fatal; the choice just won't persist.
          }
          render(state);
        },
      });

    return el('section', {
      class: 'an-tiles',
      children: [
        metricTile('visitors', 'Visitors'),
        metricTile('pageviews', 'Pageviews'),
        metricTile('sessions', 'Sessions'),
        tile({
          label: 'Avg. session',
          value: formatDuration(sessions.avgDurationSec || 0),
          hint: `median ${formatDuration(sessions.medianDurationSec || 0)}`,
        }),
        tile({ label: 'Bounce rate', value: formatPercent(sessions.bounceRate || 0), hint: 'single-page sessions' }),
        tile({ label: 'Pages / session', value: (sessions.avgPageviews || 0).toFixed(1), hint: 'in this period' }),
      ],
    });
  }

  function legend(series: { name: string; color: string }[]): HTMLElement {
    return el('ul', {
      class: 'an-legend',
      children: series.map((s) => {
        const item = el('li');
        const dot = el('span', { class: 'an-dot' });
        dot.style.background = s.color;
        item.append(dot, document.createTextNode(s.name));
        return item;
      }),
    });
  }

  function chartCard(m: any): HTMLElement {
    const base = [
      { key: 'visitors', name: 'Visitors', color: ACCENT },
      { key: 'pageviews', name: 'Pageviews', color: ACCENT_SOFT },
    ];
    const series =
      primaryMetric === 'sessions'
        ? [{ key: 'sessions', name: 'Sessions', color: ACCENT }, base[1]]
        : base;

    const points: ChartPoint[] = (m.traffic?.series || []).map((p: any) => ({
      label: p.day,
      values: { visitors: p.visitors, pageviews: p.pageviews, sessions: p.sessions },
    }));

    const plot = el('div', { class: 'an-chart' });
    const card = el('section', {
      class: 'an-card',
      children: [
        el('header', {
          class: 'an-card-head',
          children: [el('h2', { class: 'an-card-title', text: `Last ${m.days} days` }), legend(series)],
        }),
        plot,
      ],
    });

    disposeChart?.();
    // Measure after the node is in the document, or getBoundingClientRect is 0.
    queueMicrotask(() => {
      disposeChart = renderChart(plot, {
        points,
        series,
        primaryKey: primaryMetric,
        mode: 'day',
        onSelect: (point) => {
          window.location.href = buildUrl({ day: point.label });
        },
      });
    });

    return card;
  }

  function hourlyCard(m: any): HTMLElement {
    const series = [
      { key: 'visitors', name: 'Visitors', color: ACCENT },
      { key: 'pageviews', name: 'Pageviews', color: ACCENT_SOFT },
    ];
    const points: ChartPoint[] = (m.hourly || []).map((p: any) => ({
      label: p.hour,
      values: { visitors: p.visitors, pageviews: p.pageviews },
    }));

    const plot = el('div', { class: 'an-chart' });
    const card = el('section', {
      class: 'an-card',
      children: [
        el('header', {
          class: 'an-card-head',
          children: [
            el('h2', { class: 'an-card-title', text: `Hour by hour - ${m.selectedDay}` }),
            legend(series),
          ],
        }),
        plot,
      ],
    });

    disposeHourly?.();
    queueMicrotask(() => {
      disposeHourly = renderChart(plot, { points, series, primaryKey: 'visitors', mode: 'hour' });
    });

    return card;
  }

  function aiTable(details: any[]): HTMLElement {
    const card = el('section', { class: 'an-card' });
    card.appendChild(
      el('header', {
        class: 'an-card-head',
        children: [el('h2', { class: 'an-card-title', text: 'Pages cited by AI' })],
      })
    );

    if (!details.length) {
      card.appendChild(el('p', { class: 'an-empty', text: 'No AI citations in this period.' }));
      return card;
    }

    const body = el('tbody');
    for (const row of details.slice(0, 30)) {
      body.appendChild(
        el('tr', {
          children: [
            el('td', { text: row.platform }),
            el('td', { text: row.country }),
            el('td', { class: 'an-td-path', text: row.path, attrs: { title: row.path } }),
            el('td', { class: 'an-td-num', text: formatNumber(row.pageviews) }),
            el('td', { class: 'an-td-num', text: formatNumber(row.visitors) }),
          ],
        })
      );
    }

    const head = el('thead', {
      children: [
        el('tr', {
          children: [
            el('th', { text: 'Platform' }),
            el('th', { text: 'Country' }),
            el('th', { text: 'Page' }),
            el('th', { class: 'an-td-num', text: 'Views' }),
            el('th', { class: 'an-td-num', text: 'Visitors' }),
          ],
        }),
      ],
    });

    card.appendChild(
      el('div', {
        class: 'an-table-wrap',
        children: [el('table', { class: 'an-table', children: [head, body] })],
      })
    );

    return card;
  }

  function render(m: any) {
    if (!m) return;

    filterBarEl.replaceChildren();
    const pills = filterPills(
      filters,
      (index) => applyFilters(filters.filter((_, i) => i !== index)),
      () => applyFilters([])
    );
    if (pills) filterBarEl.appendChild(pills);

    errorsEl.replaceChildren();
    if (!m.posthogConfigured) {
      errorsEl.appendChild(
        el('p', {
          class: 'an-notice',
          text: 'PostHog is not connected - set POSTHOG_API_KEY and POSTHOG_PROJECT_ID to populate this dashboard.',
        })
      );
    }
    if (m.errors?.length) {
      const details = el('details', { class: 'an-notice is-error' });
      details.appendChild(
        el('summary', { text: `${m.errors.length} ${m.errors.length === 1 ? 'query' : 'queries'} failed` })
      );
      details.appendChild(el('ul', { children: m.errors.map((e: string) => el('li', { text: e })) }));
      errorsEl.appendChild(details);
    }

    const onFilter = (filter: AnalyticsFilter) => addFilter(filter);
    const acq = m.acquisition || {};
    const content = m.content || {};

    const liveTitle = el('h2', { class: 'an-section-title' });
    liveTitle.append(el('span', { class: 'an-pulse' }), document.createTextNode('Right now'));

    const nodes: Node[] = [metricTiles(m), chartCard(m)];

    if (isToday || m.hourly?.length) nodes.push(hourlyCard(m));

    nodes.push(
      el('section', {
        children: [liveTitle, el('div', { class: 'an-grid-3', attrs: { 'data-live-detail': '' } })],
      }),
      el('div', {
        class: 'an-grid-2',
        children: [
          breakdown({ title: 'Top pages', items: toItems(content.topPages), filterKey: 'path', limit: 12, onFilter, emptyText: 'No pageviews in this period.' }),
          breakdown({ title: 'Sections', items: toItems(content.sections), filterKey: 'section', limit: 12, onFilter, emptyText: 'No pageviews in this period.' }),
        ],
      }),
      el('div', {
        class: 'an-grid-3',
        children: [
          breakdown({
            title: 'Countries',
            items: toItems(acq.countries),
            filterKey: 'country',
            filterValue: (item) => item.code || item.label,
            limit: 10,
            onFilter,
            emptyText: 'No country data yet.',
          }),
          breakdown({ title: 'Devices', items: toItems(acq.devices), filterKey: 'device', limit: 6, onFilter, emptyText: 'No device data yet.' }),
          breakdown({ title: 'Browsers', items: toItems(acq.browsers), filterKey: 'browser', limit: 10, onFilter, emptyText: 'No browser data yet.' }),
        ],
      }),
      el('div', {
        class: 'an-grid-3',
        children: [
          breakdown({ title: 'Operating systems', items: toItems(acq.operatingSystems), filterKey: 'os', limit: 8, onFilter, emptyText: 'No OS data yet.' }),
          breakdown({ title: 'Referrer types', items: toItems(acq.referrerTypes), filterKey: 'referrerType', limit: 8, onFilter }),
          breakdown({ title: 'Referring domains', items: toItems(acq.referringDomains), filterKey: 'referringDomain', limit: 10, onFilter, emptyText: 'No external referrers in this period.' }),
        ],
      }),
      el('div', {
        class: 'an-grid-3',
        children: [
          breakdown({ title: 'UTM sources', items: toItems(acq.utmSources), filterKey: 'utmSource', limit: 8, onFilter }),
          breakdown({ title: 'UTM campaigns', items: toItems(acq.utmCampaigns), filterKey: 'utmCampaign', limit: 8, onFilter }),
          breakdown({ title: 'Page types', items: toItems(content.pageTypes), filterKey: 'pageType', limit: 8, onFilter, emptyText: 'No page_type property recorded yet.' }),
        ],
      }),
      el('div', {
        class: 'an-grid-2',
        children: [
          breakdown({ title: 'AI platforms', items: toItems(m.aiReferrers?.platforms), filterKey: 'aiPlatform', limit: 10, onFilter, emptyText: 'No AI referrers in this period.' }),
          aiTable(m.aiReferrers?.details || []),
        ],
      }),
      breakdown({
        title: 'Custom events',
        items: (m.engagement?.customEvents || []).map((row: any) => ({
          label: row.event,
          visitors: row.total,
          pageviews: row.total,
        })),
        limit: 12,
        valueLabel: 'events',
        emptyText: 'No custom events in this period.',
      }),
      el('footer', {
        class: 'an-footnote',
        text: 'Visitors are counted with a daily-rotating hash of IP + user-agent + salt; raw IPs are never stored. Days follow UTC. Live counts cover the last 30 minutes.',
      })
    );

    rootEl.replaceChildren(...nodes);

    // The live panel node only exists after this render, so repaint it.
    loadLive();

    const generated = m.generatedAt
      ? new Date(m.generatedAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })
      : '';
    metaEl.textContent =
      `${m.days} days ending ${m.selectedDay}` +
      (filters.length ? ` · ${filters.length} filter${filters.length === 1 ? '' : 's'}` : '') +
      (generated ? ` · updated ${generated}` : '');
  }

  /* ---------------------------------------------------------------- Load */

  function pick(next: any[], prev: any[]) {
    return next && next.length ? next : prev;
  }

  function merge(base: any, next: any) {
    if (!base) return next;
    const bc = base.content || {};
    const nc = next.content || {};
    const ba = base.acquisition || {};
    const na = next.acquisition || {};
    const bAi = base.aiReferrers || {};
    const nAi = next.aiReferrers || {};
    const bEng = base.engagement || {};
    const nEng = next.engagement || {};

    return {
      ...base,
      ...next,
      traffic: next.traffic?.series?.length ? next.traffic : base.traffic,
      selectedDayTotals: next.selectedDayTotals || base.selectedDayTotals,
      hourly: pick(next.hourly, base.hourly),
      content: {
        sections: pick(nc.sections, bc.sections),
        topPages: pick(nc.topPages, bc.topPages),
        pageTypes: pick(nc.pageTypes, bc.pageTypes),
      },
      acquisition: {
        referrerTypes: pick(na.referrerTypes, ba.referrerTypes),
        referringDomains: pick(na.referringDomains, ba.referringDomains),
        utmSources: pick(na.utmSources, ba.utmSources),
        utmCampaigns: pick(na.utmCampaigns, ba.utmCampaigns),
        countries: pick(na.countries, ba.countries),
        devices: pick(na.devices, ba.devices),
        browsers: pick(na.browsers, ba.browsers),
        operatingSystems: pick(na.operatingSystems, ba.operatingSystems),
      },
      aiReferrers: {
        platforms: pick(nAi.platforms, bAi.platforms),
        details: pick(nAi.details, bAi.details),
      },
      engagement: {
        sessions: nEng.sessions?.sessions ? nEng.sessions : bEng.sessions,
        customEvents: pick(nEng.customEvents, bEng.customEvents),
      },
      errors: [...(base.errors || []), ...(next.errors || [])],
      generatedAt: next.generatedAt || base.generatedAt,
    };
  }

  function metricsUrl(part: 'core' | 'extra'): string {
    const params = new URLSearchParams({ range, day: selectedDay, part });
    if (wantsRefresh) params.set('refresh', '1');
    const serialized = serializeFilters(filters);
    return `/api/admin/metrics?${params.toString()}${serialized ? `&${serialized}` : ''}`;
  }

  loadLive();
  if (isToday) window.setInterval(loadLive, 30000);

  // Core first so the graph and top pages paint fast; the long tail follows.
  fetch(metricsUrl('core'), { credentials: 'same-origin' })
    .then((res) => {
      if (!res.ok) throw new Error(res.status === 404 ? 'Not authorised' : 'Failed to load metrics');
      return res.json();
    })
    .then((core) => {
      state = merge(state, core);
      render(state);
      return fetch(metricsUrl('extra'), { credentials: 'same-origin' });
    })
    .then((res) => (res && res.ok ? res.json() : null))
    .then((extra) => {
      if (!extra) return;
      state = merge(state, extra);
      render(state);
    })
    .catch((err) => {
      rootEl.replaceChildren(
        el('p', { class: 'an-notice is-error', text: `Could not load metrics: ${err.message}` })
      );
    });
</script>
