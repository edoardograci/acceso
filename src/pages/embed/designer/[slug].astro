---
const { slug } = Astro.params;

const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let studio: any = null;

try {
  const res = await fetch(`${domain}/test-studios.json`);
  if (res.ok) {
    const data = await res.json();
    const studios = Array.isArray(data) ? data : (data.items || []);
    studio = studios.find((s: any) => s.slug === slug) || null;
  }
} catch (e) {
  console.error('[Embed Map] Failed to fetch studios:', e);
}

if (!studio || studio.latitude == null || studio.longitude == null) {
  return Astro.redirect('/404');
}

const lat = parseFloat(studio.latitude);
const lng = parseFloat(studio.longitude);
const embedOrigin = Astro.site?.toString().replace(/\/$/, '') || Astro.url.origin;
const widgetCode = `<iframe src="${embedOrigin}/embed/designer/${studio.slug}" width="100%" height="380" style="border:0;border-radius:16px;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{studio.name} — Map</title>
    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; overflow: hidden; }
      #embed-map { position: absolute; inset: 0; background: transparent; }

      /* Designer name pill — rendered as a map marker, always above the pin */
      .embed-name-pill {
        max-width: 200px;
        padding: 7px 16px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 999px;
        color: #000;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.18);
        pointer-events: none;
        cursor: default;
      }

      .embed-pin {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #EDFF77;
        border: 2.5px solid #ffffff;
        color: #000;
        font-weight: 700;
        font-size: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
      }

      /* Bottom-right group: info + get widget */
      .embed-bottom-right {
        position: absolute;
        right: 12px;
        bottom: 12px;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      /* Get Widget pill (bottom-right) */
      .embed-widget-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 34px;
        padding: 0 16px;
        border: none;
        border-radius: 999px;
        background: #000;
        color: #fff;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.25);
      }
      .embed-widget-btn:hover { opacity: 0.85; }
      .embed-widget-btn span { transform: translateY(-1.5px); }

      /* Info / legal contribution toggle */
      .embed-info-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1.5px solid #ffffff;
        background: rgba(255, 255, 255, 0.92);
        color: #000;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        font-style: italic;
        font-size: 15px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 1px 5px rgba(0, 0, 0, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s ease, border-color 0.2s ease;
      }
      .embed-info-btn:hover { background: #ffffff; }

      .embed-info-popover {
        position: absolute;
        right: 0;
        bottom: 46px;
        width: 264px;
        background: #fff;
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: 0 6px 22px rgba(0, 0, 0, 0.28);
        z-index: 6;
      }
      .embed-info-popover[hidden] { display: none; }
      .embed-info-text {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        font-size: 12px;
        line-height: 1.55;
        color: #52525B;
      }
      .embed-info-text strong { color: #000; font-weight: 700; }
      .embed-info-text a { color: #000; text-decoration: underline; }

      .embed-widget-modal {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .embed-widget-modal[hidden] { display: none; }
      .embed-widget-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }
      .embed-widget-box {
        position: relative;
        width: 100%;
        max-width: 440px;
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      }
      .embed-widget-close {
        position: absolute; top: 12px; right: 14px;
        background: none; border: none; font-size: 24px; line-height: 1;
        color: #52525B; cursor: pointer;
      }
      .embed-widget-title { font-family: system-ui, sans-serif; font-size: 20px; font-weight: 400; color: #000; margin: 0 0 8px; }
      .embed-widget-desc { font-family: system-ui, sans-serif; font-size: 13px; line-height: 1.5; color: #52525B; margin: 0 0 14px; }
      .embed-widget-code {
        width: 100%; height: 90px; resize: none; border-radius: 10px;
        border: 1px solid #e4e4e7; background: #f4f4f5; padding: 12px;
        font-family: ui-monospace, Menlo, monospace; font-size: 11px; color: #000;
        box-sizing: border-box;
      }
      .embed-widget-actions { display: flex; justify-content: flex-end; margin-top: 14px; }
      .embed-widget-copy {
        height: 42px; padding: 0 22px; border: none; border-radius: 10px;
        background: #000; color: #fff; font-family: system-ui, sans-serif;
        font-size: 14px; font-weight: 700; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
      }
      .embed-widget-copy:hover { opacity: 0.9; }
    </style>
  </head>
  <body>
    <div id="embed-map" data-lat={lat} data-lng={lng} data-name={studio.name}></div>

    <div class="embed-bottom-right">
      <button class="embed-info-btn" id="infoBtn" type="button" aria-label="Legal information" aria-expanded="false">i</button>

      <button class="embed-widget-btn" id="widgetBtn" type="button">
        <span>Get Widget</span>
      </button>

      <div class="embed-info-popover" id="infoPopover" hidden>
        <p class="embed-info-text"><strong>Map data.</strong> © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors, served by <a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a>. Tiles and geocoding are openly licensed community contributions.</p>
      </div>
    </div>

    <div class="embed-widget-modal" id="widgetModal" hidden>
      <div class="embed-widget-backdrop" id="widgetBackdrop"></div>
      <div class="embed-widget-box" role="dialog" aria-modal="true" aria-label="Get this widget">
        <button class="embed-widget-close" id="widgetClose" type="button" aria-label="Close">&times;</button>
        <h3 class="embed-widget-title">Get this widget</h3>
        <p class="embed-widget-desc">Paste this code into your website to show your Acceso location.</p>
        <textarea class="embed-widget-code" id="widgetCode" readonly>{widgetCode}</textarea>
        <div class="embed-widget-actions">
          <button class="embed-widget-copy" id="widgetCopy" type="button">Copy code</button>
        </div>
      </div>
    </div>

    <script>
      (async () => {
        const container = document.getElementById('embed-map');
        if (!container) return;
        const lat = parseFloat(container.dataset.lat ?? '');
        const lng = parseFloat(container.dataset.lng ?? '');
        const name = container.dataset.name || 'D';

        const [maplibregl] = await Promise.all([
          import('maplibre-gl').then((m) => m.default),
          import('maplibre-gl/dist/maplibre-gl.css'),
        ]);

        // Serve glyphs through our own origin. The /api/fonts proxy serves our
        // self-hosted Geist glyphs locally (fast, no extra network call) and
        // lazily proxies any other fontstack (Noto Sans) from OpenFreeMap — but
        // ONLY for the codepoint ranges a visible label actually needs, so
        // non-Latin glyphs (CJK, Arabic, etc.) are fetched on demand. Without
        // this, a designer from Japan/Korea/etc. shows a broken map because the
        // static /fonts Geist PBFs are empty stubs for non-Latin ranges with no
        // fallback. This mirrors the fix already applied to the main map.
        // Fontstack names use underscores to match the on-disk folder names
        // (Geist_Regular / Geist_Bold); MapLibre URL-encodes the stack and
        // won't resolve spaces otherwise.
        const STRIP_LAYERS = new Set([
          'waterway_line_label',
          'water_name_point_label',
          'water_name_line_label',
          'label_other',
          'label_state',
          'highway-shield-non-us',
          'highway-shield-us-interstate',
          'road_shield_us',
        ]);
        const styleRes = await fetch('https://tiles.openfreemap.org/styles/positron');
        const styleJson = await styleRes.json();
        if (styleJson && Array.isArray(styleJson.layers)) {
          styleJson.layers = styleJson.layers.filter(
            (l: any) => !STRIP_LAYERS.has(l.id)
          );
        }
        styleJson.glyphs = `${window.location.origin}/api/fonts/{fontstack}/{range}.pbf`;
        const FONT_MAP: Record<string, string[]> = {
          'Noto Sans Regular': ['Geist_Regular', 'Noto Sans Regular'],
          'Noto Sans Bold': ['Geist_Bold', 'Noto Sans Bold'],
          'Noto Sans Italic': ['Geist_Regular', 'Noto Sans Regular'],
        };
        for (const layer of styleJson.layers || []) {
          const tf = layer?.layout?.['text-font'];
          if (Array.isArray(tf)) {
            const mapped = tf.flatMap((f: string) => FONT_MAP[f] || [f]);
            layer.layout['text-font'] = Array.from(new Set(mapped));
          }
        }

        const map = new maplibregl.Map({
          container: 'embed-map',
          style: styleJson,
          center: [lng, lat],
          zoom: 15,
          minZoom: 2,
          maxZoom: 18,
          attributionControl: false,
          scrollZoom: false,
          boxZoom: false,
          dragRotate: false,
          keyboard: false,
          pitchWithRotate: false,
          fadeDuration: 100,
        });

        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

        const el = document.createElement('div');
        el.className = 'embed-pin';
        el.textContent = (name || 'D').trim().charAt(0).toUpperCase();
        new maplibregl.Marker({ element: el }).setLngLat([lng, lat]).addTo(map);

        const pill = document.createElement('div');
        pill.className = 'embed-name-pill';
        pill.textContent = name;
        new maplibregl.Marker({ element: pill, anchor: 'bottom', offset: [0, -28] }).setLngLat([lng, lat]).addTo(map);

        // Info / legal contribution toggle
        const infoBtn = document.getElementById('infoBtn');
        const infoPopover = document.getElementById('infoPopover');
        if (infoBtn && infoPopover) {
          infoBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = infoPopover.hidden;
            infoPopover.hidden = !open;
            infoBtn.setAttribute('aria-expanded', String(open));
          });
          document.addEventListener('click', (e) => {
            if (!infoPopover.hidden && !infoBtn.contains(e.target as Node) && !infoPopover.contains(e.target as Node)) {
              infoPopover.hidden = true;
              infoBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        const widgetBtn = document.getElementById('widgetBtn');
        const widgetModal = document.getElementById('widgetModal');
        const widgetClose = document.getElementById('widgetClose');
        const widgetBackdrop = document.getElementById('widgetBackdrop');
        const widgetCopy = document.getElementById('widgetCopy');
        const widgetCodeEl = document.getElementById('widgetCode') as HTMLTextAreaElement | null;

        const openWidget = () => { if (widgetModal) { widgetModal.hidden = false; widgetCodeEl?.focus(); widgetCodeEl?.select(); } };
        const closeWidget = () => { if (widgetModal) widgetModal.hidden = true; };

        if (widgetBtn) widgetBtn.addEventListener('click', openWidget);
        if (widgetClose) widgetClose.addEventListener('click', closeWidget);
        if (widgetBackdrop) widgetBackdrop.addEventListener('click', closeWidget);
        if (widgetCopy && widgetCodeEl) {
          widgetCopy.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(widgetCodeEl.value);
              widgetCopy.textContent = 'Copied!';
              setTimeout(() => { widgetCopy.textContent = 'Copy code'; }, 2000);
            } catch (e) {
              widgetCodeEl.select();
            }
          });
        }
      })();
    </script>
  </body>
</html>
