---
import PostHogLayout from '../../../../layouts/PostHogLayout.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import EventBasicCard from '../../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../../lib/images';

const { place } = Astro.params;

const isDev = import.meta.env.DEV;
const origin = Astro.url.origin;
const domain = isDev ? 'https://json.acceso.design' : `${origin}/cdn`;

async function fetchJson<T>(path: string): Promise<T> {
  const u = `${domain}${path.startsWith('/') ? '' : '/'}${path}`;
  const r = await fetch(u);
  if (!r.ok) throw new Error(`Fetch failed ${path}: ${r.status}`);
  return (await r.json()) as T;
}

type City = { slug: string; name: string; country?: string };
type Country = { slug: string; name: string };

let cities: City[] = [];
let countries: Country[] = [];
let allMuseums: any[] = [];
let mode: 'city' | 'country' | 'unknown' = 'unknown';
let cityName: string | null = null;
let countryName: string | null = null;
let totalMuseums: number = 0;

try {
  const [citiesData, countriesData, museumsData] = await Promise.all([
    fetchJson<City[]>('/test-cities.json'),
    fetchJson<Country[]>('/test-countries.json'),
    fetchJson<any[]>('/museums.json'),
  ]);
  cities = citiesData;
  countries = countriesData;
  allMuseums = Array.isArray(museumsData) ? museumsData : (museumsData as any).items || [];
} catch (e) {
  console.error('[Museums Location] Fetch failed:', e);
}

const cityObj = cities.find((c) => c.slug === place) ?? null;
const countryObj = countries.find((c) => c.slug === place) ?? null;

let museums: any[] = [];

if (cityObj) {
  mode = 'city';
  cityName = cityObj.name;
  const c = countries.find((x) => x.slug === (cityObj.country ?? '')) ?? null;
  countryName = c?.name ?? null;
  museums = allMuseums.filter(m => m.city_slug === place);
} else if (countryObj) {
  mode = 'country';
  countryName = countryObj.name;
  museums = allMuseums.filter(m => m.country_slug === place);
} else {
  return Astro.redirect('/404');
}

totalMuseums = museums.length;

const canonical = new URL(`/events/museums/in/${place}`, Astro.site);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Events', url: '/events' },
  { name: 'Museums', url: '/events/museums' },
  { name: `in ${mode === 'city' ? cityName : countryName}`, url: canonical.pathname }
];

const pageTitle = `Design Museums in ${mode === 'city' ? cityName : countryName} | Acceso`;
const pageDesc = `Explore prominent design museums and cultural institutions in ${mode === 'city' ? cityName : countryName}. Discover local design history and exhibitions.`;
---

<PostHogLayout title={pageTitle} description={pageDesc} canonical={canonical}>
  <Navbar />

  <main class="location-events-page">
    <div class="page-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="breadcrumb-item">Home</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/events" class="breadcrumb-item">Events</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/events/museums" class="breadcrumb-item">Museums</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">In {mode === 'city' ? cityName : countryName}</span>
      </nav>

      <header class="page-header">
        <h1 class="location-heading">
          Design museums<br />
          in <span class="text-yellow">{mode === 'city' ? cityName : countryName}</span>
        </h1>
        {mode === 'city' && countryName && (
          <div class="country-subtitle">({countryName})</div>
        )}
      </header>

      <div class="results-meta">
        <h2 class="results-count">
          {totalMuseums} {totalMuseums === 1 ? 'museum' : 'museums'} found
        </h2>
      </div>

      <div class="events-grid">
        {museums.map(museum => (
          <EventBasicCard 
            name={museum.name}
            slug={museum.slug}
            type="museum"
            location={museum.city || cityName}
            image={normalizeImage(museum.image, Astro)}
          />
        ))}
      </div>

      {museums.length === 0 && (
        <div class="empty-state">
          <p>No design museums found in this location at the moment.</p>
          <a href="/events/museums" class="pill-btn">Browse all museums</a>
        </div>
      )}
    </div>
  </main>

  <Footer />
</PostHogLayout>

<style>
  .location-events-page {
    background: var(--color-black);
    min-height: 100vh;
    padding-bottom: 80px;
  }

  .page-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 60px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    margin-bottom: 32px;
  }

  .breadcrumb-item {
    color: var(--color-gray);
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-item:hover { color: white; }

  .breadcrumb-separator {
    color: rgba(255,255,255,0.1);
  }

  .breadcrumb-current {
    color: white;
    font-weight: 700;
  }

  .page-header {
    margin-bottom: 60px;
  }

  .location-heading {
    font-family: var(--font-mono);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: white;
    margin: 0;
  }

  .text-yellow {
    color: var(--color-yellow);
  }

  .country-subtitle {
     font-family: var(--font-mono);
     font-size: 24px;
     color: var(--color-gray);
     margin-top: 12px;
     font-weight: 700;
     letter-spacing: -0.02em;
  }

  .results-meta {
    margin-bottom: 32px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding-bottom: 16px;
  }

  .results-count {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    color: var(--color-gray);
    margin: 0;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .empty-state {
    text-align: center;
    padding: 100px 0;
    color: var(--color-gray);
    font-family: var(--font-sans);
  }

  .empty-state p {
    margin-bottom: 24px;
    font-size: 18px;
  }

  .pill-btn {
     height: 44px;
     padding: 0 24px;
     background: var(--color-yellow);
     color: var(--color-black);
     border-radius: 999px;
     font-family: var(--font-sans);
     font-size: 15px;
     font-weight: 700;
     text-decoration: none;
     display: inline-flex;
     align-items: center;
     transition: all 0.2s;
  }

  .pill-btn:hover {
     opacity: 0.9;
  }

  @media (max-width: 1200px) {
    .events-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .events-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
    .page-container {
      padding: 24px 20px 60px;
    }
    .location-heading {
      font-size: 36px;
    }
  }
</style>
