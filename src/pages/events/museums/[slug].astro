---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import SaveButton from '../../../components/SaveButton.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../lib/images';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let museum: any = null;
let relatedMuseums: any[] = [];
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [musRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/museums.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (musRes.ok) {
    const rawData = await musRes.json();
    const allMuseums = Array.isArray(rawData) ? rawData : (rawData.items || []);
    
    const processedMuseums = allMuseums;

    museum = processedMuseums.find(m => m.slug === slug) || null;

    if (museum) {
      // Discovery: Similar Museums/Institutions
      relatedMuseums = processedMuseums
        .filter(m => m.slug !== slug && (m.city_slug === museum.city_slug || m.country_slug === museum.country_slug))
        .sort((a, b) => (a.city_slug === museum.city_slug ? -1 : 1))
        .slice(0, 8);
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();
  if (countriesRes.ok) countriesMapping = await countriesRes.json();

} catch (e) {
  console.error('[Museum Slug] Fail to fetch data:', e);
}

if (!museum) {
  return Astro.redirect('/404');
}

const countryName = museum.country || countriesMapping.find(c => c.slug === museum.country_slug)?.name || museum.country_slug;
const cityName = museum.city || citiesMapping.find(c => c.slug === museum.city_slug)?.name || museum.city_slug;

const pageTitle = `${museum.name} — Design Museum in ${cityName}`;
const pageDesc = museum.description || `Explore ${museum.name}, a prominent design institution in ${cityName}, ${countryName}.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar />

  <div class="breadcrumbs-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/events" class="breadcrumb-item">Events</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/events/museums" class="breadcrumb-item">Museums</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{museum.name}</span>
    </nav>
  </div>

  <main class="detail-container">
    <div class="hero-row">
      <div class="hero-image-wrapper">
        {museum.image ? (
          <img 
            src={normalizeImage(museum.image, Astro)} 
            alt={museum.name} 
            class="hero-image" 
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="hero-image-placeholder">No image available</div>
        )}
      </div>

      <aside class="info-card">
        <div class="info-card-content">
          <h1 class="item-name">{museum.name}</h1>
          <p class="item-description">
            {museum.description}
          </p>

          <div class="social-links">
            {museum.instagram && (
              <a href={museum.instagram} target="_blank" class="social-btn">
                <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                <span>Instagram</span>
              </a>
            )}
            {museum.facebook && (
              <a href={museum.facebook} target="_blank" class="social-btn">
                <img src="/icons/facebook.svg" alt="" width="16" height="16" />
                <span>Facebook</span>
              </a>
            )}
          </div>

          <div class="details-section">
            <div class="details-row">
              <span class="detail-label">Location</span>
              <div class="detail-value-group">
                {museum.city_slug ? (
                  <a href={`/events/museums/in/${museum.city_slug}`} class="detail-value underlined">{cityName}</a>
                ) : <span class="detail-value">{cityName}</span>}
                {cityName && countryName && <span class="detail-separator">,</span>}
                {museum.country_slug ? (
                  <a href={`/events/museums/in/${museum.country_slug}`} class="detail-value underlined">{countryName}</a>
                ) : <span class="detail-value">{countryName}</span>}
              </div>
            </div>
          </div>

          <!-- Static Details + Contacts (no dropdowns) -->
          <div class="details-group" id="detailsSection">
            {museum.address && (
              <div class="details-row">
                <span class="detail-label">Address</span>
                <span class="detail-value">{museum.address}</span>
              </div>
            )}
            {museum.address && museum.opening_hours && <div class="details-divider"></div>}
            {museum.opening_hours && (
              <div class="details-row top-align">
                <span class="detail-label">Opening Hours</span>
                <span class="detail-value">{museum.opening_hours}</span>
              </div>
            )}
            {!museum.address && !museum.opening_hours && <span class="detail-value">No details available</span>}
          </div>

          <div class="contacts-group" id="contactsSection">
            {museum.contact ? (
              museum.contact.split(/[/,|;]/).map((part: string, index: number, array: string[]) => {
                const val = part.trim();
                if (!val) return null;
                const isEmail = val.includes('@');
                return (
                  <>
                    <div class="details-row">
                      <span class="detail-label">{isEmail ? 'Email' : 'Phone'}</span>
                      <a
                        href={isEmail ? `mailto:${val}` : `tel:${val.replace(/\s/g, '')}`}
                        class="detail-value underlined"
                      >
                        {val}
                      </a>
                    </div>
                    {index < array.length - 1 && val && array[index + 1]?.trim() && <div class="details-divider"></div>}
                  </>
                );
              })
            ) : (
              <span class="detail-value">No contact available</span>
            )}
          </div>
        </div>

        <div class="card-footer-actions">
          <button class="footer-btn share-btn" id="shareButton">
            <img src="/icons/share.svg" alt="" width="18" height="18" />
            <span>Share</span>
          </button>
          
          {museum.website ? (
            <a href={museum.website} target="_blank" class="footer-btn primary-btn">
              <span>Visit Website</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ) : (
             <div class="footer-btn disabled-btn">No Website Available</div>
          )}
        </div>
      </aside>
    </div>

    <section class="discovery-area">
      <div class="discovery-content">
        {relatedMuseums.length > 0 && (
          <div class="discovery-section">
            <div class="section-top">
              <h2 class="discovery-title">Other museums in the area</h2>
              <a href="/events/museums" class="discovery-see-all pill-link">
                Explore museums
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <div class="discovery-grid">
              {relatedMuseums.map(m => (
                <div class="grid-item">
                  <EventBasicCard 
                    name={m.name}
                    slug={m.slug}
                    type="museum"
                    location={m.city || cityName}
                    image={normalizeImage(m.image, Astro)}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: `Check out ${document.title.split('—')[0]} on Acceso`
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) { }
    });
  }
</script>

<style>
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .breadcrumb-item { color: var(--color-gray); text-decoration: none; }
  .breadcrumb-separator { color: var(--color-gray); }
  .breadcrumb-current { color: var(--color-white); }

  .hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: flex-start;
    justify-content: flex-end;
  }

  .hero-image-wrapper {
    height: clamp(400px, 75vh, 850px);
    width: auto;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 1;
    display: flex;
    justify-content: center;
  }

  .hero-image {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
    border-radius: 8px;
  }

  .hero-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-mono);
  }

  .info-card {
    width: 400px;
    height: clamp(500px, 75vh, 700px);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
  }
  
  .info-card-content::-webkit-scrollbar { display: none; }
  .info-card::-webkit-scrollbar { display: none; }

  .tag-row { margin-bottom: 16px; }
  .category-tag { font-family: var(--font-sans); font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--color-yellow); letter-spacing: 0.1em; }

  .item-name {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .item-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-gray);
    margin-bottom: 24px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .social-links { display: flex; gap: 8px; margin-bottom: 24px; }
  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    background: var(--color-btn-bg);
    border-radius: 10px;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }
  .social-btn:hover { background: #222528; }

  .details-section { background: var(--color-btn-bg); border-radius: 10px; padding: 16px; margin-bottom: 20px; }
  .details-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .details-row.top-align { align-items: flex-start; }
  .detail-label { font-size: 15px; color: var(--color-gray); }
  .detail-value { font-size: 15px; font-weight: 700; color: var(--color-white); text-align: right; text-decoration: none; line-height: 1.4; word-break: break-word; }
  .detail-value.underlined { text-decoration: underline; }
  .detail-value.underlined:hover { color: var(--color-yellow); }
  .detail-value-group { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .detail-separator { color: var(--color-gray); margin: 0 2px; font-weight: 400; }
  .details-divider { height: 1px; background: rgba(255,255,255,0.05); margin: 12px 0; }

  .details-group,
  .contacts-group {
    background: var(--color-btn-bg);
    border-radius: 10px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .card-footer-actions { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 12px; 
    width: 100%;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }
  :global(.footer-btn) { display: flex; width: 100%; align-items: center; justify-content: center; gap: 10px; height: 48px; border-radius: 10px; font-weight: 700 !important; cursor: pointer; border: none; transition: transform 0.2s ease, opacity 0.2s ease; text-decoration: none; font-size: 15px; }
  :global(.footer-btn:active) { transform: scale(0.98); }
  :global(.share-btn) { background: #1C1E20 !important; color: var(--color-white) !important; border: 1px solid var(--color-stroke) !important; }
  .primary-btn { background: var(--color-white) !important; color: var(--color-black) !important; box-shadow: 0 10px 20px rgba(255, 255, 255, 0.05); }
  .primary-btn:hover { opacity: 0.9; }
  .disabled-btn { background: #111315 !important; color: var(--color-gray) !important; cursor: not-allowed; pointer-events: none; opacity: 0.5; border: 1px solid var(--color-stroke) !important; }

  .discovery-area { margin-top: 80px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .discovery-title { font-family: var(--font-mono); font-size: 24px; font-weight: 700; color: var(--color-white); }
  .discovery-see-all { flex-shrink: 0; }

  .discovery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }


  @media (max-width: 1200px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .hero-row { flex-direction: column; align-items: center; }
    .hero-image-wrapper { width: 100%; height: auto; min-height: 400px; aspect-ratio: 16/9; }
    .info-card { width: 100%; height: auto; max-width: 800px; }
    .detail-container { padding: 0 20px 40px; }
    .breadcrumbs-container { padding: 32px 20px 0; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
    .discovery-title { font-size: 20px; }
  }
</style>
