---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import SaveButton from '../../../components/SaveButton.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../lib/images';
import { ensureProtocol } from '../../../lib/url';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let award: any = null;
let relatedAwards: any[] = [];

try {
  const [awardsRes] = await Promise.all([
    fetch(`${domain}/awards.json`)
  ]);

  if (awardsRes.ok) {
    const rawData = await awardsRes.json();
    const allAwards = Array.isArray(rawData) ? rawData : (rawData.items || []);
    
    const processedAwards = allAwards.map(a => ({
      ...a,
      website: a.url || a.website || null
    }));

    award = processedAwards.find(a => a.slug === slug) || null;

    if (award) {
      // Discovery: Similar Awards
      relatedAwards = processedAwards
        .filter(a => a.slug !== slug)
        .slice(0, 8);
    }
  }
} catch (e) {
  console.error('[Award Slug] Fail to fetch data:', e);
}

if (!award) {
  return Astro.redirect('/404');
}

function getAwardStatus(deadlinesStr: string) {
  if (!deadlinesStr) return null;
  const now = new Date();
  const dates = deadlinesStr.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return null;
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  const deadlineEnd = new Date(lastDeadline);
  deadlineEnd.setHours(23, 59, 59, 999);
  return deadlineEnd > now ? 'status-open' : 'status-closed';
}

function formatDeadlines(str: string) {
  if (!str) return "Not specified";
  return str.split(',').map(d => {
    const date = new Date(d.trim());
    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }).join(', ');
}

function formatDeadlinesShort(str: string) {
  if (!str) return "";
  const dates = str.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return "";
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  return "Deadline: " + lastDeadline.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const status = getAwardStatus(award.deadlines);
const pillText = status === 'status-open' ? 'OPEN' : 'CLOSED';

const pageTitle = `${award.name} — Design Awards & Recognitions`;
const pageDesc = award.description || `Explore the ${award.name}, one of the most prestigious recognitions in industrial and furniture design.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar />

  <div class="breadcrumbs-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/events" class="breadcrumb-item">Events</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/events/awards" class="breadcrumb-item">Awards</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{award.name}</span>
    </nav>
  </div>

  <main class="detail-container">
    <div class="hero-row">
      <div class="hero-image-wrapper">
        {award.image ? (
          <img 
            src={normalizeImage(award.image, Astro, { width: 1200 })} 
            alt={award.name} 
            class="hero-image" 
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero-image-placeholder">No image available</div>
        )}
      </div>

      <aside class="info-card">
        <div class="info-card-content">
          <div class="tag-row">
             <span class:list={["status-pill", status]}>{pillText}</span>
          </div>
          <h1 class="item-name">{award.name}</h1>
          <p class="item-description">
            {award.description}
          </p>

          <div class="social-links">
            {award.instagram && (
              <a href={award.instagram} target="_blank" class="social-btn">
                <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                <span>Instagram</span>
              </a>
            )}
            {award.facebook && (
              <a href={award.facebook} target="_blank" class="social-btn">
                <img src="/icons/facebook.svg" alt="" width="16" height="16" />
                <span>Facebook</span>
              </a>
            )}
          </div>

          <div class="details-section">
            <div class="details-row">
              <span class="detail-label">Last deadline</span>
              <span class="detail-value">{formatDeadlines(award.deadlines)}</span>
            </div>
          </div>
        </div>

        <div class="card-footer-actions">
          <button class="footer-btn share-btn" id="shareButton">
            <img src="/icons/share.svg" alt="" width="18" height="18" />
            <span>Share</span>
          </button>
          
          {award.website ? (
            <a href={ensureProtocol(award.website)} target="_blank" class="footer-btn primary-btn">
              <span>Visit Website</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ) : (
             <div class="footer-btn disabled-btn">No Website Available</div>
          )}
        </div>
      </aside>
    </div>

    <section class="discovery-area">
      <div class="discovery-content">
        {relatedAwards.length > 0 && (
          <div class="discovery-section">
            <div class="section-top">
              <h2 class="discovery-title">Discover other awards</h2>
              <a href="/events/awards" class="discovery-see-all pill-link">
                Explore awards
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <div class="discovery-grid">
              {relatedAwards.map(a => (
                <div class="grid-item">
                  <EventBasicCard 
                    name={a.name}
                    slug={a.slug}
                    type="award"
                    date={formatDeadlinesShort(a.deadlines)}
                    image={normalizeImage(a.image, Astro)}
                    pillText={getAwardStatus(a.deadlines) === 'status-open' ? 'OPEN' : 'CLOSED'}
                    pillType={getAwardStatus(a.deadlines)}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: `Explore ${document.title.split('—')[0]} on Acceso`
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) { }
    });
  }
</script>

<style>
  .detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .breadcrumb-item { color: var(--color-gray); text-decoration: none; }
  .breadcrumb-separator { color: var(--color-gray); }
  .breadcrumb-current { color: var(--color-white); }

  .hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: flex-start;
    justify-content: flex-end;
  }

  .hero-image-wrapper {
    height: clamp(400px, 75vh, 850px);
    width: auto;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 1;
    display: flex;
    justify-content: center;
  }

  .hero-image {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
    border-radius: 8px;
  }

  .hero-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-mono);
  }

  .info-card {
    width: 400px;
    height: clamp(500px, 75vh, 700px);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
  }
  
  .info-card-content::-webkit-scrollbar { display: none; }
  .info-card::-webkit-scrollbar { display: none; }

  .tag-row { margin-bottom: 20px; }
  .status-pill {
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .status-open { background: var(--color-yellow); color: var(--color-black); }
  .status-closed { background: #333; color: var(--color-gray); }

  .item-name {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .item-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-gray);
    margin-bottom: 24px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .social-links { display: flex; gap: 8px; margin-bottom: 24px; }
  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    background: var(--color-btn-bg);
    border-radius: 10px;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s;
  }
  .social-btn:hover { background: #222528; }

  .details-section { background: var(--color-btn-bg); border-radius: 10px; padding: 16px; margin-bottom: 20px; }
  .details-row { display: flex; justify-content: space-between; align-items: center; }
  .detail-label { font-size: 15px; color: var(--color-gray); }
  .detail-value { font-size: 15px; font-weight: 700; color: var(--color-white); text-align: right; }

  .card-footer-actions { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 12px; 
    width: 100%;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }
  :global(.footer-btn) { display: flex; width: 100%; align-items: center; justify-content: center; gap: 10px; height: 48px; border-radius: 10px; font-weight: 700 !important; cursor: pointer; border: none; transition: transform 0.2s ease, opacity 0.2s ease; text-decoration: none; font-size: 15px; }
  :global(.footer-btn:active) { transform: scale(0.98); }
  :global(.share-btn) { background: #1C1E20 !important; color: var(--color-white) !important; border: 1px solid var(--color-stroke) !important; }
  .primary-btn { background: var(--color-white) !important; color: var(--color-black) !important; box-shadow: 0 10px 20px rgba(255, 255, 255, 0.05); }
  .primary-btn:hover { opacity: 0.9; }
  .disabled-btn { background: #111315 !important; color: var(--color-gray) !important; cursor: not-allowed; pointer-events: none; opacity: 0.5; border: 1px solid var(--color-stroke) !important; }

  .discovery-area { margin-top: 80px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .discovery-title { font-family: var(--font-mono); font-size: 24px; font-weight: 700; color: var(--color-white); }
  .discovery-see-all { flex-shrink: 0; }

  .discovery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }


  @media (max-width: 1200px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .hero-row { flex-direction: column; align-items: center; }
    .hero-image-wrapper { width: 100%; height: auto; min-height: 400px; aspect-ratio: 16/9; }
    .info-card { width: 100%; height: auto; max-width: 800px; }
    .detail-container { padding: 0 20px 40px; }
    .breadcrumbs-container { padding: 32px 20px 0; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
    .discovery-title { font-size: 20px; }
  }
</style>
