---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import SaveButton from '../../../components/SaveButton.astro';
import EventBasicCard from '../../../components/EventBasicCard.astro';
import { normalizeImage } from '../../../lib/images';
import { ensureProtocol } from '../../../lib/url';

const { slug } = Astro.params;

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let fair: any = null;
let relatedFairs: any[] = [];
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [fairsRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/fairs.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (fairsRes.ok) {
    const rawFairs = await fairsRes.json();
    const allFairs = Array.isArray(rawFairs) ? rawFairs : (rawFairs.items || []);
    
    const processedFairs = allFairs;

    fair = processedFairs.find(f => f.slug === slug) || null;

    if (fair) {
      // Discovery: Similar Fairs
      relatedFairs = processedFairs
        .filter(f => f.slug !== slug && (f.city_slug === fair.city_slug || f.country_slug === fair.country_slug))
        .sort((a, b) => (a.city_slug === fair.city_slug ? -1 : 1))
        .slice(0, 8);
    }
  }

  if (citiesRes.ok) citiesMapping = await citiesRes.json();
  if (countriesRes.ok) countriesMapping = await countriesRes.json();

} catch (e) {
  console.error('[Fair Slug] Fail to fetch data:', e);
}

if (!fair) {
  return Astro.redirect('/404');
}

function getPeriod(startStr: string, endStr: string) {
  if (!startStr) return "";
  const start = new Date(startStr);
  const end = endStr ? new Date(endStr) : null;
  const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const startDay = start.getDate();
  const startMonth = monthNames[start.getMonth()];
  if (!end || isNaN(end.getTime()) || startStr === endStr) return `${startMonth} ${startDay}, ${start.getFullYear()}`;
  const endDay = end.getDate();
  if (start.getMonth() === end.getMonth()) return `${startMonth} ${startDay}-${endDay}, ${start.getFullYear()}`;
  const endMonth = monthNames[end.getMonth()];
  return `${startMonth} ${startDay} - ${endMonth} ${endDay}, ${start.getFullYear()}`;
}

const countryName = fair.country || countriesMapping.find(c => c.slug === fair.country_slug)?.name || fair.country_slug;
const cityName = fair.city || citiesMapping.find(c => c.slug === fair.city_slug)?.name || fair.city_slug;

const pageTitle = `${fair.name} — Design Fair in ${cityName}`;
const pageDesc = fair.description || `Explore ${fair.name}, a premier design event in ${cityName}, ${countryName}.`;
---

<Layout title={pageTitle} description={pageDesc}>
  <Navbar />

  <div class="breadcrumbs-container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/events" class="breadcrumb-item">Events</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/events/fairs" class="breadcrumb-item">Fairs</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">{fair.name}</span>
    </nav>
  </div>

  <main class="fair-detail-container">
    <div class="hero-row">
      <div class="hero-image-wrapper">
        {fair.image ? (
          <img 
            src={normalizeImage(fair.image, Astro, { width: 1200 })} 
            alt={fair.name} 
            class="hero-image" 
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero-image-placeholder">No image available</div>
        )}
      </div>

      <aside class="info-card">
        <div class="info-card-content">
          <h1 class="fair-name">{fair.name}</h1>
          <p class="fair-description">
            {fair.description}
          </p>

          <div class="social-links">
            {fair.website && (
              <a href={ensureProtocol(fair.website)} target="_blank" class="social-btn">
                <img src="/icons/source.svg" alt="" width="16" height="16" />
                <span>Website</span>
              </a>
            )}
            {fair.instagram && (
              <a href={ensureProtocol(fair.instagram)} target="_blank" class="social-btn">
                <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                <span>Instagram</span>
              </a>
            )}
          </div>

          <div class="details-section">
            <div class="details-row">
              <span class="detail-label">Period</span>
              <span class="detail-value">{getPeriod(fair.start_date, fair.end_date)}</span>
            </div>
            <div class="details-divider"></div>
            <div class="details-row">
              <span class="detail-label">Location</span>
              <div class="detail-value-group">
                {fair.city_slug ? (
                  <a href={`/events/fairs/in/${fair.city_slug}`} class="detail-value underlined">{cityName}</a>
                ) : <span class="detail-value">{cityName}</span>}
                {cityName && countryName && <span class="detail-separator">,</span>}
                {fair.country_slug ? (
                  <a href={`/events/fairs/in/${fair.country_slug}`} class="detail-value underlined">{countryName}</a>
                ) : <span class="detail-value">{countryName}</span>}
              </div>
            </div>
          </div>
        </div>

        <div class="card-footer-actions">
          <button class="footer-btn share-btn" id="shareButton">
            <img src="/icons/share.svg" alt="" width="18" height="18" />
            <span>Share</span>
          </button>
          <button 
            class="footer-btn save-btn" 
            id="calendarBtn"
            data-name={fair.name}
            data-desc={fair.description}
            data-start={fair.start_date}
            data-end={fair.end_date || fair.start_date}
            data-url={fair.website}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Add to Calendar</span>
          </button>
        </div>
      </aside>
    </div>

    <section class="discovery-area">
      <div class="discovery-content">
        {relatedFairs.length > 0 && (
          <div class="discovery-section">
            <div class="section-top">
              <h2 class="discovery-title">Other fairs in the area</h2>
              <a href="/events/fairs" class="discovery-see-all pill-link">
                Explore fairs
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            <div class="discovery-grid">
              {relatedFairs.map(f => (
                <div class="grid-item">
                  <EventBasicCard 
                    name={f.name}
                    slug={f.slug}
                    type="fair"
                    location={f.city || cityName}
                    date={getPeriod(f.start_date, f.end_date)}
                    image={normalizeImage(f.image, Astro)}
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: `Check out ${document.title.split('—')[0]} on Acceso`
      };
      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) { }
    });
  }

  const calendarBtn = document.getElementById('calendarBtn');
  if (calendarBtn) {
    calendarBtn.addEventListener('click', () => {
      const { name, desc, start, end, url: website } = calendarBtn.dataset;
      const fmtStart = start.replace(/-/g, '').split('T')[0];
      const fmtEnd = end.replace(/-/g, '').split('T')[0];
      
      const icsData = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Acceso//Design Events//EN',
        'BEGIN:VEVENT',
        `DTSTART;VALUE=DATE:${fmtStart}`,
        `DTEND;VALUE=DATE:${fmtEnd}`,
        `SUMMARY:${name}`,
        `DESCRIPTION:${(desc || '').replace(/\n/g, '\\n')}\\n\\nWebsite: ${website || 'N/A'}`,
        `URL:${website || ''}`,
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      const blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8' });
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${name.toLowerCase().replace(/\s+/g, '-')}.ics`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
    });
  }
</script>

<style>
  .fair-detail-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 80px;
  }

  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .breadcrumb-item { color: var(--color-gray); text-decoration: none; }
  .breadcrumb-separator { color: var(--color-gray); }
  .breadcrumb-current { color: var(--color-white); }

  .hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: flex-start;
    justify-content: flex-end;
  }

  .hero-image-wrapper {
    height: clamp(400px, 75vh, 850px);
    width: auto;
    background: transparent;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 1;
    display: flex;
    justify-content: center;
  }

  .hero-image {
    height: 100%;
    width: auto;
    object-fit: contain;
    display: block;
    border-radius: 8px;
  }

  .hero-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    font-family: var(--font-mono);
  }

  .info-card {
    width: 400px;
    height: clamp(500px, 75vh, 700px);
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
  }
  
  .info-card-content::-webkit-scrollbar { display: none; }
  .info-card::-webkit-scrollbar { display: none; }

  .tag-row { margin-bottom: 16px; }
  .category-tag { font-family: var(--font-sans); font-size: 11px; font-weight: 400; text-transform: uppercase; color: var(--color-yellow); letter-spacing: 0.1em; }

  .fair-name {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .fair-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-gray);
    margin-bottom: 24px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .social-links { display: flex; gap: 8px; margin-bottom: 24px; }
  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    background: var(--color-btn-bg);
    border-radius: 10px;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
    transition: background 0.2s;
  }
  .social-btn:hover { background: #222528; }

  .details-section { background: var(--color-btn-bg); border-radius: 10px; padding: 16px; margin-bottom: 16px; }
  .details-row { display: flex; justify-content: space-between; align-items: center; }
  .detail-label { font-size: 14px; color: var(--color-gray); }
  .detail-value { font-size: 14px; font-weight: 400; color: var(--color-white); text-align: right; text-decoration: none; }
  .detail-value.underlined { text-decoration: underline; }
  .detail-value.underlined:hover { color: var(--color-yellow); }
  .detail-value-group { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
  .detail-separator { color: var(--color-gray); margin: 0 2px; font-weight: 400; }
  .details-divider { height: 1px; background: var(--color-stroke); margin: 12px 0; }

  .card-footer-actions { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 12px; 
    width: 100%;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
  }
  :global(.footer-btn) { display: flex; width: 100%; align-items: center; justify-content: center; gap: 10px; height: 48px; border-radius: 10px; font-weight: 400 !important; cursor: pointer; border: none; transition: opacity 0.2s ease; }
  :global(.share-btn) { background: var(--color-btn-bg) !important; color: var(--color-white) !important; }
  :global(.save-btn) { background: var(--color-white) !important; color: var(--color-black) !important; }

  .discovery-area { margin-top: 80px; }
  .section-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .discovery-title { font-family: var(--font-mono); font-size: 24px; font-weight: 400; color: var(--color-white); }
  .discovery-see-all { flex-shrink: 0; }

  .discovery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }


  @media (max-width: 1200px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .hero-row { flex-direction: column; align-items: center; }
    .hero-image-wrapper { width: 100%; height: auto; min-height: 400px; aspect-ratio: 16/9; }
    .info-card { width: 100%; height: auto; max-width: 800px; }
    .fair-detail-container { padding: 0 20px 40px; }
    .breadcrumbs-container { padding: 32px 20px 0; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
    .discovery-title { font-size: 20px; }
  }
</style>
