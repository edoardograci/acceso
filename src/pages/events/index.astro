---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import EventBasicCard from '../../components/EventBasicCard.astro';
import { normalizeImage } from '../../lib/images';

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

let fairs = [];
let museums = [];
let awards = [];
let metadata: any = null;

try {
  const [fRes, mRes, aRes, metaRes] = await Promise.all([
    fetch(`${domain}/fairs.json`),
    fetch(`${domain}/museums.json`),
    fetch(`${domain}/awards.json`),
    fetch(`${domain}/events-metadata.json`)
  ]);

  if (fRes.ok) {
    const data = await fRes.json();
    const allFairs = (Array.isArray(data) ? data : data.items || []).sort((a: any, b: any) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());
    const now = new Date();
    now.setHours(0, 0, 0, 0);

    // Find first fair that hasn't ended yet
    let startIndex = allFairs.findIndex((f: any) => {
        const endDate = f.end_date ? new Date(f.end_date) : new Date(f.start_date);
        return endDate >= now;
    });

    if (startIndex === -1) {
        // All fairs are in the past, take the last 4
        fairs = allFairs.slice(-4);
    } else {
        // We have upcoming fairs. We want to start from the current one, 
        // but if we're near the end of the list, we back up to ensure we get 4.
        const endPos = Math.min(startIndex + 4, allFairs.length);
        const startPos = Math.max(0, endPos - 4);
        fairs = allFairs.slice(startPos, endPos);
    }
  }
  if (mRes.ok) {
    const data = await mRes.json();
    museums = (Array.isArray(data) ? data : data.items || []).slice(0, 4);
  }
  if (aRes.ok) {
    const data = await aRes.json();
    awards = (Array.isArray(data) ? data : data.items || []).slice(0, 4);
  }
  if (metaRes.ok) metadata = await metaRes.json();
} catch (e) {
  console.error('[Events Index] Fail to fetch R2 data:', e);
}

function getPeriod(startStr: string, endStr: string) {
  if (!startStr) return "";
  const start = new Date(startStr);
  const end = endStr ? new Date(endStr) : null;
  const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  const startDay = start.getDate();
  const startMonth = monthNames[start.getMonth()];
  if (!end || isNaN(end.getTime()) || startStr === endStr) return `${startMonth} ${startDay}`;
  const endDay = end.getDate();
  if (start.getMonth() === end.getMonth()) return `${startMonth} ${startDay}-${endDay}`;
  const endMonth = monthNames[end.getMonth()];
  return `${startMonth} ${startDay} - ${endMonth} ${endDay}`;
}

function getAwardStatus(deadlinesStr: string) {
  if (!deadlinesStr) return null;
  const now = new Date();
  const dates = deadlinesStr.split(',').map(d => new Date(d.trim())).filter(d => !isNaN(d.getTime()));
  if (dates.length === 0) return null;
  const lastDeadline = new Date(Math.max(...dates.map(d => d.getTime())));
  const deadlineEnd = new Date(lastDeadline);
  deadlineEnd.setHours(23, 59, 59, 999);
  return deadlineEnd > now ? 'status-open' : 'status-closed';
}

const sections = [
  { 
    title: 'Next fairs', 
    cardTitle: 'Fairs',
    items: fairs.map(f => ({
      ...f,
      pillText: getPeriod(f.start_date, f.end_date),
      pillType: 'default',
      location: f.city || f.location
    })), 
    slug: 'fairs',
    description: "Global design weeks, biennials, and furniture trade shows.",
    coverImage: normalizeImage('fairs-cover.webp', Astro)
  },
  { 
    title: 'Museums & Foundations', 
    items: museums.map(m => ({
      ...m,
      location: m.city || m.location
    })), 
    slug: 'museums',
    description: "Permanent collections and institutions preserving design history.",
    coverImage: normalizeImage('museums-cover.webp', Astro)
  },
  { 
    title: 'Awards', 
    items: awards.map(a => {
      const st = getAwardStatus(a.deadlines);
      const deadlineDate = a.deadlines ? new Date(Math.max(...a.deadlines.split(',').map(d => new Date(d.trim()).getTime()))) : null;
      return {
        ...a,
        pillText: st === 'status-open' ? 'OPEN' : 'CLOSED',
        pillType: st,
        location: deadlineDate ? `Deadline: ${deadlineDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}` : ''
      };
    }), 
    slug: 'awards',
    description: "The most prestigious recognitions in industrial design worldwide.",
    coverImage: normalizeImage('awards-cover.webp', Astro)
  }
];
---

<Layout 
  title="Design Events | Acceso"
  description="Discover the world of design through a curated index of Fairs, Museums, and Awards."
>
  <Navbar />
  
  <main class="events-page">
    <div class="page-container">
      <header class="events-header">
        <h1 class="page-title">Events</h1>
        <p class="page-subtitle">A curated index of the most influential design fairs, museums and awards worldwide.</p>
      </header>

      <!-- Bento Grid Selection -->
      <div class="bento-grid">
        {sections.map(section => (
          <a href={`/events/${section.slug}`} class="bento-card">
            <div class="card-image-bg">
              <img 
                src={section.coverImage} 
                alt={section.title} 
                loading="lazy"
                decoding="async"
              />
              <div class="card-overlay"></div>
            </div>
            <div class="card-bg"></div>
            <div class="card-content">
              <div class="card-top"></div>
              <div class="card-bottom">
                <h2 class="section-title">{section.cardTitle || section.title}</h2>
                <p class="section-desc">{section.description}</p>
                <div class="section-link">
                   <span>Explore</span>
                   <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                     <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                   </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Quick Directory Sections -->
      <div class="directory-sections">
        {sections.map(section => (
          <section class="directory-section">
            <div class="section-header">
              <h2 class="directory-name">{section.title}</h2>
              <a href={`/events/${section.slug}`} class="discovery-see-all pill-link">
                See all
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
            
            <div class="section-grid">
              {section.items.map((item: any) => (
                <div class="event-card-wrapper">
                  <EventBasicCard 
                    name={item.name}
                    slug={item.slug}
                    type={section.slug === 'fairs' ? 'fair' : section.slug === 'museums' ? 'museum' : 'award'}
                    location={item.location}
                    image={normalizeImage(item.image, Astro)}
                    pillText={item.pillText}
                    pillType={item.pillType}
                  />
                </div>
              ))}
              {section.items.length === 0 && <p class="empty-state">No upcoming {section.title.toLowerCase()} found.</p>}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .events-page { background: var(--color-black); min-height: 100vh; padding-bottom: 80px; }
  .page-container { max-width: 1600px; margin: 0 auto; padding: var(--page-top-spacing) 40px 32px; }
  .events-header { margin-bottom: 64px; }
  .page-title { font-family: var(--font-mono); font-size: 56px; font-weight: 700; color: var(--color-white); margin: 0 0 16px; letter-spacing: -0.04em; }
  .page-subtitle { font-family: var(--font-sans); font-size: 18px; color: var(--color-gray); max-width: 600px; line-height: 1.5; }

  /* Bento Grid */
  .bento-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 120px; }
  .bento-card { position: relative; height: 520px; background: #0F1113; border-radius: 24px; border: 1px solid var(--color-stroke); overflow: hidden; text-decoration: none; transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1); }
  .bento-card:hover { transform: translateY(-8px); border-color: rgba(237, 254, 68, 0.5); background: #191B1D; }
  
  .card-image-bg { position: absolute; inset: 0; z-index: 0; }
  .card-image-bg img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1); }
  .bento-card:hover .card-image-bg img { transform: scale(1.05); }
  .card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, #0F1113 0%, rgba(15, 17, 19, 0.8) 40%, rgba(15, 17, 19, 0.2) 100%); z-index: 1; }

  .card-bg { position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(237, 254, 68, 0.05), transparent 60%); opacity: 0; transition: opacity 0.3s ease; z-index: 2; }
  .bento-card:hover .card-bg { opacity: 1; }
  .card-content { position: relative; z-index: 3; height: 100%; padding: 40px; display: flex; flex-direction: column; justify-content: space-between; }
  .section-title { font-family: var(--font-mono); font-size: 32px; font-weight: 700; color: var(--color-white); margin: 0 0 16px; letter-spacing: -0.02em; }
  .section-desc { font-family: var(--font-sans); font-size: 15px; color: var(--color-gray); margin-bottom: 32px; line-height: 1.5; }
  .section-link { display: flex; align-items: center; gap: 8px; color: var(--color-yellow); font-family: var(--font-sans); font-size: 16px; font-weight: 700; }
  .section-link svg { transition: transform 0.2s ease; }
  .bento-card:hover .section-link svg { transform: translateX(4px); }

  /* Directory Sections */
  .directory-sections { display: flex; flex-direction: column; gap: 100px; }
  .section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 20px; }
  .directory-name { font-family: var(--font-mono); font-size: 32px; font-weight: 700; color: var(--color-white); margin: 0; letter-spacing: -0.02em; }
  
  .discovery-see-all { flex-shrink: 0; }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .event-card-wrapper {
    width: 100%;
  }

  .empty-state { color: var(--color-gray); font-family: var(--font-sans); font-size: 14px; padding: 20px 0; }

  @media (max-width: 1200px) {
    .bento-grid { grid-template-columns: 1fr; }
    .bento-card { height: 320px; }
    .section-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .section-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .page-title { font-size: 40px; }
    .page-container { padding: 24px 20px; }
    .horizontal-scroll { margin: 0 -20px; padding: 0 20px; }
    .directory-name { font-size: 24px; }
  }
</style>
