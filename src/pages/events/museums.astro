---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import EventBasicCard from '../../components/EventBasicCard.astro';

// R2 URLs
const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;
const imageDomain = isDev ? 'https://img.acceso.design' : `${Astro.url.origin}/cdn`;

let museums: any[] = [];
let metadata: any = null;
let citiesMapping: any[] = [];
let countriesMapping: any[] = [];

try {
  const [musRes, metaRes, citiesRes, countriesRes] = await Promise.all([
    fetch(`${domain}/museums.json`),
    fetch(`${domain}/events-metadata.json`),
    fetch(`${domain}/test-cities.json`),
    fetch(`${domain}/test-countries.json`)
  ]);

  if (musRes.ok) {
    const rawData = await musRes.json();
    museums = Array.isArray(rawData) ? rawData : (rawData.items || []);
  }
  if (metaRes.ok) metadata = await metaRes.json();
  
  if (citiesRes.ok) {
    const rawCities = await citiesRes.json();
    const seenSlugs = new Set();
    citiesMapping = rawCities.filter((city: any) => {
      if (seenSlugs.has(city.slug)) return false;
      seenSlugs.add(city.slug);
      return true;
    });
  }
  
  if (countriesRes.ok) {
    const rawCountries = await countriesRes.json();
    const seenSlugs = new Set();
    countriesMapping = rawCountries.filter((c: any) => {
      if (seenSlugs.has(c.slug)) return false;
      seenSlugs.add(c.slug);
      return true;
    });
  }
} catch (e) {
  console.error('[Museums Page] Fail to fetch R2 data:', e);
}

// Enrich museums with country data
const enrichedMuseums = museums.map((m: any) => {
  let countrySlug = m.country_slug;
  let countryName = m.country;
  if (!countrySlug && m.city_slug) {
    const cityMap = citiesMapping.find(c => c.slug === m.city_slug);
    if (cityMap) {
      countrySlug = cityMap.country;
      const countryMap = countriesMapping.find(c => c.slug === countrySlug);
      if (countryMap) countryName = countryMap.name;
    }
  }
  return { ...m, country_slug: countrySlug, country: countryName };
});

// Pillar Cities for Pills
const pillarCities = ['Milan', 'Berlin', 'Copenhagen', 'London', 'Paris', 'Seoul', 'Stockholm', 'Tokyo'];

// Generate Filter Data
const musCities = metadata?.museums?.byCity || {};
const filterData = countriesMapping.map(country => {
    const countryCities = citiesMapping
        .filter(city => city.country === country.slug && musCities[city.slug])
        .map(city => ({ 
            name: city.name, 
            slug: city.slug, 
            count: musCities[city.slug] 
        }));
    if (countryCities.length > 0) {
        return { 
            name: country.name, 
            slug: country.slug, 
            cities: countryCities,
            totalCount: countryCities.reduce((acc, c) => acc + c.count, 0)
        };
    }
    return null;
}).filter(Boolean).sort((a: any, b: any) => a.name.localeCompare(b.name));

const pageSubtitle = "A directory of permanent collections and institutions preserving design culture and history.";
---

<Layout 
  title="Museums & Foundations | Acceso"
  description={pageSubtitle}
>
  <Navbar />
  
  <main class="category-page">
    <div class="page-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/events" class="breadcrumb-link">Events</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">Museums & Foundations</span>
      </nav>

      <header class="page-header">
        <div class="title-group">
          <h1 class="page-title">Museums & Foundations</h1>
          <p class="page-subtitle">{pageSubtitle}</p>
        </div>

        <div class="search-filter-section">
          <div class="city-filter-row">
            <div class="filter-popover-wrapper">
              <button class="filter-trigger-btn" id="filter-trigger">Filter</button>
              <div class="filter-popover" id="filter-popover">
                <div class="filter-popover-header">
                  <span>Filter by location</span>
                  <div class="filter-header-actions">
                    <button class="filter-clear-all" id="filter-clear-all">Clear all</button>
                    <button class="filter-close-btn" id="filter-close-btn">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                         <path d="M18 6L6 18M6 6l12 12" />
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="filter-popover-content">
                  {filterData.map((group: any) => (
                    <div class="filter-group">
                      <label class="filter-item country-item">
                        <input type="checkbox" class="country-checkbox" data-slug={group.slug} />
                        <span class="filter-name">{group.name}</span>
                        <span class="filter-count">({group.totalCount})</span>
                      </label>
                      <div class="city-items">
                        {group.cities.map((city: any) => (
                          <label class="filter-item city-item">
                            <input type="checkbox" class="city-checkbox" data-slug={city.slug} data-country={group.slug} />
                            <span class="filter-name">{city.name}</span>
                            <span class="filter-count">({city.count})</span>
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <div class="city-filter-bar">
              <div class="city-filter-scroll" id="city-filters">
                <button class="city-pill active" data-city="all">All</button>
                {pillarCities.map(city => (
                  <button class="city-pill" data-city={city.toLowerCase()}>{city}</button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="results-meta">
        <p class="results-count" id="results-count">{enrichedMuseums.length} results</p>
      </div>

      <div class="items-grid" id="items-grid">
        {enrichedMuseums.map((museum: any) => (
          <div class="grid-item" data-name={museum.name.toLowerCase()} data-city={(museum.city_slug || '').toLowerCase()} data-country={(museum.country_slug || '').toLowerCase()}>
            <EventBasicCard 
              name={museum.name}
              slug={museum.slug}
              type="museum"
              location={museum.city ? (museum.country ? `${museum.city}, ${museum.country}` : museum.city) : (museum.location || '')}
              image={museum.image ? (museum.image.startsWith('http') ? museum.image : `${imageDomain}/${museum.image}`) : null}
            />
          </div>
        ))}
      </div>

      <div id="pagination-container" class="pagination-wrapper"></div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .category-page { background: var(--color-black); min-height: 100vh; padding-bottom: 80px; }
  .page-container { max-width: 1600px; margin: 0 auto; padding: var(--page-top-spacing) 40px 32px; }
  .breadcrumbs { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 14px; margin-bottom: 24px; }
  .breadcrumb-link { color: var(--color-gray); text-decoration: none; transition: color 0.2s ease; }
  .breadcrumb-link:hover { color: var(--color-white); }
  .breadcrumb-separator { color: var(--color-gray); opacity: 0.5; }
  .breadcrumb-current { color: var(--color-white); }
  
  .page-header { margin-bottom: 48px; }
  .title-group { margin-bottom: 40px; }
  .page-title { font-family: var(--font-mono); font-size: 48px; font-weight: 700; color: var(--color-white); margin: 0 0 16px; letter-spacing: -0.04em; }
  .page-subtitle { font-family: var(--font-sans); font-size: 16px; color: var(--color-gray); max-width: 600px; line-height: 1.5; }
  
  .search-filter-section { display: flex; flex-direction: column; gap: 24px; }
  .search-input { width: 100%; height: 56px; background: #111315; border: 1px solid var(--color-stroke); border-radius: 12px; padding: 0 20px; color: var(--color-white); font-family: var(--font-sans); font-size: 15px; outline: none; transition: border-color 0.2s ease; }
  .search-input:focus { border-color: var(--color-yellow); }
  
  .city-filter-row { display: flex; align-items: center; position: relative; z-index: 200; }
  .city-filter-bar { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(to right, black 85%, transparent 100%); -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%); cursor: grab; user-select: none; }
  .city-filter-bar::-webkit-scrollbar { display: none; }
  .city-filter-scroll { display: flex; gap: 8px; padding: 4px 0; align-items: center; width: max-content; }
  
  .filter-popover-wrapper { position: relative; flex-shrink: 0; z-index: 400; margin-right: 12px; }
  .filter-trigger-btn { height: 36px; padding: 0 16px; background: var(--color-yellow); color: var(--color-black); border: none; border-radius: 999px; font-family: var(--font-sans); font-size: 15px; font-weight: 700; cursor: pointer; transition: opacity 0.2s ease; }
  .filter-trigger-btn:hover { opacity: 0.9; }
  
  .filter-popover { position: absolute; top: calc(100% + 12px); left: 0; width: 600px; background: #1C1E20; border: 1px solid var(--color-stroke); border-radius: 16px; padding: 24px; z-index: 1500; display: none; box-shadow: 0 20px 40px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05); }
  .filter-popover.show { display: block !important; }
  .filter-popover-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-family: var(--font-sans); font-size: 16px; color: var(--color-white); font-weight: 600; }
  .filter-header-actions { display: flex; align-items: center; gap: 16px; }
  .filter-clear-all { background: transparent; border: none; color: var(--color-gray); font-size: 14px; text-decoration: underline; cursor: pointer; }
  
  .filter-popover-content { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; max-height: 400px; overflow-y: auto; padding-right: 12px; }
  .filter-popover-content::-webkit-scrollbar { width: 4px; }
  .filter-popover-content::-webkit-scrollbar-thumb { background: var(--color-stroke); border-radius: 10px; }
  
  .filter-group { display: flex; flex-direction: column; gap: 8px; }
  .filter-item { display: flex; align-items: center; gap: 10px; cursor: pointer; user-select: none; }
  .filter-name { font-family: var(--font-sans); font-size: 14px; color: var(--color-white) !important; font-weight: 600; }
  .filter-count { font-family: var(--font-mono); font-size: 10px; color: var(--color-gray); opacity: 0.8; }
  
  .filter-item input[type="checkbox"] { appearance: none; -webkit-appearance: none; width: 18px; height: 18px; border: 2px solid var(--color-stroke); border-radius: 4px; background: transparent; cursor: pointer; position: relative; }
  .filter-item input[type="checkbox"]:checked { background: var(--color-yellow); border-color: var(--color-yellow); }
  .filter-item input[type="checkbox"]:checked::after { content: ""; position: absolute; left: 5px; top: 2px; width: 4px; height: 8px; border: solid var(--color-black); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  
  .country-item { font-weight: 700; font-size: 15px; }
  .city-items { margin-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .city-item .filter-name { color: var(--color-white); opacity: 0.8; }
  
  .city-pill { flex-shrink: 0; height: 36px; padding: 0 16px; background: transparent; border: 1px solid var(--color-stroke); border-radius: 999px; color: var(--color-gray); font-family: var(--font-sans); font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; white-space: nowrap; }
  .city-pill:hover { border-color: var(--color-gray); color: var(--color-white); }
  .city-pill.active { background: var(--color-white); border-color: var(--color-white); color: var(--color-black); }
  
  .results-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .results-count { font-family: var(--font-sans); font-size: 15px; font-weight: 400; color: var(--color-white); margin: 0; }
  
  .items-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 24px; margin-bottom: 40px; }
  .grid-item { width: 100%; display: none; }
  
  .pagination-wrapper { display: flex; justify-content: center; align-items: center; gap: 16px; padding: 48px 0; border-top: 1px solid var(--color-stroke); margin-top: 40px; }
  :global(.pagination-btn) { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; border-radius: 50%; color: var(--color-nav-inactive); font-family: var(--font-sans); font-size: 14px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; }
  :global(.pagination-btn.active) { color: var(--color-white); cursor: default; }
  :global(.pagination-btn:disabled) { opacity: 0.2; cursor: not-allowed; }
  :global(.pagination-arrow) { background: #15181A !important; border: 1px solid var(--color-stroke) !important; color: var(--color-white); }

  @media (max-width: 1200px) {
    .items-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .items-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .items-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .page-title { font-size: 32px; }
    .filter-popover { width: calc(100vw - 40px); }
  }
</style>

<script define:vars={{ pillarCities }}>
  function init() {
    const searchInput = document.getElementById('search-input');
    const filterTrigger = document.getElementById('filter-trigger');
    const filterCloseBtn = document.getElementById('filter-close-btn');
    const filterPopover = document.getElementById('filter-popover');
    const filterClearAll = document.getElementById('filter-clear-all');
    const gridItems = document.querySelectorAll('.grid-item');
    const cityPills = document.querySelectorAll('.city-pill');
    const countryCheckboxes = document.querySelectorAll('.country-checkbox');
    const cityCheckboxes = document.querySelectorAll('.city-checkbox');
    const resultsCount = document.getElementById('results-count');
    const paginationContainer = document.getElementById('pagination-container');

    const pageUrlParams = new URLSearchParams(window.location.search);
    let selectedCountrySlug = pageUrlParams.get('country') || '';
    let selectedCitySlug = pageUrlParams.get('city') || '';
    let currentSearch = '';
    let currentCity = selectedCitySlug && pillarCities.map(c => c.toLowerCase()).includes(selectedCitySlug.toLowerCase()) ? selectedCitySlug.toLowerCase() : 'all';
    let currentPage = 1;
    const itemsPerPage = 12;

    if (selectedCitySlug || selectedCountrySlug) {
      if (currentCity !== 'all') {
        cityPills.forEach(p => {
          if (p.dataset.city === currentCity) p.classList.add('active');
          else p.classList.remove('active');
        });
      } else {
        cityPills.forEach(p => p.classList.remove('active'));
        const allPill = document.querySelector('.city-pill[data-city="all"]');
        allPill?.classList.add('active');
      }

      if (selectedCountrySlug) {
        countryCheckboxes.forEach(cb => { if (cb.dataset.slug === selectedCountrySlug) cb.checked = true; });
      }
      if (selectedCitySlug) {
        cityCheckboxes.forEach(cb => { if (cb.dataset.slug === selectedCitySlug) cb.checked = true; });
      }
    }

    function applyFilters(keepPage = false) {
      if (!keepPage) currentPage = 1;
      const visibleItems = Array.from(gridItems).filter(item => {
        const name = (item.dataset.name || '').toLowerCase();
        const city = (item.dataset.city || '').toLowerCase();
        const country = (item.dataset.country || '').toLowerCase();
        const matchesSearch = name.includes(currentSearch.toLowerCase());
        let matchesLoc = false;
        
        if (selectedCitySlug) matchesLoc = city === selectedCitySlug.toLowerCase();
        else if (selectedCountrySlug) matchesLoc = country === selectedCountrySlug.toLowerCase();
        else if (currentCity !== 'all') matchesLoc = city === currentCity.toLowerCase();
        else matchesLoc = true;

        return matchesSearch && matchesLoc;
      });

      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      
      gridItems.forEach(item => { item.style.display = 'none'; });
      visibleItems.forEach((item, index) => { 
        if (index >= start && index < end) {
          item.style.display = 'block';
        }
      });

      if (resultsCount) resultsCount.textContent = `${visibleItems.length} results`;
      renderPagination(visibleItems.length);
    }

    function renderPagination(total) {
      if (!paginationContainer) return;
      const pages = Math.ceil(total / itemsPerPage);
      if (pages <= 1) { paginationContainer.innerHTML = ''; return; }
      let html = `<button class="pagination-btn pagination-arrow" ${currentPage === 1 ? 'disabled' : ''} data-page="prev"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" /></svg></button>`;
      for (let i = 1; i <= pages; i++) html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      html += `<button class="pagination-btn pagination-arrow" ${currentPage === pages ? 'disabled' : ''} data-page="next"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" /></svg></button>`;
      paginationContainer.innerHTML = html;
      paginationContainer.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const p = e.currentTarget.dataset.page;
          if (p === 'prev') currentPage--; else if (p === 'next') currentPage++; else currentPage = parseInt(p);
          applyFilters(true); window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });
    }

    searchInput?.addEventListener('input', (e) => { currentSearch = e.target.value; applyFilters(); });
    cityPills.forEach(pill => {
      pill.addEventListener('click', () => {
        cityPills.forEach(p => p.classList.remove('active')); 
        pill.classList.add('active'); 
        currentCity = pill.dataset.city || 'all';
        selectedCountrySlug = ''; selectedCitySlug = ''; 
        countryCheckboxes.forEach(cb => cb.checked = false); 
        cityCheckboxes.forEach(cb => cb.checked = false);
        applyFilters();
      });
    });

    countryCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        if (cb.checked) {
          countryCheckboxes.forEach(o => { if (o !== cb) o.checked = false }); 
          cityCheckboxes.forEach(o => o.checked = false); 
          selectedCountrySlug = cb.dataset.slug || ''; 
          selectedCitySlug = '';
        } else selectedCountrySlug = '';
        currentCity = 'all'; cityPills.forEach(p => p.classList.remove('active'));
        const allPill = document.querySelector('.city-pill[data-city="all"]'); 
        allPill?.classList.add('active'); 
        applyFilters();
      });
    });

    cityCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        if (cb.checked) {
          cityCheckboxes.forEach(o => { if (o !== cb) o.checked = false }); 
          countryCheckboxes.forEach(o => o.checked = false); 
          selectedCitySlug = cb.dataset.slug || ''; 
          selectedCountrySlug = '';
        } else selectedCitySlug = '';
        currentCity = 'all'; cityPills.forEach(p => p.classList.remove('active'));
        const allPill = document.querySelector('.city-pill[data-city="all"]'); 
        allPill?.classList.add('active'); 
        applyFilters();
      });
    });

    filterClearAll?.addEventListener('click', () => {
      countryCheckboxes.forEach(cb => cb.checked = false); 
      cityCheckboxes.forEach(cb => cb.checked = false); 
      selectedCountrySlug = ''; selectedCitySlug = ''; 
      currentCity = 'all'; cityPills.forEach(p => p.classList.remove('active'));
      const allPill = document.querySelector('.city-pill[data-city="all"]'); 
      allPill?.classList.add('active'); 
      applyFilters();
    });

    filterTrigger?.addEventListener('click', (e) => { e.stopPropagation(); filterPopover?.classList.toggle('show'); });
    filterCloseBtn?.addEventListener('click', () => filterPopover?.classList.remove('show'));
    document.addEventListener('click', (e) => { if (filterPopover?.classList.contains('show') && !filterPopover?.contains(e.target) && e.target !== filterTrigger) filterPopover?.classList.remove('show'); });

    const slider = document.querySelector('.city-filter-bar');
    let isDown = false; let startX; let scrollLeft;
    slider?.addEventListener('mousedown', (e) => { isDown = true; startX = e.pageX - slider.offsetLeft; scrollLeft = slider.scrollLeft; });
    slider?.addEventListener('mouseleave', () => isDown = false); 
    slider?.addEventListener('mouseup', () => isDown = false);
    slider?.addEventListener('mousemove', (e) => { if (!isDown) return; e.preventDefault(); const x = e.pageX - slider.offsetLeft; slider.scrollLeft = scrollLeft - (x - startX) * 2; });

    applyFilters();
  }
  init();
  document.addEventListener('astro:after-swap', init);
</script>
