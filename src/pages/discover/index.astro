---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { normalizeImage } from '../../lib/images';
import { itemList } from '../../lib/seo/schema';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  images: ProductImage[];
  cover: string | null;
}

let moodboardItems: MoodboardItem[] = [];
let error = null;

try {
  const moodboardUrl = new URL('/cdn/moodboard.json', Astro.url.origin).toString();
  const response = await fetch(moodboardUrl);
  if (!response.ok) throw new Error('CDN Proxy Not Ready');
  moodboardItems = await response.json();
} catch (e) {
  try {
    const localUrl = new URL('/moodboard.json', Astro.url.origin);
    const localRes = await fetch(localUrl.toString());
    moodboardItems = await localRes.json();
  } catch (localErr) {
    error = localErr;
  }
}

const visibleItems = moodboardItems.filter((item) => item.cover);

// ── SEO: Canonical + ItemList schema ───────────────────────────────────────────
const canonical = new URL('/discover', Astro.site);
const discoverSchema = itemList({
  url: canonical.toString(),
  name: 'Industrial Design Projects | Acceso Discover',
  items: visibleItems.slice(0, 50).map((item) => ({
    name: item.name,
    url: new URL(`/discover/${item.slug}`, Astro.site).toString(),
  })),
});
---

<Layout
  title="Discover Design Inspiration | Acceso"
  description="A curated gallery of industrial design projects, furniture, and product photography from independent studios worldwide."
  canonical={canonical}
  schema={discoverSchema}
>
    <Navbar />

    <main class="discover-page">
      <div class="discover-inner">
        <header class="discover-hero">
          <h1 class="discover-title">Discover</h1>
          <p class="discover-description">
            Furniture and industrial design projects from independent studios worldwide. A design inspiration gallery revealing how designers approach materials, function, and form.
          </p>
        </header>

        {error ? (
          <div class="discover-empty">
            <p>Failed to load projects. Please try again later.</p>
          </div>
        ) : (
          <div class="discover-grid" id="discover-grid">
            {visibleItems.map((item) => (
              <a href={`/discover/${item.slug}`} class="discover-item">
                <img
                  src={normalizeImage(item.cover!, Astro, { width: 800 })}
                  alt={item.name}
                  class="discover-image"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ))}
          </div>

          <script is:inline>
            (function () {
              const grid = document.getElementById('discover-grid');
              if (!grid) return;
              const KEY = 'acceso:discover-aspect';
              const MAX = 1000;
              let cache;
              try { cache = JSON.parse(localStorage.getItem(KEY) || '{}'); }
              catch (e) { cache = {}; }

              const imgs = grid.querySelectorAll('img');
              imgs.forEach((img) => {
                const src = img.getAttribute('src');
                if (!src) return;
                if (cache[src]) img.style.aspectRatio = cache[src];

                const record = () => {
                  if (!img.naturalWidth || !img.naturalHeight) return;
                  const ar = img.naturalWidth + ' / ' + img.naturalHeight;
                  if (cache[src] !== ar) {
                    cache[src] = ar;
                    img.style.aspectRatio = ar;
                    try {
                      const keys = Object.keys(cache);
                      if (keys.length > MAX) delete cache[keys[0]];
                      localStorage.setItem(KEY, JSON.stringify(cache));
                    } catch (e) {}
                  }
                  img.classList.add('is-loaded');
                };

                if (img.complete && img.naturalWidth) record();
                else img.addEventListener('load', record, { once: true });
              });
            })();
          </script>
        )}
      </div>
    </main>

    <Footer />
</Layout>

<style>
  .discover-page {
    background: var(--color-white);
    min-height: calc(100vh - var(--navbar-height));
    padding: var(--page-top-spacing) 0 80px;
  }

  .discover-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .discover-hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 56px;
    max-width: 640px;
  }

  .discover-title {
    font-family: var(--font-sans);
    font-size: clamp(48px, 5.5vw, 80px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.08em;
    color: var(--color-black);
    margin: 0;
  }

  .discover-description {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 52ch;
  }

  @media (min-width: 1025px) {
    .discover-hero {
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0 48px;
      max-width: none;
    }

    .discover-description {
      max-width: min(52ch, 42vw);
    }
  }

  .discover-grid {
    columns: 2;
    column-gap: 16px;
  }

  .discover-item {
    display: block;
    break-inside: avoid;
    margin-bottom: 16px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .discover-item:hover {
    transform: translateY(-2px);
  }

  .discover-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    vertical-align: middle;
    border-radius: 12px;
    background-color: #e9e9e9;
    background-image: linear-gradient(
      100deg,
      #e9e9e9 30%,
      #f3f3f3 50%,
      #e9e9e9 70%
    );
    background-size: 200% 100%;
    animation: discover-shimmer 1.4s ease-in-out infinite;
  }

  .discover-image.is-loaded {
    animation: none;
    background-image: none;
    background-color: transparent;
  }

  @keyframes discover-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .discover-image { animation: none; }
  }

  .discover-empty {
    padding: 80px 0;
    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  @media (min-width: 768px) {
    .discover-grid {
      columns: 3;
      column-gap: 18px;
    }
  }

  @media (min-width: 1100px) {
    .discover-grid {
      columns: 4;
      column-gap: 20px;
    }
  }

  @media (min-width: 1400px) {
    .discover-grid {
      columns: 5;
    }
  }

  @media (max-width: 900px) {
    .discover-hero {
      margin-bottom: 48px;
    }
  }

  @media (max-width: 640px) {
    .discover-inner {
      padding: 0 16px;
    }

    .discover-grid {
      column-gap: 10px;
    }

    .discover-item {
      margin-bottom: 10px;
      border-radius: 10px;
    }
  }
</style>
