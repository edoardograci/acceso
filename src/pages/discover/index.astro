---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { normalizeImage } from '../../lib/images';
import { itemList } from '../../lib/seo/schema';
import { withCovers } from '../../lib/moodboard';
import WeeklySpotlight from '../../components/WeeklySpotlight.astro';
import DiscoverSidebar from '../../components/DiscoverSidebar.astro';

interface ProductImage {
  id: string;
  product_id: string;
  image_url: string;
  r2_key: string;
  position: number;
  created_at: string;
}

interface MoodboardItem {
  id: string;
  slug: string;
  name: string;
  designer: string | null;
  year: string | null;
  client: string | null;
  link: string | null;
  city: string | null;
  status: string;
  created_at: string;
  updated_at: string;
  dayToPost: string | null;
  images: ProductImage[];
  cover: string | null;
}

let moodboardItems: MoodboardItem[] = [];
let error = null;

try {
  const moodboardUrl = new URL('/cdn/moodboard.json', Astro.url.origin).toString();
  const response = await fetch(moodboardUrl);
  if (!response.ok) throw new Error('CDN Proxy Not Ready');
  moodboardItems = await response.json();
} catch (e) {
  try {
    const localUrl = new URL('/moodboard.json', Astro.url.origin);
    const localRes = await fetch(localUrl.toString());
    moodboardItems = await localRes.json();
  } catch (localErr) {
    error = localErr;
  }
}

const visibleItems = withCovers(moodboardItems)
  .filter((item) => item.cover)
  .sort((a, b) => new Date(b.dayToPost ?? 0).getTime() - new Date(a.dayToPost ?? 0).getTime());

// ── Weekly Spotlight ────────────────────────────────────────────────────────────
// The spotlight is the most recent week present in the data (Monday–Sunday, UTC),
// NOT the calendar week. This way, on Monday before the new 3 are pushed, last
// week's items stay in the spotlight instead of leaving it empty and rejoining the
// masonry early. Once newer items exist, the previous week automatically falls back
// into the grid.
function mondayOf(d: Date): Date {
  const day = d.getUTCDay(); // 0 = Sun … 6 = Sat
  const diff = day === 0 ? 6 : day - 1; // days since Monday
  return new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate() - diff));
}

const WEEK_MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
function formatWeekLabel(start: Date, endExclusive: Date): string {
  // endExclusive is the following Monday; step back one day to get Sunday.
  const end = new Date(endExclusive.getTime() - 24 * 60 * 60 * 1000);
  const f = (d: Date) => `${d.getUTCDate()} ${WEEK_MONTHS[d.getUTCMonth()]}`;
  return `${f(start)} – ${f(end)}`;
}

let spotlightItems: MoodboardItem[] = [];
let spotlightWeekLabel = '';
if (visibleItems.length) {
  const times = visibleItems
    .map((i) => new Date(i.dayToPost ?? 0).getTime())
    .filter((t) => !Number.isNaN(t));
  if (times.length) {
    const maxTime = Math.max(...times);
    const weekStart = mondayOf(new Date(maxTime));
    const weekEnd = new Date(weekStart.getTime() + 7 * 24 * 60 * 60 * 1000);
    spotlightWeekLabel = formatWeekLabel(weekStart, weekEnd);
    spotlightItems = visibleItems
      .filter((i) => {
        const t = new Date(i.dayToPost ?? 0).getTime();
        return !Number.isNaN(t) && t >= weekStart.getTime() && t < weekEnd.getTime();
      })
      .sort((a, b) => new Date(a.dayToPost ?? 0).getTime() - new Date(b.dayToPost ?? 0).getTime());
  }
}

const spotlightSlugs = new Set(spotlightItems.map((i) => i.slug));
const gridItems = visibleItems.filter((i) => !spotlightSlugs.has(i.slug));

// ── SEO: Canonical + ItemList schema ───────────────────────────────────────────
const canonical = new URL('/discover', Astro.site);
const discoverSchema = itemList({
  url: canonical.toString(),
  name: 'Industrial Design Projects | Acceso Discover',
  items: visibleItems.slice(0, 50).map((item) => ({
    name: item.name,
    url: new URL(`/discover/${item.slug}`, Astro.site).toString(),
  })),
});
---

<Layout
  title="Discover Design Inspiration | Acceso"
  description="A curated gallery of industrial design projects, furniture, and product photography from independent studios worldwide."
  canonical={canonical}
  schema={discoverSchema}
>
    <Navbar />

    <main class="discover-page">
      <div class="discover-inner">
        <header class="discover-hero">
          <h1 class="discover-title">Discover</h1>
          <p class="discover-description">
            Furniture and industrial design projects from independent studios worldwide. A design inspiration gallery revealing how designers approach materials, function, and form.
          </p>
        </header>

        {error ? (
          <div class="discover-empty">
            <p>Failed to load projects. Please try again later.</p>
          </div>
        ) : (
          <WeeklySpotlight items={spotlightItems} weekLabel={spotlightWeekLabel} />

          <div class="discover-layout">
            <div class="discover-grid" id="discover-grid">
              {gridItems.map((item) => (
                <a href={`/discover/${item.slug}`} class="discover-item">
                  <img
                    src={normalizeImage(item.cover!, Astro, { width: 800 })}
                    alt={item.name}
                    class="discover-image"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              ))}
            </div>

            <DiscoverSidebar />
          </div>

          <script is:inline>
            (function () {
              const grid = document.getElementById('discover-grid');
              if (!grid) return;
              const KEY = 'acceso:discover-aspect';
              const MAX = 1000;
              let cache;
              try { cache = JSON.parse(localStorage.getItem(KEY) || '{}'); }
              catch (e) { cache = {}; }

              const items = Array.from(grid.querySelectorAll('.discover-item'));
              const imgs = items.map((el) => el.querySelector('img')).filter(Boolean);

              // Decide every item's position up front (before images load) so the
              // masonry never reorders on screen. Items are absolutely positioned
              // from a precomputed aspect ratio; new images self-seed the cache.
              let placed = false;
              const columnCount = () => {
                const w = window.innerWidth;
                // Cap at 4 columns; the sidebar occupies its own fixed-width
                // container beside the grid (magazine-style layout).
                if (w >= 1100) return 4;
                if (w >= 768) return 3;
                return 2;
              };
              const gapFor = () => (window.innerWidth <= 640 ? 10 : window.innerWidth < 768 ? 16 : window.innerWidth < 1100 ? 18 : 20);

              const layout = () => {
                const cols = columnCount();
                const gap = gapFor();
                const totalGap = gap * (cols - 1);
                const colW = (grid.clientWidth - totalGap) / cols;
                const colH = new Array(cols).fill(0);

                grid.style.position = 'relative';

                items.forEach((el) => {
                  const img = el.querySelector('img');
                  const src = img && img.getAttribute('src');
                  const ar = src && cache[src] ? cache[src] : '1 / 1';
                  const [rw, rh] = ar.split('/').map((n) => parseFloat(n.trim()));
                  const ratio = rh && rw ? rh / rw : 1;
                  const h = colW * ratio;

                  let min = 0;
                  for (let i = 1; i < cols; i++) if (colH[i] < colH[min]) min = i;

                  const x = min * (colW + gap);
                  const y = colH[min];
                  el.style.position = 'absolute';
                  el.style.width = colW + 'px';
                  el.style.height = h + 'px';
                  el.style.transform = `translate(${x}px, ${y}px)`;
                  el.style.margin = '0';

                  const imgEl = el.querySelector('img');
                  if (imgEl) {
                    imgEl.style.aspectRatio = ar;
                    imgEl.style.width = '100%';
                    imgEl.style.height = '100%';
                    imgEl.style.objectFit = 'cover';
                  }

                  colH[min] += h + gap;
                });

                grid.style.height = Math.max(...colH) + 'px';
                placed = true;
              };

              // Seed aspect ratios from cache before first paint, then lay out.
              imgs.forEach((img) => {
                const src = img.getAttribute('src');
                if (src && cache[src]) img.style.aspectRatio = cache[src];
              });

              const onResize = () => { if (placed) layout(); };
              window.addEventListener('resize', onResize);

              const tryLayout = () => { if (!placed) layout(); };
              if (document.readyState !== 'loading') tryLayout();
              else window.addEventListener('DOMContentLoaded', tryLayout);
              // Safety: ensure layout even if load events are missed.
              window.addEventListener('load', tryLayout);
              setTimeout(tryLayout, 300);

              const record = (img) => {
                if (!img.naturalWidth || !img.naturalHeight) return;
                const ar = img.naturalWidth + ' / ' + img.naturalHeight;
                const src = img.getAttribute('src');
                if (src && cache[src] !== ar) {
                  cache[src] = ar;
                  try {
                    const keys = Object.keys(cache);
                    if (keys.length > MAX) delete cache[keys[0]];
                    localStorage.setItem(KEY, JSON.stringify(cache));
                  } catch (e) {}
                }
                img.classList.add('is-loaded');
                // Ratio may have changed from the placeholder → recompute positions.
                if (placed) layout();
              };

              imgs.forEach((img) => {
                if (img.complete && img.naturalWidth) record(img);
                else img.addEventListener('load', () => record(img), { once: true });
              });
            })();
          </script>
        )}
      </div>
    </main>

    <Footer />
</Layout>

<style>
  .discover-page {
    background: var(--color-white);
    min-height: calc(100vh - var(--navbar-height));
    padding: var(--page-top-spacing) 0 80px;
  }

  .discover-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .discover-hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    margin-bottom: 56px;
    max-width: 640px;
  }

  .discover-title {
    font-family: var(--font-sans);
    font-size: clamp(48px, 5.5vw, 80px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.08em;
    color: var(--color-black);
    margin: 0;
  }

  .discover-description {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 52ch;
  }

  @media (min-width: 1025px) {
    .discover-hero {
      flex-direction: row;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 0 48px;
      max-width: none;
    }

    .discover-description {
      max-width: min(52ch, 42vw);
    }
  }

  .discover-layout {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .discover-grid {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (max-width: 1099px) {
    .discover-layout {
      display: block;
    }
  }

  .discover-item {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    will-change: transform;
  }

  .discover-item:hover .discover-image {
    transform: scale(1.02);
  }

  .discover-image {
    transition: transform 0.2s ease;
  }

  .discover-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    vertical-align: middle;
    border-radius: 12px;
    background-color: #e9e9e9;
    background-image: linear-gradient(
      100deg,
      #e9e9e9 30%,
      #f3f3f3 50%,
      #e9e9e9 70%
    );
    background-size: 200% 100%;
    animation: discover-shimmer 1.4s ease-in-out infinite;
  }

  .discover-image.is-loaded {
    animation: none;
    background-image: none;
    background-color: transparent;
  }

  @keyframes discover-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .discover-image { animation: none; }
  }

  .discover-empty {
    padding: 80px 0;
    text-align: center;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  @media (max-width: 900px) {
    .discover-hero {
      margin-bottom: 48px;
    }
  }

  @media (max-width: 640px) {
    .discover-inner {
      padding: 0 16px;
    }

    .discover-item {
      border-radius: 10px;
    }

    .discover-image {
      border-radius: 10px;
    }
  }
</style>
