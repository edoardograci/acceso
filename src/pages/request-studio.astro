---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Request a Studio - Acceso">
  <Navbar />
  <main class="request-page">
    <div class="request-container">
      <div id="request-form-section">
        <header class="request-header">
          <h1 class="request-title">Request a studio</h1>
          <p class="request-subtitle">
            Acceso grows through careful curation. Submissions help us surface independent studios that may be overlooked. Every request is reviewed by our team.
          </p>
        </header>

        <form id="request-form" class="request-form">
          {/* Choice Selector */}
          <div class="form-group">
            <label class="field-label">What would you like to do?</label>
            <div class="choice-selector">
              <label class="choice-option">
                <input type="radio" name="request_type" value="own_studio" class="choice-input" checked>
                <div class="choice-card">
                  <span class="choice-text">Add my own studio</span>
                </div>
              </label>
              <label class="choice-option">
                <input type="radio" name="request_type" value="suggest_studio" class="choice-input">
                <div class="choice-card">
                  <span class="choice-text">Suggest a studio</span>
                </div>
              </label>
            </div>
          </div>

          {/* Form Fields */}
          <div class="form-fields">
            <div class="form-group">
              <label for="name" class="field-label">Studio Name</label>
              <input type="text" id="name" name="name" class="text-input" required placeholder="e.g. Studio Name" />
            </div>

            <div class="form-group">
              <label for="website" class="field-label">Website URL</label>
              <input type="url" id="website" name="website" class="text-input" required placeholder="https://..." />
            </div>

            <div class="form-group">
              <label for="city" class="field-label">City</label>
              <input type="text" id="city" name="city" class="text-input" required placeholder="e.g. Milan" />
            </div>
          </div>

          <button type="submit" class="submit-btn" id="submit-btn">
            Submit request
          </button>
        </form>
      </div>

      {/* Success Message (Hidden by default) */}
      <div id="success-message" class="success-message" style="display: none;">
        <div class="success-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="success-title">Request received</h2>
        <p class="success-description">
          Thank you for your submission. Our team reviews every request to ensure it fits our curation criteria.
        </p>
        <p class="success-note">
          Please note that not all submissions are accepted, and we will only reach out if we need more information.
        </p>
        <a href="/" class="return-link">Return to home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.getElementById('request-form');
  const formSection = document.getElementById('request-form-section');
  const successMessage = document.getElementById('success-message');
  const submitBtn = document.getElementById('submit-btn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form as HTMLFormElement);
      const data = {
        type: formData.get('request_type'),
        name: formData.get('name'),
        website: formData.get('website'),
        city: formData.get('city')
      };

      if (submitBtn) {
        submitBtn.textContent = 'Submitting...';
        (submitBtn as HTMLButtonElement).disabled = true;
      }

      try {
        const response = await fetch('/api/requests/studio', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          // Show success
          if (formSection) formSection.style.display = 'none';
          if (successMessage) successMessage.style.display = 'flex';
          window.scrollTo(0, 0);
        } else {
          const resData = await response.json();
          alert(resData.error || 'Something went wrong. Please try again.');
          if (submitBtn) {
            submitBtn.textContent = 'Submit request';
            (submitBtn as HTMLButtonElement).disabled = false;
          }
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Something went wrong. Please try again.');
        if (submitBtn) {
          submitBtn.textContent = 'Submit request';
          (submitBtn as HTMLButtonElement).disabled = false;
        }
      }
    });
  }
</script>

<style>
  .request-page {
    background: var(--color-black);
    min-height: 100vh;
    padding-top: 80px;
    display: flex;
    flex-direction: column;
  }

  .request-container {
    max-width: 600px;
    width: 100%;
    margin: 0 auto;
    padding: 60px var(--spacing-page) 120px;
    flex: 1;
  }

  .request-header {
    margin-bottom: 48px;
    text-align: center;
  }

  .request-title {
    font-family: var(--font-mono);
    font-size: 40px;
    font-weight: 400;
    color: var(--color-white);
    margin: 0 0 16px;
    letter-spacing: -0.02em;
  }

  .request-subtitle {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    max-width: 480px;
    margin: 0 auto;
  }

  .request-form {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .field-label {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-white);
  }

  /* Choice Selector */
  .choice-selector {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .choice-option {
    cursor: pointer;
    position: relative;
  }

  .choice-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .choice-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 6px;
    padding: 16px;
    text-align: center;
    transition: all 0.2s ease;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .choice-text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-gray);
    transition: color 0.2s ease;
  }

  /* Checked State */
  .choice-input:checked + .choice-card {
    border-color: var(--color-yellow);
    background: rgba(234, 240, 6, 0.05);
  }

  .choice-input:checked + .choice-card .choice-text {
    color: var(--color-yellow);
  }

  .choice-card:hover {
    border-color: var(--color-gray);
  }

  /* Text Inputs */
  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .text-input {
    width: 100%;
    height: 48px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 6px;
    padding: 0 16px;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-white);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .text-input:focus {
    border-color: var(--color-yellow);
  }

  .text-input::placeholder {
    color: #555;
  }

  /* Submit Button */
  .submit-btn {
    width: 100%;
    height: 48px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 8px;
  }

  .submit-btn:hover {
    border-color: var(--color-white);
    transform: translateY(-2px);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Success Message */
  .success-message {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px 0;
    animation: fadeIn 0.5s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .success-icon {
    width: 48px;
    height: 48px;
    background: rgba(46, 204, 113, 0.1);
    border: 1px solid rgba(46, 204, 113, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2ecc71;
    margin-bottom: 24px;
  }

  .success-title {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 400;
    color: var(--color-white);
    margin: 0 0 16px;
  }

  .success-description {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-white);
    margin: 0 0 16px;
  }

  .success-note {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0 0 32px;
    max-width: 400px;
  }

  .return-link {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-yellow);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .return-link:hover {
    border-color: var(--color-yellow);
  }

  @media (max-width: 768px) {
    .request-container {
      padding: 40px var(--spacing-page) 80px;
    }
    
    .request-title {
      font-size: 32px;
    }

    .choice-selector {
      grid-template-columns: 1fr;
    }
  }
</style>
