---
import PostHogLayout from '../layouts/PostHogLayout.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const user = Astro.locals.user;
---

<PostHogLayout 
  title="Get Listed - Join Acceso | Acceso"
  description="Secure your place on Acceso. Join a curated selection of independent industrial and furniture design studios. Permanent presence, one-time payment."
>
  <Layout title="Get Listed - Join Acceso | Acceso">
    <Navbar />
    
    <main class="get-listed-page">
      {/* REFINED PURPLE HILL - Monochrome Atmosphere */}
      <div class="mesh-canvas">
        <div class="noise-grain"></div>
      </div>
      
      <div class="page-content">
        <!-- Hero Stage -->
        <section class="hero-stage">
          <div class="hero-inner animate-slide-up">
            <h1 class="hero-headline">Secure your place<br/>on Acceso</h1>
            <p class="hero-subheadline">
              Join a curated selection of independent design studios.<br/>
              One-time payment. Permanent presence.
            </p>

            <div class="price-block">
              <div class="price-text">
                <span class="currency">€</span>
                <span class="amount">120</span>
                <span class="details">one-time</span>
              </div>
              <div class="pricing-badge">
                <span>Early access pricing</span>
              </div>
            </div>

            <div class="action-container">
              {user ? (
                <a href="/submission" class="btn-cta">
                  Start submission
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              ) : (
                <a href="/login" class="btn-cta">
                  Get listed
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
              <p class="subscription-note">Permanent listing. No subscriptions.</p>
            </div>
          </div>
        </section>

        <!-- Feature Matrix -->
        <section class="feature-matrix animate-fade-in">
          <div class="matrix-grid">
            <div class="matrix-item">
              <span class="matrix-star">✦</span>
              <p>Studio profile with image, links & description</p>
            </div>
            <div class="matrix-item">
              <span class="matrix-star">✦</span>
              <p>Presence across maps and city listings</p>
            </div>
            <div class="matrix-item">
              <span class="matrix-star">✦</span>
              <p>Permanent placement (no renewals)</p>
            </div>
            <div class="matrix-item">
              <span class="matrix-star">✦</span>
              <p>Manual review before publication</p>
            </div>
          </div>
          
          <div class="guarantee-tag">
             <p>All submissions are reviewed. If not approved, you will be fully refunded.</p>
          </div>
        </section>
      </div>

      <svg style="display: none;">
        <filter id="grainyNoise">
          <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="3" stitchTiles="stitch" />
          <feColorMatrix type="saturate" values="0" />
        </filter>
      </svg>
    </main>

    <Footer />
  </Layout>

  <style>
    .get-listed-page {
      background: #0F1113;
      color: #FFFFFF;
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      font-family: var(--font-sans);
    }

    /* REFINED BROAD HILL - Lowered version */
    .mesh-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: #0F1113;
      /* Massive Hill Body: Sunk lower (165% Y) */
      background-image: 
        linear-gradient(to top, #0F1113 0%, transparent 40%),
        radial-gradient(
          ellipse 150% 160% at 50% 165%,
          #F3E8FF 0%,
          rgba(243, 232, 255, 0.4) 30%,
          rgba(243, 232, 255, 0.1) 60%,
          transparent 90%
        );
    }

    .mesh-canvas::before {
      content: '';
      position: absolute;
      inset: 0;
      /* Broad Core Glow: Sunk lower (160% Y) */
      background: radial-gradient(
        ellipse 120% 100% at 50% 160%,
        rgba(243, 232, 255, 0.3) 0%,
        transparent 80%
      );
    }

    .mesh-canvas::after {
      content: '';
      position: absolute;
      inset: 0;
      /* Top Halo: Spans full width */
      background: radial-gradient(
        ellipse 100% 80% at 50% 5%,
        rgba(243, 232, 255, 0.1) 0%,
        transparent 100%
      );
    }

    .noise-grain {
      position: absolute;
      inset: 0;
      opacity: 0.02;
      filter: url(#grainyNoise);
      mix-blend-mode: overlay;
    }

    .page-content {
      position: relative;
      z-index: 10;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 40px;
    }

    /* HERO STAGE - PULLED HIGHER */
    .hero-stage {
      padding: var(--page-top-spacing) 0 60px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero-headline {
      font-family: var(--font-mono);
      font-size: 64px;
      font-weight: 400;
      line-height: 0.95;
      margin-bottom: 24px;
      letter-spacing: 0;
    }

    .hero-subheadline {
      font-size: 18px;
      color: #FFFFFF;
      opacity: 0.8;
      line-height: 1.6;
      max-width: 580px;
      margin-bottom: 56px;
    }

    .price-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 48px;
    }

    .price-text {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }

    .currency {
      font-family: var(--font-sans);
      font-size: 24px;
      font-weight: 400;
      color: #FFFFFF;
      opacity: 0.8;
    }

    .amount {
      font-family: var(--font-sans);
      font-size: 104px;
      font-weight: 400;
      color: #FFFFFF;
      letter-spacing: 0;
      line-height: 1;
    }

    .details {
      font-size: 16px;
      font-weight: 400;
      color: #FFFFFF;
      opacity: 0.7;
      margin-left: 12px;
    }

    .pricing-badge {
      margin-top: 16px;
    }

    .pricing-badge span {
      font-size: 11px;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-yellow);
      background: rgba(237, 254, 68, 0.08);
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid rgba(237, 254, 68, 0.2);
    }

    .action-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .btn-cta {
      height: 52px;
      padding: 0 40px;
      background: #FFFFFF;
      color: #000;
      border-radius: 12px;
      font-weight: 700;
      font-size: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.3s ease;
    }

    .btn-cta:hover {
      background: var(--color-yellow);
      box-shadow: none;
    }

    .subscription-note {
      font-size: 14px;
      font-weight: 400;
      color: #FFFFFF;
      opacity: 0.7;
      margin-top: 8px;
    }

    /* FEATURE MATRIX */
    .feature-matrix {
      max-width: 1000px;
      margin: 0 auto 120px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 64px;
    }

    .matrix-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 100px;
      width: 100%;
    }

    .matrix-item {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .matrix-star {
      color: var(--color-yellow);
      font-size: 20px;
      line-height: 1;
      width: 20px;
      text-align: center;
    }

    .matrix-item p {
      margin: 0;
      font-size: 16px;
      color: #D1D2D3;
      font-weight: 400;
    }

    .guarantee-tag {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      padding: 16px 32px;
      border-radius: 999px;
    }

    .guarantee-tag p {
      margin: 0; font-size: 14px; color: var(--color-gray);
    }

    .animate-slide-up { animation: heroSlideUp 1s cubic-bezier(0.19, 1, 0.22, 1) forwards; }
    .animate-fade-in { opacity: 0; animation: fadeIn 1s ease-out 0.4s forwards; }

    @keyframes heroSlideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @media (max-width: 768px) {
      .hero-headline { font-size: 48px; }
      .amount { font-size: 72px; }
      .matrix-grid { grid-template-columns: 1fr; gap: 32px; }
    }
  </style>
</PostHogLayout>
