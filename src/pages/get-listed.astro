---
import PostHogLayout from '../layouts/PostHogLayout.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const user = Astro.locals.user;
---

<PostHogLayout 
  title="Get Listed - Join Acceso | Acceso"
  description="Secure your place on Acceso. Join a curated selection of independent industrial and furniture design studios. Permanent presence, one-time payment."
>
  <Layout title="Get Listed - Join Acceso | Acceso">
    <Navbar />
    
    <main class="get-listed-page">
      {/* REFINED PURPLE HILL - Monochrome Atmosphere */}
      <div class="mesh-canvas">
        <div class="noise-grain"></div>
      </div>
      
      <div class="page-content">
        <div class="listing-layout">
          <!-- Left Column: Branding -->
          <section class="branding-stage animate-slide-up">
            <h1 class="hero-headline">Secure your place<br/>on Acceso</h1>
            <p class="hero-subheadline">
              Join a curated selection of independent design studios.<br/>
              One-time payment. Permanent presence.
            </p>
          </section>

          <!-- Right Column: Actions -->
          <div class="action-stage animate-fade-in">
            
            <!-- Premium Offer Box -->
            <section class="premium-offer-box">
              <div class="offer-pricing">
                <div class="price-block">
                  <div class="pricing-badge">
                    <span>Early access pricing</span>
                  </div>
                  <div class="price-text">
                    <span class="currency">€</span>
                    <span class="amount">120</span>
                    <span class="details">one-time</span>
                  </div>
                </div>

                <div class="action-container">
                  {user ? (
                    <a href="/submission" class="btn-cta">
                      Start submission
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  ) : (
                    <a href="/login" class="btn-cta">
                      Get listed
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  )}
                  <p class="subscription-note">Permanent listing. No subscriptions.</p>
                </div>
              </div>

              <div class="offer-features">
                <div class="feature-list">
                  <div class="feature-item">
                    <span class="matrix-star">✦</span>
                    <p>Studio profile with image, links & description</p>
                  </div>
                  <div class="feature-item">
                    <span class="matrix-star">✦</span>
                    <p>Permanent placement (no renewals)</p>
                  </div>
                  <div class="feature-item">
                    <span class="matrix-star">✦</span>
                    <p>Presence across maps and city listings</p>
                  </div>
                  <div class="feature-item">
                    <span class="matrix-star">✦</span>
                    <p>Manual review before publication</p>
                  </div>
                </div>
              </div>
            </section>

            <!-- Open Call Box -->
            <section class="open-call-card">
              <div class="open-call-header">
                <div class="status-badge">Closed</div>
                <h2 class="open-call-title">Open Call</h2>
              </div>
              <div class="open-call-content">
                <p class="open-call-body">
                  Each season, 10 studios are selected and featured on Acceso. No submission fee.
                </p>
                <div class="call-action-wrap">
                  <button class="btn-cta-disabled" disabled>
                    Submit for free
                  </button>
                  <p class="open-call-note">
                    Next call announced on <a href="https://www.instagram.com/acceso.milano" target="_blank" rel="noopener noreferrer">Instagram</a>.
                  </p>
                </div>
              </div>
            </section>

            <div class="guarantee-tag">
               <p>All submissions are reviewed. If not approved, you will be fully refunded.</p>
            </div>
          </div>
        </div>
      </div>

      <svg style="display: none;">
        <filter id="grainyNoise">
          <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="3" stitchTiles="stitch" />
          <feColorMatrix type="saturate" values="0" />
        </filter>
      </svg>
    </main>

    <Footer />
  </Layout>

  <style>
    .get-listed-page {
      background: #0F1113;
      color: #FFFFFF;
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      font-family: var(--font-sans);
    }

    /* REFINED BROAD HILL - Lowered version */
    .mesh-canvas {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      background: #0F1113;
      /* Massive Hill Body: Sunk lower (165% Y) */
      background-image: 
        linear-gradient(to top, #0F1113 0%, transparent 40%),
        radial-gradient(
          ellipse 150% 160% at 50% 165%,
          #F3E8FF 0%,
          rgba(243, 232, 255, 0.4) 30%,
          rgba(243, 232, 255, 0.1) 60%,
          transparent 90%
        );
    }

    .mesh-canvas::before {
      content: '';
      position: absolute;
      inset: 0;
      /* Broad Core Glow: Sunk lower (160% Y) */
      background: radial-gradient(
        ellipse 120% 100% at 50% 160%,
        rgba(243, 232, 255, 0.3) 0%,
        transparent 80%
      );
    }

    .mesh-canvas::after {
      content: '';
      position: absolute;
      inset: 0;
      /* Top Halo: Spans full width */
      background: radial-gradient(
        ellipse 100% 80% at 50% 5%,
        rgba(243, 232, 255, 0.1) 0%,
        transparent 100%
      );
    }

    .noise-grain {
      position: absolute;
      inset: 0;
      opacity: 0.02;
      filter: url(#grainyNoise);
      mix-blend-mode: overlay;
    }

    .page-content {
      position: relative;
      z-index: 10;
      max-width: 1600px;
      margin: 0 auto;
      padding: 0 40px;
    }

    /* HERO STAGE - PULLED HIGHER */

    .page-content {
      position: relative;
      z-index: 10;
      max-width: 1400px;
      margin: 0 auto;
      padding: var(--page-top-spacing) 40px 120px;
    }

    .listing-layout {
      display: flex;
      flex-direction: column;
      gap: 120px;
      align-items: center;
    }

    /* BRANDING STAGE */
    .branding-stage {
      padding-top: 40px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-headline {
      font-family: var(--font-mono);
      font-size: 80px;
      font-weight: 400;
      line-height: 0.95;
      margin-bottom: 32px;
      letter-spacing: -0.02em;
      text-align: center;
    }

    .hero-subheadline {
      font-size: 20px;
      color: #FFFFFF;
      opacity: 0.7;
      line-height: 1.5;
      max-width: 600px;
      text-align: center;
    }

    /* ACTION STAGE */
    .action-stage {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      width: 100%;
    }

    .premium-offer-box {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 48px;
      display: flex;
      flex-direction: column;
      gap: 40px;
      align-items: flex-start;
      height: 100%;
    }

    .offer-pricing {
      display: flex;
      flex-direction: column;
      gap: 32px;
      width: 100%;
    }

    .price-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .price-text {
      display: flex;
      align-items: baseline;
      gap: 4px;
    }

    .currency {
      font-family: var(--font-sans);
      font-size: 20px;
      font-weight: 400;
      color: #FFFFFF;
      opacity: 0.6;
    }

    .amount {
      font-family: var(--font-sans);
      font-size: 88px;
      font-weight: 400;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      line-height: 1;
    }

    .details {
      font-size: 14px;
      font-weight: 400;
      color: #FFFFFF;
      opacity: 0.5;
      margin-left: 8px;
    }

    .pricing-badge {
      margin: 0;
    }

    .pricing-badge span {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-yellow);
      background: rgba(237, 254, 68, 0.08);
      padding: 4px 12px;
      border-radius: 999px;
      border: 1px solid rgba(237, 254, 68, 0.15);
    }

    .action-container {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .btn-cta {
      height: 52px;
      padding: 0 40px;
      background: #FFFFFF;
      color: #000;
      border-radius: 12px;
      font-weight: 700;
      font-size: 15px;
      display: flex;
      align-items: center;
      gap: 10px;
      transition: all 0.3s ease;
    }

    .btn-cta:hover {
      background: #f3f4f6;
    }

    .subscription-note {
      font-size: 13px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.4);
      margin: 0;
    }

    /* FEATURES */
    .feature-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
    }

    .matrix-star {
      color: var(--color-yellow);
      font-size: 16px;
      line-height: 1;
      margin-top: 2px;
    }

    .feature-item p {
      margin: 0;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 400;
      line-height: 1.4;
    }

    /* OPEN CALL */
    .open-call-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 24px;
      padding: 48px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      position: relative;
      height: 100%;
    }

    .open-call-header {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 24px;
    }

    .open-call-title {
      font-family: var(--font-sans);
      font-size: 28px;
      font-weight: 600;
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .status-badge {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: rgba(255, 255, 255, 0.4);
      background: rgba(255, 255, 255, 0.05);
      padding: 3px 10px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .open-call-body {
      font-size: 15px;
      line-height: 1.6;
      color: rgba(255,255,255,0.6);
      max-width: none;
      margin-bottom: 32px;
    }

    .call-action-wrap {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    .btn-cta-disabled {
      height: 48px;
      padding: 0 32px;
      background: rgba(255, 255, 255, 0.03);
      color: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      font-weight: 700;
      font-size: 14px;
      cursor: not-allowed;
      margin: 0;
    }

    .open-call-note {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.4);
      margin: 0;
    }

    .open-call-note a {
      color: #FFFFFF;
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .guarantee-tag {
      padding: 0 12px;
      grid-column: span 2;
      text-align: center;
    }

    .guarantee-tag p {
      margin: 0; font-size: 13px; color: rgba(255, 255, 255, 0.35);
    }

    .animate-slide-up { animation: heroSlideUp 1s cubic-bezier(0.19, 1, 0.22, 1) forwards; }
    .animate-fade-in { opacity: 0; animation: fadeIn 1s ease-out 0.4s forwards; }

    @keyframes heroSlideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    @media (max-width: 1024px) {
      .action-stage {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .guarantee-tag {
        grid-column: span 1;
      }
      .hero-headline { font-size: 56px; }
      .premium-offer-box {
        padding: 32px;
      }
      .open-call-card {
        padding: 32px;
      }
      .call-action-wrap {
        gap: 16px;
      }
    }
  </style>
</PostHogLayout>
