---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

  <Layout 
    title="Acceso | Independent Furniture & Industrial Design Studios"
    description="Curated directory of independent furniture and industrial design studios. Explore studios, objects, and projects across Milan, London, Berlin, Seoul, and more."
    keywords="independent design studios, furniture design studios, industrial design studios, design studios directory, design studio map, design studios Milan, design studios London, design studios Seoul, design inspiration objects" ogType="website">
    <Navbar />
    
    {/* Page Hero */}
    <section class="info-hero">
      <div class="info-hero-container reveal-on-scroll">
        <div class="info-hero-content">
          <div class="info-hero-kicker">
            <span class="pill">WE MAP DESIGN IN 300+ CITIES</span>
          </div>
          <h1 class="info-hero-title">Your local<br/>design infopoint</h1>
          <p class="info-hero-sub">
            Acceso is a curated directory of local design communities.
          </p>
          <div class="info-hero-ctas">
            <a href="/" class="btn-primary">
              Explore map
            </a>
            <a href="/designers" class="btn-secondary">Browse designers</a>
          </div>
        </div>
        <div class="info-hero-image">
          <div class="info-hero-img-wrapper">
             <img src="/images/projects-grid.webp" alt="Design projects grid" class="info-hero-img" />
          </div>
        </div>
      </div>
    </section>

    {/* What is Acceso Section */}
    <section class="what-is-acceso-section">
      <div class="what-is-grid">
        <div class="what-is-header">
          <span class="showcase-label reveal-on-scroll">WHAT IS ACCESO</span>
          <h2 class="what-is-title reveal-on-scroll">Mapping the<br/>design ecosystem</h2>
          <p class="what-is-desc reveal-on-scroll">
            Acceso is a curated directory of local design communities. Discover independent design studios, industrial designers, furniture designers, design schools, exhibitions, fairs, design weeks, awards, competitions, manufacturers, workshops, galleries, museums, showrooms, retailers, jobs, and creative opportunities in cities around the world.
          </p>
          <p class="what-is-desc reveal-on-scroll">
            Each city page includes interactive maps, curated listings, and practical information to help you explore the local design scene. Whether you're looking for design inspiration, planning a visit, searching for a studio, hiring a designer, or researching a city's creative ecosystem, Acceso provides a single place to discover and navigate local design.
          </p>
        </div>
        <div class="what-is-image">
          <img src="/images/map.webp" alt="Acceso map of local design" class="what-is-img" />
        </div>
      </div>
    </section>

    {/* 
    <main class="spotlight-page">
      <Spotlight 
        activeSpotlight={activeSpotlight} 
        spotlightImages={spotlightImages} 
        designerStudio={designerStudio} 
      />
    </main>
    */}

    {/* Start collecting Section */}
    <section class="community-section">
      <div class="community-content">
        <span class="showcase-label reveal-on-scroll">Your personal space</span>
        <h2 class="community-title reveal-on-scroll">Start building<br/>your map</h2>
        <p class="community-subtitle reveal-on-scroll">Create an account to save studios, objects, schools, museums and build your own map of local design references. Make it completely personalized to reflect your taste.</p>
        <a href="/login" class="btn-primary community-btn reveal-on-scroll">Build my map</a>
      </div>
    </section>

    <Footer />
  </Layout>

<style>
  /* New Info Hero */
  .info-hero {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 100px;
  }

  .info-hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .info-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .info-hero-kicker {
    margin-bottom: 24px;
  }

  .pill {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray);
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--color-stroke);
    padding: 8px 12px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    display: inline-block;
  }

  .info-hero-title {
    font-family: var(--font-sans);
    font-size: clamp(48px, 6vw, 84px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.08em;
    margin: 0 0 24px;
    color: var(--color-black);
  }

  .info-hero-sub {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0 0 32px;
    max-width: 500px;
  }

  .info-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .info-hero-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
  }

  .info-hero-img-wrapper {
    width: 100%;
    height: 100%;
  }

  .info-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .info-hero {
      padding: var(--page-top-spacing) 24px 60px;
    }
    .info-hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .info-hero-content {
      order: 2;
    }
    .info-hero-image {
      aspect-ratio: 4 / 3;
      order: 1;
    }
  }

  @media (max-width: 480px) {
    .info-hero {
      padding: var(--page-top-spacing) 20px 48px;
    }
  }

  /* Shared Button Extensions */
  .btn-primary, .btn-secondary {
    white-space: nowrap;
  }

  /* What is Acceso Section */
  .what-is-acceso-section {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    position: relative;
    z-index: 10;
  }

  .what-is-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .what-is-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    text-align: left;
  }

  .what-is-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
  }

  .what-is-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .what-is-title {
    font-family: var(--font-sans);
    font-size: 64px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-black);
    letter-spacing: -0.04em;
    max-width: 900px;
    margin: 0;
  }

  .what-is-desc {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-gray);
    max-width: 720px;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .what-is-grid {
      gap: 48px;
    }
    .what-is-title {
      font-size: 48px;
    }
  }

  @media (max-width: 900px) {
    .what-is-acceso-section {
      padding: 0 24px;
    }
    .what-is-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .what-is-title {
      font-size: 40px;
    }
  }

  @media (max-width: 480px) {
    .what-is-acceso-section {
      padding: 0 20px;
    }
    .what-is-title {
      font-size: 32px;
    }
  }

  /* Showcase Label (shared pill) */
  .showcase-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gray);
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--color-stroke);
    padding: 8px 12px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }

  /* Modern CTA styling (align with current site buttons) */
  .btn-primary,
  .btn-secondary,
  .community-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 22px;
    border-radius: 14px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }

  .btn-primary,
  .community-btn {
    background: var(--color-black);
    color: var(--color-white);
    border: 1px solid var(--color-black);
  }

  .btn-primary:hover,
  .community-btn:hover {
    opacity: 0.9;
  }

  .btn-secondary {
    background: var(--color-bg-secondary);
    color: var(--color-black);
    border: 1px solid var(--color-stroke);
  }

  .btn-secondary:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
  }

  /* Community Section */
  .community-section {
    max-width: 1600px;
    margin: 0 auto;
    padding: 120px 40px;
    text-align: center;
    background: var(--color-white);
  }

  .community-content {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .community-title {
    font-family: var(--font-sans);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    color: var(--color-black);
    margin: 0;
    letter-spacing: -0.04em;
  }

  .community-subtitle {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0 0 16px;
  }

  .community-btn {
    min-width: 160px;
  }

  @media (max-width: 768px) {
    .community-section {
      padding: 80px 20px;
      text-align: left;
    }

    .community-content {
      margin: 0;
      align-items: flex-start;
    }
    
    .community-title {
      font-size: 36px;
    }
    
    
    .community-subtitle {
      font-size: 16px;
    }
  }
</style>

