<script>
  const observerOptions = {
    root: null,
    rootMargin: '0px 0px -50px 0px',
    threshold: 0.05
  };

  const observer = new IntersectionObserver((entries, observer) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  const elements = document.querySelectorAll('.reveal-on-scroll');
  elements.forEach(el => observer.observe(el));

  // Infinite Carousel with Drag
  const track = document.querySelector('.carousel-track') as HTMLElement;
  const container = document.querySelector('.carousel-container') as HTMLElement;

  if (track && container) {
    let x = 0;
    let isDragging = false;
    let startX = 0;
    let prevX = 0;
    let speed = 0.6; // Slightly faster for better feel
    
    const getTrackWidth = () => track.scrollWidth;
    const getLoopThreshold = () => getTrackWidth() / 4;

    const animate = () => {
      if (!isDragging) {
        x -= speed;
        
        const threshold = getLoopThreshold();
        if (Math.abs(x) >= threshold) {
          x += threshold; // Seamless loop
        }
        
        track.style.transform = `translate3d(${x}px, 0, 0)`;
      }
      requestAnimationFrame(animate);
    };

    const handleStart = (clientX: number) => {
      isDragging = true;
      startX = clientX;
      prevX = x;
      container.style.cursor = 'grabbing';
      // Disable smooth transitions during drag if any
      track.style.transition = 'none';
    };

    const handleMove = (clientX: number) => {
      if (!isDragging) return;
      
      const dx = clientX - startX;
      x = prevX + dx;

      // Handle loop while dragging to keep x within bounds
      const threshold = getLoopThreshold();
      while (x > 0) x -= threshold;
      while (x < -threshold) x += threshold;

      track.style.transform = `translate3d(${x}px, 0, 0)`;
    };

    const handleEnd = () => {
      if (!isDragging) return;
      isDragging = false;
      container.style.cursor = 'grab';
    };

    // Mouse Events
    container.addEventListener('mousedown', (e) => {
      handleStart(e.clientX);
      e.preventDefault(); // Prevent text selection/drag ghosts
    });

    window.addEventListener('mousemove', (e) => {
      handleMove(e.clientX);
    });

    window.addEventListener('mouseup', handleEnd);

    // Touch Events
    container.addEventListener('touchstart', (e) => {
      handleStart(e.touches[0].clientX);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (isDragging) {
        handleMove(e.touches[0].clientX);
        // Only prevent default if we are moving enough horizontally
        // to clearly distinguish from a vertical page scroll
        if (Math.abs(e.touches[0].clientX - startX) > 5) {
          // e.preventDefault(); // Cannot prevent default on passive listener, but we use {passive: true} for start
        }
      }
    });

    window.addEventListener('touchend', handleEnd);

    // Handle clicks vs drags
    container.addEventListener('click', (e) => {
      // If we moved more than 5px, it was a drag, so prevent the click
      if (Math.abs(x - prevX) > 5) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    // Initial state
    container.style.cursor = 'grab';
    animate();
  }
</script>
