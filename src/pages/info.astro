---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const isDev = import.meta.env.DEV;
const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;

async function readJson(filename: string) {
  try {
    const response = await fetch(`${domain}/${filename}`);
    if (!response.ok) return null;
    return await response.json();
  } catch {
    return null;
  }
}

function toArray(data: any): any[] {
  if (!data) return [];
  if (Array.isArray(data)) return data;
  if (Array.isArray(data.items)) return data.items;
  return [];
}

const [citiesData, countriesData, studiosData, projectsData, schoolsData, museumsData, fairsData, awardsData] = await Promise.all([
  readJson('test-cities.json'),
  readJson('test-countries.json'),
  readJson('test-studios.json'),
  readJson('moodboard.json'),
  readJson('universities.json'),
  readJson('museums.json'),
  readJson('fairs.json'),
  readJson('awards.json'),
]);

const counts = {
  cities: toArray(citiesData).length || 300,
  countries: toArray(countriesData).length || 60,
  studios: toArray(studiosData).length || 1000,
  projects: toArray(projectsData).length,
  schools: toArray(schoolsData).length,
  museums: toArray(museumsData).length,
  fairs: toArray(fairsData).length,
  awards: toArray(awardsData).length,
};

function formatCount(value: number, fallback: string) {
  if (!value) return fallback;
  if (value >= 1000) return `${Math.floor(value / 100) / 10}k`;
  return value.toLocaleString('en-US');
}

const platformLinks = [
  {
    title: 'Map',
    text: 'Explore the design map by city and jump from local clusters to individual listings.',
    href: '/',
    cta: 'Open map',
  },
  {
    title: 'Designers',
    text: 'Find independent furniture, product, and industrial design studios across the world.',
    href: '/designers',
    cta: 'Browse studios',
  },
  {
    title: 'Discover',
    text: 'Look through objects and projects, then follow the studio or reference behind them.',
    href: '/discover',
    cta: 'See projects',
  },
  {
    title: 'Directory',
    text: 'Compare schools, museums, fairs, awards, competitions, and design institutions.',
    href: '/directory',
    cta: 'Use directory',
  },
];

const ecosystemItems = [
  { label: 'Independent design studios' },
  { label: 'Furniture and industrial designers' },
  { label: 'Design schools and programs' },
  { label: 'Museums and permanent collections' },
  { label: 'Fairs, biennials, and design weeks' },
  { label: 'Awards and open calls' },
  { label: 'Galleries, showrooms, and retailers', soon: true },
  { label: 'Manufacturers, workshops, and opportunities', soon: true },
];

const actionCards = [
  {
    label: 'Explore globally',
    title: 'Find designers outside your usual feed',
    text: 'Start from the designers page, filter by city, and discover studios working in places you may not already follow.',
  },
  {
    label: 'Compare options',
    title: 'Weigh schools, awards, and open calls',
    text: 'Use the directory to compare education paths, prizes, deadlines, and institutions without jumping across tabs.',
  },
  {
    label: 'Save references',
    title: 'Build your own map of studios and objects',
    text: 'Create an account to save designers, projects, schools, and museums into a personal collection you can return to.',
  },
];
---

<Layout
  title="Info | Acceso"
  description="Acceso is a local design infopoint: a curated map, directory, and discovery platform for independent design studios, schools, museums, fairs, awards, and design culture worldwide."
  keywords="Acceso design, local design map, design directory, independent design studios, design schools, design museums, design fairs, industrial design platform"
  ogType="website"
>
  <Navbar />

  <main class="info-page">
    <section class="info-hero">
      <div class="hero-copy">
        <p class="eyebrow">YOUR LOCAL DESIGN INFOPOINT</p>
        <h1>Design culture, city by city.</h1>
        <p class="hero-description">
          Acceso connects the pieces of local design culture: independent studios, projects, schools,
          museums, fairs, awards, and the cities around them. Start with a place, a designer, or an
          object, then keep moving through the network.
        </p>
        <div class="hero-actions">
          <a href="/" class="btn-primary">Explore map</a>
          <a href="/submission" class="btn-submission">Submit a listing</a>
        </div>
      </div>

      <div class="hero-panel" aria-label="Acceso platform overview">
        <div class="hero-image">
          <img src="/images/info-hero.webp" alt="Acceso platform overview" />
        </div>
      </div>
    </section>

    <section class="stats-strip" aria-label="Acceso coverage">
      <div>
        <strong>{formatCount(counts.cities, '300+')}</strong>
        <span>Cities mapped</span>
      </div>
      <div>
        <strong>{formatCount(counts.studios, '1k+')}</strong>
        <span>Design studios</span>
      </div>
      <div>
        <strong>{formatCount(counts.countries, '60+')}</strong>
        <span>Countries covered</span>
      </div>
    </section>

    <section class="section-block intro-block">
      <div class="section-heading">
        <p class="eyebrow">WHAT ACCESO DOES</p>
        <h2>A connected view of local design.</h2>
      </div>
      <div class="section-text">
        <p>
          Acceso is built to make design scenes easier to read. It is a map, a discovery layer, and a
          growing index of the people and institutions that shape industrial, furniture, and product
          design around the world.
        </p>
        <p>
          You can use it to find studios in another city, compare schools, browse current awards and
          competitions, save references, or move from a project to the wider context around it.
        </p>
      </div>
    </section>

    <section class="platform-grid" aria-label="Explore Acceso">
      {platformLinks.map((item) => (
        <a class="platform-card" href={item.href}>
          <span>{item.title}</span>
          <p>{item.text}</p>
          <strong>{item.cta}</strong>
        </a>
      ))}
    </section>

    <section class="section-block ecosystem-block">
      <div class="section-heading">
        <p class="eyebrow">THE ECOSYSTEM</p>
        <h2>Every layer of a design scene, in one place.</h2>
      </div>
      <ul class="ecosystem-list">
        {ecosystemItems.map((item) => (
          <li class:list={{ 'soon-item': item.soon }}>
            <span>{item.label}</span>
            {item.soon && <em>Soon</em>}
          </li>
        ))}
      </ul>
    </section>

    <section class="image-feature">
      <div class="feature-image">
        <img src="/cdn/museums/triennale-milano/cover.webp" alt="Triennale Milano" loading="lazy" decoding="async" />
      </div>
      <div class="feature-copy">
        <p class="eyebrow">WHAT YOU CAN FIND</p>
        <h2>One project leads to its whole context.</h2>
        <p>
          Acceso is useful when you want to move between discovery and research. Browse a project,
          open the studio behind it, check what city it belongs to, then keep exploring nearby schools,
          museums, fairs, awards, and design references.
        </p>
      </div>
    </section>

    <section class="action-section">
      <div class="section-heading">
        <p class="eyebrow">USE ACCESO TO</p>
        <h2>Move through design with a little more context.</h2>
      </div>
      <div class="action-grid" aria-label="What people can do on Acceso">
        {actionCards.map((item) => (
          <article class="use-case-card">
            <p class="eyebrow">{item.label}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="bottom-cards">
      <section class="contribute-section">
        <div class="contribute-copy">
          <p class="eyebrow">CONTRIBUTE</p>
          <h2>Know something we should add?</h2>
          <p>
            Send us a studio, school, museum, fair, award, competition, or design event that belongs on
            Acceso. Submissions help keep the map specific, current, and close to the people building
            each local scene.
          </p>
          <a href="/submission" class="btn-save">Submit a listing</a>
        </div>
      </section>

      <section class="final-cta">
        <div class="final-cta-copy">
          <p class="eyebrow">BUILD YOUR MAP</p>
          <h2>Save what you want to remember.</h2>
          <p>
            Create an account to collect studios, objects, schools, and museums as you explore. Your map
            becomes a personal index of design references, not another endless feed.
          </p>
          <a href="/login" class="btn-save">Start saving</a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .info-page {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 96px;
    background: var(--color-white);
  }

  .info-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.98fr) minmax(360px, 0.82fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    padding: 42px 0 64px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .info-hero h1,
  .section-heading h2,
  .feature-copy h2,
  .contribute-section h2,
  .final-cta h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-black);
    letter-spacing: -0.06em;
  }

  .info-hero h1 {
    max-width: 11ch;
    font-size: clamp(46px, 5.8vw, 88px);
    line-height: 0.96;
  }

  .hero-description {
    max-width: 620px;
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .hero-panel {
    min-width: 0;
  }

  .hero-image {
    aspect-ratio: 1.12 / 1;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-bg-secondary);
  }

  .hero-image img,
  .feature-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-stroke);
    border-bottom: 1px solid var(--color-stroke);
    margin-bottom: 96px;
  }

  .stats-strip div {
    min-height: 164px;
    padding: 24px;
    border-right: 1px solid var(--color-stroke);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .stats-strip div:last-child {
    border-right: 0;
  }

  .stats-strip strong {
    font-size: clamp(56px, 8vw, 122px);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .stats-strip span {
    max-width: 16ch;
    font-size: 15px;
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .section-block {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(32px, 7vw, 120px);
    align-items: start;
    margin-bottom: 84px;
  }

  .section-heading h2,
  .feature-copy h2,
  .contribute-section h2,
  .final-cta h2 {
    font-size: clamp(34px, 4vw, 60px);
    line-height: 1.04;
  }

  .section-text {
    display: grid;
    gap: 20px;
    padding-top: 30px;
  }

  .section-text p,
  .feature-copy p:not(.eyebrow) {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 100px;
    padding: 10px;
    border: 1px solid var(--color-stroke);
    border-radius: 14px;
  }

  .platform-card {
    min-height: 210px;
    padding: 18px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .platform-card:hover {
    background: var(--color-bg-secondary);
    border-color: var(--color-stroke);
    transform: none;
    color: var(--color-black);
  }

  .platform-card span {
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .platform-card p {
    margin: auto 0 18px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .platform-card strong {
    font-size: 14px;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Ecosystem: a quiet, editorial list instead of a boxed grid */
  .ecosystem-block {
    align-items: start;
  }

  .ecosystem-list {
    margin: 0;
    padding: 0;
    padding-top: 8px;
    list-style: none;
  }

  .ecosystem-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-stroke);
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--color-black);
  }

  .ecosystem-list li:first-child {
    border-top: 1px solid var(--color-stroke);
  }

  .ecosystem-list em {
    flex-shrink: 0;
    font-style: normal;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ecosystem-list li.soon-item {
    opacity: 0.5;
  }

  .image-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    margin-bottom: 96px;
  }

  .feature-image {
    aspect-ratio: 1.55 / 1;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
  }

  .feature-copy {
    max-width: 580px;
  }

  .feature-copy h2 {
    font-size: clamp(28px, 3vw, 44px);
  }

  .feature-copy p:not(.eyebrow) {
    margin-top: 24px;
  }

  .action-section {
    margin-bottom: 96px;
  }

  .action-section > .section-heading {
    max-width: 820px;
    margin-bottom: 28px;
  }

  .action-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .use-case-card {
    min-height: 260px;
    padding: 24px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: transparent;
  }

  .use-case-card h3 {
    max-width: 13ch;
    margin: 0 0 28px;
    font-size: clamp(26px, 2.55vw, 38px);
    line-height: 1.04;
    letter-spacing: -0.05em;
  }

  .use-case-card p:not(.eyebrow) {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* Bottom cards: contribute + build your map */
  .bottom-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 96px;
  }

  .contribute-section {
    padding: 48px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-bg-secondary);
  }

  .final-cta {
    padding: 48px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: rgba(237, 255, 119, 0.5);
  }

  .contribute-copy,
  .final-cta-copy {
    max-width: 640px;
  }

  .contribute-copy p:not(.eyebrow),
  .final-cta-copy p:not(.eyebrow) {
    margin: 22px 0 28px;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .hero-actions .btn-submission {
    height: var(--btn-height-large);
    padding: 0 24px;
  }

  @media (max-width: 1100px) {
    .info-hero,
    .section-block,
    .image-feature {
      grid-template-columns: 1fr;
    }

    .info-hero {
      align-items: start;
    }

    .platform-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .final-cta {
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .info-page {
      padding: var(--page-top-spacing) 16px 72px;
    }

    .info-hero {
      gap: 36px;
      padding-bottom: 44px;
    }

    .info-hero h1 {
      max-width: 9ch;
      font-size: clamp(52px, 15vw, 72px);
      letter-spacing: -0.07em;
    }

    .hero-description,
    .section-text p,
    .feature-copy p:not(.eyebrow),
    .contribute-copy p:not(.eyebrow),
    .final-cta-copy p:not(.eyebrow) {
      font-size: 16px;
    }

    .hero-image {
      aspect-ratio: 1 / 0.92;
    }

    .stats-strip,
    .platform-grid,
    .action-grid {
      grid-template-columns: 1fr;
    }

    .stats-strip {
      margin-bottom: 72px;
    }

    .stats-strip div,
    .stats-strip div:last-child {
      min-height: 112px;
      border-right: 0;
      border-bottom: 1px solid var(--color-stroke);
    }

    .stats-strip div:last-child {
      border-bottom: 0;
    }

    .section-block,
    .platform-grid,
    .image-feature,
    .action-section,
    .contribute-section,
    .final-cta {
      margin-bottom: 72px;
    }

    .section-text {
      padding-top: 0;
    }

    .platform-card,
    .use-case-card {
      min-height: 210px;
    }

    .ecosystem-list li {
      font-size: 16px;
    }

    .feature-image {
      aspect-ratio: 1 / 0.82;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions a {
      width: 100%;
    }

    .contribute-section {
      padding: 24px;
    }

    .final-cta {
      align-items: stretch;
    }

    .bottom-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
