---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

  <Layout 
    title="Acceso | Independent Furniture & Industrial Design Studios"
    description="Curated directory of independent furniture and industrial design studios. Explore studios, objects, and projects across Milan, London, Berlin, Seoul, and more."
    keywords="independent design studios, furniture design studios, industrial design studios, design studios directory, design studio map, design studios Milan, design studios London, design studios Seoul, design inspiration objects" type="website">
    <Navbar />
    
    {/* Page Hero */}
    <section class="info-hero">
      <div class="info-hero-container reveal-on-scroll">
        <div class="info-hero-content">
          <div class="info-hero-kicker">
            <span class="pill">300+ designers 8+ countries</span>
          </div>
          <h1 class="info-hero-title">Design lives<br/>in cities</h1>
          <p class="info-hero-sub">
            Explore independent studios through the places they belong to, and the objects they create.
          </p>
          <div class="info-hero-ctas">
            <a href="/designers" class="btn-primary">
              Explore studios
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left: 8px;">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="/projects" class="btn-secondary">Browse projects</a>
          </div>
        </div>
        <div class="info-hero-image">
          <div class="info-hero-img-wrapper">
             <img src="/images/hero-image-grid.webp" alt="Design objects grid" class="info-hero-img" />
          </div>
        </div>
      </div>
    </section>

    {/* Why Acceso Section */}
    <section class="why-acceso-section">
      <div class="why-header">
        <span class="showcase-label reveal-on-scroll">WHY ACCESO</span>
        <h2 class="why-title reveal-on-scroll">A different way to explore design studios</h2>
      </div>

      <div class="why-comparison">
        {/* Left Column */}
        <div class="why-column why-column-left reveal-on-scroll">
          <h3 class="comparison-title">Common design platforms</h3>
          <ul class="card-features">
            <li>Renderings without context</li>
            <li>Catalog images</li>
            <li>Brands over studios</li>
            <li>Articles instead of objects</li>
            <li>No geographic context</li>
          </ul>
        </div>

        {/* Divider */}
        <div class="why-divider"></div>

        {/* Right Column */}
        <div class="why-column why-column-right reveal-on-scroll">
          <h3 class="comparison-title">What Acceso shows</h3>
          <ul class="card-features">
            <li>Manufactured objects</li>
            <li>Real product photography</li>
            <li>Independent studios</li>
            <li>Objects connected to the studios</li>
            <li>Organized by city</li>
          </ul>
        </div>
      </div>
      </section>

    {/* Feature Showcase: Map Discovery */}
    <section class="feature-showcase">
      <div class="showcase-container">
        <div class="showcase-content">
          <span class="showcase-label reveal-on-scroll">Explore by city</span>
          <h2 class="showcase-title reveal-on-scroll">Your design<br/>neighborhood</h2>
          <p class="showcase-description reveal-on-scroll">
            Navigate the city through its designers. Find studios, discover hidden projects, and see where creativity happens in Milan, London, Paris, Berlin, and beyond.
          </p>
          <a href="/map" class="showcase-btn reveal-on-scroll">Explore map</a>
        </div>
        <div class="showcase-image">
          <div class="showcase-image-wrapper">
            <img src="/images/map.webp" alt="Acceso Map Interface" class="showcase-img" />
          </div>
        </div>
      </div>
    </section>

    {/* Feature Showcase: Designer (Mirrored) */}
    <section class="feature-showcase feature-showcase--reversed">
      <div class="showcase-container">
        <div class="showcase-content">
          <span class="showcase-label reveal-on-scroll">Design studios</span>
          <h2 class="showcase-title reveal-on-scroll">Meet the<br/>designers</h2>
          <p class="showcase-description reveal-on-scroll">
            Explore the studios behind the objects you love. Learn their stories and see the projects shaping local and global design today.
          </p>
          <a href="/designers" class="showcase-btn reveal-on-scroll">Browse designers</a>
        </div>
        <div class="showcase-image">
          <div class="showcase-image-wrapper">
            <img src="/images/designers.webp" alt="Acceso Designers Interface" class="showcase-img" />
          </div>
        </div>
      </div>
    </section>


    {/* Feature Showcase: Moodboard */}
    <section class="feature-showcase">
      <div class="showcase-container">
        <div class="showcase-content">
          <span class="showcase-label reveal-on-scroll">Visual inspiration</span>
          <h2 class="showcase-title reveal-on-scroll">Curate your<br/>moodboard</h2>
          <p class="showcase-description reveal-on-scroll">
            Gather inspiration from objects, projects, and ideas handpicked from studios worldwide. Build moodboards, save items into collections, and capture visual references for your next project.
          </p>
          <a href="/projects" class="showcase-btn reveal-on-scroll">Browse projects</a>
        </div>
        <div class="showcase-image">
          <div class="showcase-image-wrapper">
            <img src="/images/moodboard.webp" alt="Acceso Moodboard Interface" class="showcase-img" />
          </div>
        </div>
      </div>
    </section>
    {/* 
    <main class="spotlight-page">
      <Spotlight 
        activeSpotlight={activeSpotlight} 
        spotlightImages={spotlightImages} 
        designerStudio={designerStudio} 
      />
    </main>
    */}

    {/* Start collecting Section */}
    <section class="community-section">
      <div class="community-content">
        <span class="showcase-label reveal-on-scroll">Your personal space</span>
        <h2 class="community-title reveal-on-scroll">Start building your</br>design references</h2>
        <p class="community-subtitle reveal-on-scroll">Create an account to save studios, collect objects, and build your own reference library. Acceso works better when it remembers what you care about.</p>
        <a href="/login" class="btn-primary community-btn reveal-on-scroll">Start collecting</a>
      </div>
    </section>

    {/* Contributors Section */}
    <section class="contributors-section">
      <div class="contributors-content reveal-on-scroll">
        <h2 class="contributors-title">Contributors</h2>
        <p class="contributors-text">
          Thanks to the contributors for making this resource free to use for anyone in the field: 
          <strong>Edoardo Graci</strong>, <strong>Hyeji Shin</strong> from Acceso and <strong>A.doc Team</strong> members 
          Andrea Pedulli, Agnese De Angelis, Luca Pinotti, Andrea Lorenzo, Mattia Cenedese and Nicola Capelli.
        </p>
      </div>
    </section>

    <Footer />
  </Layout>

<style>
  /* New Info Hero */
  .info-hero {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 100px;
  }

  .info-hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .info-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .info-hero-kicker {
    margin-bottom: 24px;
  }

  .pill {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 8px 12px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
    display: inline-block;
  }

  .info-hero-title {
    font-family: var(--font-mono);
    font-size: clamp(48px, 6vw, 84px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: 0;
    margin: 0 0 24px;
    color: var(--color-white);
  }

  .info-hero-sub {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.6);
    margin: 0 0 32px;
    max-width: 500px;
  }

  .info-hero-ctas {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .info-hero-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
  }

  .info-hero-img-wrapper {
    width: 100%;
    height: 100%;
  }

  .info-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Shared Button Extensions */
  .btn-primary, .btn-secondary {
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .info-hero-container {
      gap: 40px;
    }
    .info-hero-title {
      font-size: 56px;
    }
  }

  @media (max-width: 768px) {
    .info-hero {
      padding: var(--page-top-spacing) 24px 60px;
    }
    .info-hero-container {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .info-hero-title {
      font-size: 42px;
    }
    .info-hero-sub {
      font-size: 16px;
    }
    .info-hero-image {
      aspect-ratio: 4 / 3;
    }
  }

  /* Hero Section */
  .hero-section {
    padding: 24px var(--spacing-page) 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--color-black);
    height: auto;
    min-height: 100vh;
    min-height: 100dvh;
    position: relative;
  }

  .hero-content {
    max-width: 1000px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 40px;
  }

  /* Hero Static Image */
  .hero-image-wrapper {
    position: relative;
    width: 100%;
    max-width: 1100px;
    margin-bottom: 64px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: none !important;
    outline: none !important;
    background: var(--color-black);
  }

  .hero-static-image {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    top: -1px;
  }

  .hero-gradient-overlay {
    display: none;
  }

  .hero-title {
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 16px;
    letter-spacing: 0;
    color: var(--color-white);
  }

  .hero-subtitle {
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-gray);
    max-width: 600px;
    margin: 0 auto 24px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: #ffffff;
    color: var(--color-black);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btn-primary:hover {
    background: #f3f4f6;
    color: var(--color-black);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: var(--color-white);
    background: rgba(255,255,255,0.1);
  }

  /* Why Acceso Section */
  .why-acceso-section {
    width: 100%;
    max-width: 1600px;
    margin: 80px auto 120px;
    padding: 0 40px;
    position: relative;
    z-index: 10;
  }

  .why-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    text-align: left;
    margin-bottom: 100px;
  }

  .why-title {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: 0;
    max-width: 900px;
    margin: 0;
  }

  .why-comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 80px;
    align-items: start;
  }

  .why-column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .why-column-left {
    opacity: 0.7;
  }

  .why-column-right {
    opacity: 1;
  }

  .why-divider {
    width: 1px;
    background: var(--color-stroke);
    min-height: 300px;
  }

  .comparison-title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 400;
    color: var(--color-white);
    margin: 0;
    letter-spacing: 0;
  }

  .why-column-left .comparison-title {
    color: var(--color-gray);
    opacity: 0.8;
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-features li {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-white);
    position: relative;
    padding-left: 20px;
  }

  .why-column-left .card-features li {
    color: var(--color-gray);
    opacity: 0.75;
  }

  .why-column-right .card-features li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background-color: var(--color-yellow);
    border-radius: 50%;
  }

  @media (max-width: 1024px) {
    .why-acceso-section,
    .feature-showcase,
    .community-section {
      padding-left: 24px;
      padding-right: 24px;
    }
    .why-title {
      font-size: 48px;
    }
    .why-comparison {
      gap: 60px;
    }
    .why-divider {
      min-height: 250px;
    }
  }

  @media (max-width: 768px) {
    .why-acceso-section {
      margin: var(--page-top-spacing) auto 80px;
      padding: 0 20px;
    }
    .why-header {
      margin-bottom: 64px;
    }
    .why-title {
      font-size: 32px;
    }
    .why-comparison {
      grid-template-columns: 1fr;
      gap: 80px;
    }
    .why-divider {
      display: none;
    }
    .why-column-left {
      opacity: 0.7;
      padding-bottom: 40px;
      border-bottom: 1px solid var(--color-stroke);
    }
  }

  .hero-lower {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto 64px;
    position: relative;
    z-index: 10;
  }

  .lower-title {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 32px;
    color: var(--color-white);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Carousel */
  .carousel-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 12px 0;
  }

  .carousel-container::before,
  .carousel-container::after {
    content: "";
    position: absolute;
    top: -2px;
    bottom: -2px;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .carousel-container::before {
    left: -2px;
    background: transparent;
  }

  .carousel-container::after {
    right: -2px;
    background: transparent;
  }

  .carousel-track {
    display: flex;
    gap: 16px;
    width: max-content;
    will-change: transform;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (min-width: 769px) {
    .hero-section {
      padding-top: 80px;
      height: auto;
      min-height: 100vh;
      overflow: visible;
      justify-content: flex-start;
    }
    
    .hero-content {
      display: grid !important;
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0;
    }

    .hero-title {
      grid-row: 1;
      font-size: 64px;
      margin-bottom: 24px;
    }

    .hero-subtitle {
      grid-row: 2;
      margin-bottom: 32px;
    }

    .hero-actions {
      grid-row: 3;
      margin-bottom: 80px;
    }

    .hero-image-wrapper {
      grid-row: 4;
      margin-top: 0;
      margin-bottom: 0;
      box-shadow: none;
      max-width: 1100px;
      width: 100%;
      inset: 0;
    }
  }

  .carousel-container {
    margin-top: 0px;
  }

  .city-pill {
    padding: 12px 32px;
    background: var(--color-bg-secondary);
    box-shadow: inset 0 0 0 1.5px var(--color-stroke);
    border: none;
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 16px;
    border-radius: 9999px;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .city-pill:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
  }

  .spotlight-page {
    position: relative;
    padding-top: 80px;
    min-height: auto;
    background: var(--color-black);
  }

  @media (max-width: 768px) {
    .hero-section {
      justify-content: flex-start;
      padding: 24px var(--spacing-page) 32px;
      min-height: auto;
      height: auto;
    }

    .hero-content {
      margin-bottom: 32px;
      width: 100%;
      max-width: 100%;
      padding: 0;
    }

    .hero-title {
      margin-bottom: 24px;
      font-size: 32px;
      max-width: 100%;
      overflow-wrap: break-word;
    }

    .hero-subtitle {
      margin-bottom: 32px;
      font-size: 18px;
      width: 100%;
      max-width: 100%;
      padding: 0 16px;
      box-sizing: border-box;
      white-space: normal;
      overflow-wrap: break-word;
      word-wrap: break-word;
      line-height: 1.4;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .hero-image-wrapper {
      margin-bottom: 0px;
      box-shadow: none;
      border: none;
      outline: none;
    }

    .hero-image-wrapper .hero-gradient-overlay {
      height: 60%; 
      bottom: -3px;
      background: transparent;
    }

    .lower-title {
      font-size: 16px;
    }

    .carousel-track {
      animation-duration: 40s;
    }
  }

  /* Reveal on Scroll Animation */
  @media (prefers-reduced-motion: no-preference) {
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      will-change: opacity, transform;
    }
    
    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Feature Showcase Sections */
  .feature-showcase {
    max-width: 1600px;
    margin: 0 auto;
    padding: 80px 40px;
  }

  .showcase-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .feature-showcase--reversed .showcase-container {
    direction: rtl;
  }

  .feature-showcase--reversed .showcase-content,
  .feature-showcase--reversed .showcase-image {
    direction: ltr;
  }

  .showcase-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .showcase-label {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 8px 12px;
    border-radius: 999px;
    backdrop-filter: blur(10px);
  }

  .showcase-title {
    font-family: var(--font-mono);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-white);
    letter-spacing: 0;
    margin: 0;
  }

  .showcase-description {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-gray);
    max-width: 500px;
    margin: 0;
  }

  .showcase-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 32px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
    margin-top: 8px;
  }

  .showcase-btn:hover {
    border-color: var(--color-white);
    background: #f3f4f6;
    color: #0b0d0f;
  }

  .showcase-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    border-radius: 20px;
    border: 1px solid var(--color-stroke);
  }

  .showcase-image-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-gradient-overlay {
    display: none;
  }

  /* Modern CTA styling (align with current site buttons) */
  .btn-primary,
  .btn-secondary,
  .showcase-btn,
  .community-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 22px;
    border-radius: 14px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .btn-primary:hover,
  .btn-secondary:hover,
  .showcase-btn:hover,
