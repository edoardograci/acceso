---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Tabs from '../../components/Tabs.astro';
import DesignerInfo from '../../components/DesignerInfo.astro';
import DesignerMoodboard from '../../components/DesignerMoodboard.astro';

import DesignerActionButtons from '../../components/DesignerActionButtons.astro';
import type { Studio } from '../../lib/types';
const { slug } = Astro.params;

let studio: Studio | null = null;
let error = null;

try {
  // Fetch from static JSON - cached at edge
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const response = await fetch(studiosUrl.toString());
  if (!response.ok) throw new Error('Failed to load studios data');
  
  const studios: Studio[] = await response.json();
  studio = studios.find(s => s.slug === slug) || null;
} catch (e) {
  error = e;
  console.error('Failed to fetch studio:', e);
}

if (!studio && !error) {
  return Astro.redirect('/404');
}

const pageTitle = studio ? `${studio.name} - Acceso` : 'Studio Not Found';
const pageDescription = studio ? `Discover ${studio.name}, an independent design studio in ${studio.city}` : '';
const pageImage = studio?.cover || '/og-default.jpg';
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
>
  <Navbar />
  
  <main class="designer-page">
    <div class="designer-left-col">


      {error ? (
        <div class="error-state">
          <h2 style="color: #ff6b6b; margin-bottom: 16px;">Error Loading Studio</h2>
          <p style="color: var(--text-secondary); margin-bottom: 16px;">
            Unable to load studio data. Please try again later.
          </p>
        </div>
      ) : (
        <>
          <div class="designer-image-container">
            {studio.cover ? (
              <img 
                src={studio.cover} 
                alt={studio.name}
                class="designer-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                data-skeleton
              />
            ) : (
              <div class="designer-image-placeholder">
                <span>No image available</span>
              </div>
            )}
          </div>

          <DesignerActionButtons 
            studioId={studio.id} 
            designerImageUrl={studio.cover}
            designerName={studio.slug}
          />
        </>
      )}
    </div>

    {!error && (
      <div class="designer-content">
        <Tabs active="info" />
        
        <div id="tab-info" class="tab-content tab-content-active">
          <DesignerInfo studio={studio} />
        </div>
        
        <div id="tab-moodboard" class="tab-content">
          <DesignerMoodboard studio={studio} />
        </div>
      </div>
    )}
  </main>
</Layout>

<style>
  .designer-page {
    min-height: 100vh;
    max-width: 1400px;
    margin-left: auto;
    margin-right: auto;
    /* Default mobile layout */
    display: block;
  }

  .designer-left-col {
    /* Mobile styles effectively inherit/block */
  }

  /* Desktop Layout */
  @media (min-width: 768px) {
    .designer-page {
      display: grid;
      grid-template-columns: 1fr 1fr; /* 50% 50% split */
      gap: 48px;
      padding-left: 24px;
      padding-right: 24px;
      padding-top: calc(var(--navbar-height) + 40px);
      align-items: start;
    }

    .designer-left-col {
      position: sticky;
      top: 100px; /* Adjust based on navbar */
    }

    /* Adjust image sizing for desktop */
    .designer-image-container {
      margin-bottom: 24px;
    }
    
    .designer-image {
      max-height: 60vh; /* Allow larger image on desktop */
      object-fit: contain;
    }
  }

  .designer-header {
    padding: 32px var(--spacing-page) 16px; /* Adjusted padding */
  }
  
  @media (min-width: 768px) {
    .designer-header {
      padding: 0 0 24px 0;
    }
  }

  .designer-name {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.02em;
    font-variation-settings: 'wght' 500;
    margin: 0;
    line-height: 1.2;
  }

  .designer-image-container {
    margin-top: 48px;
    padding: 0 var(--spacing-page);
    margin-bottom: 20px;
  }

  @media (min-width: 768px) {
    .designer-image-container {
      padding: 0;
      margin-top: 0;
    }
    
    /* Ensure action buttons align with container */
    :global(.designer-actions) {
      padding: 0 !important;
    }
  }


  .designer-image {
    width: 100%;
    height: auto;
    max-height: 379px;
    object-fit: contain;
    display: block;
    content-visibility: auto;
  }

  @media (min-width: 768px) {
    .designer-image {
      max-height: 600px;
    }
  }

  .designer-image-placeholder {
    width: 100%;
    height: 379px;
    background-color: var(--gray-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .designer-image-placeholder {
      height: 600px;
    }
  }

  .designer-content {
    padding: 16px var(--spacing-page);
  }
  
  @media (min-width: 768px) {
    .designer-content {
      padding: 0;
      margin-top: 0;
    }
    
    /* Adjust tabs margin on desktop */
    :global(.tabs) {
      margin-top: 0 !important;
    }
  }

  .error-state {
    padding: 48px var(--spacing-page);
    text-align: center;
  }

  .tab-content {
    opacity: 0;
    visibility: hidden;
    display: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .tab-content-active {
    opacity: 1;
    visibility: visible;
    display: block;
    pointer-events: auto;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.tab-button') as NodeListOf<HTMLElement>;
  const tabContents = document.querySelectorAll('.tab-content') as NodeListOf<HTMLElement>;
  const tabIndicator = document.querySelector('.tab-indicator') as HTMLElement;

  function updateIndicator() {
    const activeTab = document.querySelector('.tab-button.active') as HTMLElement;
    if (activeTab && tabIndicator) {
      tabIndicator.style.left = activeTab.offsetLeft + 'px';
      tabIndicator.style.width = activeTab.offsetWidth + 'px';
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const tabName = tab.dataset.tab;
      
      // Remove active class from all tabs and contents
      tabs.forEach(t => t.classList.remove('active'));
      tabContents.forEach(content => content.classList.remove('tab-content-active'));
      
      // Add active class to clicked tab and corresponding content
      tab.classList.add('active');
      const activeContent = document.getElementById(`tab-${tabName}`);
      if (activeContent) {
        activeContent.classList.add('tab-content-active');
      }
      
      // Update indicator position
      updateIndicator();
    });
  });
</script>