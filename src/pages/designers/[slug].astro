---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import DirectoryCard from '../../components/DirectoryCard.astro';
import Footer from '../../components/Footer.astro';
import SaveButton from '../../components/SaveButton.astro';
import { normalizeImage } from '../../lib/images';
import { ensureProtocol } from '../../lib/url';
import type { Studio } from '../../lib/types';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../lib/seo/schema';

const { slug } = Astro.params;

const countryNames: Record<string, string> = {
  'united-kingdom': 'United Kingdom',
  'south-korea': 'South Korea',
  'united-states': 'United States',
};

function countryDisplayName(slugVal: string | null): string {
  if (!slugVal) return '';
  const val = slugVal.toLowerCase();
  if (countryNames[val]) return countryNames[val];
  return val.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

const user = Astro.locals.user;
const isLoggedIn = !!user;

let studio: Studio | null = null;
let cover: string | null = null;
let error = null;
let sameCityStudios: Studio[] = [];
let sameCountryStudios: Studio[] = [];
let worldStudios: Studio[] = [];

try {
  const isDev = import.meta.env.DEV;
  const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;
  const studiosUrl = `${domain}/test-studios.json`;
  
  const response = await fetch(studiosUrl);
  if (response.ok) {
    const rawStudios: Studio[] = await response.json();
    const mappedStudios = rawStudios;
    studio = mappedStudios.find(s => s.slug === slug) || null;
    cover = studio ? (studio.cover || (studio as any).image || null) : null;

    if (studio) {
      const currentStudio = studio;
      // 2. Suggested studios in three tiers: same city, same country, worldwide.
      sameCityStudios = mappedStudios
        .filter((s: any) => s.slug !== slug && s.city_slug === currentStudio.city_slug)
        .slice(0, 10);
      sameCountryStudios = mappedStudios
        .filter((s: any) => s.slug !== slug && s.country_slug === currentStudio.country_slug && s.city_slug !== currentStudio.city_slug)
        .slice(0, 10);
      // Worldwide: diversify so it isn't dominated by the largest city
      // (e.g. Milan). Pick at most one studio per city, deterministically.
      const worldPool = mappedStudios.filter((s: any) => s.slug !== slug && s.country_slug !== currentStudio.country_slug);
      const worldShuffled = [...worldPool].sort((a: any, b: any) => String(a.slug).localeCompare(String(b.slug)));
      const worldSeenCities = new Set<string>();
      worldStudios = [];
      for (const s of worldShuffled) {
        if (worldStudios.length >= 10) break;
        const cityKey = (s.city_slug as string) || s.slug;
        if (worldSeenCities.has(cityKey)) continue;
        worldSeenCities.add(cityKey);
        worldStudios.push(s);
      }
      if (worldStudios.length < 10) {
        for (const s of worldShuffled) {
          if (worldStudios.length >= 10) break;
          if (!worldStudios.includes(s)) worldStudios.push(s);
        }
      }
    }
  } else {
    throw new Error('Failed to fetch studios');
  }
} catch (e) {
  error = e;
  console.error('Failure to fetch data:', e);
}

if (!studio && !error) {
  return new Response(null, { status: 404 });
}


// ── Location / embed data ───────────────────────────────────────────────
// The location section only renders when the studio has an address AND a
// map pin (lat/lng). Studios missing either keep the current layout.
const studioLat = studio?.latitude ?? NaN;
const studioLng = studio?.longitude ?? NaN;
const studioHasLocation = !!studio && !!studio.address && !isNaN(studioLat) && !isNaN(studioLng);

const gmapsDirections = studioHasLocation
  ? `https://www.google.com/maps/dir/?api=1&destination=${studioLat},${studioLng}`
  : '';

// ── SEO: Canonical URL & LocalBusiness schema ────────────────────────────────
const canonical = new URL(`/designers/${slug}`, Astro.site);

const studioSchema = studio ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${canonical}#business`,
      name: studio.name,
      description: studio.description || undefined,
      image: studio.cover || undefined,
      url: canonical.toString(),
      ...(studio.address ? { address: { '@type': 'PostalAddress', streetAddress: studio.address, addressLocality: studio.city } } : {}),
      ...(studioHasLocation ? { geo: { '@type': 'GeoCoordinates', latitude: studioLat, longitude: studioLng } } : {}),
      sameAs: [studio.website, studio.instagram].filter(Boolean),
    },
    breadcrumbList([
      { name: 'Home', url: '/' },
      { name: 'Designers', url: '/designers' },
      { name: studio.name, url: `/designers/${slug}` },
    ]),
  ],
} : null;
---

<Layout 
  title={studio ? `${studio.name} — Independent Design Studio in ${studio.city}` : 'Loading...'}
  description={studio ? `${studio.name} is an independent design studio based in ${studio.city}. Explore projects, objects, and studio information.` : ''}
  canonical={canonical}
  schema={studioSchema || undefined}
>
  <Navbar />
  
  {studio && (
    <div class="breadcrumbs-container">
      <Breadcrumbs items={[
        { label: 'Designers', href: '/designers' },
        { label: studio.name }
      ]} />
    </div>
  )}

  <main class="designer-container">
    {error ? (
      <div role="alert" style="padding: 64px 24px; text-align: center; color: var(--color-text-muted); font-family: var(--font-sans);">
        <p style="margin: 0;">This designer couldn't be loaded right now. Please try again later.</p>
      </div>
    ) : studio && (
      <>
        <div class="designer-hero-row">
          <div class="hero-image-wrapper">
            {cover ? (
              <img 
                src={normalizeImage(cover, Astro, { width: 1200 })} 
                alt={studio.name} 
                class="hero-image"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            ) : (
              <div class="hero-image-placeholder">No image available</div>
            )}
          </div>

          <aside class="info-card">
            <div class="info-card-content">
              <h1 class="designer-name">{studio.name}</h1>
              <div class="description-wrapper">
                <p class="designer-description" id="designerDescription">
                  {studio.description || 'No description available.'}
                </p>
                <button class="description-toggle" id="descriptionToggle" type="button" hidden>Read more</button>
              </div>

              <div class="social-links">
                <a href={ensureProtocol(studio.website) || '#'} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                  <img src="/icons/source.svg" alt="" width="16" height="16" />
                  <span>Website</span>
                </a>
                {studio.instagram ? (
                  <a href={ensureProtocol(studio.instagram)} target="_blank" rel="noopener noreferrer" class="card-social-btn">
                    <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                    <span>Instagram</span>
                  </a>
                ) : (
                  <span class="card-social-btn disabled" aria-disabled="true">
                    <img src="/icons/instagram.svg" alt="" width="16" height="16" />
                    <span>Instagram</span>
                  </span>
                )}
              </div>

              <div class="details-section">
                <div class="details-row">
                  <span class="detail-label">Country</span>
                  {studio.country_slug ? (
                    <a href={`/designers/in/${studio.country_slug}`} class="detail-value underlined detail-link">
                      {countryDisplayName(studio.country_slug)}
                    </a>
                  ) : (
                    <span class="detail-value">{studio.city}</span>
                  )}
                </div>
                <div class="details-divider"></div>
                <div class="details-row">
                  <span class="detail-label">Location</span>
                  {studio.city_slug ? (
                    <a href={`/designers/in/${studio.city_slug}`} class="detail-value underlined detail-link">
                      {studio.city}
                    </a>
                  ) : (
                    <span class="detail-value underlined">{studio.city}</span>
                  )}
                </div>
              </div>

              <div class="contacts-section" id="contactsSection">
                <div class:list={['details-row', { 'contacts-toggle-clickable': isLoggedIn }]} id="contactsToggle">
                  <span class="detail-label">Contacts</span>
                  {isLoggedIn ? (
                    <div class="contact-trigger">
                      <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M19 9l-7 7-7-7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                  ) : (
                    <a href="/login" class="detail-value contact-link">
                      <span>Login to view</span>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  )}
                </div>
                {isLoggedIn && studio && (
                  <div class="contacts-content" id="contactsContent">
                    {studio.email && <a href={`mailto:${studio.email}`} class="contact-email underlined">{studio.email}</a>}
                    {studio.email2 && <a href={`mailto:${studio.email2}`} class="contact-email underlined">{studio.email2}</a>}
                    {!studio.email && !studio.email2 && <span class="contact-email">No contact email available</span>}
                  </div>
                )}
              </div>
            </div>

            <div class="card-footer-actions">
              <button class="footer-btn share-btn" id="shareButton">
                <img src="/icons/share.svg" alt="" width="18" height="18" />
                <span>Share</span>
              </button>
              <SaveButton type="designer" itemId={studio.id} itemName={studio.name} buttonClass="footer-btn save-btn" />
            </div>
          </aside>
        </div>

        {studioHasLocation && (
          <section class="designer-location-section">
            <div class="location-grid">
              <div class="location-info">
                <h2 class="location-title">Location</h2>
                <p class="location-studio-name">{studio.name}</p>
                <p class="location-address">{studio.address}</p>
                <p class="location-meta">{(studio.city || '').split(',')[0].trim()}</p>
                <div class="location-actions">
                  <a class="location-cta location-directions" href={gmapsDirections} target="_blank" rel="noopener">
                    Get directions
                  </a>
                  <button class="location-wrong-link" id="locationReport" type="button">
                    Something wrong?
                  </button>
                </div>
              </div>
              <div class="location-map-col">
                <iframe
                  class="location-map"
                  src={`/embed/designer/${studio.slug}`}
                  title={`Map of ${studio.name}`}
                  loading="lazy"
                ></iframe>
              </div>
            </div>
          </section>
        )}

        <section class="discovery-area">
          <div class="discovery-content">
            {sameCityStudios.length > 0 && (
              <div class="discovery-section">
                <div class="section-top">
                  <h2 class="discovery-title">Discover more in {studio.city || 'the area'}</h2>
                  <a href={`/designers?city=${studio.city_slug}`} class="discovery-see-all pill-link">
                    Discover city
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
                <div class="discovery-grid">
                  {sameCityStudios.map((s, index) => (
                    <DirectoryCard studio={s} index={index} />
                  ))}
                </div>
              </div>
            )}

            {sameCountryStudios.length > 0 && (
              <div class="discovery-section">
                <div class="section-top">
                  <h2 class="discovery-title">Discover more in {countryDisplayName(studio.country_slug)}</h2>
                  <a href={`/designers?country=${studio.country_slug}`} class="discovery-see-all pill-link">
                    Discover country
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
                <div class="discovery-grid">
                  {sameCountryStudios.map((s, index) => (
                    <DirectoryCard studio={s} index={index} />
                  ))}
                </div>
              </div>
            )}

            {worldStudios.length > 0 && (
              <div class="discovery-section">
                <div class="section-top">
                  <h2 class="discovery-title">Discover from the world</h2>
                  <a href="/designers" class="discovery-see-all pill-link">
                    Discover world
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </div>
                <div class="discovery-grid">
                  {worldStudios.map((s, index) => (
                    <DirectoryCard studio={s} index={index} />
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      </>
    )}
  </main>

  {studioHasLocation && (
    <div class="embed-modal" id="reportModal" hidden>
      <div class="embed-modal-backdrop" id="reportBackdrop"></div>
      <div class="embed-modal-box" role="dialog" aria-modal="true" aria-label="Report this information">
        <button class="embed-modal-close" id="reportClose" type="button" aria-label="Close">&times;</button>
        <h3 class="embed-modal-title">Report this information</h3>
        <p class="embed-modal-desc">
          Something wrong with the address, map, or links? Tell us and we'll fix it.
        </p>
        <textarea class="embed-modal-code" id="reportText" placeholder="Describe the issue (optional)..."></textarea>
        <div class="embed-modal-actions">
          <button class="embed-modal-copy" id="reportSend" type="button">Send report</button>
        </div>
      </div>
    </div>
  )}

  <Footer />
</Layout>

<script>
  // Share Button Functionality
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: 'Check out this designer on Acceso'
      };

      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) {
      }
    });
  }

  // Contacts Dropdown Toggle
  const contactsToggle = document.getElementById('contactsToggle');
  const contactsSection = document.getElementById('contactsSection');
  if (contactsToggle && contactsSection) {
    contactsToggle.addEventListener('click', () => {
      contactsSection.classList.toggle('expanded');
    });
  }

  // Report popup (email to hello@acceso.design)
  const reportBtn = document.getElementById('locationReport');
  const reportModal = document.getElementById('reportModal');
  const reportClose = document.getElementById('reportClose');
  const reportBackdrop = document.getElementById('reportBackdrop');
  const reportSend = document.getElementById('reportSend');
  const reportText = document.getElementById('reportText') as HTMLTextAreaElement | null;
  const studioName = document.querySelector('.location-studio-name')?.textContent?.trim() || '';

  function openReportModal() {
    if (!reportModal) return;
    reportModal.hidden = false;
    reportText?.focus();
  }
  function closeReportModal() {
    if (reportModal) reportModal.hidden = true;
  }

  if (reportBtn) reportBtn.addEventListener('click', openReportModal);
  if (reportClose) reportClose.addEventListener('click', closeReportModal);
  if (reportBackdrop) reportBackdrop.addEventListener('click', closeReportModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeReportModal();
  });
  if (reportSend && reportText) {
    reportSend.addEventListener('click', () => {
      const note = reportText.value.trim();
      const body = `Designer: ${studioName}\nURL: ${window.location.href}\n\n${note}`;
      window.location.href = `mailto:hello@acceso.design?subject=${encodeURIComponent('Report: ' + studioName)}&body=${encodeURIComponent(body)}`;
      closeReportModal();
    });
  }

  // Description Read more / Read less
  const description = document.getElementById('designerDescription');
  const descriptionToggle = document.getElementById('descriptionToggle');
  if (description && descriptionToggle) {
    const checkTruncation = () => {
      if (description.classList.contains('expanded')) return;
      // Toggle is only useful when the clamped text is actually cut off.
      descriptionToggle.hidden = description.scrollHeight <= description.clientHeight + 1;
    };

    checkTruncation();
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(checkTruncation);
    }
    window.addEventListener('resize', checkTruncation);

    descriptionToggle.addEventListener('click', () => {
      const expanded = description.classList.toggle('expanded');
      descriptionToggle.textContent = expanded ? 'Read less' : 'Read more';
    });
  }
</script>

<style>
  .detail-value.underlined {
    text-decoration: underline;
  }

  save-button {
    display: contents;
  }

  .designer-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px 0px;
  }

  /* Breadcrumbs */
  .breadcrumbs-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--page-top-spacing) 40px 0;
  }

  /* Hero Layout */
  .designer-hero-row {
    display: flex;
    gap: 40px;
    margin-top: var(--page-hero-gap);
    align-items: stretch;
    justify-content: flex-end;
    --hero-card-height: clamp(500px, 75vh, 700px);
  }

  .hero-image-wrapper {
    height: var(--hero-card-height);
    max-height: var(--hero-card-height);
    width: auto;
    max-width: 100%;
    background: var(--color-bg-secondary);
    border-radius: 20px;
    overflow: hidden;
    flex-shrink: 1;
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 0;
  }

  /* Info Card */
  .info-card {
    width: 400px;
    height: var(--hero-card-height, clamp(500px, 75vh, 700px));
    max-height: var(--hero-card-height, clamp(500px, 75vh, 700px));
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: clamp(20px, 3vh, 32px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    overflow: hidden;
  }

  .info-card-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    padding-right: 8px;
    margin-right: -8px;
    min-height: 0;
  }

  .info-card::-webkit-scrollbar { display: none; }
  .info-card-content::-webkit-scrollbar { display: none; }

  .designer-name {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-black);
    margin-bottom: 24px;
  }

  .description-wrapper {
    margin-bottom: 24px;
  }

  .designer-description {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-gray);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .designer-description.expanded {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .description-toggle {
    margin-top: 6px;
    padding: 0;
    background: none;
    border: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-black);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .description-toggle:hover {
    opacity: 0.6;
  }

  .social-links {
    display: flex;
    gap: 8px;
    margin-bottom: 24px;
  }

  /* Unify hover for Website, Instagram and Share buttons to match the
     back button: a subtle, elegant darken. */
  .card-social-btn:hover,
  .share-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .details-section {
    background: var(--color-btn-bg);
    border-radius: 10px;
    padding: 16px 0;
    margin-bottom: 16px;
  }

  .details-row { display: flex; justify-content: space-between; align-items: center; }
  .detail-label { font-size: 15px; color: var(--color-gray); }
  .detail-value { font-size: 15px; font-weight: 700; color: var(--color-black); text-decoration: none; display: flex; align-items: center; gap: 6px; }

  /* Unify hover for Country, Location and "Login to view": simply
     get a little lighter, no movement. */
  .detail-link,
  .contact-link { transition: opacity 0.2s ease; }
  .detail-link:hover,
  .contact-link:hover { opacity: 0.6; }

  .details-divider { height: 1px; background: var(--color-stroke); margin: 12px 0; }

  .contacts-section { background: var(--color-btn-bg); border-radius: 10px; padding: 16px 0; margin-bottom: 24px; }
  .contacts-toggle-clickable { cursor: pointer; }
  .contact-trigger { cursor: pointer; display: flex; align-items: center; color: var(--color-black); }
  .chevron-icon { transition: transform 0.3s ease; }
  .contacts-section.expanded .chevron-icon { transform: rotate(180deg); }
  .contacts-content { display: none; flex-direction: column; gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-stroke); }
  .contacts-section.expanded .contacts-content { display: flex; }
  .contact-email { font-size: 15px; font-weight: 700; color: var(--color-black); text-decoration: none; width: fit-content; }

  .card-footer-actions {
    margin-top: auto;
  }

  /* Discovery Area Styling */
  .discovery-area {
    margin-top: 120px;
    padding-bottom: 80px;
  }

  .discovery-section {
    margin-bottom: 80px;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
    padding-bottom: 0;
  }

  .discovery-title {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-black);
  }

  .discovery-see-all { flex-shrink: 0; font-weight: 600; }

  .discovery-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); }

  .events-discovery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 1300px) {
    .discovery-grid { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 1100px) {
    .discovery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .designer-hero-row { flex-direction: column; align-items: center; }
    .info-card { width: 100%; height: auto; max-height: none; max-width: 600px; }
    .hero-image-wrapper { width: 100%; max-width: 600px; height: auto; max-height: none; min-height: auto; border-radius: 0; }
    .designer-container { padding: 0 20px 0px; }
    .breadcrumbs-container { padding-left: 20px; }
  }

  @media (max-width: 640px) {
    .discovery-grid { grid-template-columns: repeat(2, 1fr); }
