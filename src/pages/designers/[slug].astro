---
import PostHogLayout from '../../layouts/PostHogLayout.astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Tabs from '../../components/Tabs.astro';
import DesignerInfo from '../../components/DesignerInfo.astro';
import DesignerMoodboard from '../../components/DesignerMoodboard.astro';

import DesignerActionButtons from '../../components/DesignerActionButtons.astro';
import type { Studio } from '../../lib/types';
import '../../styles/designer-detail.css';
const { slug } = Astro.params;

let studio: Studio | null = null;
let error = null;

try {
  // Fetch from static JSON - cached at edge
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const response = await fetch(studiosUrl.toString());
  if (!response.ok) throw new Error('Failed to load studios data');
  
  const studios: Studio[] = await response.json();
  studio = studios.find(s => s.slug === slug) || null;
} catch (e) {
  error = e;
  console.error('Failed to fetch studio:', e);
}

if (!studio && !error) {
  return Astro.redirect('/404');
}

const pageTitle = studio ? `${studio.name} - Acceso` : 'Studio Not Found';
const pageDescription = studio ? `Discover ${studio.name}, an independent design studio in ${studio.city}` : '';
const pageImage = studio?.cover || '/og-default.jpg';
---

<PostHogLayout>
  <Layout 
    title={`${studio.name} - ${studio.city} Design Studio | Acceso`}
    description={`${studio.name} is an independent design studio based in ${studio.city}. Explore their projects, objects, and contact information.`}
    image={studio.cover || '/social-card.png'}
    type="article"
    keywords={`${studio.name}, ${studio.city} design, industrial design studio, product design ${studio.city}`}
    publishedTime={studio.created_at}
    modifiedTime={studio.updated_at}
  >
    <!-- Organization Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": studio.name,
      "url": studio.website,
      "logo": studio.cover,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": studio.city,
        "streetAddress": studio.address
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": studio.email,
        "contactType": "General Inquiry"
      },
      "sameAs": [studio.instagram, studio.website].filter(Boolean)
    })} />
    <Navbar />
    
    <main class="designer-page">
      <div class="designer-left-col">


        {error ? (
          <div class="error-state">
            <h2 style="color: #ff6b6b; margin-bottom: 16px;">Error Loading Studio</h2>
            <p style="color: var(--text-secondary); margin-bottom: 16px;">
              Unable to load studio data. Please try again later.
            </p>
          </div>
        ) : (
          <>
            <div class="designer-image-container">
              {studio.cover ? (
                <img 
                  src={studio.cover} 
                  alt={studio.name}
                  class="designer-image"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  data-skeleton
                />
              ) : (
                <div class="designer-image-placeholder">
                  <span>No image available</span>
                </div>
              )}
            </div>

            <DesignerActionButtons 
              studioId={studio.id} 
              designerImageUrl={studio.cover}
              designerName={studio.slug}
            />
          </>
        )}
      </div>

      {!error && (
        <div class="designer-content">
          <Tabs active="info" />
          
          <div id="tab-info" class="tab-content tab-content-active">
            <DesignerInfo studio={studio} />
          </div>
          
          <div id="tab-moodboard" class="tab-content">
            <DesignerMoodboard studio={studio} />
          </div>
        </div>
      )}
    </main>
  </Layout>
</PostHogLayout>

<script src="/js/designer-detail.js" is:inline></script>