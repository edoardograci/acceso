---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Tabs from '../../components/Tabs.astro';
import DesignerInfo from '../../components/DesignerInfo.astro';
import ActionButtons from '../../components/ActionButtons.astro';
import { getStudioBySlug } from '../../lib/db';

const { slug } = Astro.params;

let studio = null;
let error = null;

try {
  const env = Astro.locals.runtime.env;  // Access runtime env
  studio = await getStudioBySlug(slug, env);
} catch (e) {
  error = e;
  console.error('Failed to fetch studio:', e);
}

if (!studio && !error) {
  return Astro.redirect('/404');
}

const pageTitle = studio ? `${studio.name} - Acceso` : 'Studio Not Found';
const pageDescription = studio ? `Discover ${studio.name}, an independent design studio in ${studio.city}` : '';
const pageImage = studio?.cover || '/og-default.jpg';
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
>
  <Navbar />
  
  <main class="designer-page">
    <div class="designer-header">
      <h1 class="designer-page-title">Designers</h1>
      <p class="designer-breadcrumb">/ {studio?.name || 'Not Found'}</p>
    </div>

    {error ? (
      <div class="error-state">
        <h2 style="color: #ff6b6b; margin-bottom: 16px;">Database Connection Error</h2>
        <p style="color: var(--text-secondary); margin-bottom: 16px;">
          Unable to connect to the database or fetch studio.
        </p>
        <details style="margin-top: 24px; padding: 16px; background: var(--gray-dark); border-radius: 8px; text-align: left; max-width: 800px; margin: 24px auto;">
          <summary style="cursor: pointer; color: var(--accent-yellow);">View Error Details</summary>
          <pre style="margin-top: 16px; overflow: auto; font-size: 12px; color: #ff6b6b;">{JSON.stringify(error, null, 2)}</pre>
        </details>
      </div>
    ) : (
      <>
        <div class="designer-image-container">
          {studio.cover ? (
            <img 
              src={studio.cover} 
              alt={studio.name}
              class="designer-image"
              loading="eager"
            />
          ) : (
            <div class="designer-image-placeholder">
              <span>No image available</span>
            </div>
          )}
        </div>

        <div class="designer-content">
          <Tabs active="info" />
          <DesignerInfo studio={studio} />
          <ActionButtons />
        </div>
      </>
    )}
  </main>
</Layout>

<style>
  .designer-page {
    padding-top: var(--navbar-height);
    min-height: 100vh;
  }

  .designer-header {
    padding: 32px var(--spacing-page);
  }

  .designer-page-title {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 0.64px;
    margin-bottom: 8px;
  }

  .designer-breadcrumb {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 200;
    letter-spacing: 0.56px;
    color: var(--text-primary);
  }

  .designer-image-container {
    padding: 0 var(--spacing-page);
    margin-bottom: 16px;
  }

  .designer-image {
    width: 100%;
    height: auto;
    max-height: 379px;
    object-fit: contain;
    display: block;
  }

  .designer-image-placeholder {
    width: 100%;
    height: 379px;
    background-color: var(--gray-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
  }

  .designer-content {
    padding: 16px var(--spacing-page);
  }
</style>