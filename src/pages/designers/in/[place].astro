---
import PostHogLayout from '../../../layouts/PostHogLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import DirectoryCard from '../../../components/DirectoryCard.astro';
import { locationTitle, locationDescription, locationIntro, locationH1Parts, LOCATION_BREADCRUMB_LABEL } from '../../../lib/seo/copy';
import { breadcrumbList, itemList, faqPage, studioBusinessNodes } from '../../../lib/seo/schema';
import { normalizeImage } from '../../../lib/images';
import type { Studio } from '../../../lib/types';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

const { place } = Astro.params;

const isDev = import.meta.env.DEV;
const origin = Astro.url.origin;
const domain = isDev ? 'https://json.acceso.design' : `${origin}/cdn`;

async function fetchJson<T>(path: string): Promise<T> {
  const u = `${domain}${path.startsWith('/') ? '' : '/'}${path}`;
  const r = await fetch(u);
  if (!r.ok) throw new Error(`Fetch failed ${path}: ${r.status}`);
  return (await r.json()) as T;
}

type City = { slug: string; name: string; country?: string };
type Country = { slug: string; name: string };

let cities: City[] = [];
let countries: Country[] = [];
let allStudios: Studio[] = [];
let mode: 'city' | 'country' | 'unknown' = 'unknown';
let cityName: string | null = null;
let countryName: string | null = null;
let countrySlug: string | null = null;
let totalStudios: number = 0;

try {
  [cities, countries, allStudios] = await Promise.all([
    fetchJson<City[]>('/test-cities.json'),
    fetchJson<Country[]>('/test-countries.json'),
    fetchJson<Studio[]>('/test-studios.json'),
  ]);
} catch (e) {
  console.error('[SSR] Fetch failed:', e);
}

const cityObj = cities.find((c) => c.slug === place) ?? null;
const countryObj = countries.find((c) => c.slug === place) ?? null;

let studios: Studio[] = [];

if (cityObj) {
  mode = 'city';
  cityName = cityObj.name;
  const c = countries.find((x) => x.slug === (cityObj.country ?? '')) ?? null;
  countryName = c?.name ?? null;
  countrySlug = cityObj.country ?? null;
  studios = allStudios.filter(s => {
    const studioSlug = (s.city_slug || '').toLowerCase();
    const studioCity = (s.city || '').toLowerCase();
    const target = place.toLowerCase();
    return (
      studioSlug === target ||
      studioCity === target ||
      studioCity.startsWith(`${target},`) ||
      studioCity.startsWith(`${target} `)
    );
  });
} else if (countryObj) {
  mode = 'country';
  countryName = countryObj.name;
  studios = allStudios.filter(s => s.country_slug === place);
} else {
  return new Response(null, { status: 404 });
}

totalStudios = studios.length;

// Normalize images
studios = studios.map((s) => ({
  ...s,
  cover: normalizeImage(s.cover, Astro) as string | null,
}));

const where =
  mode === 'city'
    ? { cityName: cityName!, countryName, totalStudios, exampleStudios: studios.slice(0, 6).map((s) => s.name) }
    : { cityName: countryName!, countryName: null, totalStudios, exampleStudios: studios.slice(0, 6).map((s) => s.name) };

const pageTitle = locationTitle(where);
const pageDesc = locationDescription(where);
const { paragraph } = locationIntro(where);
const { prefix: h1Prefix, place: h1Place } = locationH1Parts(where);

const canonical = new URL(`/designers/in/${place}`, Astro.site);

const crumbs = 
  mode === 'city' 
    ? [
        { name: 'Home', url: '/' },
        { name: LOCATION_BREADCRUMB_LABEL, url: '/designers' },
        { name: `in ${cityName}`, url: canonical.pathname }
      ]
    : [
        { name: 'Home', url: '/' },
        { name: LOCATION_BREADCRUMB_LABEL, url: '/designers' },
        { name: `in ${countryName}`, url: canonical.pathname }
      ];

// Related Locations Logic
function studioMatchesCity(studio: any, citySlug: string, cityName: string): boolean {
  const studioSlug = (studio.city_slug || '').toLowerCase();
  const studioCity = (studio.city || '').toLowerCase();
  const targetSlug = citySlug.toLowerCase();
  const targetName = cityName.toLowerCase();
  return (
    studioSlug === targetSlug ||
    studioCity === targetName ||
    studioCity.startsWith(`${targetName},`) ||
    studioCity.startsWith(`${targetName} `)
  );
}

const cityToCountrySlug: Record<string, string> = {};
cities.forEach((ct: any) => {
  if (!ct.slug) return;
  const match = allStudios.find((s: any) => s.country_slug && studioMatchesCity(s, ct.slug, ct.name));
  if (match) cityToCountrySlug[ct.slug] = match.country_slug;
});

let relatedLocations: { name: string; slug: string }[] = [];
if (mode === 'country') {
  relatedLocations = cities
    .filter(c => c.slug !== place && cityToCountrySlug[c.slug] === place)
    .map(c => ({ name: c.name, slug: c.slug }));
} else if (mode === 'city') {
  const currentCountry = cityToCountrySlug[place] || cityObj?.country || null;
  if (currentCountry) {
    if (!countryName) {
      const c = countries.find((x) => x.slug === currentCountry) ?? null;
      if (c) countryName = c.name;
    }
    if (!countrySlug) {
      countrySlug = currentCountry;
    }
    relatedLocations = cities
      .filter(c => c.slug !== place && cityToCountrySlug[c.slug] === currentCountry)
      .map(c => ({ name: c.name, slug: c.slug }));
  }
}

const relatedLocationsHeading =
  mode === 'country'
    ? `Cities in ${countryName}`
    : countryName
      ? `Other design cities in ${countryName}`
      : 'Related locations';

const placeName = mode === 'city' ? cityName : countryName;

const listSchema = itemList({
  url: canonical.toString(),
  name: mode === 'city' ? `Studios in ${cityName}${countryName ? `, ${countryName}` : ''}` : `Studios in ${countryName}`,
  items: studios.slice(0, 50).map((s) => ({
    name: s.name,
    url: new URL(`/designers/${encodeURIComponent(s.slug)}`, Astro.site).toString(),
  })),
});

// "Last verified" = the most recently updated studio in this result set, so
// the freshness claim shown on the page (and in schema below) is a real
// fact about the data, never a hardcoded date.
const updatedTimestamps = studios
  .map((s) => (s.updated_at ? new Date(s.updated_at) : null))
  .filter((d): d is Date => !!d && !isNaN(d.getTime()))
  .map((d) => d.getTime());

const lastVerifiedDate = updatedTimestamps.length ? new Date(Math.max(...updatedTimestamps)) : new Date();
const lastVerifiedLabel = lastVerifiedDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const lastVerifiedIso = lastVerifiedDate.toISOString();

const businessNodes = studioBusinessNodes({
  items: studios.slice(0, 50).map((s) => ({
    name: s.name,
    url: new URL(`/designers/${encodeURIComponent(s.slug)}`, Astro.site).toString(),
    website: s.website,
    description: s.description,
    city: s.city,
    country: s.country || countryName,
  })),
});

// Two entries, shared by the visible pill links (q + href) and the
// FAQPage schema (q + a) — a single source so the label on the page and
// the answer in structured data can never drift apart. Each question maps
// to a real page the pill actually sends you to.
const faqItems = [
  {
    q: 'How is this list curated?',
    a: `Studios are added by self-submission and reviewed by Acceso's editorial team before publishing. See the Info page for our full curation methodology.`,
    href: '/info',
  },
  {
    q: 'Can I add my studio to this list?',
    a: `Yes — submitting a studio is free. Once approved by Acceso's editorial team, it will appear on the ${placeName} design map and directory.`,
    href: '/submission',
  },
];
const faqSchema = faqPage(faqItems.map(({ q, a }) => ({ q, a })));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    breadcrumbList(crumbs),
    { ...listSchema, dateModified: lastVerifiedIso },
    faqSchema,
    ...businessNodes,
  ],
};

const initialStudios = studios.slice(0, 18);
const mapStudios = studios.map(s => ({
  id: s.id,
  name: s.name,
  city: s.city,
  country: s.country,
  address: s.address,
  latitude: s.latitude,
  longitude: s.longitude,
  slug: s.slug,
  cover: s.cover
}));
---

<PostHogLayout title={pageTitle} description={pageDesc} canonical={canonical} schema={schema}>
  <Navbar />

  <main class="designers-page">
    <div class="split-container">
      <!-- Left Column: Results Panel -->
      <aside class="results-panel">
        <div class="panel-handle" aria-hidden="true"><span class="panel-handle-bar"></span></div>
        <div class="results-panel-content">
          <Breadcrumbs items={[
            { label: 'Home', href: '/' },
            { label: LOCATION_BREADCRUMB_LABEL, href: '/designers' },
            { label: `In ${mode === 'city' ? cityName : countryName}` }
          ]} />

          <header class="panel-header">
             <h1 class="location-heading">
                {h1Prefix} <span class="location-accent">{h1Place}</span>
             </h1>

             {mode === 'city' && countryName && countrySlug && (
               <a href={`/designers/in/${countrySlug}`} class="country-subtitle">
                 {countryName} <svg class="country-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
               </a>
             )}

             <p class="location-intro">{paragraph}</p>

             <div class="location-byline">
               <img src="/icon.svg" alt="" width="20" height="20" class="byline-icon" />
               <span>Curated by <span style="font-weight: 600; color: var(--color-black);">Acceso's Editorial Team</span> · Last verified {lastVerifiedLabel}</span>
             </div>

             <div class="mini-faq">
               {faqItems.map((item) => (
                 <a href={item.href} class="pill-btn">{item.q}</a>
               ))}
             </div>
          </header>

          <div class="results-meta">
            <h2 class="results-count" id="studio-count">
              {totalStudios} results
            </h2>
          </div>

          <div class="studios-grid" id="studios-grid">
            {initialStudios.map((studio, index) => (
              <DirectoryCard studio={studio} index={index} showDescription description={studio.description} />
            ))}
          </div>

          <div class="hidden py-12 text-center text-gray" id="empty-result"></div>
          
          <!-- Pagination: pinned footer of the panel on mobile (like the homepage) -->
          <div id="pagination-container" class="pagination-wrapper"></div>

          <!-- Related locations (bottom, no more submission card here — the
               two pills above already cover "how do I get listed") -->
          {relatedLocations.length > 0 && (
            <div class="bottom-cards-section">
              <div class="related-locations-card">
                 <div class="rl-header">
                    <h3 class="rl-title">{relatedLocationsHeading}</h3>
                 </div>
                 <div class="rl-content">
                    {relatedLocations.slice(0, 10).map(loc => (
                      <a href={`/designers/in/${loc.slug}`} class="pill-btn">
                        {loc.name}
                      </a>
                    ))}
                 </div>
              </div>
            </div>
          )}
        </div>
      </aside>

      <!-- Right Column: Map Panel -->
      <section class="map-panel">
        <div class="map-canvas-wrap">
          <div id="map"></div>

          <button type="button" class="map-recenter-btn" id="map-recenter-btn" aria-label="Recenter map">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>
            </svg>
            RECENTER
          </button>

          <!-- Studio UI Card -->
          <div class="studio-ui-container" id="studio-ui-container">
            <div class="studio-card" id="studio-card">
              <a href="#" class="studio-card-inner" id="studio-card-link">
                <div class="studio-card-media">
                  <img 
                    src="" 
                    alt="" 
                    class="studio-card-image" 
                    id="studio-card-image"
                  />
                </div>
                <div class="studio-card-info">
                  <h3 class="studio-card-title" id="studio-card-title"></h3>
                  <p class="studio-card-city" id="studio-card-city"></p>
                  <div class="studio-card-address-row">
                     <p class="studio-card-address" id="studio-card-address"></p>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />

  <script is:inline define:vars={{ studios, mapStudios }}>
    window.INITIAL_STUDIOS = studios;
    window.MAP_STUDIOS = mapStudios;
  </script>

  <script>
    import { initializeMap } from '../../../lib/map-init';
    import { firstSentence } from '../../../lib/text';

    const ALL_STUDIOS = (window as any).INITIAL_STUDIOS;
    const MAP_STUDIOS = (window as any).MAP_STUDIOS;
    const itemsPerPage = 18;
    let currentPage = 1;
    let filteredStudios = [...ALL_STUDIOS];
    let mapInstance: any = null;

    async function initMap() {
      if (MAP_STUDIOS?.length > 0) {
        const bounds: [[number, number], [number, number]] | null = (() => {
          let minLng = Infinity, minLat = Infinity, maxLng = -Infinity, maxLat = -Infinity;
          MAP_STUDIOS.forEach((s: any) => {
            const lat = typeof s.latitude === 'string' ? parseFloat(s.latitude) : s.latitude;
            const lng = typeof s.longitude === 'string' ? parseFloat(s.longitude) : s.longitude;
            if (lat == null || lng == null || isNaN(lat) || isNaN(lng)) return;
            minLng = Math.min(minLng, lng);
            minLat = Math.min(minLat, lat);
            maxLng = Math.max(maxLng, lng);
            maxLat = Math.max(maxLat, lat);
          });
          if (minLng === Infinity) return null;
          return [[minLng, minLat], [maxLng, maxLat]];
        })();

        mapInstance = await initializeMap(MAP_STUDIOS, null, 'studio', bounds);
        if (!mapInstance || !mapInstance.map) return;

        const focusLocation = () => {
          mapInstance.map.resize();
          if (mapInstance.updateStudios) {
            mapInstance.updateStudios(MAP_STUDIOS, false, true);
          }
        };

        if (mapInstance.map.loaded()) {
          focusLocation();
        } else {
          mapInstance.map.once('load', focusLocation);
        }

        const recenterBtn = document.getElementById('map-recenter-btn');
        recenterBtn?.addEventListener('click', () => {
          mapInstance?.recenter();
        });
      }
    }

    function init() {
      initMap();

      renderGrid();

      const studiosGrid = document.getElementById('studios-grid');
      studiosGrid?.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('.directory-card') as HTMLElement;
        if (!card) return;

        const lat = card.dataset.lat;
        const lng = card.dataset.lng;
        const slug = card.dataset.slug;

        if (window.innerWidth > 1024 && lat && lng && mapInstance) {
          e.preventDefault();
          const studio = mapInstance.studiosData.find((s: any) => s.slug === slug);
          if (studio) {
            mapInstance.navigateToStudio(studio);
          }
        }
      });

      // Desktop-only: hovering a studio card in the list shows the map
      // hover pill on the corresponding unclustered pin (Airbnb-style).
      if (window.innerWidth > 1024) {
        setupCardHoverPill();
      }
    }

    function setupCardHoverPill() {
      const studiosGrid = document.getElementById('studios-grid');
      if (!studiosGrid) return;

      let hoveredCard: HTMLElement | null = null;

      studiosGrid.addEventListener('mouseover', (e) => {
        const card = (e.target as HTMLElement).closest('.directory-card') as HTMLElement | null;
        if (card === hoveredCard) return; // same card, no-op

        // Moving to a different card or out of any card
        if (hoveredCard && mapInstance?.hidePill) {
          mapInstance.hidePill();
        }
        hoveredCard = card;

        if (!card || !mapInstance || !mapInstance.showPill || !mapInstance.map) return;

        const slug = card.dataset.slug;
        const lat = parseFloat(card.dataset.lat || '');
        const lng = parseFloat(card.dataset.lng || '');
        if (!slug || isNaN(lat) || isNaN(lng)) return;

        const studio = mapInstance.studiosData.find((s: any) => s.slug === slug);
        if (!studio) return;

        try {
          const features = mapInstance.map.queryRenderedFeatures(undefined, {
            layers: ['unclustered-point'],
          });
          const match = features.find((f: any) => String(f.properties?.id) === String(studio.id));
          if (!match) return; // pin is clustered or not visible

          mapInstance.showPill(studio.name, [lng, lat]);
        } catch (_) {
          // layer may not exist yet
        }
      });

      studiosGrid.addEventListener('mouseleave', () => {
        hoveredCard = null;
        if (mapInstance?.hidePill) {
          mapInstance.hidePill();
        }
      });
    }

    function escapeHtml(value: string) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function resolveCover(cover?: string | null) {
      if (!cover) return '';
      if (cover.startsWith('http')) return cover;
      return `${window.location.origin}/cdn/${cover.replace(/^\/+/, '')}`;
    }

    function renderGrid() {
      const grid = document.getElementById('studios-grid');
      const start = (currentPage - 1) * itemsPerPage;
      const end = start + itemsPerPage;
      const pageItems = filteredStudios.slice(start, end);

      const count = document.getElementById('studio-count');
      if (count) count.textContent = `${filteredStudios.length} results`;

      if (grid) {
        if (filteredStudios.length === 0) {
          grid.style.display = 'none';
          const empty = document.getElementById('empty-result');
          if (empty) {
            empty.style.display = 'block';
            if (!empty.firstChild) {
              const p = document.createElement('p');
              p.textContent = 'No designers found matching your criteria.';
              empty.appendChild(p);
            }
          }
        } else {
          grid.style.display = 'grid';
          const empty = document.getElementById('empty-result');
          if (empty) empty.style.display = 'none';
          
          grid.innerHTML = pageItems.map((s) => {
            const cover = resolveCover(s.cover);
            const cityClean = (s.city || '').split(',')[0].trim();
            const location = cityClean || '';
            const snippet = firstSentence(s.description);
            return `
            <a href="/designers/${encodeURIComponent(s.slug || '')}"
               class="directory-card"
               data-lat="${escapeHtml(s.latitude || '')}"
               data-lng="${escapeHtml(s.longitude || '')}"
               data-slug="${escapeHtml(s.slug || '')}"
            >
              <div class="directory-card-media">
                ${cover ? `<img src="${escapeHtml(cover)}" alt="${escapeHtml(s.name || '')}" class="directory-card-image" loading="lazy" decoding="async" />` : '<div class="directory-card-placeholder"></div>'}
              </div>
              <h3 class="directory-card-name">${escapeHtml(s.name || '')}</h3>
              <p class="directory-card-location">${escapeHtml(location)}</p>
              ${snippet ? `<p class="directory-card-desc">${escapeHtml(snippet)}</p>` : ''}
            </a>
          `;
          }).join('');
        }
      }

      renderPagination();
    }

    function renderPagination() {
      const container = document.getElementById('pagination-container');
      const totalPages = Math.ceil(filteredStudios.length / itemsPerPage);

      if (!container) return;
      if (totalPages <= 1) {
        container.innerHTML = '';
        container.style.display = 'none';
        return;
      }
      container.style.display = '';

      let html = `<button class="pagination-btn pagination-arrow" ${currentPage === 1 ? 'disabled' : ''} data-page="prev"><svg class="pagination-icon-prev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></button>`;
      let startPage = Math.max(1, currentPage - 2);
      let endPage = Math.min(totalPages, startPage + 4);
      if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
      for (let i = startPage; i <= endPage; i++) {
        html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
      }
      html += `<button class="pagination-btn pagination-arrow" ${currentPage === totalPages ? 'disabled' : ''} data-page="next"><svg class="pagination-icon-next" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg></button>`;
      container.innerHTML = html;

      container.querySelectorAll('.pagination-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const page = (e.currentTarget as HTMLElement).dataset.page;
          if (page === 'prev') currentPage--;
          else if (page === 'next') currentPage++;
          else currentPage = parseInt(page!);
          renderGrid();
          const inner = document.querySelector('.results-panel-content') as HTMLElement | null;
          if (inner && window.innerWidth <= 1024) {
            inner.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      });
    }

    init();

      const panel = document.querySelector('.results-panel') as HTMLElement | null;
      const panelInner = panel ? panel.querySelector('.results-panel-content') as HTMLElement | null : null;

      const COLLAPSED_PEEK = 240;
      const isMobilePanel = () => window.innerWidth <= 1024;

      let startY = 0;
      let startMaxH = 0;
      let currentMaxH = 0;
      let startedOnHandle = false;
      let isDragging = false;
      let collapsed = true;

      const collapsedHeight = () => COLLAPSED_PEEK;
      const expandedHeight = () => Math.round(window.innerHeight * 0.88);

      function setSnap(expanded: boolean, animate = true) {
        if (!panel) return;
        collapsed = !expanded;
        panel.style.transition = animate ? 'max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
        panel.style.maxHeight = expanded ? `${expandedHeight()}px` : `${collapsedHeight()}px`;
        panel.classList.toggle('is-expanded', expanded);
        if (!expanded && panelInner) panelInner.scrollTop = 0;
        if (animate) setTimeout(() => mapInstance?.map?.resize(), 350);
      }

      if (panel && isMobilePanel()) {
        setSnap(false, false);
      }

      window.addEventListener('resize', () => {
        if (!panel) return;
        if (!isMobilePanel()) {
          panel.style.transition = '';
          panel.style.maxHeight = '';
          panel.classList.remove('is-expanded');
          return;
        }
        setSnap(!collapsed, false);
        setTimeout(() => mapInstance?.map?.resize(), 100);
      });

      panel?.addEventListener('touchstart', (e) => {
        if (!isMobilePanel()) return;
        const target = e.target as HTMLElement | null;
        const onHandle = !!(target && target.closest('.panel-handle'));
        if (!onHandle && panelInner && panelInner.scrollTop > 0) return;
        startedOnHandle = onHandle;
        startY = e.touches[0].clientY;
        startMaxH = collapsed ? collapsedHeight() : expandedHeight();
        currentMaxH = startMaxH;
        isDragging = true;
        panel.style.transition = 'none';
      }, { passive: true });

      panel?.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        if (!startedOnHandle && panelInner && panelInner.scrollTop > 0) return;

        const delta = e.touches[0].clientY - startY;
        if (!startedOnHandle && delta < 0 && !collapsed) return;

        let next = startMaxH - delta;
        const full = expandedHeight();
        if (next > full) next = full + (next - full) * 0.15;
        if (next < collapsedHeight() * 0.5) next = collapsedHeight() * 0.5 + (next - collapsedHeight() * 0.5) * 0.3;

        currentMaxH = next;
        panel.style.maxHeight = `${Math.max(0, next)}px`;
      }, { passive: true });

      const endDrag = () => {
        if (!isDragging) return;
        isDragging = false;
        panel!.style.transition = '';
        const full = expandedHeight();
        const mid = (collapsedHeight() + full) / 2;
        panel!.style.maxHeight = '';
        if (currentMaxH <= collapsedHeight() * 0.6) {
          setSnap(false, true);
        } else if (currentMaxH >= mid) {
          setSnap(true, true);
        } else {
          setSnap(false, true);
        }
      };

      panel?.addEventListener('touchend', endDrag);
      panel?.addEventListener('touchcancel', endDrag);
    </script>

  <script>
    (function () {
      const referrer = document.referrer;
      let referrerPath = '';
      try {
        referrerPath = new URL(referrer).pathname;
      } catch (e) {}

      if (referrerPath !== '/') return;

      const breadcrumbNav = document.querySelector('.breadcrumbs');
      if (!breadcrumbNav) return;

      const backBtn = breadcrumbNav.querySelector('.breadcrumb-back');
      const items = breadcrumbNav.querySelectorAll('.breadcrumb-item');
      const separators = breadcrumbNav.querySelectorAll('.breadcrumb-separator');

      if (backBtn) backBtn.href = '/';
      if (items.length >= 2) items[1].remove();
      if (separators.length >= 1) separators[0].remove();
    })();
  </script>

