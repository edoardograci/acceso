---
import PostHogLayout from '../../layouts/PostHogLayout.astro';
import Navbar from '../../components/Navbar.astro';
import DirectoryCard from '../../components/DirectoryCard.astro';
import Footer from '../../components/Footer.astro';
import type { Studio} from '../../lib/types';
import { itemList } from '../../lib/seo/schema';

// Fetch Data
let studios: Studio[] = [];
let metadata: any = null;
let error = null;
let cities: string[] = [];
let totalStudios = 0;
let orderedFilterData: any[] = [];

function distributeGroupsForColumns(groups: any[], columns = 6) {
  const colHeights = Array(columns).fill(0);
  const cols: any[][] = Array.from({ length: columns }, () => []);
  for (const g of groups) {
    const weight = 1 + (g.cities?.length || 0);
    let target = 0;
    for (let i = 1; i < columns; i++) {
      if (colHeights[i] < colHeights[target]) target = i;
    }
    cols[target].push(g);
    colHeights[target] += weight;
  }
  return cols.flat();
}

try {
  const isDev = import.meta.env.DEV;
  const domain = isDev ? 'https://json.acceso.design' : `${Astro.url.origin}/cdn`;
  
  const metadataUrl = `${domain}/metadata.json`;
  const countriesUrl = `${domain}/test-countries.json`;
  const citiesUrl = `${domain}/test-cities.json`;
  
  const [metaRes, cRes, ciRes] = await Promise.all([
    fetch(metadataUrl),
    fetch(countriesUrl),
    fetch(citiesUrl)
  ]);

  if (metaRes.ok && cRes.ok && ciRes.ok) {
    metadata = await metaRes.json();
    totalStudios = metadata.totalStudios || 0;
    const countriesList = await cRes.json();
    const citiesList = await ciRes.json();
    
    cities = ['Milan', 'Berlin', 'Copenhagen', 'London', 'Paris', 'Seoul', 'Stockholm', 'Tokyo'];

    // Load page-1 of ALL studios natively from test-studios.json (since no all/page-1 exists)
    const studiosRes = await fetch(`${domain}/test-studios.json`);
    if (studiosRes.ok) {
      const rawAll = await studiosRes.json();
      totalStudios = rawAll.length; // Use actual count from studios data
      studios = rawAll.slice(0, 20);
      
      // Count studios per city from actual data
      const cityCounts: Record<string, number> = {};
      rawAll.forEach((studio: any) => {
        if (studio.city_slug) {
          cityCounts[studio.city_slug] = (cityCounts[studio.city_slug] || 0) + 1;
        }
      });
      
      // The cities list has empty country fields, so derive each city's
      // country from the studios data (which does carry country_slug).
      const cityToCountry: Record<string, string> = {};
      rawAll.forEach((studio: any) => {
        if (studio.city_slug && studio.country_slug) {
          cityToCountry[studio.city_slug] = studio.country_slug;
        }
      });
      const countryNames = Object.fromEntries(countriesList.map((c: any) => [c.slug, c.name]));

      // Group every city under its real country — no "Other" catch-all.
      const groupsByCountry: Record<string, any> = {};
      citiesList.forEach((ct: any) => {
        if (!ct.slug) return;
        const countrySlug = ct.country || cityToCountry[ct.slug];
        if (!countrySlug) return;
        if (!groupsByCountry[countrySlug]) {
          groupsByCountry[countrySlug] = {
            name: countryNames[countrySlug] || countrySlug,
            slug: countrySlug,
            count: 0,
            cities: [] as any[],
          };
        }
        const count = cityCounts[ct.slug] || 0;
        groupsByCountry[countrySlug].cities.push({ name: ct.name, slug: ct.slug, count });
        groupsByCountry[countrySlug].count += count;
      });

      const sortedGroups = Object.values(groupsByCountry).sort((a: any, b: any) => {
        const byCities = (b.cities?.length || 0) - (a.cities?.length || 0);
        if (byCities !== 0) return byCities;
        return a.name.localeCompare(b.name);
      });
      orderedFilterData = distributeGroupsForColumns(sortedGroups, 6);
    }
  }
} catch (e) {
  error = e;
  console.error('[SSR] Failure to fetch data:', e);
}

const cityParam = Astro.url.searchParams.get('city');
let initialCity = 'all';
if (cityParam) {
  const matched = cities.find((c) => c.toLowerCase().replace(/\s+/g, '-') === cityParam);
  if (matched) initialCity = matched;
}

// ── SEO: Canonical + ItemList hub schema ──────────────────────────────────────
const canonical = new URL('/designers', Astro.site);
const hubSchema = itemList({
  url: canonical.toString(),
  name: 'Independent Industrial Design Studios | Acceso',
  items: studios.map((s) => ({
    name: s.name,
    url: new URL(`/designers/${s.slug}`, Astro.site).toString(),
  })),
});

---

<PostHogLayout 
  title="Independent Design Studios Worldwide | Acceso"
  description="Browse independent industrial and furniture design studios. Explore local design scenes across global cities."
  canonical={canonical}
  schema={hubSchema}
>
  <Navbar />
  
  <main class="directory-page">
    <div class="directory-inner">
      <header class="directory-hero">
        <h1 class="directory-title">Designers</h1>
        <p class="directory-description">
          Independent furniture and industrial design studios from around the world. Browse our design studios directory by city and discover the industrial designers shaping local design scenes.
        </p>
      </header>

      {error && (
        <div role="alert" style="padding: 14px 18px; margin-bottom: 24px; border: 1px solid var(--color-stroke); border-radius: 12px; background: var(--color-bg-secondary); color: var(--color-text-muted); font-family: var(--font-sans); font-size: 15px;">
          <p style="margin: 0;">We couldn't load the latest studios. Please try again later.</p>
        </div>
      )}

      <div class="search-row hidden" id="search-row">
        <input
          type="text"
          id="search-input"
          placeholder="Search designers..."
          aria-label="Search designers"
          class="search-input"
        />
      </div>

      <div class="city-filter-row">
        <div class="filter-popover-wrapper">
          <button class="filter-trigger-btn" id="filter-trigger" type="button">Filter</button>
          <div class="filter-popover" id="filter-popover">
            <div class="filter-popover-header">
              <span>Filter by location</span>
              <div class="filter-header-actions">
                <button class="filter-clear-all" id="filter-clear-all" type="button">Clear all</button>
                <button class="filter-close-btn" id="filter-close-btn" type="button" aria-label="Close filters">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="filter-popover-content">
              {orderedFilterData.map((group: any) => (
                <div class="filter-group">
                  <label class="filter-item country-item">
                    <input type="checkbox" class="country-checkbox" data-country={group.name} data-slug={group.slug} />
                    <span class="filter-name">{group.name}</span>
                    <span class="filter-count">({group.count})</span>
                  </label>
                  <div class="city-items">
                    {group.cities.map((city: any) => (
                      <label class="filter-item city-item">
                        <input type="checkbox" class="city-checkbox" data-city={city.name} data-slug={city.slug} data-country={group.name} />
                        <span class="filter-name">{city.name}</span>
                        <span class="filter-count">({city.count})</span>
                      </label>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="city-filter-bar">
          <div class="city-filter-scroll" id="city-filters">
            <button class:list={['city-pill', { active: initialCity === 'all' }]} data-city="all" type="button">All</button>
            {cities.map(city => (
              <button class:list={['city-pill', { active: initialCity === city }]} data-city={city} type="button">{city}</button>
            ))}
          </div>
        </div>

        <div class="directory-toolbar">
          <button type="button" class="toolbar-btn" id="sort-btn" aria-label="Sort results">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 15l5 5 5-5M7 9l5-5 5 5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="toolbar-btn" id="view-btn" aria-label="Toggle grid view">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
            </svg>
          </button>
          <button type="button" class="toolbar-btn" id="search-toggle" aria-label="Search" aria-expanded="false">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="results-meta">
        <p class="results-count" id="studio-count">{totalStudios} results</p>
      </div>

      <script is:inline define:vars={{ totalStudios }}>
        window.totalStudios = {totalStudios};
      </script>

      <div class="studios-grid" id="studios-grid">
        {studios.map((studio, index) => (
          <DirectoryCard studio={studio} index={index} />
        ))}
      </div>

      <div class="hidden py-12 text-center text-gray" id="empty-result">
        <p>No designers found matching your criteria.</p>
      </div>

      <div id="pagination-container" class="pagination-wrapper"></div>
    </div>
  </main>


  <style>
  .directory-page { background: var(--color-white); }
  .directory-inner { max-width: 1600px; margin: 0 auto; padding: var(--page-top-spacing) 40px 80px; }
  .directory-hero { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; margin-bottom: 28px; max-width: 640px; }
  .directory-title { font-family: var(--font-sans); font-size: clamp(48px, 5.5vw, 80px); font-weight: 400; line-height: 1; letter-spacing: -0.08em; margin: 0; color: var(--color-black); }
  .directory-description { font-family: var(--font-sans); font-size: 16px; line-height: 1.55; color: var(--color-text-muted); margin: 0; max-width: 52ch; }
  @media (min-width: 1025px) {
    .directory-hero {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0 48px;
      max-width: none;
    }
    .directory-description {
      max-width: min(52ch, 42vw);
    }
  }
  .directory-toolbar { display: flex; gap: 4px; flex-shrink: 0; margin-left: auto; }
  .toolbar-btn { width: 40px; height: 40px; border: none; background: transparent; color: var(--color-black); cursor: pointer; display: flex; align-items: center; justify-content: center; border-radius: 8px; transition: background 0.2s; }
  .toolbar-btn:hover { background: var(--color-bg-secondary); }
  .search-row { margin-bottom: 20px; max-width: 480px; margin-left: auto; }
  .search-row:not(.hidden) { display: block; }
  .search-input { width: 100%; height: 44px; background: transparent; border: none; border-bottom: 1px solid var(--color-stroke); border-radius: 0; padding: 0 4px; color: var(--color-black); font-family: var(--font-sans); font-size: 15px; outline: none; }
  .search-input::placeholder { color: var(--color-text-muted); }
  .search-input:focus { border-bottom-color: var(--color-black); }
  .city-filter-row { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; position: relative; z-index: 200; }
  .filter-popover-wrapper { flex-shrink: 0; }
  .filter-trigger-btn { height: 36px; padding: 1px 16px 0; border-radius: 999px; border: none; background: var(--color-yellow); color: var(--color-black); font-family: var(--font-sans); font-size: 14px; font-weight: 700; cursor: pointer; }
  .filter-popover { position: absolute; top: calc(100% + 12px); left: 0; right: 0; max-width: min(1600px, calc(100vw - 80px)); background: var(--color-white); border: 1px solid var(--color-stroke); border-radius: 16px; padding: 24px; z-index: 1500; display: none; box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
  .filter-popover.show { display: block; }
  .filter-popover-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; font-family: var(--font-sans); font-size: 16px; font-weight: 600; color: var(--color-black); }
  .filter-header-actions { display: flex; align-items: center; gap: 16px; }
  .filter-clear-all { height: 32px; padding: 1px 14px 0; border-radius: 999px; border: 1px solid var(--color-stroke); background: var(--color-bg-secondary); color: var(--color-black); font-size: 13px; font-weight: 700; cursor: pointer; font-family: var(--font-sans); }
  .filter-close-btn { display: none; background: transparent; border: none; cursor: pointer; color: var(--color-black); }
  .filter-popover-content { column-count: 6; column-gap: 20px; }
  .filter-group { margin-bottom: 18px; break-inside: avoid; }
  @media (min-width: 901px) {
    .filter-group { break-inside: auto; }
  }
  .filter-item { display: flex; align-items: center; gap: 10px; cursor: pointer; }
  .filter-name { font-family: var(--font-sans); font-size: 14px; font-weight: 400; color: var(--color-black); }
  .country-item .filter-name { font-weight: 700; }
  .filter-count { font-family: var(--font-sans); font-size: 12px; font-weight: 400; color: var(--color-text-muted); }
  .filter-item input[type="checkbox"] {
    appearance: none;
    width: 18px;
    height: 18px;
    border: 2px solid var(--color-stroke);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    background: var(--color-white);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .filter-item input[type="checkbox"]:checked {
    background: var(--color-black);
    border-color: var(--color-black);
  }

  .filter-item input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: 4px;
    height: 8px;
    border: solid var(--color-white);
    border-width: 0 2px 2px 0;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .city-items { margin-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .city-filter-bar { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(to right, black 85%, transparent 100%); }
  .city-filter-bar::-webkit-scrollbar { display: none; }
  .city-filter-scroll { display: flex; gap: 8px; padding: 4px 0; width: max-content; }
  .city-pill { flex-shrink: 0; height: 36px; padding: 1px 16px 0; display: inline-flex; align-items: center; background: transparent; border: 1px solid var(--color-stroke); border-radius: 999px; color: var(--color-text-muted); font-family: var(--font-sans); font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .city-pill:hover { color: var(--color-black); border-color: var(--color-black); }
  .city-pill.active { background: var(--color-black); border-color: var(--color-black); color: var(--color-white); }
  .results-meta { margin-bottom: 24px; }
  .results-count { font-family: var(--font-sans); font-size: 15px; color: var(--color-black); margin: 0; }
  .studios-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(16px, 2vw, 24px); margin-bottom: 40px; width: 100%; }
  .studios-grid.compact { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 12px; }
  :global(.studios-grid .directory-card) { min-width: 0; }
  :global(.studios-grid.compact .directory-card-name) { font-size: 11px; letter-spacing: 0.01em; }
  :global(.studios-grid.compact .directory-card-location) { font-size: 11px; margin-top: -4px; }
  :global(.studios-grid.compact .directory-card-media) { border-radius: 8px; }
  :global(.directory-card) { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: inherit; transition: transform 0.2s ease; }
  :global(.directory-card:hover) { transform: translateY(-2px); color: inherit; }
  :global(.directory-card-media) { aspect-ratio: 1; overflow: hidden; background: #E0E0E0; border-radius: 12px; }
  :global(.directory-card-image) { width: 100%; height: 100%; object-fit: cover; display: block; }
  :global(.directory-card-placeholder) { width: 100%; height: 100%; background: #E0E0E0; }
  :global(.directory-card-name) { font-family: var(--font-sans); font-size: 14px; font-weight: 400; color: var(--color-black); margin: 0; line-height: 1.25; text-transform: uppercase; letter-spacing: 0.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.directory-card-location) { font-family: var(--font-sans); font-size: 13px; font-weight: 400; color: var(--color-text-muted); margin: -6px 0 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.pagination-wrapper) { display: flex; justify-content: center; align-items: center; gap: 16px; padding: 48px 0; border-top: 1px solid var(--color-stroke); }
  :global(.pagination-btn) { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: transparent; border: 1px solid transparent; border-radius: 50%; color: #9ca3af; font-family: var(--font-sans); font-size: 14px; font-weight: 700; cursor: pointer; transition: color 0.2s ease, background 0.2s ease; }
  :global(.pagination-btn:hover:not(.active)) { color: var(--color-black); }
  :global(.pagination-btn.active) { background: var(--color-black); color: var(--color-white); border-color: var(--color-black); cursor: default; }
  :global(.pagination-btn:disabled) { opacity: 0.3; cursor: not-allowed; }
  :global(.pagination-arrow) { background: var(--color-bg-secondary) !important; border: 1px solid var(--color-stroke) !important; color: var(--color-black); }
  :global(.pagination-ellipsis) { color: var(--color-text-muted); font-family: var(--font-sans); }
  @media (max-width: 900px) { .filter-popover-content { column-count: 2; } .search-row { margin-left: 0; max-width: none; } .studios-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .studios-grid.compact { grid-template-columns: repeat(4, minmax(0, 1fr)); } .directory-description { font-size: 14px; line-height: 1.5; } .filter-trigger-btn, .city-pill { height: 40px; } }
  @media (max-width: 640px) {
    .directory-inner { padding: var(--page-top-spacing) 16px 64px; }
    .studios-grid { grid-template-columns: 1fr; gap: 20px; }
    .studios-grid.compact { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .city-filter-row { flex-wrap: wrap; }
    .directory-toolbar { margin-left: 0; width: 100%; justify-content: flex-end; }
    .filter-popover {
      position: fixed;
      top: var(--navbar-height, 64px);
      left: 0;
      right: 0;
      width: 100%;
      height: calc(100dvh - var(--navbar-height, 64px));
      max-width: none;
      border-radius: 0;
      padding: 16px 16px 24px;
      z-index: 9001;
      border: none;
      box-shadow: none;
      display: none;
      flex-direction: column;
      overflow: hidden;
      box-sizing: border-box;
    }
    .filter-popover.show { display: flex; animation: filterSlideIn 0.22s ease-out; }
    .filter-popover-header { font-size: 18px; font-weight: 600; margin-bottom: 16px; margin-top: 0; flex-shrink: 0; }
    .filter-close-btn { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; }
    .filter-clear-all { height: 40px; padding: 0 16px; font-size: 14px; }
    .filter-popover-content {
      display: block;
      flex: 1;
      min-height: 0;
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      column-count: 2;
      column-gap: 20px;
      width: 100%;
    }
    .filter-group { margin-bottom: 20px; width: 100%; break-inside: avoid; }
    .filter-name { font-size: 16px; }
    .country-item .filter-name { font-size: 17px; }
    .filter-count { font-size: 14px; }
    .filter-item { width: 100%; }
    .filter-item input[type="checkbox"] { width: 22px; height: 22px; flex-shrink: 0; }
    .city-items { margin-left: 20px; margin-top: 8px; gap: 8px; width: calc(100% - 20px); }
  }
  @keyframes filterSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  </style>

  <script is:inline define:vars={{ totalAllStudios: totalStudios, metadataGlobal: metadata, isDev: import.meta.env.DEV }}>
    window.totalAllStudios = totalAllStudios;
    window.metadataGlobal = metadataGlobal;
    window.isDev = isDev;
  </script>

  <script src="../../scripts/directory-client.ts"></script>
  <Footer />
</PostHogLayout>
