---
import PostHogLayout from '../../layouts/PostHogLayout.astro';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import type { Studio } from '../../lib/types';
import '../../styles/designers-index.css';

// Fetch from static JSON file - this is served from Cloudflare's edge
let studios: Studio[] = [];
let error = null;

try {
  // Fetch from static JSON file - served from Cloudflare's edge
  const studiosUrl = new URL('/studios.json', Astro.url.origin);
  const response = await fetch(studiosUrl.toString());
  if (!response.ok) throw new Error('Failed to load studios data');
  studios = await response.json();
} catch (e) {
  error = e;
  console.error('Failed to fetch studios:', e);
}

// Get unique cities for filter, ensuring Milan is first
const cities = [...new Set(studios.map(s => s.city))].sort((a, b) => {
  if (a === 'Milan') return -1;
  if (b === 'Milan') return 1;
  return a.localeCompare(b);
});

// Get initial city filter from URL query parameter
const initialCity = Astro.url.searchParams.get('city') || 'all';
---

<PostHogLayout>
  <Layout 
    title="Design Studios Directory | Acceso"
    description="Browse 86+ independent industrial design studios from Milan, Seoul, Berlin, Copenhagen, London, Paris, and Tokyo. Curated directory of product designers."
    keywords="design studios, industrial designers, product design firms, Milan designers, independent design studios"
  >
    <Navbar />
    
    <main class="designers-page">
      {!error && (
        <>
          <div class="filters-container">
            <div class="search-bar">
              <input 
                type="text" 
                id="search-input" 
                placeholder="Search by name..."
                aria-label="Search studios"
              />
            </div>
            
            <div class="filter-buttons">
              <button class="filter-btn" data-city="all" class:list={{active: initialCity === 'all'}}>All</button>
              {cities.map(city => (
                <button class="filter-btn" data-city={city} class:list={{active: initialCity === city}}>{city}</button>
              ))}
            </div>

            <p id="studio-count">{studios.length} Design Studios</p>
          </div>

          <div class="designers-grid" id="studios-grid">
            {studios.map(studio => (
              <a 
                href={`/designers/${studio.slug}`} 
                class="studio-card"
                data-name={studio.name.toLowerCase()}
                data-city={studio.city}
              >
                {studio.cover ? (
                  <img 
                    src={studio.cover} 
                    alt={studio.name} 
                    class="studio-image" 
                    loading="lazy" 
                    decoding="async"
                    data-skeleton
                  />
                ) : (
                  <div class="studio-image-placeholder">No image</div>
                )}
                <div class="studio-info">
                  <h3>{studio.name}</h3>
                  <p>{studio.city}</p>
                </div>
              </a>
            ))}
          </div>

          <div class="empty-result" id="empty-result" style="display: none;">
            <p>No studios found matching your criteria.</p>
          </div>
        </>
      )}
    </main>
  </Layout>
</PostHogLayout>

<script src="/js/designers-index.js" is:inline></script>