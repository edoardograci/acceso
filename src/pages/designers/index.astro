---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { getAllStudios } from '../../lib/db';

let studios = [];
let error = null;

try {
  const env = Astro.locals.runtime.env;  // Access runtime env
  studios = await getAllStudios(env);
} catch (e) {
  error = e;
  console.error('Failed to fetch studios:', e);
}
---

<Layout title="Designers - Acceso">
  <Navbar />
  
  <main class="designers-page">
    <div class="designers-header">
      <h1>Designers</h1>
      {!error && <p>{studios.length} studios in Milan</p>}
    </div>

    {error && (
      <div class="error-state">
        <h2 style="color: #ff6b6b; margin-bottom: 16px;">Database Connection Error</h2>
        <p style="color: var(--text-secondary); margin-bottom: 16px;">
          Unable to connect to the database. Please check:
        </p>
        <ul style="color: var(--text-secondary); text-align: left; max-width: 600px; margin: 0 auto;">
          <li>Environment variables are set in Cloudflare Pages settings</li>
          <li>TURSO_DATABASE_URL is correct</li>
          <li>TURSO_AUTH_TOKEN is valid</li>
          <li>Database is accessible from Cloudflare</li>
        </ul>
        <details style="margin-top: 24px; padding: 16px; background: var(--gray-dark); border-radius: 8px; text-align: left; max-width: 800px; margin: 24px auto;">
          <summary style="cursor: pointer; color: var(--accent-yellow);">View Error Details</summary>
          <pre style="margin-top: 16px; overflow: auto; font-size: 12px; color: #ff6b6b;">{JSON.stringify(error, null, 2)}</pre>
        </details>
      </div>
    )}

    {!error && studios.length > 0 && (
      <div class="designers-grid">
        {studios.map(studio => (
          <a href={`/designers/${studio.slug}`} class="studio-card">
            {studio.cover ? (
              <img src={studio.cover} alt={studio.name} class="studio-image" />
            ) : (
              <div class="studio-image-placeholder">No image</div>
            )}
            <div class="studio-info">
              <h3>{studio.name}</h3>
              <p>{studio.city}</p>
            </div>
          </a>
        ))}
      </div>
    )}

    {!error && studios.length === 0 && (
      <div class="empty-state">
        <p>No studios found in the database.</p>
        <p style="margin-top: 16px; color: var(--text-secondary);">
          The database connection works, but no published studios were found.
        </p>
      </div>
    )}
  </main>
</Layout>

<style>
  .designers-page {
    padding-top: var(--navbar-height);
    min-height: 100vh;
  }

  .designers-header {
    padding: 48px var(--spacing-page);
    text-align: center;
  }

  .designers-header h1 {
    font-size: 48px;
    margin-bottom: 12px;
  }

  .designers-header p {
    color: var(--text-secondary);
  }

  .designers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 2fr));
    gap: 24px;
    padding: 0 var(--spacing-page) 48px;
  }

  .studio-card {
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .studio-card:hover {
    transform: translateY(-4px);
  }

  .studio-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    margin-bottom: 12px;
  }

  .studio-image-placeholder {
    width: 100%;
    height: 200px;
    background: var(--gray-dark);
    border-radius: 8px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
  }

  .studio-info h3 {
    font-size: 20px;
    margin-bottom: 4px;
  }

  .studio-info p {
    color: var(--text-secondary);
    font-size: 14px;
  }

  .empty-state,
  .error-state {
    padding: 48px var(--spacing-page);
    text-align: center;
  }
</style>