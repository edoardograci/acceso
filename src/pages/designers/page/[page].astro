---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { breadcrumbList, itemList } from '../../../lib/seo/schema';
import { normalizeImage } from '../../../lib/images';

type Studio = { slug: string; name: string; cover?: string | null; city?: string | null; country_slug?: string | null };

const page = Math.max(1, Number.parseInt(Astro.params.page || '1', 10) || 1);
const perPage = 18;

const isDev = import.meta.env.DEV;
const origin = Astro.url.origin;
const dataOrigin = isDev ? 'https://json.acceso.design' : origin;

async function fetchJson<T>(path: string): Promise<T> {
  const u = new URL(path, dataOrigin).toString();
  const r = await fetch(u);
  if (!r.ok) throw new Error(`Fetch failed ${path}: ${r.status}`);
  return (await r.json()) as T;
}

let all: Studio[] = [];
let total = 0;
let totalPages = 1;

try {
  const data = await fetchJson<any[]>('/cdn/test-studios.json');
  all = Array.isArray(data) ? data : [];
  total = all.length;
  totalPages = Math.max(1, Math.ceil(total / perPage));
} catch {
  all = [];
  total = 0;
  totalPages = 1;
}

if (page > totalPages) return Astro.redirect('/404');

const slice = all.slice((page - 1) * perPage, page * perPage).map((s) => {
  return { ...s, cover: normalizeImage(s.cover, Astro) as string | null };
});

const title = page === 1 ? 'Design studios directory | Acceso' : `Design studios directory (Page ${page}) | Acceso`;
const description =
  page === 1
    ? 'Browse independent industrial and furniture design studios. Explore profiles, locations, and related designers.'
    : `Browse independent industrial and furniture design studios — page ${page} of ${totalPages}. Explore profiles and locations.`;

const canonical = new URL(`/designers/page/${page}`, Astro.site);

const prevUrl = page > 1 ? new URL(`/designers/page/${page - 1}`, Astro.site).toString() : null;
const nextUrl = page < totalPages ? new URL(`/designers/page/${page + 1}`, Astro.site).toString() : null;

const crumbs = [
  { name: 'Home', url: new URL('/', Astro.site).toString() },
  { name: 'Designers', url: new URL('/designers', Astro.site).toString() },
  { name: `Page ${page}`, url: canonical.toString() },
];

const schema = {
  '@graph': [
    breadcrumbList(crumbs),
    itemList({
      url: canonical.toString(),
      name: `Design studios directory — page ${page}`,
      items: slice.map((s) => ({ name: s.name, url: new URL(`/designers/${encodeURIComponent(s.slug)}`, Astro.site).toString() })),
    }),
  ],
};
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Navbar />

  <slot slot="head">
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
  </slot>

  <main class="bg-white">
    <section class="max-w-[1600px] mx-auto px-10 pt-14 pb-10">
      <h1 class="font-sans text-black font-normal tracking-normal leading-[0.98] text-[clamp(34px,4vw,56px)]">
        Design studios directory <span class="text-gray">(Page {page} of {totalPages})</span>
      </h1>
      <p class="font-sans text-[15px] leading-[1.6] text-gray mt-4 max-w-[75ch]">
        A crawlable, server-rendered directory view for search engines and research. For interactive filtering and map exploration, use the main Designers experience.
      </p>
      <div class="mt-4 flex gap-2 flex-wrap">
        <a href="/designers" class="px-4 h-10 inline-flex items-center rounded-full border border-stroke bg-bg-secondary text-black font-sans font-semibold text-[13px] no-underline">Open Designers</a>
      </div>
    </section>

    <section class="max-w-[1600px] mx-auto px-10 pb-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {slice.map((s) => (
          <a
            href={`/designers/${s.slug}`}
            class="block rounded-2xl bg-white border border-stroke overflow-hidden no-underline hover:-translate-y-1 transition-transform duration-200"
          >
            <div class="p-6 flex items-center gap-4">
              <div class="w-14 h-14 rounded-xl bg-bg-secondary overflow-hidden flex-shrink-0">
                {s.cover ? <img src={s.cover} alt={s.name} loading="lazy" class="w-full h-full object-cover" /> : <div class="w-full h-full bg-bg-secondary" />}
              </div>
              <div class="min-w-0">
                <div class="font-sans text-black font-normal text-[18px] leading-[1.15] truncate">{s.name}</div>
                <div class="font-sans text-gray text-[13px] mt-1 truncate">
                  {s.city ?? ''}{s.city && s.country_slug ? ' · ' : ''}{s.country_slug ?? ''}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <nav class="max-w-[1600px] mx-auto px-10 pb-24 flex items-center justify-between">
      {prevUrl ? (
        <a href={`/designers/page/${page - 1}`} class="px-4 h-10 inline-flex items-center rounded-full border border-stroke bg-bg-secondary text-black font-sans font-semibold text-[13px] no-underline">
          Prev
        </a>
      ) : <span />}
      {nextUrl ? (
        <a href={`/designers/page/${page + 1}`} class="px-4 h-10 inline-flex items-center rounded-full border border-stroke bg-bg-secondary text-black font-sans font-semibold text-[13px] no-underline">
          Next
        </a>
      ) : <span />}
    </nav>
  </main>

  <Footer />
</Layout>

