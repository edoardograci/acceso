---
interface City {
  name: string;
  slug: string;
  count: number;
}

interface CountryGroup {
  name: string;
  slug: string;
  count: number;
  cities: City[];
}

interface FilterOption {
  name: string;
  slug: string;
  count: number;
}

interface FilterSection {
  id: string;
  title: string;
  type: 'location' | 'checkbox' | 'radio';
  options?: FilterOption[];
  groups?: CountryGroup[];
  collapsed?: boolean;
}

interface Props {
  sections?: FilterSection[];
  // Legacy props for backward compatibility
  groups?: CountryGroup[];
  title?: string;
}

const { sections, groups, title = 'Filters' } = Astro.props;

// If legacy mode (only groups provided), create a single location section
const filterSections: FilterSection[] = sections || (groups ? [{
  id: 'location',
  title: 'Filter by location',
  type: 'location',
  groups: groups,
  collapsed: false
}] : []);
---

<div class="filter-sidebar-backdrop" id="filter-sidebar-backdrop" aria-hidden="true"></div>

<aside class="filter-sidebar-drawer" id="filter-sidebar-drawer" role="dialog" aria-modal="true" aria-label={title}>
  <div class="filter-sidebar-header">
    <span class="filter-sidebar-title">{title}</span>
  </div>

  <div class="filter-sidebar-search-box">
    <div class="filter-search-input-wrapper">
      <svg class="filter-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="filter-sidebar-search"
        class="filter-sidebar-search-input"
        placeholder="Search..."
        aria-label="Search filters"
      />
      <button type="button" id="filter-sidebar-search-clear" class="filter-search-clear hidden" aria-label="Clear filter search">&times;</button>
    </div>
    <button class="filter-close-btn" id="filter-close-btn" type="button" aria-label="Close filters">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="filter-sidebar-content" id="filter-sidebar-content">
    {filterSections.map((section) => (
      <div class={`filter-section ${section.collapsed ? 'collapsed' : ''}`} data-section-id={section.id}>
        <button type="button" class="filter-section-header">
          <span class="filter-section-title">{section.title}</span>
          <svg class="section-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <div class="filter-section-content">
          {section.type === 'location' && section.groups && section.groups.map((group) => (
            <div class="filter-group collapsed" data-country-name={group.name.toLowerCase()} data-country-slug={group.slug}>
              <div class="filter-group-header">
                <label class="filter-item country-item" onclick="event.stopPropagation();">
                  <input type="checkbox" class="country-checkbox" data-country={group.name} data-slug={group.slug} />
                  <span class="filter-name">{group.name}</span>
                  <span class="filter-count">({group.count})</span>
                </label>
                {group.cities && group.cities.length > 0 && (
                  <button type="button" class="group-collapse-btn" aria-label={`Toggle ${group.name} cities`}>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                )}
              </div>
              
              {group.cities && group.cities.length > 0 && (
                <div class="city-items">
                  {group.cities.map((city) => (
                    <label class="filter-item city-item" data-city-name={city.name.toLowerCase()} data-city-slug={city.slug}>
                      <input type="checkbox" class="city-checkbox" data-city={city.name} data-slug={city.slug} data-country={group.name} />
                      <span class="filter-name">{city.name}</span>
                      <span class="filter-count">({city.count})</span>
                    </label>
                  ))}
                </div>
              )}
            </div>
          ))}

          {section.type === 'checkbox' && section.options && section.options.map((option) => (
            <label class="filter-item simple-option" data-option-name={option.name.toLowerCase()}>
              <input type="checkbox" class={`${section.id}-checkbox`} data-slug={option.slug} data-section={section.id} />
              <span class="filter-name">{option.name}</span>
              {option.count > 0 && <span class="filter-count">({option.count})</span>}
            </label>
          ))}

          {section.type === 'radio' && section.options && section.options.map((option) => (
            <label class="filter-item simple-option" data-option-name={option.name.toLowerCase()}>
              <input type="radio" name={section.id} class={`${section.id}-radio`} data-slug={option.slug} data-section={section.id} />
              <span class="filter-name">{option.name}</span>
              {option.count > 0 && <span class="filter-count">({option.count})</span>}
            </label>
          ))}
        </div>
      </div>
    ))}
    
    <div id="filter-sidebar-empty" class="filter-sidebar-empty hidden">
      <p>No matching filters found.</p>
    </div>
  </div>

  <div class="filter-sidebar-footer">
    <button type="button" class="filter-clear-all" id="filter-clear-all">Clear</button>
    <button type="button" class="filter-done-btn" id="filter-done-btn">Apply Filters</button>
  </div>
</aside>

<style>
  .filter-sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .filter-sidebar-backdrop.show {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-sidebar-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 400px;
    max-width: 90vw;
    background: var(--color-white, #ffffff);
    z-index: 999999;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 12px 0 32px rgba(0, 0, 0, 0.16);
    border-right: 1px solid var(--color-stroke, #e5e5e5);
  }
  .filter-sidebar-drawer.show {
    transform: translateX(0);
  }

  .filter-sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 20px 14px;
    flex-shrink: 0;
    position: relative;
    z-index: 10;
  }
  .filter-sidebar-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-black, #000000);
    letter-spacing: -0.02em;
  }
  .filter-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-stroke, #e5e5e5);
    border-radius: 50%;
    background: var(--color-bg-secondary, #f5f5f5);
    cursor: pointer;
    color: var(--color-black, #000000);
    transition: background 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
    position: relative;
    z-index: 20;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-close-btn:hover,
  .filter-close-btn:active {
    background: #eaeaea;
    border-color: #cccccc;
  }

  .filter-sidebar-search-box {
    padding: 4px 20px 16px;
    flex-shrink: 0;
    background: var(--color-white, #ffffff);
  }
  .filter-search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .filter-search-icon {
    position: absolute;
    left: 2px;
    color: var(--color-text-muted, #737373);
    pointer-events: none;
  }
  .filter-sidebar-search-input {
    width: 100%;
    height: 38px;
    padding: 0 28px 0 28px;
    border: none;
    border-bottom: 1.5px solid var(--color-stroke, #e5e5e5);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-black, #000000);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .filter-sidebar-search-input:focus {
    border-bottom-color: var(--color-black, #000000);
  }
  .filter-sidebar-search-input::placeholder {
    color: var(--color-text-muted, #999999);
  }
  .filter-search-clear {
    position: absolute;
    right: 4px;
    width: 24px;
    height: 24px;
    border: none;
    border-radius: 50%;
    background: var(--color-stroke, #e5e5e5);
    color: var(--color-black, #000000);
    font-size: 15px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .filter-search-clear.hidden {
    display: none;
  }

  .filter-sidebar-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 8px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
    min-height: 0;
  }

  /* Filter Sections (collapsible categories) */
  .filter-section {
    display: flex;
    flex-direction: column;
    padding: 0;
    margin-bottom: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    flex-shrink: 0;
  }
  
  /* When any section is OPEN (not collapsed), it grows to fill space */
  .filter-section:not(.collapsed) {
    flex: 1;
    min-height: 0;
  }
  
  .filter-section:last-child {
    border-bottom: none;
  }

  .filter-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    flex-shrink: 0;
  }
  .filter-section-title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gray, #737373);
    line-height: 16px;
  }
  .section-chevron {
    color: var(--color-gray, #737373);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  .filter-section.collapsed .section-chevron {
    transform: rotate(-90deg);
  }
  .filter-section.collapsed .filter-section-content {
    display: none;
  }

  .filter-section-content {
    padding: 0 0 14px 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* When any section is OPEN, its content grows and scrolls */
  .filter-section:not(.collapsed) .filter-section-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
  }

  /* Minimal scrollbar for location section */
  .filter-section[data-section-id="location"] .filter-section-content::-webkit-scrollbar {
    width: 4px;
  }
  .filter-section[data-section-id="location"] .filter-section-content::-webkit-scrollbar-track {
    background: transparent;
  }
  .filter-section[data-section-id="location"] .filter-section-content::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
  }
  .filter-section[data-section-id="location"] .filter-section-content::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.25);
  }
  .filter-section[data-section-id="location"] .filter-section-content {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }

  .filter-group {
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }
  .filter-group:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  .filter-group.hidden {
    display: none !important;
  }

  .filter-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    cursor: pointer;
    border-radius: 6px;
  }
  .group-collapse-btn {
    background: transparent;
    border: none;
    padding: 4px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-text-muted, #737373);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .group-collapse-btn:hover {
    color: var(--color-black, #000000);
  }
  .chevron-icon {
    transition: transform 0.2s ease;
  }
  .filter-group.collapsed .chevron-icon {
    transform: rotate(-90deg);
  }
  .filter-group.collapsed .city-items {
    display: none;
  }

  .filter-item {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    padding: 4px 0;
  }
  .filter-item.hidden {
    display: none !important;
  }

  .country-item {
    font-weight: 700;
  }
  .filter-name {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-black, #000000);
    flex: 1;
  }
  .country-item .filter-name {
    font-size: 14px;
    font-weight: 700;
  }
  .filter-count {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-text-muted, #737373);
    flex-shrink: 0;
  }

  .filter-item input[type="checkbox"],
  .filter-item input[type="radio"] {
    appearance: none;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--color-stroke, #cccccc);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    background: var(--color-white, #ffffff);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .filter-item input[type="radio"] {
    border-radius: 50%;
  }
  .filter-item input[type="checkbox"]:hover,
  .filter-item input[type="radio"]:hover {
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:checked,
  .filter-item input[type="radio"]:checked {
    background: var(--color-black, #000000);
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: 4px;
    height: 8px;
    border: solid var(--color-white, #ffffff);
    border-width: 0 2px 2px 0;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .filter-item input[type="radio"]:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    background: var(--color-white, #ffffff);
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .filter-item input[type="checkbox"]:indeterminate {
    background: var(--color-black, #000000);
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:indeterminate::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 2px;
    background: var(--color-white, #ffffff);
    transform: translate(-50%, -50%);
  }

  .city-items {
    margin-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }

  .simple-option {
    margin-bottom: 2px;
  }

  .filter-sidebar-empty {
    padding: 32px 0;
    text-align: center;
    color: var(--color-text-muted, #737373);
    font-family: var(--font-sans);
    font-size: 13px;
  }
  .filter-sidebar-empty.hidden {
    display: none;
  }

  .filter-sidebar-footer {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 16px 20px max(16px, env(safe-area-inset-bottom, 16px));
    border-top: 1px solid var(--color-stroke, #e5e5e5);
    background: var(--color-white, #ffffff);
    flex-shrink: 0;
  }
  .filter-clear-all {
    flex: 1;
    height: 44px;
    border: 1px solid var(--color-stroke, #e5e5e5);
    border-radius: 999px;
    background: var(--color-bg-secondary, #f5f5f5);
    color: var(--color-black, #000000);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-clear-all:hover,
  .filter-clear-all:active {
    background: #eaeaea;
    border-color: #cccccc;
  }
  .filter-done-btn {
    flex: 1.6;
    height: 44px;
    border: none;
    border-radius: 999px;
    background: var(--color-black, #000000);
    color: var(--color-white, #ffffff);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-done-btn:hover,
  .filter-done-btn:active {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .filter-sidebar-drawer {
      width: 100vw;
      max-width: 100vw;
      border-right: none;
    }
    .filter-sidebar-header {
      padding-top: max(24px, env(safe-area-inset-top, 24px));
      padding-bottom: 10px;
    }
    .filter-sidebar-search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-top: 10px;
    }
    .filter-search-input-wrapper {
      flex: 1;
      min-width: 0;
    }
    .filter-close-btn {
      display: flex;
      position: static;
      z-index: auto;
      flex-shrink: 0;
    }
  }
</style>

<script>
  function setupFilterSidebar() {
    const backdrop = document.getElementById('filter-sidebar-backdrop');
    const drawer = document.getElementById('filter-sidebar-drawer');
    const closeBtn = document.getElementById('filter-close-btn');
    const searchInput = document.getElementById('filter-sidebar-search') as HTMLInputElement;
    const searchClear = document.getElementById('filter-sidebar-search-clear');
    const sections = document.querySelectorAll('.filter-section');
    const sectionHeaders = document.querySelectorAll('.filter-section-header');
    const groups = document.querySelectorAll('.filter-group');
    const groupHeaders = document.querySelectorAll('.filter-group-header');
    const emptyEl = document.getElementById('filter-sidebar-empty');

    function closeSidebar() {
      drawer?.classList.remove('show');
      backdrop?.classList.remove('show');
      document.body.style.overflow = '';
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSidebar);
      closeBtn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        closeSidebar();
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', closeSidebar);
      backdrop.addEventListener('touchstart', (e) => {
        if (e.target === backdrop) {
          e.preventDefault();
          closeSidebar();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('show')) {
        closeSidebar();
      }
    });

    // Section header toggle with accordion behavior (only one section open at a time)
    sectionHeaders.forEach((header) => {
      header.addEventListener('click', () => {
        const section = header.closest('.filter-section');
        const isCurrentlyCollapsed = section?.classList.contains('collapsed');
        
        if (isCurrentlyCollapsed) {
          // Collapse all other sections
          sections.forEach((s) => {
            if (s !== section) {
              s.classList.add('collapsed');
            }
          });
          // Expand this one
          section?.classList.remove('collapsed');
        } else {
          // Collapse this one
          section?.classList.add('collapsed');
        }
      });
    });

    // Accordion toggle on group header click (for location groups)
    groupHeaders.forEach((header) => {
      header.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'INPUT') return;
        const group = header.closest('.filter-group');
        group?.classList.toggle('collapsed');
      });
    });

    // Auto expand groups if child city is checked
    function syncExpandChecked() {
      groups.forEach((group) => {
        const cityCbs = group.querySelectorAll<HTMLInputElement>('.city-checkbox:checked');
        if (cityCbs.length > 0) {
          group.classList.remove('collapsed');
        }
      });
    }

    // In-drawer search filter
    function applySearch() {
      if (!searchInput) return;
      const query = searchInput.value.trim().toLowerCase();
      searchClear?.classList.toggle('hidden', !query);

      let totalVisible = 0;

      // Search across all sections
      sections.forEach((section) => {
        let sectionHasMatch = false;

        // Search in location groups
        const locationGroups = section.querySelectorAll('.filter-group');
        locationGroups.forEach((group) => {
          const countryName = group.getAttribute('data-country-name') || '';
          const cityItems = group.querySelectorAll('.city-item');
          let groupHasMatch = countryName.includes(query);
          let visibleCitiesCount = 0;

          cityItems.forEach((cityItem) => {
            const cityName = cityItem.getAttribute('data-city-name') || '';
            const cityMatches = cityName.includes(query);
            if (countryName.includes(query) || cityMatches) {
              cityItem.classList.remove('hidden');
              visibleCitiesCount++;
            } else {
              cityItem.classList.add('hidden');
            }
          });

          if (groupHasMatch || visibleCitiesCount > 0) {
            group.classList.remove('hidden');
            if (query) group.classList.remove('collapsed');
            sectionHasMatch = true;
          } else {
            group.classList.add('hidden');
          }
        });

        // Search in simple options (tags, frequency, etc.)
        const simpleOptions = section.querySelectorAll('.simple-option');
        simpleOptions.forEach((option) => {
          const optionName = option.getAttribute('data-option-name') || '';
          if (optionName.includes(query)) {
            option.classList.remove('hidden');
            sectionHasMatch = true;
          } else {
            option.classList.add('hidden');
          }
        });

        if (sectionHasMatch) {
          section.classList.remove('hidden');
          if (query) section.classList.remove('collapsed');
          totalVisible++;
        } else {
          section.classList.add('hidden');
        }
      });

      if (!query) {
        // Re-collapse when query cleared unless item is checked
        sections.forEach((section) => {
          const checkedInputs = section.querySelectorAll<HTMLInputElement>('input:checked');
          if (checkedInputs.length === 0 && section.getAttribute('data-section-id') !== 'location') {
            section.classList.add('collapsed');
          }
        });
        groups.forEach((group) => {
          const checkedCount = group.querySelectorAll<HTMLInputElement>('.city-checkbox:checked, .country-checkbox:checked').length;
          if (checkedCount === 0) {
            group.classList.add('collapsed');
          }
        });
      }

      emptyEl?.classList.toggle('hidden', totalVisible > 0);
    }

    searchInput?.addEventListener('input', applySearch);

    searchClear?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        applySearch();
        searchInput.focus();
      }
    });

    syncExpandChecked();
  }

  // Initialize on DOM load and page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilterSidebar);
  } else {
    setupFilterSidebar();
  }
</script>
