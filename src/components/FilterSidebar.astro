---
interface City {
  name: string;
  slug: string;
  count: number;
}

interface CountryGroup {
  name: string;
  slug: string;
  count: number;
  cities: City[];
}

interface Props {
  groups: CountryGroup[];
  title?: string;
}

const { groups = [], title = 'Filter by location' } = Astro.props;
---

<div class="filter-sidebar-backdrop" id="filter-sidebar-backdrop" aria-hidden="true"></div>

<aside class="filter-sidebar-drawer" id="filter-sidebar-drawer" role="dialog" aria-modal="true" aria-label={title}>
  <div class="filter-sidebar-header">
    <span class="filter-sidebar-title">{title}</span>
  </div>

  <div class="filter-sidebar-search-box">
    <div class="filter-search-input-wrapper">
      <svg class="filter-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="filter-sidebar-search"
        class="filter-sidebar-search-input"
        placeholder="Search country or city..."
        aria-label="Search country or city in filter"
      />
      <button type="button" id="filter-sidebar-search-clear" class="filter-search-clear hidden" aria-label="Clear filter search">&times;</button>
    </div>
    <button class="filter-close-btn" id="filter-close-btn" type="button" aria-label="Close filters">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="filter-sidebar-content" id="filter-sidebar-content">
    {groups.map((group) => (
      <div class="filter-group collapsed" data-country-name={group.name.toLowerCase()} data-country-slug={group.slug}>
        <div class="filter-group-header">
          <label class="filter-item country-item" onclick="event.stopPropagation();">
            <input type="checkbox" class="country-checkbox" data-country={group.name} data-slug={group.slug} />
            <span class="filter-name">{group.name}</span>
            <span class="filter-count">({group.count})</span>
          </label>
          {group.cities && group.cities.length > 0 && (
            <button type="button" class="group-collapse-btn" aria-label={`Toggle ${group.name} cities`}>
              <svg class="chevron-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          )}
        </div>
        
        {group.cities && group.cities.length > 0 && (
          <div class="city-items">
            {group.cities.map((city) => (
              <label class="filter-item city-item" data-city-name={city.name.toLowerCase()} data-city-slug={city.slug}>
                <input type="checkbox" class="city-checkbox" data-city={city.name} data-slug={city.slug} data-country={group.name} />
                <span class="filter-name">{city.name}</span>
                <span class="filter-count">({city.count})</span>
              </label>
            ))}
          </div>
        )}
      </div>
    ))}
    <div id="filter-sidebar-empty" class="filter-sidebar-empty hidden">
      <p>No matching location found.</p>
    </div>
  </div>

  <div class="filter-sidebar-footer">
    <button type="button" class="filter-clear-all" id="filter-clear-all">Clear</button>
    <button type="button" class="filter-done-btn" id="filter-done-btn">Apply Filters</button>
  </div>
</aside>

<style>
  .filter-sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 999998;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .filter-sidebar-backdrop.show {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-sidebar-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 400px;
    max-width: 90vw;
    background: var(--color-white, #ffffff);
    z-index: 999999;
    transform: translateX(-100%);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    box-shadow: 12px 0 32px rgba(0, 0, 0, 0.16);
    border-right: 1px solid var(--color-stroke, #e5e5e5);
  }
  .filter-sidebar-drawer.show {
    transform: translateX(0);
  }

  .filter-sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px 24px 16px;
    flex-shrink: 0;
    position: relative;
    z-index: 10;
  }
  .filter-sidebar-title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-black, #000000);
    letter-spacing: -0.02em;
  }
  .filter-close-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-stroke, #e5e5e5);
    border-radius: 50%;
    background: var(--color-bg-secondary, #f5f5f5);
    cursor: pointer;
    color: var(--color-black, #000000);
    transition: background 0.15s ease, border-color 0.15s ease;
    flex-shrink: 0;
    position: relative;
    z-index: 20;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-close-btn:hover,
  .filter-close-btn:active {
    background: #eaeaea;
    border-color: #cccccc;
  }

  .filter-sidebar-search-box {
    padding: 8px 24px 20px;
    flex-shrink: 0;
    background: var(--color-white, #ffffff);
  }
  .filter-search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }
  .filter-search-icon {
    position: absolute;
    left: 4px;
    color: var(--color-text-muted, #737373);
    pointer-events: none;
  }
  .filter-sidebar-search-input {
    width: 100%;
    height: 44px;
    padding: 0 32px 0 32px;
    border: none;
    border-bottom: 1.5px solid var(--color-stroke, #e5e5e5);
    border-radius: 0;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-black, #000000);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .filter-sidebar-search-input:focus {
    border-bottom-color: var(--color-black, #000000);
  }
  .filter-sidebar-search-input::placeholder {
    color: var(--color-text-muted, #999999);
  }
  .filter-search-clear {
    position: absolute;
    right: 4px;
    width: 24px;
    height: 24px;
    border: none;
    border-radius: 50%;
    background: var(--color-stroke, #e5e5e5);
    color: var(--color-black, #000000);
    font-size: 15px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .filter-search-clear.hidden {
    display: none;
  }

  .filter-sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: 8px 24px 24px;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .filter-group {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  .filter-group:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  .filter-group.hidden {
    display: none !important;
  }

  .filter-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    cursor: pointer;
    border-radius: 6px;
  }
  .group-collapse-btn {
    background: transparent;
    border: none;
    padding: 6px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--color-text-muted, #737373);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .group-collapse-btn:hover {
    color: var(--color-black, #000000);
  }
  .chevron-icon {
    transition: transform 0.2s ease;
  }
  .filter-group.collapsed .chevron-icon {
    transform: rotate(-90deg);
  }
  .filter-group.collapsed .city-items {
    display: none;
  }

  .filter-item {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
    padding: 5px 0;
  }
  .filter-item.hidden {
    display: none !important;
  }

  .country-item {
    font-weight: 700;
  }
  .filter-name {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-black, #000000);
  }
  .country-item .filter-name {
    font-size: 16px;
    font-weight: 700;
  }
  .filter-count {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-muted, #737373);
  }

  .filter-item input[type="checkbox"] {
    appearance: none;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--color-stroke, #cccccc);
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    background: var(--color-white, #ffffff);
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .filter-item input[type="checkbox"]:hover {
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:checked {
    background: var(--color-black, #000000);
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    width: 5px;
    height: 9px;
    border: solid var(--color-white, #ffffff);
    border-width: 0 2px 2px 0;
    transform: translate(-50%, -50%) rotate(45deg);
  }
  .filter-item input[type="checkbox"]:indeterminate {
    background: var(--color-black, #000000);
    border-color: var(--color-black, #000000);
  }
  .filter-item input[type="checkbox"]:indeterminate::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 9px;
    height: 2px;
    background: var(--color-white, #ffffff);
    transform: translate(-50%, -50%);
  }

  .city-items {
    margin-left: 28px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 6px;
  }

  .filter-sidebar-empty {
    padding: 40px 0;
    text-align: center;
    color: var(--color-text-muted, #737373);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  .filter-sidebar-empty.hidden {
    display: none;
  }

  .filter-sidebar-footer {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 18px 24px max(20px, env(safe-area-inset-bottom, 20px));
    border-top: 1px solid var(--color-stroke, #e5e5e5);
    background: var(--color-white, #ffffff);
    flex-shrink: 0;
  }
  .filter-clear-all {
    flex: 1;
    height: 46px;
    border: 1px solid var(--color-stroke, #e5e5e5);
    border-radius: 999px;
    background: var(--color-bg-secondary, #f5f5f5);
    color: var(--color-black, #000000);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-clear-all:hover,
  .filter-clear-all:active {
    background: #eaeaea;
    border-color: #cccccc;
  }
  .filter-done-btn {
    flex: 1.6;
    height: 46px;
    border: none;
    border-radius: 999px;
    background: var(--color-black, #000000);
    color: var(--color-white, #ffffff);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .filter-done-btn:hover,
  .filter-done-btn:active {
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .filter-sidebar-drawer {
      width: 100vw;
      max-width: 100vw;
      border-right: none;
    }
    .filter-sidebar-header {
      padding-top: max(28px, env(safe-area-inset-top, 28px));
      padding-bottom: 12px;
    }
    .filter-sidebar-search-box {
      display: flex;
      align-items: center;
      gap: 12px;
      padding-top: 12px;
    }
    .filter-search-input-wrapper {
      flex: 1;
      min-width: 0;
    }
    .filter-close-btn {
      display: flex;
      position: static;
      z-index: auto;
      flex-shrink: 0;
    }
  }
</style>

<script>
  function setupFilterSidebar() {
    const backdrop = document.getElementById('filter-sidebar-backdrop');
    const drawer = document.getElementById('filter-sidebar-drawer');
    const closeBtn = document.getElementById('filter-close-btn');
    const searchInput = document.getElementById('filter-sidebar-search') as HTMLInputElement;
    const searchClear = document.getElementById('filter-sidebar-search-clear');
    const groups = document.querySelectorAll('.filter-group');
    const groupHeaders = document.querySelectorAll('.filter-group-header');
    const emptyEl = document.getElementById('filter-sidebar-empty');

    function closeSidebar() {
      drawer?.classList.remove('show');
      backdrop?.classList.remove('show');
      document.body.style.overflow = '';
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSidebar);
      closeBtn.addEventListener('touchstart', (e) => {
        e.preventDefault();
        closeSidebar();
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', closeSidebar);
      backdrop.addEventListener('touchstart', (e) => {
        if (e.target === backdrop) {
          e.preventDefault();
          closeSidebar();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer?.classList.contains('show')) {
        closeSidebar();
      }
    });

    // Accordion toggle on group header click
    groupHeaders.forEach((header) => {
      header.addEventListener('click', (e) => {
        // If clicking directly on checkbox, let checkbox change event handle it
        if ((e.target as HTMLElement).tagName === 'INPUT') return;
        const group = header.closest('.filter-group');
        group?.classList.toggle('collapsed');
      });
    });

    // Auto expand groups if child city is checked
    function syncExpandChecked() {
      groups.forEach((group) => {
        const cityCbs = group.querySelectorAll<HTMLInputElement>('.city-checkbox:checked');
        if (cityCbs.length > 0) {
          group.classList.remove('collapsed');
        }
      });
    }

    // In-drawer search filter
    function applySearch() {
      if (!searchInput) return;
      const query = searchInput.value.trim().toLowerCase();
      searchClear?.classList.toggle('hidden', !query);

      let totalVisible = 0;

      groups.forEach((group) => {
        const countryName = group.getAttribute('data-country-name') || '';
        const cityItems = group.querySelectorAll('.city-item');
        let groupHasMatch = countryName.includes(query);
        let visibleCitiesCount = 0;

        cityItems.forEach((cityItem) => {
          const cityName = cityItem.getAttribute('data-city-name') || '';
          const cityMatches = cityName.includes(query);
          if (countryName.includes(query) || cityMatches) {
            cityItem.classList.remove('hidden');
            visibleCitiesCount++;
          } else {
            cityItem.classList.add('hidden');
          }
        });

        if (groupHasMatch || visibleCitiesCount > 0) {
          group.classList.remove('hidden');
          if (query) {
            group.classList.remove('collapsed');
          }
          totalVisible++;
        } else {
          group.classList.add('hidden');
        }
      });

      if (!query) {
        // Re-collapse when query cleared unless item is checked
        groups.forEach((group) => {
          const checkedCount = group.querySelectorAll<HTMLInputElement>('.city-checkbox:checked, .country-checkbox:checked').length;
          if (checkedCount === 0) {
            group.classList.add('collapsed');
          }
        });
      }

      emptyEl?.classList.toggle('hidden', totalVisible > 0);
    }

    searchInput?.addEventListener('input', applySearch);

    searchClear?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        applySearch();
        searchInput.focus();
      }
    });

    syncExpandChecked();
  }

  // Initialize on DOM load and page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilterSidebar);
  } else {
    setupFilterSidebar();
  }
</script>
