---
import { normalizeImage } from '../lib/images';

interface Props {
  items: Array<{ slug: string; name: string; designer: string | null; cover: string | null }>;
  weekLabel?: string;
}

const { items, weekLabel } = Astro.props;

// Resolve designer names to their profile slugs so the names can link through.
let studioSlugs = new Map<string, string>();
try {
  const studiosUrl = new URL('/cdn/test-studios.json', Astro.url.origin).toString();
  const response = await fetch(studiosUrl);
  if (response.ok) {
    const studios = await response.json();
    for (const s of studios) studioSlugs.set(s.name, s.slug);
  }
} catch {
  // If the studios feed is unavailable, names simply render as plain text.
}
---

{items.length > 0 && (
  <section class="weekly-spotlight" id="discover-spotlight">
    <div class="spotlight-cards">
      <div class="spotlight-card spotlight-intro">
        {weekLabel && <span class="spotlight-badge">{weekLabel}</span>}
        <h2 class="spotlight-heading">Weekly<br />Spotlight</h2>
        <p class="spotlight-intro-text">
          Three industrial design projects selected each week, highlighting furniture, products and material explorations from independent studios around the world.
        </p>
      </div>

      {items.map((item) => {
        const designerSlug = item.designer ? (studioSlugs.get(item.designer) ?? null) : null;
        return (
          <div class="spotlight-card">
            <a href={`/discover/${item.slug}`} class="spotlight-link">
              <img
                src={normalizeImage(item.cover!, Astro, { width: 600 })}
                alt={item.name}
                loading="lazy"
                decoding="async"
              />
            </a>
            <p class="spotlight-name">{item.name}</p>
            {item.designer && (
              designerSlug ? (
                <a class="spotlight-designer" href={`/designers/${designerSlug}`}>{item.designer}</a>
              ) : (
                <p class="spotlight-designer">{item.designer}</p>
              )
            )}
          </div>
        );
      })}
    </div>
  </section>
)}

<style>
  .weekly-spotlight {
    margin-bottom: 40px;
  }

  .spotlight-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  /* With exactly four cards the only clean layouts are 4-across (one row) or
     2×2 (two rows); a 3-column state would leave an awkward lone card. Drop to
     two rows as soon as the row starts getting tight, in step with the rest of
     the page layout (sidebar collapses at 1099px). */
  @media (max-width: 1099px) {
    .spotlight-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spotlight-card {
    min-width: 0;
    display: block;
  }

  .spotlight-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    border: 1px solid var(--color-stroke);
    border-radius: 999px;
    padding: 5px 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }

  .spotlight-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    padding: 22px;
    background: transparent;
  }

  .spotlight-heading {
    font-family: var(--font-sans);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--color-black);
    margin: 0 0 16px;
  }

  .spotlight-intro-text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .spotlight-link {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }

  .spotlight-link img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background-color: #e9e9e9;
    transition: transform 0.2s ease;
  }

  .spotlight-link:hover img {
    transform: scale(1.02);
  }

  .spotlight-name {
    margin: 12px 0 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-black);
  }

  .spotlight-designer {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .spotlight-designer:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .spotlight-intro {
      padding: 14px;
    }

    .spotlight-heading {
      font-size: 24px;
    }
  }
</style>
