---
import { normalizeImage } from '../lib/images';

interface Props {
  items: Array<{ slug: string; name: string; designer: string | null; cover: string | null }>;
  weekLabel?: string;
  /** Overrides the intro card's body copy. Defaults to the /discover wording. */
  introText?: string;
  /** When set, renders a button in the intro card linking to this href (e.g. "/discover"). */
  ctaHref?: string;
  /** Label for the optional CTA button. Defaults to "See all projects". */
  ctaLabel?: string;
  /** Mobile-only CTA label. Defaults to `ctaLabel`. */
  ctaLabelMobile?: string;
  variant?: 'default' | 'yellow';
}

const {
  items,
  weekLabel,
  introText = 'A weekly selection of furniture, product and material design projects from independent studios worldwide.',
  ctaHref,
  ctaLabel = 'See all projects',
  ctaLabelMobile,
  variant = 'default',
} = Astro.props;

// Resolve designer names to their profile slugs so the names can link through.
let studioSlugs = new Map<string, string>();
try {
  const studiosUrl = new URL('/cdn/test-studios.json', Astro.url.origin).toString();
  const response = await fetch(studiosUrl);
  if (response.ok) {
    const studios = await response.json();
    for (const s of studios) studioSlugs.set(s.name, s.slug);
  }
} catch {
  // If the studios feed is unavailable, names simply render as plain text.
}
---

{items.length > 0 && (
  <section class="weekly-spotlight" id="discover-spotlight">
    <div class="spotlight-cards">
      <div class="spotlight-card spotlight-intro" class:list={[variant === 'yellow' ? 'spotlight-intro--yellow' : 'spotlight-intro--default']}>
        {weekLabel && <span class="spotlight-badge">{weekLabel}</span>}
        <h2 class="spotlight-heading">Weekly<br />Spotlight</h2>
        <p class="spotlight-intro-text">
          {introText}
        </p>
        {ctaHref && (
          <a href={ctaHref} class="spotlight-cta">
            <span class="spotlight-cta-desktop">{ctaLabel}</span>
            <span class="spotlight-cta-mobile">{ctaLabelMobile ?? ctaLabel}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        )}
      </div>

      {items.map((item) => {
        const designerSlug = item.designer ? (studioSlugs.get(item.designer) ?? null) : null;
        return (
          <div class="spotlight-card">
            <a href={`/discover/${item.slug}`} class="spotlight-link">
              <img
                src={normalizeImage(item.cover!, Astro, { width: 600 })}
                alt={item.name}
                loading="lazy"
                decoding="async"
              />
            </a>
            <p class="spotlight-name">{item.name}</p>
            {item.designer && (
              designerSlug ? (
                <a class="spotlight-designer" href={`/designers/${designerSlug}`}>{item.designer}</a>
              ) : (
                <p class="spotlight-designer">{item.designer}</p>
              )
            )}
          </div>
        );
      })}
    </div>
  </section>
)}

<style>
  .weekly-spotlight {
    margin-bottom: 40px;
  }

  .spotlight-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  /* With exactly four cards the only clean layouts are 4-across (one row) or
     2×2 (two rows); a 3-column state would leave an awkward lone card. Drop to
     two rows as soon as the row starts getting tight, in step with the rest of
     the page layout (sidebar collapses at 1099px). */
  @media (max-width: 1099px) {
    .spotlight-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .spotlight-card {
    min-width: 0;
    display: block;
  }

  .spotlight-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    border: 1px solid var(--color-stroke);
    border-radius: 999px;
    padding: 5px 12px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }

  .spotlight-intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    padding: 22px;
    background: transparent;
  }

  .spotlight-intro--default {
    background: transparent;
    border-color: var(--color-stroke);
  }

  .spotlight-intro--yellow .spotlight-badge {
    background: var(--color-black);
    border-color: var(--color-black);
    color: #fff;
  }

  .spotlight-intro--yellow {
    background: rgba(237, 255, 119, 0.5);
    border-color: rgba(237, 255, 119, 0.5);
  }

  .spotlight-heading {
    font-family: var(--font-sans);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--color-black);
    margin: 0 0 16px;
  }

  .spotlight-intro-text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .spotlight-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    margin-top: 18px;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--color-bg-secondary);
    color: var(--color-black);
    border: 1px solid var(--color-stroke);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .spotlight-cta:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .spotlight-cta svg {
    flex-shrink: 0;
  }

  .spotlight-cta-desktop {
    display: inline;
  }

  .spotlight-cta-mobile {
    display: none;
  }

  @media (max-width: 640px) {
    .spotlight-cta-desktop {
      display: none;
    }

    .spotlight-cta-mobile {
      display: inline;
    }
  }

  .spotlight-link {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }

  .spotlight-link img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background-color: #e9e9e9;
    transition: transform 0.2s ease;
  }

  .spotlight-link:hover img {
    transform: scale(1.02);
  }

  .spotlight-name {
    margin: 12px 0 0;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-black);
  }

  .spotlight-designer {
    margin: 4px 0 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .spotlight-designer:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .spotlight-intro {
      padding: 14px;
    }

    .spotlight-heading {
      font-size: 24px;
    }
  }
</style>
