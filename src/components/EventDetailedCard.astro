---
interface Props {
  name: string;
  date: string;
  location: string;
  description?: string;
  buttonText: string;
  buttonLink?: string;
  contact?: string;
  image?: string;
  showImage?: boolean;
  variant?: 'website' | 'register';
}

const { 
  name, 
  date, 
  location, 
  description, 
  buttonText, 
  buttonLink = "#", 
  contact, 
  image,
  showImage = true,
  variant = 'website'
} = Astro.props;
---

<div class="event-detailed-card">
  {showImage && (
    <div class="card-image-wrapper">
      {image ? (
        <img src={image} alt={name} class="event-image" />
      ) : (
        <div class="image-placeholder"></div>
      )}
    </div>
  )}
  
  <div class="card-content">
    <div class="card-header">
      <h3 class="event-title">{name}</h3>
      <div class="event-meta">
        <span class="event-date">{date}</span>
        <span class="dot">•</span>
        <span class="event-location">{location}</span>
      </div>
    </div>
    
    <p class="event-description">
      {description || "A curated event showcasing the best in industrial and furniture design from around the globe."}
    </p>
    
    <div class="card-footer">
      <a href={buttonLink} target="_blank" rel="noopener noreferrer" class:list={["action-button", `variant-${variant}`]}>
        {variant === 'website' && (
          <img src="/icons/source.svg" alt="" width="16" height="16" class="action-btn-icon" />
        )}
        <span>{buttonText}</span>
      </a>
      {contact && (
        <span class="contact-info">Contact: {contact}</span>
      )}
    </div>
  </div>
</div>

<style>
  .event-detailed-card {
    background: #111315;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    overflow: hidden;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .event-detailed-card:hover {
    background: #191B1D;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .card-image-wrapper {
    height: 200px;
    background: #1C1E20;
    overflow: hidden;
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #1C1E20, #25282A);
  }

  .card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    margin-bottom: 16px;
  }

  .event-title {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 8px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .dot {
    opacity: 0.3;
  }

  .event-description {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gray);
    line-height: 1.6;
    margin: 0 0 24px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .action-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 24px;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .variant-website {
    background: var(--color-btn-bg);
    color: var(--color-white);
  }

  .variant-register {
    background: var(--color-white);
    color: var(--color-black);
  }

  .action-button:hover {
    opacity: 0.9;
  }

  .action-btn-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transform: translateY(2px);
  }

  .contact-info {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-gray);
    opacity: 0.8;
  }

  @media (max-width: 768px) {
    .card-content {
      padding: 20px;
    }
    .event-title {
      font-size: 19px;
    }
    .action-button {
       width: 100%;
    }
    .card-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
