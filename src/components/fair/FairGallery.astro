---
import { normalizeImage } from '../../lib/images';

interface Props {
  fair: {
    name: string;
    image?: string;
    slideshow?: string;
  };
}

const { fair } = Astro.props;

const slideshowRaw = fair.slideshow || '[]';
const images: string[] = JSON.parse(slideshowRaw).filter(Boolean);
const thumbs = images.slice(0, 4);
const mainImage = images.length > 0 ? images[0] : fair.image;
---

<section class="gallery-section">
  <div class="gallery-frame" id="slideshowMain">
    {mainImage ? (
      <img
        src={normalizeImage(mainImage, Astro, { width: 1400 })}
        alt={`${fair.name}`}
        class="gallery-main-img"
        id="slideshowMainImg"
        loading="eager"
        decoding="async"
      />
    ) : (
      <div class="gallery-empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        <span>Event photography coming soon</span>
      </div>
    )}

    <!-- Autoplay Loading Line -->
    <div class="slideshow-progress-bar-wrap" id="slideProgressBarWrap">
      <div class="slideshow-progress-bar" id="slideProgressBar"></div>
    </div>

    <div class="gallery-counter" id="slideCounter" aria-live="polite">
      <span id="currentSlide">1</span> / <span id="totalSlides">{thumbs.length}</span>
    </div>

    <div class="gallery-nav-controls">
      <button class="gallery-nav-btn" id="slidePrev" aria-label="Previous image" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="gallery-nav-btn" id="slideNext" aria-label="Next image" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>

  <!-- Thumbnail Strip -->
  <div class="gallery-thumbnails" id="slideshowThumbs" role="list" aria-label="Event photos">
    {thumbs.map((img: string, i: number) => (
      <button
        type="button"
        class={`thumb-btn${i === 0 ? ' active' : ''}${!img ? ' wireframe' : ''}`}
        data-index={i}
        aria-label={`Image ${i + 1}`}
        aria-current={i === 0 ? 'true' : undefined}
      >
        {img ? (
          <img src={normalizeImage(img, Astro, { width: 200 })} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="wireframe-pattern"></div>
        )}
      </button>
    ))}
  </div>
</section>

<script>
  const thumbs = document.querySelectorAll('.thumb-btn');
  const mainImg = document.getElementById('slideshowMainImg') as HTMLImageElement | null;
  const currentSlideEl = document.getElementById('currentSlide');
  const totalSlidesEl = document.getElementById('totalSlides');
  const counter = document.getElementById('slideCounter');
  const progressBar = document.getElementById('slideProgressBar');
  const galleryFrame = document.getElementById('slideshowMain');
  const prevBtn = document.getElementById('slidePrev');
  const nextBtn = document.getElementById('slideNext');

  const totalThumbs = thumbs.length;
  let currentIndex = 0;
  const SLIDE_DURATION = 5000;
  let animationStart = performance.now();
  let reqId: number | null = null;
  let isPaused = false;

  if (totalSlidesEl) totalSlidesEl.textContent = String(totalThumbs);

  function setActiveSlide(idx: number) {
    currentIndex = ((idx % totalThumbs) + totalThumbs) % totalThumbs;
    const activeThumb = thumbs[currentIndex] as HTMLElement | undefined;
    if (!activeThumb) return;

    const src = activeThumb.querySelector('img')?.src;
    if (src && mainImg) {
      mainImg.src = src;
    }

    thumbs.forEach(t => { t.classList.remove('active'); t.removeAttribute('aria-current'); });
    activeThumb.classList.add('active');
    activeThumb.setAttribute('aria-current', 'true');

    if (currentSlideEl) currentSlideEl.textContent = String(currentIndex + 1);

    resetProgress();
  }

  function resetProgress() {
    animationStart = performance.now();
    if (progressBar) progressBar.style.width = '0%';
  }

  function step(now: number) {
    if (!isPaused && totalThumbs > 1) {
      const elapsed = now - animationStart;
      const progress = Math.min(elapsed / SLIDE_DURATION, 1);
      if (progressBar) progressBar.style.width = `${progress * 100}%`;

      if (elapsed >= SLIDE_DURATION) {
        setActiveSlide(currentIndex + 1);
      }
    }
    reqId = requestAnimationFrame(step);
  }

  if (totalThumbs > 1) {
    reqId = requestAnimationFrame(step);

    if (galleryFrame) {
      galleryFrame.addEventListener('mouseenter', () => { isPaused = true; });
      galleryFrame.addEventListener('mouseleave', () => {
        isPaused = false;
        animationStart = performance.now();
      });
    }
  } else {
    if (counter) counter.style.display = 'none';
    const progressWrap = document.getElementById('slideProgressBarWrap');
    if (progressWrap) progressWrap.style.display = 'none';
  }

  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const idx = Number((thumb as HTMLElement).dataset.index ?? 0);
      setActiveSlide(idx);
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setActiveSlide(currentIndex - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setActiveSlide(currentIndex + 1);
    });
  }
</script>

<style>
  .gallery-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .gallery-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: var(--color-bg-secondary);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-stroke);
    box-sizing: border-box;
  }

  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  .gallery-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--color-gray);
    font-family: var(--font-sans);
    font-size: 15px;
  }

  .slideshow-progress-bar-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: rgba(0, 0, 0, 0.15);
    z-index: 4;
    overflow: hidden;
  }

  .slideshow-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-white);
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
    will-change: width;
  }

  .gallery-counter {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(15, 17, 19, 0.68);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.92);
    border-radius: 999px;
    padding: 4px 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    pointer-events: none;
    z-index: 5;
  }

  .gallery-nav-controls {
    position: absolute;
    bottom: 14px;
    left: 14px;
    display: flex;
    gap: 6px;
    z-index: 5;
  }

  .gallery-nav-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .gallery-nav-btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .gallery-thumbnails {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 2px;
    width: 100%;
    box-sizing: border-box;
  }

  .thumb-btn {
    flex-shrink: 0;
    width: 80px;
    height: 60px;
    border-radius: 10px;
    border: 2px solid transparent;
    overflow: hidden;
    background: var(--color-bg-secondary);
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s ease, opacity 0.2s ease;
    opacity: 0.7;
    box-sizing: border-box;
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .thumb-btn.active {
    border-color: var(--color-black);
    opacity: 1;
  }

  .thumb-btn:hover {
    opacity: 1;
  }

  .thumb-btn.wireframe {
    cursor: default;
    opacity: 0.35;
  }

  .wireframe-pattern {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      var(--color-stroke),
      var(--color-stroke) 1px,
      transparent 1px,
      transparent 8px
    );
  }
</style>
