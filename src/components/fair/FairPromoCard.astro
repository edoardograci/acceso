---
---

<div class="promo-box promo-blue">
  <div class="promo-top-row">
    <div class="promo-icon-badge" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    </div>
    <span class="promo-tag">For Organizers</span>
  </div>
  
  <h4 class="promo-heading">Organizer of a Design Fair?</h4>
  <p class="promo-text">
    Submit your fair edition, publish venue schedules, and reach global design professionals and collectors on Acceso.
  </p>
  
  <a href="/submission" class="promo-cta-btn">
    <span>Submit for review</span>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </a>
</div>

<style>
  .promo-box {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
  }

  .promo-blue {
    background: #F0F8FF;
    border: 1px solid #BDE2F8;
  }

  .promo-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .promo-blue .promo-icon-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #BDE2F8;
    border: 1px solid #93C5FD;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0369A1;
  }

  .promo-blue .promo-tag {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #0284C7;
  }

  .promo-heading {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
  }

  .promo-text {
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-gray);
    margin: 0;
  }

  .promo-blue .promo-cta-btn {
    margin-top: 4px;
    width: 100%;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    color: var(--color-black);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-sizing: border-box;
    border: 1.5px solid #7DD3FC;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .promo-blue .promo-cta-btn:hover {
    background: #BDE2F8;
    border-color: #38BDF8;
    color: #0F1113;
  }
</style>
