---
interface Props {
  fair: {
    name: string;
    slug: string;
    gmaps_url?: string;
    gmaps?: string;
  };
  gmapsUrl: string;
}

const { fair, gmapsUrl } = Astro.props;
---

<div class="sidebar-location-section">
  <div class="sidebar-location-top">
    <h3 class="sidebar-location-title">Venue & Location</h3>
    <button class="location-report-icon-btn" id="locationReport" type="button" aria-label="Report location issue" title="Something wrong with this location?">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        <line x1="12" y1="9" x2="12" y2="13"/>
        <line x1="12" y1="17" x2="12.01" y2="17"/>
      </svg>
    </button>
  </div>

  <!-- Map Embed full width of column -->
  <div class="sidebar-map-box">
    <iframe
      class="sidebar-map-embed"
      src={`/embed/fair/${fair.slug}`}
      title={`Map of ${fair.name}`}
      loading="lazy"
    ></iframe>
  </div>

  <!-- Directions Button (48px height) -->
  {gmapsUrl && (
    <div class="sidebar-location-actions">
      <a class="directions-btn" href={gmapsUrl} target="_blank" rel="noopener noreferrer">
        <img src="/icons/googlemaps.svg" alt="" width="18" height="18" />
        <span>Get Directions</span>
      </a>
    </div>
  )}
</div>

<style>
  .sidebar-location-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .sidebar-location-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .sidebar-location-title {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  .location-report-icon-btn {
    background: transparent;
    border: 1px solid var(--color-stroke);
    border-radius: 50%;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gray);
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .location-report-icon-btn:hover {
    color: var(--color-danger, #ef4444);
    border-color: var(--color-danger, #ef4444);
    background: rgba(239, 68, 68, 0.06);
  }

  .sidebar-map-box {
    width: 100%;
    height: 260px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
    box-sizing: border-box;
  }

  .sidebar-map-embed {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .sidebar-location-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0;
    width: 100%;
  }

  .directions-btn {
    height: 48px;
    padding: 0 20px;
    border-radius: 12px;
    background: var(--color-white);
    color: var(--color-black);
    border: 1px solid var(--color-stroke);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    width: 100%;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .directions-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  @media (max-width: 960px) {
    .sidebar-map-box {
      height: 320px;
    }
  }
</style>
