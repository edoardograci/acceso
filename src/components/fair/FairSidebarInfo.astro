---
import { ensureProtocol } from '../../lib/url';

interface Props {
  fair: {
    name: string;
    description?: string;
    start_date?: string;
    end_date?: string;
    recurrence?: string;
    ticket?: string;
    country_slug?: string;
    city_slug?: string;
    address?: string;
    founded?: string | number;
    website?: string;
    instagram?: string;
    facebook?: string;
  };
  period: string;
  countryName: string;
  cityName: string;
}

const { fair, period, countryName, cityName } = Astro.props;

function formatInstagram(urlOrHandle: string): string {
  if (!urlOrHandle) return '';
  const clean = urlOrHandle.replace(/\/$/, '').trim();
  if (clean.startsWith('@')) return clean;
  const parts = clean.split('/');
  const handle = parts[parts.length - 1];
  if (handle && handle !== 'instagram.com' && !handle.includes('http') && !handle.includes('?')) {
    return `@${handle.replace(/^@/, '')}`;
  }
  return 'Instagram ↗';
}
---

<div class="info-card">
  <!-- Info Rows Group -->
  <div class="info-rows-group">
    {period && (
      <div class="info-row">
        <span class="info-label">Period</span>
        <span class="info-val">{period}</span>
      </div>
    )}

    {fair.recurrence && (
      <div class="info-row">
        <span class="info-label">Frequency</span>
        <span class="info-val">{fair.recurrence}</span>
      </div>
    )}

    {fair.ticket && (
      <div class="info-row">
        <span class="info-label">Admission</span>
        <span class="info-val">{fair.ticket}</span>
      </div>
    )}

    {countryName && (
      <div class="info-row">
        <span class="info-label">Country</span>
        {fair.country_slug ? (
          <a href={`/directory/fairs/in/${fair.country_slug}`} class="info-val underlined">{countryName}</a>
        ) : (
          <span class="info-val">{countryName}</span>
        )}
      </div>
    )}

    {cityName && (
      <div class="info-row">
        <span class="info-label">City</span>
        {fair.city_slug ? (
          <a href={`/directory/fairs/in/${fair.city_slug}`} class="info-val underlined">{cityName}</a>
        ) : (
          <span class="info-val">{cityName}</span>
        )}
      </div>
    )}

    {fair.address && (
      <div class="info-row top-align">
        <span class="info-label">Address</span>
        <span class="info-val">{fair.address}</span>
      </div>
    )}

    {fair.founded && (
      <div class="info-row">
        <span class="info-label">Established</span>
        <span class="info-val">{fair.founded}</span>
      </div>
    )}

    {fair.instagram && (
      <div class="info-row">
        <span class="info-label">Instagram</span>
        <a href={ensureProtocol(fair.instagram)} target="_blank" rel="noopener noreferrer" class="info-val underlined">
          {formatInstagram(fair.instagram)}
        </a>
      </div>
    )}

    {fair.facebook && (
      <div class="info-row">
        <span class="info-label">Facebook</span>
        <a href={ensureProtocol(fair.facebook)} target="_blank" rel="noopener noreferrer" class="info-val underlined">
          Facebook ↗
        </a>
      </div>
    )}
  </div>

  <!-- Official Website Button (48px height) -->
  {fair.website && (
    <a href={ensureProtocol(fair.website)} target="_blank" rel="noopener noreferrer" class="sidebar-website-btn">
      <div class="website-btn-left">
        <img src="/icons/source.svg" alt="" width="18" height="18" />
        <span>Visit Official Website</span>
      </div>
      <svg class="website-ext-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  )}

  <!-- Save Date Action Button (48px height, triggers CalendarModal) -->
  <div class="sidebar-save-wrap">
    <button 
      class="sidebar-calendar-btn" 
      id="calendarBtn"
      data-name={fair.name}
      data-desc={fair.description}
      data-start={fair.start_date}
      data-end={fair.end_date || fair.start_date}
      data-location={`${cityName}${countryName ? ', ' + countryName : ''}`}
      data-url={fair.website}
      type="button"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>Save date</span>
    </button>
  </div>
</div>

<style>
  .info-card {
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .info-rows-group {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-stroke);
    box-sizing: border-box;
    width: 100%;
  }

  .info-row.top-align {
    align-items: flex-start;
  }

  .info-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .info-row:first-child {
    padding-top: 4px;
  }

  .info-label {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gray);
    flex-shrink: 0;
    font-weight: 400;
  }

  .info-val {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-black);
    text-align: right;
    text-decoration: none;
    line-height: 1.4;
    word-break: break-word;
  }

  .info-val.underlined {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .info-val.underlined:hover {
    opacity: 0.6;
    color: var(--color-black);
  }

  .sidebar-website-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 16px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    color: var(--color-black);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    box-sizing: border-box;
    width: 100%;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    margin-top: 6px;
  }

  .website-btn-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sidebar-website-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .website-ext-icon {
    color: var(--color-gray);
  }

  .sidebar-website-btn:hover .website-ext-icon {
    color: var(--color-black);
  }

  .sidebar-save-wrap {
    margin-top: 0;
    width: 100%;
  }

  .sidebar-calendar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 48px;
    width: 100%;
    background: var(--color-black);
    color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-sizing: border-box;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .sidebar-calendar-btn:hover {
    background: #2A2D30;
    border-color: #2A2D30;
  }
</style>
