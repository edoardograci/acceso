---
---

<div class="promo-box promo-green">
  <div class="promo-top-row">
    <div class="promo-icon-badge" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
      </svg>
    </div>
    <span class="promo-tag">For Institutions</span>
  </div>
  
  <h4 class="promo-heading">Represent a Design Museum?</h4>
  <p class="promo-text">
    Submit your institution, showcase exhibitions, and connect with design enthusiasts and professionals worldwide on Acceso.
  </p>
  
  <a href="/submission" class="promo-cta-btn">
    <span>Submit for review</span>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </a>
</div>

<style>
  .promo-box {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
  }

  .promo-green {
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
  }

  .promo-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .promo-green .promo-icon-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #D1FAE5;
    border: 1px solid #86EFAC;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #14532D;
  }

  .promo-green .promo-tag {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #15803D;
  }

  .promo-heading {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
  }

  .promo-text {
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-gray);
    margin: 0;
  }

  .promo-green .promo-cta-btn {
    margin-top: 4px;
    width: 100%;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    color: var(--color-black);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-sizing: border-box;
    border: 1.5px solid #86EFAC;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .promo-green .promo-cta-btn:hover {
    background: #D1FAE5;
    border-color: #4ADE80;
    color: #0F1113;
  }
</style>
