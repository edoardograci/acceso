---
interface Props {
  active: 'info' | 'moodboard';
}

const { active } = Astro.props;
---

<div class="tabs">
  <button 
    class:list={['tab', 'tab-button', { active: active === 'info' }]}
    data-tab="info"
  >
    Info
  </button>
  
  <button 
    class:list={['tab', 'tab-button', { active: active === 'moodboard' }]}
    data-tab="moodboard"
  >
    Moodboard
  </button>
  
  <div class="tab-indicator"></div>
</div>

<style>
  .tabs {
    display: flex;
    gap: 48px;
    margin-bottom: 16px;
    position: relative;
    justify-content: center;
  }

  .tab {
    background: none;
    border: none;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 200;
    letter-spacing: 0.64px;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0 0 12px 0;
    transition: color 0.2s ease;
    position: relative;
  }

  .tab.active {
    color: var(--text-primary);
  }

  .tab:not(.active):hover {
    color: var(--text-primary);
  }

  .tab-indicator {
    position: absolute;
    bottom: 0;
    height: 2px;
    background-color: var(--accent-yellow);
    transition: left 0.3s ease, width 0.3s ease;
  }
</style>

<script>
  const tabs = document.querySelectorAll('.tab-button') as NodeListOf<HTMLElement>;
  const tabIndicator = document.querySelector('.tab-indicator') as HTMLElement;

  function updateIndicator() {
    const activeTab = document.querySelector('.tab-button.active') as HTMLElement;
    if (activeTab && tabIndicator) {
      tabIndicator.style.left = activeTab.offsetLeft + 'px';
      tabIndicator.style.width = activeTab.offsetWidth + 'px';
    }
  }

  // Initialize on page load
  updateIndicator();

  // Update on window resize
  window.addEventListener('resize', updateIndicator);
</script>