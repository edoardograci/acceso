---
import type { Studio } from '../lib/types';
import { Image } from 'astro:assets';

interface Props {
  studio: Studio;
  products: any[];
  index: number;
}

const { studio, products, index } = Astro.props;
---

<a 
  href={`/designers/${studio.slug}`} 
  class="designer-card block no-underline text-inherit transition-all duration-200 hover:-translate-y-1"
  data-name={studio.name.toLowerCase()}
  data-city={studio.city}
  data-country={studio.country}
  data-id={studio.id}
  data-index={index}
>
  <div class="card-inner">
    <div class="studio-logo-wrapper">
      {studio.cover ? (
        <Image 
          src={studio.cover} 
          alt={studio.name} 
          width={160} 
          height={160} 
          quality={80}
          class="studio-logo-img"
        />
      ) : (
        <div class="studio-logo-placeholder"></div>
      )}
    </div>
    <div class="header-info">
      <h3 class="studio-name">{studio.name}</h3>
      <p class="studio-location">{studio.city}</p>
    </div>
  </div>
</a>

<style>
  .designer-card {
    background: #111315;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.03);
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .designer-card:hover {
    background: #191B1D;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .card-inner {
    padding: 24px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .studio-logo-wrapper {
    width: 64px;
    height: 64px;
    background: #1C1E20;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .studio-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .studio-logo-placeholder {
    width: 100%;
    height: 100%;
    background: #1C1E20;
  }

  .header-info {
    min-width: 0;
  }

  .studio-name {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-white);
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .studio-location {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
    margin: 4px 0 0;
  }

  @media (max-width: 768px) {
    .card-inner {
      padding: 20px;
      gap: 20px;
    }
    .studio-logo-wrapper {
      width: 64px;
      height: 64px;
      border-radius: 12px;
    }
    .studio-name {
      font-size: 19px;
    }
    .studio-location {
      font-size: 15px;
    }
  }
</style>
