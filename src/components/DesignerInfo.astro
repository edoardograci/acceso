---
import type { Studio } from '../lib/types';

interface Props {
  studio: Studio;
}

const { studio } = Astro.props;
---

<div class="designer-info">
  <div class="info-section">
    <div class="info-label">Name</div>
    <div class="info-value">{studio.name}</div>
  </div>

  <div class="info-section">
    <div class="info-label">Location</div>
    <a href={`/designers?city=${studio.city}`} class="info-value">
      {studio.city}
    </a>
  </div>

  {studio.address && (
    <div class="info-section">
      <div class="info-label">Address</div>
      <a href={`/map?studio=${studio.slug}`} class="info-value">
        {studio.address}
      </a>
    </div>
  )}

  <div class="info-section">
    <div class="info-label">Email</div>
    <div class="info-value">
      {studio.email && (
        <a href={`mailto:${studio.email}`}>{studio.email}</a>
      )}
      {studio.email2 && (
        <>
          <br />
          <a href={`mailto:${studio.email2}`}>{studio.email2}</a>
        </>
      )}
    </div>
  </div>

  <div class="info-links">
    {studio.website && (
      <a href={studio.website} target="_blank" rel="noopener noreferrer" class="info-btn">
        <img src="/icons/source.svg" alt="" />
        Source
      </a>
    )}
    {studio.instagram && (
      <a href={studio.instagram} target="_blank" rel="noopener noreferrer" class="info-btn">
        <img src="/icons/instagram.svg" alt="" />
        Instagram
      </a>
    )}
  </div>
</div>

<style>
  .designer-info {
    padding-top: 24px;
  }

  .info-section {
    margin-bottom: 24px;
  }

  .info-label {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 200;
    letter-spacing: 0.56px;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .info-value {
    font-family: var(--font-sans);
    font-size: 16px; 
    font-weight: 450;
    line-height: 1.4;
    text-decoration: underline;
  }

  .info-value a {
    display: inline;
  }

  .info-links {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .info-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 14px; /* Assuming button text size */
    font-weight: 450;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .info-btn:hover {
    opacity: 0.8;
  }

  .info-btn img {
    height: 14px; /* Adjusting icon size */
    width: auto;
  }
</style>