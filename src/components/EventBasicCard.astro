---
import { normalizeImage } from '../lib/images';

interface Props {
  name: string;
  slug?: string;
  type?: 'fair' | 'museum' | 'award' | 'designer' | 'university';
  image?: string | null;
  location?: string;
  date?: string;
  pillText?: string;
  pillType?: 'default' | 'status-open' | 'status-closed';
}

const { name, slug, type, image, location, date, pillText, pillType = 'default' } = Astro.props;

const href = slug && type ? (type === 'designer' ? `/designers/${slug}` : `/directory/${type === 'fair' ? 'fairs' : type === 'museum' ? 'museums' : type === 'university' ? 'universities' : 'awards'}/${slug}`) : null;
---

<a href={href} class="event-basic-card">
  <div class="card-image-wrapper">
    {pillText && (
      <div class:list={["card-pill", pillType]}>
        <span>{pillText}</span>
      </div>
    )}
    {image ? (
      <img 
        src={normalizeImage(image, Astro, { width: 600 })} 
        alt={name} 
        class="event-image" 
        loading="lazy" 
        decoding="async"
      />
    ) : (
      <div class="image-placeholder"></div>
    )}
  </div>
  
  <div class="card-content">
    <h3 class="event-title">{name}</h3>
    {(location || date) && (
      <div class="event-meta">
        {location && <span class="event-location">{location}</span>}
        {location && date && <span class="dot">•</span>}
        {date && <span class="event-date">{date}</span>}
      </div>
    )}
  </div>
</a>

<style>
  .event-basic-card {
    background: transparent;
    border-radius: 0;
    overflow: visible;
    transition: transform 0.2s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }

  .event-basic-card:hover {
    transform: translateY(-4px);
    color: inherit;
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 1.4;
    background: #E8E8EA;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-stroke);
  }

  .event-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .event-basic-card:hover .event-image {
    transform: scale(1.03);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: #E8E8EA;
  }

  .card-pill {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    padding: 2px 12px 0;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 17, 19, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .card-pill span {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    color: var(--color-white);
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .card-pill.status-open {
    background: #C6F6D6;
    border-color: #C6F6D6;
  }
  .card-pill.status-open span {
    color: var(--color-black);
  }

  .card-pill.status-closed {
    background: rgba(15, 17, 19, 0.88);
    border-color: rgba(255, 255, 255, 0.08);
  }
  .card-pill.status-closed span {
    color: rgba(255, 255, 255, 0.72);
    font-weight: 400;
  }

  .card-content {
    padding: 0 2px 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .event-title {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .dot {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .event-title {
      font-size: 15px;
    }
  }
</style>
