<style>
  .site-footer {
    background: var(--color-black);
    padding: 80px var(--spacing-page) 40px;
    margin-top: 120px;
  }

  .footer-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px;
    margin-bottom: 80px;
  }

  /* Brand & Social */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 400;
    color: var(--color-white);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .footer-logo:hover {
    color: var(--color-yellow);
  }

  .follow-text {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
    margin-top: 8px;
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-white);
    transition: all 0.2s ease;
  }

  .social-link:hover {
    border-color: var(--color-yellow);
    color: var(--color-yellow);
    transform: translateY(-2px);
  }

  /* Navigation Columns */
  .footer-nav-columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .footer-nav-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-nav-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-white);
    margin-bottom: 4px;
    letter-spacing: 0.01em;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav-list li a {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-nav-list li a:hover {
    color: var(--color-white);
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 32px;
    border-top: 1px solid var(--color-stroke);
  }

  .footer-copyright,
  .footer-tagline,
  .footer-credit {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-gray);
  }

  .footer-tagline {
    color: var(--color-yellow);
  }

  /* Mobile Responsive */
  @media (max-width: 1024px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 60px var(--spacing-page) 32px;
      margin-top: 80px;
    }

    .footer-main {
      gap: 40px;
      margin-bottom: 48px;
    }

    .footer-nav-columns {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }

    .footer-nav-column:last-child {
      grid-column: span 2;
    }

    .footer-bottom {
      gap: 12px;
      text-align: center;
      padding-top: 24px;
    }

    .footer-credit {
      order: 1;
    }

    .footer-tagline {
      order: 2;
    }

    .footer-copyright {
      order: 3;
    }
  }

  @media (max-width: 480px) {
    .footer-nav-columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer-nav-column:last-child {
      grid-column: span 1;
    }
  }
</style>
