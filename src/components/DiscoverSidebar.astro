---
const instagramUrl = 'https://instagram.com/acceso_design';
---

<aside class="discover-sidebar">
  <div class="sidebar-card">
    <div class="sidebar-card-icon" aria-hidden="true">
      <img src="/icons/instagram.svg" alt="" width="22" height="22" />
    </div>
    <h3 class="sidebar-card-title">Follow us on Instagram</h3>
    <p class="sidebar-card-text">
      Stay up to date with the latest industrial design projects, moodboards and studio drops.
    </p>
    <a class="sidebar-follow-btn" href={instagramUrl} target="_blank" rel="noopener noreferrer">
      Follow @acceso_design
    </a>
  </div>
</aside>

<style>
  .discover-sidebar {
    flex: 0 0 300px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-card {
    background: var(--color-bg-secondary);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .sidebar-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-black);
  }

  .sidebar-card-title {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
  }

  .sidebar-card-text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0;
  }

  .sidebar-follow-btn {
    margin-top: 4px;
    width: 100%;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--color-black);
    color: var(--color-white);
    border: 1px solid var(--color-black);
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .sidebar-follow-btn:hover {
    background: #2a2d30;
    border-color: #2a2d30;
  }

  @media (max-width: 1099px) {
    .discover-sidebar {
      margin-top: 40px;
    }
  }
</style>
