---
import { AFFILIATE_DISCLOSURE } from '../../lib/seo/wishlist';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p class:list={['affiliate-note', className]}>
  {AFFILIATE_DISCLOSURE}
</p>

<style>
  .affiliate-note {
    margin: 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
