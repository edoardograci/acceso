---
interface Props {
  className?: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
}

const {
  className = "",
  title = "Get listed",
  subtitle = "Submit your studio. We’ll review and make it discoverable.",
  ctaLabel = "Submit for review",
} = Astro.props;
---

<a href="/submission" class={`cta-card cta-vertical cta-getlisted ${className}`}>
  <div class="cta-copy">
    <div class="cta-title">{title}</div>
    <div class="cta-sub">{subtitle}</div>
  </div>
  <div class="cta-action mt-6">{ctaLabel}</div>
</a>

<style>
  .cta-card {
    text-decoration: none;
    border-radius: 24px;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
    padding: 40px 32px;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    justify-content: center;
    gap: 0px;
    transition: all 0.2s ease;
  }
  
  .cta-card:hover {
    background: #EAEAEC;
    border-color: #D4D4D8;
  }

  .cta-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-title {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 400;
    color: var(--color-black);
    margin-bottom: 12px;
    letter-spacing: 0;
    line-height: 1;
  }

  .cta-sub {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gray);
    line-height: 1.5;
    margin-bottom: 0;
    max-width: 32ch;
  }

  .cta-action {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-black);
    background: var(--color-white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 24px;
    border-radius: 14px;
    border: 1px solid var(--color-stroke);
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .cta-action:hover {
    background: #f3f4f6;
    border-color: #f3f4f6;
    transform: translateY(-2px);
  }

  .mt-6 { margin-top: 24px; }

  @media (max-width: 640px) {
    .cta-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .cta-action {
      width: 100%;
    }
  }
</style>
