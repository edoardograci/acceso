---
import type { Studio } from '../lib/types';
import { normalizeImage } from '../lib/images';
import { firstSentence } from '../lib/text';

interface Props {
  studio: Studio;
  index?: number;
  cover?: string | null;
  basePath?: string;
  /** Opt-in: renders a one-line specialty/description snippet on the card.
   *  Off by default so existing pages using this component are unaffected. */
  showDescription?: boolean;
}

const { studio, index = 0, cover, basePath = '/designers', showDescription = false } = Astro.props;
const snippet = showDescription ? firstSentence(studio.description) : '';
---

<a
  href={`${basePath}/${studio.slug}`}
  class="directory-card"
  data-name={String(studio.name ?? '').toLowerCase()}
  data-city={studio.city}
  data-country={studio.country}
  data-id={studio.id}
  data-index={index}
  data-lat={studio.latitude}
  data-lng={studio.longitude}
  data-slug={studio.slug}
>
  <div class="directory-card-media">
    {cover ?? studio.cover ? (
      <img
        src={normalizeImage(cover ?? studio.cover, Astro)}
        alt={studio.name}
        width="400"
        height="400"
        loading="lazy"
        decoding="async"
        class="directory-card-image"
      />
    ) : (
      <div class="directory-card-placeholder" aria-hidden="true"></div>
    )}
  </div>
  <h3 class="directory-card-name">{studio.name}</h3>
  <p class="directory-card-location">{(studio.city || '').split(',')[0].trim()}</p>
  {snippet && <p class="directory-card-desc">{snippet}</p>}
</a>

<style is:global>
  .directory-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease;
  }

  .directory-card:hover {
    transform: translateY(-4px);
    color: inherit;
  }

  .directory-card-media {
    aspect-ratio: 1;
    overflow: hidden;
    background: #E8E8EA;
    border-radius: 12px;
    border: 1px solid var(--color-stroke);
  }

  .directory-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .directory-card:hover .directory-card-image {
    transform: scale(1.03);
  }

  .directory-card-placeholder {
    width: 100%;
    height: 100%;
    background: #E8E8EA;
  }

  .directory-card-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-card-location {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-text-muted);
    margin: -6px 0 0;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .directory-card-desc {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text-muted);
    margin: -4px 0 0;
    line-height: 1.4;
    opacity: 0.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
