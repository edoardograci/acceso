---
import SaveButton from './SaveButton.astro';
import ThreeDotsMenu from './ThreeDotsMenu.astro';

interface Props {
  productId: string;
  currentImageUrl?: string;
  imageName?: string;
  itemName?: string;
}

const { productId, currentImageUrl, imageName, itemName } = Astro.props;
---
<div class="moodboard-actions">
  <div class="flex gap-4">
    <button class="btn-icon" id="shareButton" aria-label="Share">
      <img src="/icons/share.svg" alt="" />
    </button>
    <ThreeDotsMenu imageUrl={currentImageUrl} downloadFileName={imageName} />
  </div>
  
  <SaveButton type="object" itemId={productId} itemName={itemName} />
</div>

<style>
  .moodboard-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin: 20px 0;
    padding: 0 var(--spacing-page);
  }

  @media (min-width: 768px) {
    .moodboard-actions {
      justify-content: flex-start;
      gap: 16px;
    }
  }
</style>

<script>
  const shareButton = document.getElementById('shareButton');
  if (shareButton) {
    shareButton.addEventListener('click', async () => {
      const shareData = {
        title: document.title,
        url: window.location.href,
        text: 'Check out this project on Acceso'
      };

      try {
        if (navigator.canShare && navigator.canShare(shareData)) {
          await navigator.share(shareData);
        } else {
          // Fallback to clipboard
          await navigator.clipboard.writeText(window.location.href);
          alert('Link copied to clipboard');
        }
      } catch (err) {
      }
    });
  }
</script>
