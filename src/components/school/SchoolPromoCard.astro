---
---

<div class="promo-box promo-purple">
  <div class="promo-top-row">
    <div class="promo-icon-badge" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
        <path d="M6 12v5c3 3 9 3 12 0v-5"/>
      </svg>
    </div>
    <span class="promo-tag">For Institutions</span>
  </div>
  
  <h4 class="promo-heading">Represent a Design School?</h4>
  <p class="promo-text">
    Submit your academy, manage curriculum listings, and connect with prospective design students worldwide on Acceso.
  </p>
  
  <a href="/submission" class="promo-cta-btn">
    <span>Submit for review</span>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
  </a>
</div>

<style>
  .promo-box {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    box-sizing: border-box;
  }

  .promo-purple {
    background: #FAF7FF;
    border: 1px solid #E9D8FD;
  }

  .promo-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .promo-purple .promo-icon-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: #EAD8FE;
    border: 1px solid #D8B4FE;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4C1D95;
  }

  .promo-purple .promo-tag {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #7C3AED;
  }

  .promo-heading {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-black);
    margin: 0;
    line-height: 1.25;
  }

  .promo-text {
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-gray);
    margin: 0;
  }

  .promo-purple .promo-cta-btn {
    margin-top: 4px;
    width: 100%;
    height: 48px; /* 48px height matching website, save, directions buttons */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    color: var(--color-black);
    border-radius: 12px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-sizing: border-box;
    border: 1.5px solid #D8B4FE;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .promo-purple .promo-cta-btn:hover {
    background: #EAD8FE;
    border-color: #C4B5FD;
    color: #0F1113;
  }
</style>
