---
import SaveButton from '../SaveButton.astro';
import { ensureProtocol } from '../../lib/url';

interface Props {
  university: {
    id?: string;
    slug: string;
    name: string;
    country_slug?: string;
    city_slug?: string;
    address?: string;
    website?: string;
    instagram?: string;
    facebook?: string;
  };
  countryName: string;
  cityName: string;
  contactParts: string[];
}

const { university, countryName, cityName, contactParts } = Astro.props;
---

<div class="info-card">
  <!-- Info Rows -->
  <div class="info-rows-group">
    {countryName && (
      <div class="info-row">
        <span class="info-label">Country</span>
        {university.country_slug ? (
          <a href={`/directory/schools/in/${university.country_slug}`} class="info-val underlined">{countryName}</a>
        ) : (
          <span class="info-val">{countryName}</span>
        )}
      </div>
    )}
    {cityName && (
      <div class="info-row">
        <span class="info-label">City</span>
        {university.city_slug ? (
          <a href={`/directory/schools/in/${university.city_slug}`} class="info-val underlined">{cityName}</a>
        ) : (
          <span class="info-val">{cityName}</span>
        )}
      </div>
    )}
    {university.address && (
      <div class="info-row top-align">
        <span class="info-label">Address</span>
        <span class="info-val">{university.address}</span>
      </div>
    )}
    {contactParts.length > 0 && contactParts.map((val) => {
      const isEmail = val.includes('@');
      return (
        <div class="info-row">
          <span class="info-label">{isEmail ? 'Email' : 'Phone'}</span>
          <a
            href={isEmail ? `mailto:${val}` : `tel:${val.replace(/\s/g, '')}`}
            class="info-val underlined"
          >
            {val}
          </a>
        </div>
      );
    })}
  </div>

  <!-- Social Links -->
  {(university.instagram || university.facebook) && (
    <div class="sidebar-links-list">
      {university.instagram && (
        <a href={ensureProtocol(university.instagram)} target="_blank" rel="noopener noreferrer" class="social-link-item">
          <img src="/icons/instagram.svg" alt="" width="16" height="16" />
          <span>Instagram</span>
          <svg class="ext-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
      {university.facebook && (
        <a href={ensureProtocol(university.facebook)} target="_blank" rel="noopener noreferrer" class="social-link-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          <span>Facebook</span>
          <svg class="ext-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
      )}
    </div>
  )}

  <!-- Official Website Button (48px height) -->
  {university.website && (
    <a href={ensureProtocol(university.website)} target="_blank" rel="noopener noreferrer" class="sidebar-website-btn">
      <div class="website-btn-left">
        <img src="/icons/source.svg" alt="" width="18" height="18" />
        <span>Visit Official Website</span>
      </div>
      <svg class="website-ext-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
    </a>
  )}

  <!-- Save Action Button (48px height) -->
  <div class="sidebar-save-wrap">
    <SaveButton type="university" itemId={university.id || university.slug} itemName={university.name} buttonClass="footer-btn save-btn" />
  </div>
</div>

<style>
  .info-card {
    background: var(--color-bg-secondary);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .info-rows-group {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--color-stroke);
    box-sizing: border-box;
    width: 100%;
  }

  .info-row.top-align {
    align-items: flex-start;
  }

  .info-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .info-row:first-child {
    padding-top: 4px;
  }

  .info-label {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-gray);
    flex-shrink: 0;
    font-weight: 400;
  }

  .info-val {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-black);
    text-align: right;
    text-decoration: none;
    line-height: 1.4;
    word-break: break-word;
  }

  .info-val.underlined {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.2s ease;
  }

  .info-val.underlined:hover {
    opacity: 0.6;
    color: var(--color-black);
  }

  .sidebar-links-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-stroke);
    padding-top: 4px;
    width: 100%;
  }

  .social-link-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--color-stroke);
    color: var(--color-black);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
    width: 100%;
  }

  .social-link-item:last-child {
    border-bottom: none;
  }

  .social-link-item:hover {
    opacity: 0.6;
  }

  .social-link-item span {
    flex: 1;
  }

  .ext-arrow {
    flex-shrink: 0;
    color: var(--color-gray);
  }

  .sidebar-website-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 16px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    color: var(--color-black);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    box-sizing: border-box;
    width: 100%;
    transition: background-color 0.2s ease, border-color 0.2s ease;
    margin-top: 6px;
  }

  .website-btn-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sidebar-website-btn:hover {
    background: #EBEBED;
    border-color: #D4D4D8;
    color: var(--color-black);
  }

  .website-ext-icon {
    color: var(--color-gray);
  }

  .sidebar-website-btn:hover .website-ext-icon {
    color: var(--color-black);
  }

  .sidebar-save-wrap {
    margin-top: 0;
    width: 100%;
  }

  .sidebar-save-wrap :global(.save-btn) {
    width: 100%;
    height: 48px;
  }
</style>
