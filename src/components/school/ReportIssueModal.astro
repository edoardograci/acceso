---
interface Props {
  universityName: string;
  universityHasLocation: boolean;
}

const { universityName, universityHasLocation } = Astro.props;
---

{universityHasLocation && (
  <div class="report-modal" id="reportModal" hidden data-school-name={universityName}>
    <div class="report-modal-backdrop" id="reportBackdrop"></div>
    <div class="report-modal-box" role="dialog" aria-modal="true" aria-label="Report this information">
      
      <div class="report-modal-header">
        <div class="report-icon-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
        </div>
        <button class="report-modal-close" id="reportClose" type="button" aria-label="Close modal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <h3 class="report-modal-title">Report information issue</h3>
      <p class="report-modal-desc">
        Notice incorrect address details, map position, or links for <strong class="school-name-highlight">{universityName}</strong>? Let us know so we can fix it.
      </p>

      <textarea
        class="report-modal-textarea"
        id="reportText"
        placeholder="Describe what needs updating (optional)..."
        rows="4"
      ></textarea>

      <div class="report-modal-actions">
        <button class="report-send-btn" id="reportSend" type="button">
          <span>Send Report</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"/>
            <polygon points="22 2 15 22 11 13 2 9 22 2"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
)}

<script>
  const reportBtn = document.getElementById('locationReport');
  const reportModal = document.getElementById('reportModal');
  const reportClose = document.getElementById('reportClose');
  const reportBackdrop = document.getElementById('reportBackdrop');
  const reportSend = document.getElementById('reportSend');
  const reportText = document.getElementById('reportText') as HTMLTextAreaElement | null;
  const universityName = reportModal?.dataset.schoolName || document.querySelector('.school-title')?.textContent?.trim() || '';

  function openReportModal() {
    if (!reportModal) return;
    reportModal.hidden = false;
    reportText?.focus();
  }

  function closeReportModal() {
    if (reportModal) reportModal.hidden = true;
  }

  if (reportBtn) reportBtn.addEventListener('click', openReportModal);
  if (reportClose) reportClose.addEventListener('click', closeReportModal);
  if (reportBackdrop) reportBackdrop.addEventListener('click', closeReportModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeReportModal();
  });

  if (reportSend && reportText) {
    reportSend.addEventListener('click', () => {
      const note = reportText.value.trim();
      const body = `University: ${universityName}\nURL: ${window.location.href}\n\nNotes:\n${note}`;
      window.location.href = `mailto:hello@acceso.design?subject=${encodeURIComponent('Report: ' + universityName)}&body=${encodeURIComponent(body)}`;
      closeReportModal();
    });
  }
</script>

<style>
  .report-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .report-modal[hidden] {
    display: none;
  }

  .report-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 17, 19, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .report-modal-box {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: var(--color-white);
    border: 1px solid var(--color-stroke);
    border-radius: 20px;
    padding: 24px 28px 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  .report-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    width: 100%;
  }

  .report-icon-badge {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #FEF2F2;
    border: 1px solid #FECACA;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #EF4444;
  }

  .report-modal-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-stroke);
    color: var(--color-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .report-modal-close:hover {
    color: var(--color-black);
    border-color: var(--color-black);
    background: var(--color-white);
  }

  .report-modal-title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    color: var(--color-black);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }

  .report-modal-desc {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 18px;
  }

  .school-name-highlight {
    color: var(--color-black);
    font-weight: 600;
  }

  .report-modal-textarea {
    width: 100%;
    height: 100px;
    resize: none;
    border-radius: 12px;
    border: 1px solid var(--color-stroke);
    background: var(--color-bg-secondary);
    padding: 14px;
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-black);
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease;
    margin-bottom: 20px;
  }

  .report-modal-textarea:focus {
    outline: none;
    border-color: var(--color-black);
    background: var(--color-white);
  }

  .report-modal-textarea::placeholder {
    color: var(--color-gray);
  }

  .report-modal-actions {
    display: flex;
    width: 100%;
  }

  .report-send-btn {
    height: 48px;
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--color-black);
    background: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .report-send-btn:hover {
    background: #2A2D30;
    border-color: #2A2D30;
  }
</style>
