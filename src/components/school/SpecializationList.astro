---
import { getSpecializationColor } from '../../lib/specialization';

interface Props {
  specializationList: string[];
  title?: string;
}

const { specializationList, title = "Specializations" } = Astro.props;
---

{specializationList.length > 0 && (
  <section class="content-block spec-block">
    <h2 class="block-title">{title}</h2>
    <div class="specialization-pill-group">
      {specializationList.map((spec) => (
        <span class="spec-pill" style={{ backgroundColor: getSpecializationColor(spec) }}>
          {spec}
        </span>
      ))}
    </div>
  </section>
)}

<style>
  .content-block {
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
    box-sizing: border-box;
  }

  .block-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    margin: 0;
  }

  .specialization-pill-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
  }

  .spec-pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-black);
    line-height: 1.4;
  }
</style>
