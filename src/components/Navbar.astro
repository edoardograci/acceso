---
import type { NavLink } from '../lib/types';

const navLinks: NavLink[] = [
  { label: 'Map', href: '/' },
  { label: 'Designers', href: '/designers' },
  { label: 'Discover', href: '/discover' },
  { label: 'Directory', href: '/directory' },
  { label: 'Info', href: '/info' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath.startsWith('/?');
  if (href === '/discover') return currentPath === '/discover' || currentPath.startsWith('/discover/');
  if (href === '/directory') return currentPath === '/directory' || currentPath.startsWith('/directory/');
  if (href === '/designers') return currentPath === '/designers' || currentPath.startsWith('/designers/');
  return currentPath.startsWith(href);
}

const user = Astro.locals.user;
const profileLetter = user?.email ? user.email.charAt(0).toUpperCase() : 'A';
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="Acceso Home">
      <svg width="76" height="20" viewBox="0 0 108 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M98.2954 0C104.519 0 108 4.1523 108 9.85292C108 15.5184 104.519 19.7058 98.2954 19.7058C92.0718 19.7058 88.5908 15.5184 88.5908 9.85292C88.5908 4.1523 92.0718 0 98.2954 0ZM98.2954 16.2925C101.214 16.2925 102.972 13.8645 102.972 9.85292C102.972 5.80619 101.214 3.41333 98.2954 3.41333C95.377 3.41333 93.6189 5.80619 93.6189 9.85292C93.6189 13.8645 95.377 16.2925 98.2954 16.2925Z" fill="black"/>
