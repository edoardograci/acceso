---
import type { NavLink } from '../lib/types';
import { iconMap } from '../lib/map-icons';

const navLinks: NavLink[] = [
  { label: 'Discover', href: '/' },
  { label: 'Designers', href: '/designers' },
  { label: 'Projects', href: '/projects' },
  { label: 'Events', href: '/events' }
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const user = Astro.locals.user;
let userIcon = iconMap['DEFAULT'];

if (user && user.email) {
  const firstLetter = user.email.charAt(0).toUpperCase();
  userIcon = iconMap[firstLetter] || iconMap['DEFAULT'];
}
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="Acceso Home">
      <svg width="56" height="14" viewBox="0 0 56 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1.86039 14H0.000390738V9.4L3.38039 -9.53674e-07H5.28039L8.66039 9.4V14H6.80039V10.68H1.86039V14ZM2.18039 8.82H6.48039L4.36039 2.92H4.30039L2.18039 8.82ZM16.2559 3.54C16.2559 2.6 15.5359 1.86 14.5959 1.86H12.9959C12.0559 1.86 11.3159 2.62 11.3159 3.54V10.44C11.3159 11.36 12.0759 12.12 12.9959 12.12H14.5959C15.5159 12.12 16.2559 11.36 16.2559 10.44V9.34H18.1159V10.44C18.1159 12.4 16.5559 14 14.5959 14H12.9959C11.0559 14 9.45586 12.38 9.45586 10.44V3.54C9.45586 1.58 11.0559 -9.53674e-07 12.9959 -9.53674e-07H14.5959C16.5559 -9.53674e-07 18.1159 1.56 18.1159 3.54V4.64H16.2559V3.54ZM25.7113 3.54C25.7113 2.6 24.9913 1.86 24.0513 1.86H22.4513C21.5113 1.86 20.7713 2.62 20.7713 3.54V10.44C20.7713 11.36 21.5313 12.12 22.4513 12.12H24.0513C24.9713 12.12 25.7113 11.36 25.7113 10.44V9.34H27.5713V10.44C27.5713 12.4 26.0113 14 24.0513 14H22.4513C20.5113 14 18.9113 12.38 18.9113 10.44V3.54C18.9113 1.58 20.5113 -9.53674e-07 22.4513 -9.53674e-07H24.0513C26.0113 -9.53674e-07 27.5713 1.56 27.5713 3.54V4.64H25.7113V3.54ZM37.0268 -9.53674e-07V1.86H30.2268V5.7H36.2268V7.58H30.2268V12.14H37.0268V14H28.3668V-9.53674e-07H37.0268ZM37.8223 9.52H39.6823V10.34C39.6823 11.34 40.4823 12.14 41.4823 12.14H42.8223C43.8823 12.14 44.6223 11.46 44.6223 10.54C44.6223 7.72 38.0223 7 38.0223 3.26C38.0223 1.34 39.5423 -9.53674e-07 41.6823 -9.53674e-07H42.6223C44.6423 -9.53674e-07 46.2823 1.64 46.2823 3.66V4.26H44.4223V3.66C44.4223 2.66 43.6223 1.86 42.6223 1.86H41.6823C40.5423 1.86 39.8823 2.4 39.8823 3.26C39.8823 5.44 46.4823 6.36 46.4823 10.54C46.4823 12.5 44.9023 14 42.8223 14H41.4823C39.4623 14 37.8223 12.36 37.8223 10.34V9.52ZM52.4177 12.12C53.3377 12.12 54.0777 11.36 54.0777 10.44V3.54C54.0777 2.6 53.3577 1.86 52.4177 1.86H50.8177C49.8777 1.86 49.1377 2.62 49.1377 3.54V10.44C49.1377 11.36 49.8977 12.12 50.8177 12.12H52.4177ZM47.2777 10.44V3.54C47.2777 1.58 48.8777 -9.53674e-07 50.8177 -9.53674e-07H52.4177C54.3777 -9.53674e-07 55.9377 1.56 55.9377 3.54V10.44C55.9377 12.4 54.3777 14 52.4177 14H50.8177C48.8777 14 47.2777 12.38 47.2777 10.44Z" fill="white"/>
      </svg>
    </a>

    <div class="navbar-links">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]}>Discover</a>
      <a href="/designers" class:list={['nav-link', { active: isActive('/designers') }]}>Designers</a>
      <a href="/projects" class:list={['nav-link', { active: isActive('/projects') }]}>Projects</a>
      <a href="/events" class:list={['nav-link', { active: isActive('/events') }]}>Events</a>
    </div>

    <div class="navbar-actions">
      <a href="/info" class="nav-link">Info</a>
      <a href="/get-listed" class="nav-link">Get listed</a>
      {user ? (
        <a href="/profile" class="navbar-profile-btn" aria-label="Profile">
          <div class="profile-icon" set:html={userIcon} />
        </a>
      ) : (
        <div class="auth-buttons">
          <a href="/login" class="btn-login">Login</a>
          <a href="/login" class="btn-signup">Sign up</a>
        </div>
      )}
    </div>

    <!-- Mobile hamburger button -->
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
      <svg class="hamburger-svg" width="22" height="16" viewBox="0 0 22 16" fill="currentColor">
        <rect class="line top" x="0" y="0" width="22" height="2" rx="1" />
        <rect class="line middle" x="0" y="7" width="22" height="2" rx="1" />
        <rect class="line bottom" x="0" y="14" width="22" height="2" rx="1" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile Nav Overlay -->
<div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true">
  <div class="mobile-nav-content">
    <nav class="mobile-nav-links">
      <a href="/" class:list={['mobile-nav-link', { active: isActive('/') }]}>Discover</a>
      <a href="/designers" class:list={['mobile-nav-link', { active: isActive('/designers') }]}>Designers</a>
      <a href="/projects" class:list={['mobile-nav-link', { active: isActive('/projects') }]}>Projects</a>
      <a href="/events" class:list={['mobile-nav-link', { active: isActive('/events') }]}>Events</a>
      <a href="/info" class:list={['mobile-nav-link', { active: isActive('/info') }]}>Info</a>
      <a href="/get-listed" class:list={['mobile-nav-link', { active: isActive('/get-listed') }]}>Get listed</a>
    </nav>
    <div class="mobile-nav-actions">
      {user ? (
        <a href="/profile" class="btn-primary" style="width:100%;text-align:center;">Profile</a>
      ) : (
        <div class="mobile-auth-buttons">
          <a href="/login" class="btn-login mobile-btn-login">Login</a>
          <a href="/login" class="btn-signup mobile-btn-signup">Sign up</a>
        </div>
      )}
    </div>
  </div>
</div>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

  function openMenu() {
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    hamburgerBtn?.classList.add('open');
    mobileNavOverlay?.classList.add('open');
    mobileNavOverlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    hamburgerBtn?.classList.remove('open');
    mobileNavOverlay?.classList.remove('open');
    mobileNavOverlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', () => {
    const isOpen = hamburgerBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  // Close on overlay tap outside content
  mobileNavOverlay?.addEventListener('click', (e) => {
    if (e.target === mobileNavOverlay) closeMenu();
  });
</script>

<style>
.navbar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navbar-height);
  z-index: 2000;
  background-color: rgba(15, 17, 19, 0.9);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-stroke);
}

.navbar-inner {
  max-width: 1600px;
  margin: 0 auto;
  height: 100%;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 32px;
  margin-left: 48px;
  flex: 1;
}

.nav-link {
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 400;
  color: var(--color-nav-inactive);
  transition: color 0.2s ease;
  white-space: nowrap;
}

.nav-link:hover, .nav-link.active {
  color: var(--color-white);
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 24px;
}

.auth-buttons {
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-login, .btn-signup {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 36px;
  padding: 0 16px;
  border-radius: 999px;
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 400;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1px solid transparent;
}

.btn-login {
  background: var(--color-dark-yellow);
  color: var(--color-yellow);
  border-color: rgba(237, 254, 68, 0.24);
}

.btn-signup {
  background: var(--color-yellow);
  color: var(--color-black);
  border-color: rgba(237, 254, 68, 0.5);
}

.btn-login:hover, .btn-signup:hover {
  color: inherit;
}

.btn-login:hover {
  background: rgba(237, 254, 68, 0.18);
  border-color: rgba(237, 254, 68, 0.45);
}

.btn-signup:hover {
  background: #f2ff74;
  border-color: #f2ff74;
  color: var(--color-black) !important;
}

.navbar-profile-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  overflow: hidden;
}

.profile-icon {
  width: 100%;
  height: 100%;
}

.profile-icon :global(svg) {
  width: 100%;
  height: 100%;
}

/* ── Hamburger ─────────────────────────────── */
.hamburger-btn {
  display: none;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
  color: var(--color-white);
  padding: 0;
}

.hamburger-svg {
  display: block;
  width: 22px;
  height: 16px;
  overflow: visible;
}

.hamburger-svg .line {
  transform-origin: center;
  transform-box: fill-box; /* Ensures each line rotates independently around its own center */
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.hamburger-btn.open .line.top {
  transform: translateY(7px) rotate(45deg);
}

.hamburger-btn.open .line.middle {
  opacity: 0;
  transform: scaleX(0);
}

.hamburger-btn.open .line.bottom {
  transform: translateY(-7px) rotate(-45deg);
}

/* ── Mobile Nav Overlay ────────────────────── */
.mobile-nav-overlay {
  display: none;
  position: fixed;
  inset: 0;
  top: var(--navbar-height);
  background: rgba(15, 17, 19, 0.98);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 9999;
  overflow-y: auto;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.mobile-nav-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-nav-content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: calc(100vh - var(--navbar-height));
  padding: 16px 24px 48px;
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mobile-nav-link {
  font-family: var(--font-sans);
  font-size: 28px;
  font-weight: 400;
  color: var(--color-nav-inactive);
  text-decoration: none;
  padding: 10px 0;
  border-bottom: 1px solid var(--color-stroke);
  transition: color 0.2s ease;
  display: block;
}

.mobile-nav-link:hover,
.mobile-nav-link.active {
  color: var(--color-white);
}

.mobile-nav-actions {
  margin-top: 48px;
}

.mobile-auth-buttons {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.mobile-btn-login,
.mobile-btn-signup {
  width: 100%;
  height: 52px;
  font-size: 16px;
  justify-content: center;
  display: flex;
  align-items: center;
}

/* ── Responsive ────────────────────────────── */
@media (max-width: 860px) {
  .navbar-inner {
    padding: 0 16px;
  }
  .navbar-links,
  .navbar-actions > .nav-link,
  .navbar-actions > .auth-buttons,
  .navbar-actions > .navbar-profile-btn {
    display: none;
  }
  .navbar-actions {
    gap: 0;
  }
  .hamburger-btn {
    display: flex;
  }
  .mobile-nav-overlay {
    display: block;
  }
}
</style>
