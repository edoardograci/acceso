      <path d="M44.8003 0.167526C49.8636 0.167526 52.993 3.26416 53.3446 7.41646H48.5626C48.1055 4.70691 46.6991 3.58086 44.6948 3.58086C42.2335 3.58086 40.4754 5.58663 40.4754 9.8445C40.4754 14.4894 42.2335 16.46 44.6597 16.46C46.5584 16.46 47.9649 15.2636 48.4571 12.9059H53.3094C52.5007 17.5157 49.0549 19.8734 44.3784 19.8734C39.28 19.8734 35.4473 16.636 35.4473 10.1612C35.4473 3.7568 39.6667 0.167526 44.8003 0.167526Z" fill="black"/>
