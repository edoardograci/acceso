      </svg>
    </a>

    <div class="navbar-links">
      {navLinks.map(({ label, href }) => (
        <a href={href} class:list={['nav-link', { active: isActive(href) }]}>{label}</a>
      ))}
    </div>

    <div class="navbar-actions">
      <a
        href="https://instagram.com/acceso_design"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="navbar-instagram-btn btn-icon social-icon-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
      <a href="/submission" class="btn-submission">Submission</a>
      {user ? (
        <a href="/profile" class="navbar-profile-btn" aria-label="Profile">
          <span class="profile-icon">{profileLetter}</span>
        </a>
      ) : (
        <a href="/login" class="btn-login">Login</a>
      )}
    </div>

    <button class="hamburger-btn" id="hamburger-btn" aria-label="Open menu" aria-expanded="false">
      <svg class="hamburger-svg" width="22" height="16" viewBox="0 0 22 16" fill="currentColor">
        <rect class="line top" x="0" y="0" width="22" height="2" rx="1" />
        <rect class="line middle" x="0" y="7" width="22" height="2" rx="1" />
        <rect class="line bottom" x="0" y="14" width="22" height="2" rx="1" />
      </svg>
    </button>
  </div>
</nav>

<div class="mobile-nav-overlay" id="mobile-nav-overlay" aria-hidden="true">
  <div class="mobile-nav-content">
    <nav class="mobile-nav-links">
      {navLinks.map(({ label, href }) => (
        <a href={href} class:list={['mobile-nav-link', { active: isActive(href) }]}>{label}</a>
      ))}
      <a href="/submission" class:list={['mobile-nav-link', { active: isActive('/submission') }]}>Submission</a>
    </nav>
    <div class="mobile-nav-actions">
      <a
        href="https://instagram.com/acceso_design"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-instagram-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
        Instagram
      </a>
      {user ? (
        <a href="/profile" class="btn-primary" style="width:100%;text-align:center;">Profile</a>
      ) : (
        <a href="/login" class="btn-login mobile-btn-login">Login</a>
      )}
    </div>
  </div>
</div>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileNavOverlay = document.getElementById('mobile-nav-overlay');

  function openMenu() {
    hamburgerBtn?.setAttribute('aria-expanded', 'true');
    hamburgerBtn?.classList.add('open');
    mobileNavOverlay?.classList.add('open');
    mobileNavOverlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    hamburgerBtn?.setAttribute('aria-expanded', 'false');
    hamburgerBtn?.classList.remove('open');
    mobileNavOverlay?.classList.remove('open');
    mobileNavOverlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburgerBtn?.addEventListener('click', () => {
    const isOpen = hamburgerBtn.getAttribute('aria-expanded') === 'true';
    if (isOpen) closeMenu();
    else openMenu();
  });

  mobileNavOverlay?.addEventListener('click', (e) => {
    if (e.target === mobileNavOverlay) closeMenu();
  });
</script>

<style>
.navbar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  height: var(--navbar-height);
  z-index: 2000;
  background-color: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--color-stroke);
  color: var(--color-black);
}

.navbar-inner {
  max-width: 1600px;
  margin: 0 auto;
  height: 100%;
  padding: 0 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 32px;
  margin-left: 48px;
  flex: 1;
}

.nav-link {
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 400;
  color: var(--color-nav-inactive);
  transition: color 0.2s ease;
  white-space: nowrap;
}

.nav-link:hover {
  color: var(--color-black);
}

.nav-link.active {
  color: var(--color-black);
  font-weight: 400;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.navbar-instagram-btn {
  color: var(--color-black);
  text-decoration: none;
}

.navbar-instagram-btn:hover {
  color: var(--color-black);
}

.mobile-instagram-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  height: 52px;
  margin-bottom: 12px;
  border-radius: 999px;
  border: 1px solid var(--color-stroke);
  background: var(--color-bg-secondary);
  color: var(--color-black);
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.mobile-instagram-btn:hover {
  opacity: 0.7;
  color: var(--color-black);
}

  .btn-submission,
  .btn-login {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 1px 16px 0;
  border-radius: 999px;
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 700;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  border: 1px solid transparent;
}

.btn-submission {
  background: var(--color-bg-secondary);
  color: var(--color-black);
  border-color: var(--color-stroke);
}

.btn-submission:hover {
  background: #EBEBED;
  border-color: #D4D4D8;
  color: var(--color-black);
}

.btn-login {
  background: var(--color-yellow);
  color: var(--color-black);
  border-color: rgba(237, 255, 119, 0.5);
}

  .btn-login:hover {
    background: var(--color-yellow);
    border-color: var(--color-yellow);
    filter: brightness(0.93);
    color: var(--color-black) !important;
  }

.navbar-profile-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-yellow);
}

.profile-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #000;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  font-weight: 700;
  font-size: 15px;
  line-height: 1;
}

.hamburger-btn {
  display: none;
  justify-content: center;
  align-items: center;
  width: 44px;
  height: 44px;
  background: transparent;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
  color: var(--color-black);
  padding: 0;
}

.hamburger-svg {
  display: block;
  width: 22px;
  height: 16px;
  overflow: visible;
}

.hamburger-svg .line {
  transform-origin: center;
  transform-box: fill-box;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.hamburger-btn.open .line.top {
  transform: translateY(7px) rotate(45deg);
}

.hamburger-btn.open .line.middle {
  opacity: 0;
  transform: scaleX(0);
}

.hamburger-btn.open .line.bottom {
  transform: translateY(-7px) rotate(-45deg);
}

.mobile-nav-overlay {
  display: none;
  position: fixed;
  inset: 0;
  top: var(--navbar-height);
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 9999;
  overflow-y: auto;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.mobile-nav-overlay.open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-nav-content {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: calc(100dvh - var(--navbar-height));
  padding: 16px 24px 48px;
}

.mobile-nav-links {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mobile-nav-link {
  font-family: var(--font-sans);
  font-size: 28px;
  font-weight: 400;
  color: var(--color-nav-inactive);
  text-decoration: none;
  padding: 10px 0;
  border-bottom: 1px solid var(--color-stroke);
  transition: color 0.2s ease;
  display: block;
}

.mobile-nav-link:hover,
.mobile-nav-link.active {
  color: var(--color-black);
  font-weight: 400;
}

.mobile-nav-actions {
  margin-top: 48px;
}

.mobile-btn-login {
  width: 100%;
  height: 52px;
  font-size: 16px;
  justify-content: center;
}

@media (max-width: 860px) {
  .navbar-inner {
    padding: 0 16px;
  }
  .navbar-links,
  .navbar-actions > .btn-submission,
  .navbar-actions > .btn-login,
  .navbar-actions > .navbar-profile-btn,
  .navbar-actions > .navbar-instagram-btn {
    display: none;
  }
  .navbar-actions {
    gap: 0;
  }
  .hamburger-btn {
    display: flex;
  }
  .mobile-nav-overlay {
    display: block;
  }
}
</style>
