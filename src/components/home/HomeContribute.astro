---
---

<div class="bottom-cards">
  <section class="contribute-section">
    <div class="contribute-copy">
      <p class="eyebrow">CONTRIBUTE</p>
      <h2>Know something we should add?</h2>
      <p>
        Send us a studio, school, museum, fair, award, competition, or event that belongs on
        Acceso. Help us keep the map current and useful to each local design scene.
      </p>
      <a href="/submission" class="btn-save">Submit a listing</a>
    </div>
  </section>

  <section class="final-cta">
    <div class="final-cta-copy">
      <p class="eyebrow">BUILD YOUR MAP</p>
      <h2>Save what you want to remember</h2>
      <p>
        Create an account to collect studios, objects, schools, and museums as you explore. Build your own index of design references instead of letting them disappear into another endless feed.
      </p>
      <a href="/login" class="btn-save">Start saving</a>
    </div>
  </section>
</div>

<style>
  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .bottom-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 96px;
  }

  .contribute-section {
    padding: 48px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-bg-secondary);
  }

  .final-cta {
    padding: 48px;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: rgba(237, 255, 119, 0.5);
  }

  .contribute-copy,
  .final-cta-copy {
    max-width: 640px;
  }

  .contribute-section h2,
  .final-cta h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    color: var(--color-black);
    letter-spacing: -0.06em;
    font-size: clamp(34px, 4vw, 60px);
    line-height: 1.04;
  }

  .contribute-copy p:not(.eyebrow),
  .final-cta-copy p:not(.eyebrow) {
    margin: 22px 0 28px;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 1100px) {
    .final-cta {
      align-items: start;
    }
  }

  @media (max-width: 760px) {
    .bottom-cards {
      grid-template-columns: 1fr;
      margin-bottom: 72px;
    }

    .contribute-section,
    .final-cta {
      margin-bottom: 0;
    }

    .contribute-section {
      padding: 24px;
    }

    .final-cta {
      align-items: stretch;
      padding: 24px;
    }

    .contribute-copy p:not(.eyebrow),
    .final-cta-copy p:not(.eyebrow) {
      font-size: 16px;
    }
  }
</style>
