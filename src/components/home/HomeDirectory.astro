---
import { normalizeImage } from '../../lib/images';

const categories = [
  {
    title: 'Schools',
    slug: 'schools',
    coverFile: 'universities-cover.webp',
  },
  {
    title: 'Fairs',
    slug: 'fairs',
    coverFile: 'fairs-cover.webp',
  },
  {
    title: 'Awards',
    slug: 'awards',
    coverFile: 'awards-cover.webp',
  },
  {
    title: 'Museums',
    slug: 'museums',
    coverFile: 'museums-cover.webp',
  },
].map((c) => ({ ...c, image: normalizeImage(c.coverFile, Astro) }));
---

<section class="home-directory" aria-labelledby="home-directory-heading">
  <div class="home-directory-heading">
    <h2 id="home-directory-heading">Everything around the studios</h2>
    <p class="home-directory-lead">
      Explore the schools, fairs, awards, and museums connected to local design scenes.
    </p>
  </div>

  <div class="directory-row">
    {categories.map((c) => (
      <a href={`/directory/${c.slug}`} class="directory-tile">
        <div class="tile-image-bg">
          <img src={c.image} alt={c.title} loading="lazy" decoding="async" />
          <div class="tile-overlay"></div>
        </div>
        <div class="tile-content">
          <h3 class="tile-title">{c.title}</h3>
          <span class="tile-link">
            Explore
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .home-directory {
    margin-bottom: 96px;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .home-directory-heading {
    max-width: 640px;
    margin-bottom: 32px;
  }

  .home-directory-heading h2 {
    margin: 0 0 12px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    color: var(--color-black);
  }

  .home-directory-lead {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .directory-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .directory-tile {
    position: relative;
    height: 280px;
    border-radius: 20px;
    border: 1px solid var(--color-stroke);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .directory-tile:hover {
    transform: translateY(-6px);
    color: inherit;
  }

  .tile-image-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .tile-image-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .directory-tile:hover .tile-image-bg img {
    transform: scale(1.08);
  }

  .tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 45%, transparent 100%);
  }

  .tile-content {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tile-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .tile-link {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
  }

  .tile-link svg {
    transition: transform 0.2s ease;
  }

  .directory-tile:hover .tile-link svg {
    transform: translateX(4px);
  }

  @media (max-width: 1024px) {
    .directory-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .home-directory {
      margin-bottom: 72px;
    }

    .directory-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .directory-tile {
      height: 220px;
    }
  }
</style>
