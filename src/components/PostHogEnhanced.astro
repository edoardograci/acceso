---
// src/components/PostHogEnhanced.astro
/**
 * PostHog Loader - Cookieless Mode with server-side visitor hash
 *
 * Fetches a daily-rotating visitor hash from /api/analytics/visitor-id (computed
 * server-side from IP + UA + salt, never stored) and uses it as distinct_id so
 * pageviews from the same person on the same day count as one visitor.
 */

interface Props {
  visitorId?: string;
  visitorDay?: string;
}

const { visitorId = '', visitorDay = '' } = Astro.props;
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com';
---

{posthogKey ? (
  <script is:inline define:vars={{ posthogKey, posthogHost, visitorId, visitorDay }}>
    (function() {
      if (window.__posthog_loaded) return;
      window.__posthog_loaded = true;

      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]);t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);

      function getUtmParam(param) {
        return new URLSearchParams(window.location.search).get(param) || undefined;
      }

      function getPageType() {
        var path = window.location.pathname;
        if (path === '/' || path === '/map') return 'map';
        if (path === '/discover' || path.indexOf('/discover/') === 0) return 'discover';
        if (path === '/designers') return 'directory';
        if (path.indexOf('/designers/') === 0) return 'designer_profile';
        if (path === '/moodboard') return 'moodboard_index';
        if (path.indexOf('/moodboard/') === 0) return 'moodboard_detail';
        if (path === '/login') return 'login';
        if (path === '/profile') return 'profile';
        if (path.indexOf('/collections/') === 0) return 'collections';
        return 'other';
      }

      function getDeviceCategory() {
        var w = window.innerWidth;
        return w < 768 ? 'mobile' : w < 1024 ? 'tablet' : 'desktop';
      }

      function classifyReferrer() {
        var referrer = document.referrer;
        if (!referrer) return 'direct';
        try {
          var domain = new URL(referrer).hostname;
          if (['google.com','bing.com','yahoo.com'].some(function(d){return domain.includes(d)})) return 'organic';
          if (['t.co','facebook.com','instagram.com','linkedin.com'].some(function(d){return domain.includes(d)})) return 'social';
          return 'referral';
        } catch(e) { return 'direct'; }
      }

      function initPostHog(visitorId, visitorDay) {
        window.posthog.init(posthogKey, {
          api_host: posthogHost,
          persistence: 'memory',
          bootstrap: { distinctID: visitorId },
          loaded: function(posthog) {
            if (window.location.hostname !== 'acceso.design') {
              posthog.opt_out_capturing();
              return;
            }

            posthog.register({
              visitor_hash: visitorId,
              visitor_day: visitorDay,
              page_type: getPageType(),
              device_category: getDeviceCategory(),
              referrer_type: classifyReferrer(),
            });

            posthog.register_once({
              initial_referrer: document.referrer || '$direct',
              initial_utm_source: getUtmParam('utm_source'),
              initial_utm_medium: getUtmParam('utm_medium'),
              initial_utm_campaign: getUtmParam('utm_campaign'),
            });

            if (!sessionStorage.getItem('acceso_session_engaged')) {
              var timer = setTimeout(function() {
                sessionStorage.setItem('acceso_session_engaged', 'true');
                posthog.capture('session_engaged', { duration_sec: 30 });
              }, 30000);
              window.addEventListener('beforeunload', function() {
                clearTimeout(timer);
              }, { once: true });
            }
          },
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: false,
          disable_session_recording: true,
          opt_out_capturing_by_default: false,
          advanced_disable_feature_flags: true,
          _request_timeout_ms: 10000,
          batch_size: 20,
          batch_interval_ms: 3000,
          sanitize_properties: function(properties) {
            ['$current_url', '$referrer'].forEach(function(prop) {
              if (properties[prop]) {
                try {
                  var url = new URL(properties[prop]);
                  ['email','phone','name','address','token','key','secret'].forEach(function(p) {
                    url.searchParams.delete(p);
                  });
                  properties[prop] = url.toString();
                } catch(e) {}
              }
            });
            return properties;
          },
        });
      }

      function start(id, day) {
        initPostHog(id, day);
      }

      if (visitorId) {
        start(visitorId, visitorDay || new Date().toISOString().slice(0, 10));
      } else {
        fetch('/api/analytics/visitor-id', { credentials: 'same-origin' })
          .then(function(res) { return res.ok ? res.json() : null; })
          .then(function(data) {
            start((data && data.visitorId) || 'anon-' + Date.now(), (data && data.day) || new Date().toISOString().slice(0, 10));
          })
          .catch(function() {
            start('anon-' + Date.now(), new Date().toISOString().slice(0, 10));
          });
      }
    })();
  </script>
) : null}
