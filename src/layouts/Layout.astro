---
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import PostHogEnhanced from '../components/PostHogEnhanced.astro';
import { organization, website } from '../lib/seo/schema';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: URL;
  ogType?: 'website' | 'article';
  schema?: Record<string, any>;
  keywords?: string;
  robots?: string;
}

const {
  title,
  description,
  image = '/social-card.png',
  canonical = new URL(Astro.url.pathname, Astro.site),
  ogType = 'website',
  schema,
  keywords,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const DEFAULT_DESCRIPTION =
  'Acceso is your local design infopoint — a curated directory of independent design studios, designers, schools, museums, fairs, and awards across cities worldwide.';

const metaDescription = description || DEFAULT_DESCRIPTION;

// Pass user ID to client-side for collections state
const userId = Astro.locals.user?.id || null;

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : '';
const baseGraph: any[] = siteUrl
  ? [
      organization({
        url: siteUrl,
        name: 'Acceso',
        logo: new URL('/icon.svg', Astro.site).toString(),
      }),
      website({ url: siteUrl, name: 'Acceso' }),
    ]
  : [];

const extraGraph: any[] = (() => {
  if (!schema) return [];
  if (Array.isArray((schema as any)['@graph'])) return (schema as any)['@graph'];
  return [schema];
})();

const mergedSchema =
  baseGraph.length || extraGraph.length
    ? { '@context': 'https://schema.org', '@graph': [...baseGraph, ...extraGraph] }
    : null;
---

<!DOCTYPE html>
<html lang="en" class="light">
  <head>
    <PostHogEnhanced />
    <slot name="head" />

    <!-- EMERGENCY STABILITY GUARD: Stops adblocker-induced loops -->
    <script is:inline>
      (function() {
        // 1. Silence repetitive external crashes (Cloudflare/PostHog stubs)
        window.addEventListener('error', function(e) {
          if (e.message && (e.message.includes('iterable') || e.message.includes('Cloudflare'))) {
            e.stopImmediatePropagation();
          }
        }, true);

        // 2. Kill Cloudflare Analytics before it crashes Brave
        const observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
              if (node.tagName === 'SCRIPT' && node.src && node.src.includes('cloudflareinsights')) {
                if (node.remove) node.remove();
                else if (node.parentNode) node.parentNode.removeChild(node);
              }
            });
          });
        });
        observer.observe(document.documentElement, { childList: true, subtree: true });

        // 3. Kill ghost Service Workers
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function(rs) {
            for (var r of rs) r.unregister();
          });
        }
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg?v=2" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest?v=2" />
    <link rel="canonical" href={canonical} />

    <!-- Performance: preload the self-hosted variable font used site-wide -->
    <link rel="preconnect" href="https://img.acceso.design" />
    <link rel="preconnect" href="https://mood.acceso.design" />

    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- CRITICAL: Set user ID BEFORE loading collections state -->
    {userId && (
      <script is:inline define:vars={{ userId }}>
        window.currentUserId = userId;
      </script>
    )}

    <script>
      /**
       * Collections Engine v6.0 (High Priority)
       */
      (function() {
        const state = { designers: new Set<string>(), objects: new Set<string>(), museums: new Set<string>(), universities: new Set<string>(), loaded: false, subs: new Set<() => void>() };

        const notify = () => {
          state.subs.forEach((fn: any) => { try { fn(); } catch(e) {} });
          window.dispatchEvent(new CustomEvent('collections-changed', { detail: { designers: Array.from(state.designers), objects: Array.from(state.objects), museums: Array.from(state.museums), universities: Array.from(state.universities) } }));
        };

        const collectionConfig = (type: string) => {
          switch (type) {
            case 'designer': return { set: state.designers, endpoint: 'designers', idKey: 'studio_id' };
            case 'object':   return { set: state.objects,   endpoint: 'objects',   idKey: 'product_id' };
            case 'museum':   return { set: state.museums,   endpoint: 'museums',   idKey: 'museum_id' };
            case 'university': return { set: state.universities, endpoint: 'universities', idKey: 'university_id' };
            default:         return { set: state.objects,   endpoint: 'objects',   idKey: 'product_id' };
          }
        };

        const sync = async () => {
          try {
            const res = await fetch('/api/collections/status', { credentials: 'include', cache: 'no-store' });
            if (!res.ok) return;
            const data = await res.json();

            // Only update if we aren't currently waiting for a mutation to finish
            if (Array.isArray(data.designers)) state.designers = new Set(data.designers);
            if (Array.isArray(data.objects)) state.objects = new Set(data.objects);
            if (Array.isArray(data.museums)) state.museums = new Set(data.museums);
            if (Array.isArray(data.universities)) state.universities = new Set(data.universities);
          } catch (e) {} finally {
            state.loaded = true;
            notify();
          }
        };

        // @ts-ignore
        window.collectionsState = {
          get loaded() { return state.loaded; },
          get designers() { return state.designers; },
          get objects() { return state.objects; },
          get museums() { return state.museums; },
          get universities() { return state.universities; },
          isSaved: (t: any, i: any) => collectionConfig(t).set.has(i),
          getCount: (t: any) => collectionConfig(t).set.size,
          subscribe: (fn: any) => { state.subs.add(fn); return () => state.subs.delete(fn); },
          addItem: async (type: string, id: string) => {
            const { set, endpoint, idKey } = collectionConfig(type);
            if (set.has(id)) return;
            set.add(id); notify();
            try {
              const res = await fetch(`/api/collections/${endpoint}`, {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                credentials: 'include', body: JSON.stringify({ [idKey]: id })
              });
              if (!res.ok) throw new Error('Add failed');
            } catch (e) {
              set.delete(id); notify();
              throw e;
            }
          },
          removeItem: async (type: string, id: string) => {
            const { set, endpoint } = collectionConfig(type);
            if (!set.has(id)) return;
            set.delete(id); notify();
            try {
              const res = await fetch(`/api/collections/${endpoint}/${encodeURIComponent(id)}`, {
                method: 'DELETE', credentials: 'include'
              });
              if (!res.ok) throw new Error('Remove failed');
            } catch (e) {
              set.add(id); notify();
              throw e;
            }
          },
          init: sync
        };
        window.collectionsState?.init();
      })();
    </script>

    <title>{title}</title>

    {metaDescription && (
      <meta name="description" content={metaDescription} />
    )}

    {keywords && (
      <meta name="keywords" content={keywords} />
    )}

    <meta name="robots" content={robots} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Acceso" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    {metaDescription && (
      <meta property="og:description" content={metaDescription} />
    )}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {metaDescription && (
      <meta name="twitter:description" content={metaDescription} />
    )}
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- JSON-LD (explicit only) -->
    {mergedSchema && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(mergedSchema).replace(/</g, '\\u003c')}
      />
    )}
  </head>

  <body>
    <slot />
    <CookieBanner />
    <!-- 100% privacy-first analytics -->
    <script is:inline data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade"/></noscript>
  </body>
</html>
