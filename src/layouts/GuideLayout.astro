</style>

<script>
  // ---- TOC: close by default on tablet and smaller ----
  function initToc() {
    const details = document.getElementById('guide-toc-details') as HTMLDetailsElement | null;
    if (!details) return;
    if (window.innerWidth <= 1024) {
      details.removeAttribute('open');
    } else {
      details.setAttribute('open', '');
    }
  }

  initToc();
  window.addEventListener('resize', initToc, { passive: true });

  // ---- TOC: focus first item on load ----
  const firstTocLink = document.querySelector('.guide-toc-list li:first-child a') as HTMLAnchorElement | null;
  if (firstTocLink) {
    firstTocLink.setAttribute('tabindex', '0');
    firstTocLink.focus({ preventScroll: true });
  }

  // ---- TOC: clicking an item focuses it and scrolls smoothly ----
  document.querySelectorAll('.guide-toc-list a').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const slug = link.getAttribute('href')?.replace('#', '');
      if (slug) {
        const target = document.getElementById(slug);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      link.focus({ preventScroll: true });
    });
  });

  // ---- Copy-link button ----
  const copyBtn = document.getElementById('guide-copy-link-btn') as HTMLButtonElement | null;
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Fallback for older browsers
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      // Show check icon briefly
      const copyIcon = copyBtn.querySelector('.share-copy-icon') as SVGElement | null;
      const checkIcon = copyBtn.querySelector('.share-check-icon') as SVGElement | null;
      if (copyIcon) copyIcon.style.display = 'none';
      if (checkIcon) checkIcon.style.display = '';
      setTimeout(() => {
        if (copyIcon) copyIcon.style.display = '';
        if (checkIcon) checkIcon.style.display = 'none';
      }, 2000);
    });
  }
</script>
