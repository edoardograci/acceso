---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  keywords?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  canonical?: URL;
  schema?: Record<string, any>;
  robots?: string;
}

const props = Astro.props;
---
<Layout {...props}>
  <slot />
</Layout>
