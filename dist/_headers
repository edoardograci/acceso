# public/_headers
# Cache images aggressively
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  
/*.png
  Cache-Control: public, max-age=31536000, immutable
  
/*.webp
  Cache-Control: public, max-age=31536000, immutable
  
/*.avif
  Cache-Control: public, max-age=31536000, immutable

# Cache static JSON
/studios.json
  Cache-Control: public, max-age=3600, s-maxage=86400
  
# Cache fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable