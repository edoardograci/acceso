
# Environment Variables - NEVER commit these files
.env
.env.local
.env.production
.dev.vars

# Example file with placeholder values (safe to commit)
# .env.example

# Turso Database
TURSO_DATABASE_URL=libsql://acceso-edoardograci.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Site Configuration
PUBLIC_SITE_URL=https://acceso.design

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here

# Admin monitoring dashboard (/admin)
# Comma-separated allowlist of emails allowed to open the dashboard.
# Unset means nobody: the route stays closed rather than open.
ADMIN_EMAILS=you@example.com

# PostHog read access for the dashboard. Create a Personal API key in
# PostHog → Settings → Personal API keys, scoped to read query/insights only.
# NOTE: this is the app host (eu.posthog.com), not the ingest host
# (eu.i.posthog.com) used by PUBLIC_POSTHOG_HOST.
POSTHOG_API_KEY=phx_your_personal_api_key_here
POSTHOG_PROJECT_ID=12345
POSTHOG_API_HOST=https://eu.posthog.com

# Daily-rotating visitor hash (IP + UA + salt, never stored). Required in production.
VISITOR_HASH_SALT=YourRandomSaltHere
