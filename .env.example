
# Environment Variables - NEVER commit these files
.env
.env.local
.env.production
.dev.vars

# Example file with placeholder values (safe to commit)
# .env.example

# Turso Database
TURSO_DATABASE_URL=libsql://acceso-edoardograci.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Site Configuration
PUBLIC_SITE_URL=https://acceso.design

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_jwt_secret_here
